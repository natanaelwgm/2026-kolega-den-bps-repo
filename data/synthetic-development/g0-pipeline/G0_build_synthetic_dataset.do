version 17
clear all
set more off
set varabbrev off
set maxvar 10000
args repo_root
if `"`repo_root'"'=="" local repo_root "."
cd "`repo_root'"
confirm file "data/synthetic-development/schema/G0_analysis_ready_schema.csv"
cd "data/synthetic-development/g0-pipeline"
local pipeline_root "`c(pwd)'"
global G0INPUT "dag/data/staged"
global G0D "dag/data/word_data/G0"
global G0R "dag/reports/word_data/G0"
global G0L "dag/logs/word_data/G0"
log using "dag/logs/G0_SYNTHETIC_PRIMARY.log", text replace name(primary)
display "SYNTHETIC_ONLY_NO_ORIGINAL_DATA_NO_ESTIMATION"
do "dag/edges/G0_import_synthetic_excel.do"
display "SYNTHETIC_CHILD_START G0_01_source_manifest"
do "dag/edges/word_rows/G0/G0_01_source_manifest.do"
display "SYNTHETIC_CHILD_PASS G0_01_source_manifest"
display "SYNTHETIC_CHILD_START G0_02_preserve_annual_fields"
do "dag/edges/word_rows/G0/G0_02_preserve_annual_fields.do"
display "SYNTHETIC_CHILD_PASS G0_02_preserve_annual_fields"
display "SYNTHETIC_CHILD_START G0_03_map_economic_fields"
do "dag/edges/word_rows/G0/G0_03_map_economic_fields.do"
display "SYNTHETIC_CHILD_PASS G0_03_map_economic_fields"
display "SYNTHETIC_CHILD_START G0_04_validate_real_identifiers"
do "dag/edges/word_rows/G0/G0_04_validate_real_identifiers.do"
display "SYNTHETIC_CHILD_PASS G0_04_validate_real_identifiers"
display "SYNTHETIC_CHILD_START G0_05_map_geography_industry"
do "dag/edges/word_rows/G0/G0_05_map_geography_industry.do"
display "SYNTHETIC_CHILD_PASS G0_05_map_geography_industry"
display "SYNTHETIC_CHILD_START G0_06_stage_validate_deflators"
do "dag/edges/word_rows/G0/G0_06_stage_validate_deflators.do"
display "SYNTHETIC_CHILD_PASS G0_06_stage_validate_deflators"
display "SYNTHETIC_CHILD_START G0_07_validate_energy_units_factors"
do "dag/edges/word_rows/G0/G0_07_validate_energy_units_factors.do"
display "SYNTHETIC_CHILD_PASS G0_07_validate_energy_units_factors"
display "SYNTHETIC_CHILD_START G0_08_construct_energy_emissions"
do "dag/edges/word_rows/G0/G0_08_construct_energy_emissions.do"
display "SYNTHETIC_CHILD_PASS G0_08_construct_energy_emissions"
display "SYNTHETIC_CHILD_START G0_09_construct_ratios_logs"
do "dag/edges/word_rows/G0/G0_09_construct_ratios_logs.do"
display "SYNTHETIC_CHILD_PASS G0_09_construct_ratios_logs"
display "SYNTHETIC_CHILD_START G0_10_assemble_main_dataset"
do "dag/edges/word_rows/G0/G0_10_assemble_main_dataset.do"
display "SYNTHETIC_CHILD_PASS G0_10_assemble_main_dataset"
display "SYNTHETIC_CHILD_START G0_12_validate"
do "dag/edges/word_rows/G0/G0_12_validate.do"
display "SYNTHETIC_CHILD_PASS G0_12_validate"
log close primary
do "dag/edges/word_rows/G0/G0_verify_variable_year.do" "`pipeline_root'"
do "dag/edges/word_rows/G0/G0_integrate_verified_candidate.do" "`pipeline_root'" "dag/data/word_data/G0/G0_main_candidate.dta"
do "dag/edges/word_rows/G0/G0_publish_analysis_tunnel.do" "`pipeline_root'"
do "dag/edges/word_rows/G0/G0_render_verified_charts.do" "`pipeline_root'"
do "dag/edges/wpi/G0_apply_wpi.do"
do "dag/edges/G0_finish_preparation_gaps.do"
do "dag/edges/G0_test_preparation_cases.do"
do "dag/edges/G0_preserve_fixture_identity.do"
do "dag/edges/G0_validate_synthetic_final.do"
display "G0_SYNTHETIC_FULL_PIPELINE_SUCCESS"
