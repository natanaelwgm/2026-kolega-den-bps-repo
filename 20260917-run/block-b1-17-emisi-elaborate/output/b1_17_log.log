######## B1-17: 08_by_trade ########

. /*==========================================================================
>   Line 8: "Export or not, import or not"
>   Data  : SI 2010-2022 (data/b17_si.dta), clean == 1
>   Output sheets:
>     t08_by_exporter   CO2 scope 1 / 2 / total (level & ln), intensities,
>                       exporter vs non-exporter, pool + by year
>     t08_by_importer   the same, importer vs non-importer
>     t08_by_trade      the same, 4 groups: neither / export only /
>                       import only / both
> 
>   NOTE: 2022 export flag is set missing (the form only asks about direct
>   exports). The importer rate jumps between 2015 and 2017 (questionnaire
>   change, not a trend).
> ==========================================================================*/
. if "$B17" == "" {
.     display as error "Run 00_run.do first (it sets the paths)."
.     exit 198
. }

. use "$B17_DATA/b17_si.dta", clear
(G0 -> G0.25 OBSCURED -> G0.5 DUMMY PANEL -> G1 RE-ESTIMATED)

. keep if clean == 1
(30 observations deleted)

. generate trade = 1 if exporter == 0 & importer == 0
(20,511 missing values generated)

. replace  trade = 2 if exporter == 1 & importer == 0
(2,154 real changes made)

. replace  trade = 3 if exporter == 0 & importer == 1
(1,363 real changes made)

. replace  trade = 4 if exporter == 1 & importer == 1
(1,352 real changes made)

. label define trade 1 "Neither" 2 "Export only" 3 "Import only" 4 "Export and 
> import"

. label values trade trade

. 
. local EMIS "co2_s1 co2_s2 co2_total ln_co2_s1 ln_co2_s2 ln_co2_total co2_per_
> va co2_pw"

. do "$B17/_sumstats.do" "`EMIS'" "exporter" "t08_by_exporter"

. /*==========================================================================
>   _sumstats.do -- helper: descriptive statistics table, POOLED + BY YEAR
> 
>   Usage (data already loaded, must contain variable year):
>       do "$B17/_sumstats.do" "co2_total ln_co2_total" "fdi" "t07_by_fdi"
> 
>       argument 1 = list of variables
>       argument 2 = grouping variable ("" for no grouping)
>       argument 3 = sheet name in output/b1_17_tables.xlsx (max 31 characters)
> 
>   Result: 1 row = variable x group x period (pool, 2010, 2011, ...)
>           columns n mean sd p10 p25 p50 p75 p90 min max
>   Rows with a missing group are not counted.
>   The data in memory are unchanged after this file runs.
> ==========================================================================*/
. args vars grp sheet

. 
. tempfile result original

. save `original'
file /var/folders/7l/7f30l8dj7219j21dhg9glmwc0000gn/T//St65806.000002 saved
    as .dta format

. local first 1

. if "`grp'" == "" {
.     generate byte all = 1
.     local grp all
. }

. foreach v of local vars {
  2.     foreach period in pool year {
  3.         preserve
  4.         keep `v' `grp' year
  5.         keep if !missing(`v') & !missing(`grp')
  6.         if _N > 0 {
  7.             if "`period'" == "pool" replace year = 0
  8.             collapse (count) n = `v' (mean) mean = `v' (sd) sd = `v' ///
>                      (p10) p10 = `v' (p25) p25 = `v' (p50) p50 = `v' ///
>                      (p75) p75 = `v' (p90) p90 = `v' (min) min = `v' (max) ma
> x = `v', ///
>                      by(`grp' year)
  9.             generate str32 variable = "`v'"
 10.             if `first' == 0 append using `result'
 11.             save `result', replace
 12.             local first 0
 13.         }
 14.         restore
 15.     }
 16. }
