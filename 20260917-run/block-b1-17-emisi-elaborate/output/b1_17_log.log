. /*==========================================================================
>   _sumstats.do -- helper: descriptive statistics table, POOLED + BY YEAR
> 
>   Usage (data already loaded, must contain variable year):
>       do "$B17/_sumstats.do" "co2_total ln_co2_total" "fdi" "t07_by_fdi"
> 
>       argument 1 = list of variables
>       argument 2 = grouping variable ("" for no grouping)
>       argument 3 = sheet name in output/b1_17_tables.xlsx (max 31 characters)
> 
>   Result: 1 row = variable x group x period (pool, 2010, 2011, ...)
>           columns n mean sd p10 p25 p50 p75 p90 min max
>   Rows with a missing group are not counted.
>   The data in memory are unchanged after this file runs.
> ==========================================================================*/
. args vars grp sheet

. 
. tempfile result original

. save `original'
file /var/folders/7l/7f30l8dj7219j21dhg9glmwc0000gn/T//St65806.000002 saved
    as .dta format

. local first 1

. if "`grp'" == "" {
.     generate byte all = 1
.     local grp all
. }

. foreach v of local vars {
  2.     foreach period in pool year {
  3.         preserve
  4.         keep `v' `grp' year
  5.         keep if !missing(`v') & !missing(`grp')
  6.         if _N > 0 {
  7.             if "`period'" == "pool" replace year = 0
  8.             collapse (count) n = `v' (mean) mean = `v' (sd) sd = `v' ///
>                      (p10) p10 = `v' (p25) p25 = `v' (p50) p50 = `v' ///
>                      (p75) p75 = `v' (p90) p90 = `v' (min) min = `v' (max) ma
> x = `v', ///
>                      by(`grp' year)
  9.             generate str32 variable = "`v'"
 10.             if `first' == 0 append using `result'
 11.             save `result', replace
 12.             local first 0
 13.         }
 14.         restore
 15.     }
 16. }
