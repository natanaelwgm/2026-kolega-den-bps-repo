. * the drawn points: the three periods, CO2 per value added (per output for version "output")
. gen byte shown = drawn & kind == "main" & measure == cond(version == "output", "co2_out", "co2_va")

. * does the total keep the main version's direction? list every drawn version where it does not
. bysort pord: egen double main_change = max(cond(version == "main" & measure == "co2_va", pct_change, .))

. sort vord pord

. local flips ""

. quietly levelsof vord if shown & sign(round(pct_change)) != sign(round(main_change)), local(fv)

. foreach i of local fv {
  2.     quietly levelsof pord if shown & vord == `i' & sign(round(pct_change)) != sign(round(main_change)), local(fp)
  3.     foreach q of local fp {
  4.         quietly summarize pct_change if shown & vord == `i' & pord == `q', meanonly
  5.         local val = round(r(mean))
  6.         local val = cond(`val' > 0, "+", "−") + strofreal(abs(`val'))
  7.         quietly levelsof version if vord == `i', local(vv) clean
  8.         local L = char(96 + `q')
  9.         local flips = cond("`flips'" == "", "", "`flips'; ") + "(`L') `short_`vv'' (`val'%)"
 10.     }
 11. }

. display "   versions whose total goes the other way from the main version: `flips'"
   versions whose total goes the other way from the main version: (c) 300× (+37%); (c) without importers of unknown expo
> rt status only in 2019–22 (+12%)

. * ---- the line under the title (built from the data): per period, does every drawn
. * version move the total the same way (up or down) as the main version? Where the
. * cut-off decides it, name the single records that decide it; where the doubtful
. * importers are set aside in the end year only, say that the two years count different firms.
. local lomin : word 1 of `desc'

. foreach k of local desc {
  2.     if !`: list k in cuts_table' & `k' < `lomin' local lomin `k'   // strictest drawn cut-off
  3. }

. local same ""

. local wflip ""

. forvalues q = 1/3 {
  2.     local L = char(96 + `q')
  3.     quietly count if shown & pord == `q' & sign(round(pct_change)) != sign(round(main_change))
  4.     if r(N) == 0 {
  5.         local same = cond("`same'" == "", "(`L')", "`same' and (`L')")
  6.         continue
  7.     }
  8.     quietly summarize main_change if pord == `q', meanonly
  9.     local mv = round(r(mean))
 10.     local mtx = cond(`mv' > 0, "+", cond(`mv' < 0, "−", "")) + strofreal(abs(`mv'))
 11.     quietly summarize start_year if pord == `q', meanonly
 12.     local a = r(mean)
 13.     quietly summarize end_year if pord == `q', meanonly
 14.     local b = r(mean)
 15.     local t ""
 16.     * (1) the cut-off versions (as filed and every drawn cut-off)
.     quietly count if shown & pord == `q' & mark <= 2 & sign(round(pct_change)) != sign(round(main_change))
 17.     if r(N) > 0 {
 18.         quietly summarize pct_change if shown & pord == `q' & mark <= 2
 19.         local lo = round(r(min))
 20.         local hi = round(r(max))
 21.         local lo = cond(`lo' > 0, "+", cond(`lo' < 0, "−", "")) + strofreal(abs(`lo'))
 22.         local hi = cond(`hi' > 0, "+", cond(`hi' < 0, "−", "")) + strofreal(abs(`hi'))
 23.         local t "In (`L') the total runs from `lo'% to `hi'% across the cut-offs (main `mtx'%)"
 24.         * records some drawn version keeps and another sets aside: over the strictest
.         * drawn cut-off. The largest one in each of the two years, if it holds 10% or
.         * more of that year's CO2 (as filed), is named.
.         preserve
 25.         use `firmyears', clear
 26.         quietly keep if r9_U & inlist(year, `a', `b')
 27.         bysort year: egen double tco2 = total(co2_total_s1)
 28.         gen double sh = 100 * co2_total_s1 / tco2
 29.         gen double rel = r9_ratio / r9_med
 30.         quietly keep if rel > `lomin' & sh >= 10
 31.         bysort year (sh): keep if _n == _N
 32.         local recs ""
 33.         forvalues i = 1/`=_N' {
 34.             local rr = strofreal(round(rel[`i']), "%12.0fc")
 35.             local ss = strofreal(round(sh[`i']))
 36.             local yy = year[`i']
 37.             if "`recs'" == "" local recs "one `yy' record, at `rr'× its sector's median energy per unit of value ad
> ded, holds `ss'% of that year's CO2"
 38.             else local recs "`recs'; one `yy' record, at `rr'×, holds `ss'%"
 39.         }
 40.         restore
 41.         if "`recs'" != "" local t "`t' because single records decide it: `recs'"
 42.         local t "`t'. So whether the level fell or rose in (`L') is not settled."
 43.     }
 44.     * (2) doubtful importers set aside only in the doubt years, when the period starts
.     * before them and ends in them: the two years then count different firms
.     local dyrs "$R9_DOUBT_YRS"
 45.     local sa : list a in dyrs
 46.     local sb : list b in dyrs
 47.     quietly count if shown & pord == `q' & version == "noimpdoubt" & sign(round(pct_change)) != sign(round(main_cha
> nge))
 48.     if r(N) > 0 & !`sa' & `sb' {
 49.         quietly summarize pct_change if shown & pord == `q' & version == "noimpdoubt", meanonly
 50.         local v1 = round(r(mean))
 51.         local v1 = cond(`v1' > 0, "+", cond(`v1' < 0, "−", "")) + strofreal(abs(`v1'))
 52.         quietly summarize pct_change if shown & pord == `q' & version == "noimp", meanonly
 53.         local v2 = round(r(mean))
 54.         local v2 = cond(`v2' > 0, "+", cond(`v2' < 0, "−", "")) + strofreal(abs(`v2'))
 55.         preserve
 56.         use `firmyears', clear
 57.         quietly keep if r9_M & year == `a'
 58.         foreach g in 1 0 {
 59.             quietly summarize co2_total_s1 if imp_unk == `g', meanonly
 60.             local c = r(sum)
 61.             quietly summarize value_added_nominal if imp_unk == `g', meanonly
 62.             local lv`g' = round(1e6 * `c' / r(sum))
 63.         }
 64.         restore
 65.         local t2 "setting importers of unknown export status aside only in `dtxt' gives `v1'%, but then `a' counts 
> them and `b' does not (their `a' level: `lv1'; other firms: `lv0'); set aside in every year: `v2'%."
 66.         local t = cond("`t'" == "", "In (`L'): `t2'", "`t' " + upper(substr("`t2'", 1, 1)) + substr("`t2'", 2, .))
 67.     }
 68.     * (3) any other drawn version that goes the other way
.     quietly levelsof vord if shown & pord == `q' & mark == 3 & version != "noimpdoubt" ///
>         & sign(round(pct_change)) != sign(round(main_change)), local(ov)
 69.     foreach i of local ov {
 70.         quietly levelsof version if vord == `i', local(vv) clean
 71.         quietly summarize pct_change if shown & vord == `i' & pord == `q', meanonly
 72.         local vo = round(r(mean))
 73.         local vo = cond(`vo' > 0, "+", cond(`vo' < 0, "−", "")) + strofreal(abs(`vo'))
 74.         local t = cond("`t'" == "", "In (`L'): ", "`t' ") + "`short_`vv'': `vo'%."
 75.     }
 76.     local wflip = strtrim("`wflip' `t'")
 77. }
