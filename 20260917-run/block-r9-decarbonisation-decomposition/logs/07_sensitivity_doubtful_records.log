. capture program drop r9_interval_sample

. program define r9_interval_sample, rclass
  1.     args a b mode
  2.     if !inlist("`mode'", "", "main", "asfiled") {
  3.         display as error "r9_interval_sample: third argument must be main or asfiled"
  4.         exit 198
  5.     }
  6.     quietly {
  7.         keep if inlist(year, `a', `b')
  8.         * a firm in both files but outside the universe in one year (energy 0 or
.         * value added <= 0) would look like an entrant or leaver: set aside in main
.         bysort firm_id: gen byte r9_fstay = _N == 2
  9.         bysort firm_id: egen byte r9_ufirm = min(r9_U)
 10.         count if r9_fstay & !r9_ufirm & r9_U
 11.         return scalar n_stayers_outside_universe = r(N)
 12.         if "`mode'" != "asfiled" drop if r9_fstay & !r9_ufirm
 13.         keep if r9_U
 14.         drop r9_fstay r9_ufirm
 15.         bysort firm_id: gen byte r9_stay = _N == 2
 16.         bysort firm_id: egen byte r9_xfirm = max(r9_x)
 17.         count if r9_stay & r9_xfirm & year == `a'
 18.         return scalar n_stayers_set_aside = r(N)
 19.         count if r9_x | (r9_stay & r9_xfirm)
 20.         return scalar n_records_set_aside = r(N)
 21.         if "`mode'" != "asfiled" drop if r9_x | (r9_stay & r9_xfirm)
 22.         gen byte r9_grp = cond(r9_stay, 1, cond(year == `b', 2, 3))
 23.         label define r9_grp 1 "stayer" 2 "entrant (appears)" 3 "leaver (disappears)", replace
 24.         label values r9_grp r9_grp
 25.         drop r9_stay r9_xfirm r9_s r9_so
 26.         bysort year: egen double r9_tva = total(value_added_nominal)
 27.         gen double r9_s = value_added_nominal / r9_tva
 28.         bysort year: egen double r9_tgo = total(cond(!missing(r9_o_co2), gross_output_nominal, .))
 29.         gen double r9_so = gross_output_nominal / r9_tgo if !missing(r9_o_co2)
 30.         drop r9_tva r9_tgo
 31.         count if r9_grp == 1 & year == `a'
 32.         return scalar n_stayers = r(N)
 33.         count if r9_grp == 2
 34.         return scalar n_entrants = r(N)
 35.         count if r9_grp == 3
 36.         return scalar n_leavers = r(N)
 37.     }
 38. end

. 
. capture program drop r9_interval_note

. program define r9_interval_note, rclass
  1.     args a b
  2.     local note ""
  3.     local yrs "$R9_YEARS"
  4.     forvalues y = `=`a' + 1'/`=`b' - 1' {
  5.         if !`: list y in yrs' local note = cond("`note'" == "", "", "`note'; ") + "no annual file for `y'"
  6.     }
  7.     foreach y of global R9_JUMP_YRS {
  8.         if inlist(`y', `a', `b') local note = cond("`note'" == "", "", "`note'; ") + "energy recording jump in `y'"
  9.     }
 10.     local d ""
 11.     foreach y of global R9_DOUBT_YRS {
 12.         if inlist(`y', `a', `b') local d "energy records partly doubtful"
 13.     }
 14.     if "`d'" != "" local note = cond("`note'" == "", "", "`note'; ") + "`d'"
 15.     return local note "`note'"
 16. end

. * ============ end of R9 UNIVERSE, WEIGHTS AND INTERVALS ============
. *###########################################################################
. *## R9 DECOMPOSITION PROGRAMS (copy exactly into R9-02..05, 07)          ##
. *## Tested here in R9-06. Never edit one copy alone: change it here,     ##
. *## rerun R9-06, then copy this whole block again into every R9 file.    ##
. *###########################################################################
. * What the programs split: an aggregate ratio I in year t, e.g. total CO2 /
. * total value added, is the value-added-weighted average of the firms' ratios:
. *     I_t = sum_i num_it / sum_i den_it = sum_i s_it * a_it
. *     a_it = scale * num_it / den_it   firm i's ratio (e.g. tonnes CO2 per million of value added)
. *     s_it = den_it / sum_j den_jt     firm i's share of the year's value added (shares add to 1)
. * Between a start year (from) and an end year (to) every firm is one of:
. *     C = stays (in both years), N = enters (end year only), X = exits (start year only).
. * FHK (Foster, Haltiwanger and Krizan), dI = I_to - I_from = sum of five parts:
. *     within  = sum_C s_i,from * (a_i,to - a_i,from)            staying firms get cleaner
. *     between = sum_C (a_i,from - I_from) * (s_i,to - s_i,from) value added shifts among staying firms
. *     cross   = sum_C (a_i,to - a_i,from) * (s_i,to - s_i,from) both at once
. *     entry   = sum_N s_i,to * (a_i,to - I_from)
. *     exit    = - sum_X s_i,from * (a_i,from - I_from)
. * Melitz-Polanec, dI = sum of four parts (each group G has share S_G, own level
. * I_G = sum_G s_i a_i / S_G, plain average abar_G over its n_G firms and
. *     cov_G = sum_G (s_i/S_G - 1/n_G) * (a_i - abar_G) = I_G - abar_G,
. * i.e. n_G times the covariance of within-group shares and ratios):
. *     stayers_mean = abar_C,to - abar_C,from                      staying firms' plain average
. *     stayers_cov  = cov_C,to - cov_C,from                        shift of value added among staying firms
. *     entry        = S_N,to   * (I_N,to - I_C,to)
. *     exit         = S_X,from * (I_C,from - I_X,from)
. * The two methods measure entry and exit against different benchmarks, so
. * their parts need not match (R9-06 example 5 shows why); both add up exactly.
. * Usage (r9_mp takes the same options except saving()):
. *     r9_fhk num den [if], firm(id) year(year) from(#) to(#) [scale(#) setaside(flag) saving(file)]
. *     num den    numerator and denominator (den above zero, num zero or more, never missing:
. *                the calling file chooses its universe with -if-, the program never drops rows silently)
. *     scale()    multiplies the firm ratios (default 1,000,000: per million units of the denominator)
. *     setaside() 0/1 firm-year flag (e.g. extreme record); a firm flagged in EITHER year is left out
. *                in BOTH years, so setting a record aside never creates a fake entrant or leaver
. *     saving()   r9_fhk only: one row per firm with its five parts (zero where a part does not
. *                apply), so R9-04 and R9-05 can add the parts up by group
. * The data in memory are never changed. Results come back in r(); see -return list-.
. * R9 samples: build each period's sample with r9_interval_sample (R9-01 block) first,
. * then call without setaside(): that program already sets aside extreme records and
. * firms outside the universe in one of the two years. setaside() is for other uses.
. capture program drop _r9_prep

. program define _r9_prep, rclass
  1.     * Helper for r9_fhk and r9_mp, run on a preserved copy of the data: keeps the
.     * two years, applies the set-aside rule, leaves one row per firm with
.     * a0 s0 (start year) a1 s1 (end year) and status C, N or X.
.     version 17
  2.     syntax varlist(min=2 max=2 numeric) [if] [in], FIRM(varname) YEAR(varname numeric) ///
>         FROM(integer) TO(integer) SCALE(real) [SETASIDE(varname numeric)]
  3.     tokenize `varlist'
  4.     local num `1'
  5.     local den `2'
  6.     if `from' >= `to' {
  7.         display as error "R9 programs: from() must be an earlier year than to()"
  8.         exit 198
  9.     }
 10.     marksample touse, novarlist
 11.     quietly keep if `touse' & inlist(`year', `from', `to')
 12.     keep `firm' `year' `num' `den' `setaside'
 13.     capture isid `firm' `year'
 14.     if _rc {
 15.         display as error "R9 programs: firm() and year() must identify the rows"
 16.         exit 459
 17.     }
 18.     quietly count if missing(`num', `den') | `den' <= 0 | `num' < 0
 19.     if r(N) > 0 {
 20.         display as error "R9 programs: `den' must be above zero and `num' zero or more, never missing"
 21.         display as error "              (choose the universe with -if- before calling)"
 22.         exit 459
 23.     }
 24.     local n_set = 0
 25.     if "`setaside'" != "" {
 26.         tempvar anyflag
 27.         quietly bysort `firm': egen byte `anyflag' = max(`setaside' == 1)
 28.         quietly count if `anyflag' == 1
 29.         local n_set = r(N)
 30.         quietly drop if `anyflag' == 1
 31.     }
 32.     tempname sn
 33.     foreach t in from to {
 34.         quietly count if `year' == ``t''
 35.         if r(N) == 0 {
 36.             display as error "R9 programs: no firms left in year ``t''"
 37.             exit 2000
 38.         }
 39.         * Level straight from the totals, to check the weighted-average form.
.         quietly summarize `num' if `year' == ``t'', meanonly
 40.         scalar `sn' = r(sum)
 41.         quietly summarize `den' if `year' == ``t'', meanonly
 42.         return scalar ratio_`t' = `scale' * `sn' / r(sum)
 43.     }
 44.     tempvar tot a s
 45.     quietly bysort `year': egen double `tot' = total(`den')
 46.     quietly generate double `a' = `scale' * `num' / `den'
 47.     quietly generate double `s' = `den' / `tot'
 48.     sort `firm' `year'
 49.     quietly by `firm': generate double a0 = `a'[1]  if `year'[1]  == `from'
 50.     quietly by `firm': generate double s0 = `s'[1]  if `year'[1]  == `from'
 51.     quietly by `firm': generate double a1 = `a'[_N] if `year'[_N] == `to'
 52.     quietly by `firm': generate double s1 = `s'[_N] if `year'[_N] == `to'
 53.     quietly by `firm': keep if _n == 1
 54.     quietly generate str1 status = cond(!missing(s0) & !missing(s1), "C", cond(missing(s0), "N", "X"))
 55.     keep `firm' status a0 s0 a1 s1
 56.     return scalar n_setaside = `n_set'
 57. end

. 
. capture program drop r9_fhk

. program define r9_fhk, rclass
  1.     version 17
  2.     syntax varlist(min=2 max=2 numeric) [if] [in], FIRM(varname) YEAR(varname numeric) ///
>         FROM(integer) TO(integer) [SCALE(real 1000000) SETASIDE(varname numeric) SAVING(string asis)]
  3.     preserve
  4.     _r9_prep `varlist' `if' `in', firm(`firm') year(`year') from(`from') to(`to') ///
>         scale(`scale') setaside(`setaside')
  5.     tempname Ia Ib ra rb nset ssa ssb v
  6.     scalar `ra'   = r(ratio_from)
  7.     scalar `rb'   = r(ratio_to)
  8.     scalar `nset' = r(n_setaside)
  9.     tempvar w0 w1
 10.     quietly generate double `w0' = s0 * a0
 11.     quietly generate double `w1' = s1 * a1
 12.     quietly summarize `w0', meanonly
 13.     scalar `Ia' = r(sum)
 14.     quietly summarize `w1', meanonly
 15.     scalar `Ib' = r(sum)
 16.     quietly summarize s0, meanonly
 17.     scalar `ssa' = r(sum)
 18.     quietly summarize s1, meanonly
 19.     scalar `ssb' = r(sum)
 20.     * The five parts, firm by firm (zero where a part does not apply to the firm).
.     quietly {
 21.         generate double fhk_within  = cond(status == "C", s0 * (a1 - a0), 0)
 22.         generate double fhk_between = cond(status == "C", (a0 - `Ia') * (s1 - s0), 0)
 23.         generate double fhk_cross   = cond(status == "C", (a1 - a0) * (s1 - s0), 0)
 24.         generate double fhk_entry   = cond(status == "N", s1 * (a1 - `Ia'), 0)
 25.         generate double fhk_exit    = cond(status == "X", -s0 * (a0 - `Ia'), 0)
 26.     }
 27.     tempname tsum
 28.     scalar `tsum' = 0
 29.     foreach p in within between cross entry exit {
 30.         tempname `p'
 31.         quietly summarize fhk_`p', meanonly
 32.         scalar ``p'' = r(sum)
 33.         scalar `tsum' = `tsum' + ``p''
 34.     }
 35.     foreach g in C N X {
 36.         quietly count if status == "`g'"
 37.         local n_`g' = r(N)
 38.     }
 39.     tempname SCa SCb SNb SXa
 40.     quietly summarize s0 if status == "C", meanonly
 41.     scalar `SCa' = r(sum)
 42.     quietly summarize s1 if status == "C", meanonly
 43.     scalar `SCb' = r(sum)
 44.     quietly summarize s1 if status == "N", meanonly
 45.     scalar `SNb' = r(sum)
 46.     quietly summarize s0 if status == "X", meanonly
 47.     scalar `SXa' = r(sum)
 48.     if `"`saving'"' != "" {
 49.         quietly generate int from = `from'
 50.         quietly generate int to   = `to'
 51.         label variable status "C = stays (both years), N = enters (end year only), X = exits (start year only)"
 52.         label variable s0 "share of value added, start year"
 53.         label variable s1 "share of value added, end year"
 54.         label variable a0 "firm ratio, start year"
 55.         label variable a1 "firm ratio, end year"
 56.         quietly save `saving', replace
 57.     }
 58.     restore
 59.     display as text "FHK " `from' "->" `to' ": level " %9.4g `Ia' " -> " %9.4g `Ib' ///
>         "  within " %9.4g `within' "  between " %9.4g `between' "  cross " %9.4g `cross' ///
>         "  entry " %9.4g `entry' "  exit " %9.4g `exit' "  gap " %9.2e (`Ib' - `Ia' - `tsum')
 60.     return scalar from       = `from'
 61.     return scalar to         = `to'
 62.     return scalar I_from     = `Ia'
 63.     return scalar I_to       = `Ib'
 64.     return scalar change     = `Ib' - `Ia'
 65.     return scalar within     = `within'
 66.     return scalar between    = `between'
 67.     return scalar cross      = `cross'
 68.     return scalar entry      = `entry'
 69.     return scalar exit       = `exit'
 70.     return scalar sum_parts  = `tsum'
 71.     return scalar gap        = (`Ib' - `Ia') - `tsum'
 72.     return scalar gap_rel    = abs((`Ib' - `Ia') - `tsum') / abs(`Ia')
 73.     return scalar n_stay     = `n_C'
 74.     return scalar n_enter    = `n_N'
 75.     return scalar n_exit     = `n_X'
 76.     return scalar S_stay_from = `SCa'
 77.     return scalar S_stay_to   = `SCb'
 78.     return scalar S_enter_to  = `SNb'
 79.     return scalar S_exit_from = `SXa'
 80.     return scalar sum_s_from  = `ssa'
 81.     return scalar sum_s_to    = `ssb'
 82.     return scalar ratio_from  = `ra'
 83.     return scalar ratio_to    = `rb'
 84.     return scalar n_setaside  = `nset'
 85. end

. 
. capture program drop r9_mp

. program define r9_mp, rclass
  1.     version 17
  2.     syntax varlist(min=2 max=2 numeric) [if] [in], FIRM(varname) YEAR(varname numeric) ///
>         FROM(integer) TO(integer) [SCALE(real 1000000) SETASIDE(varname numeric)]
  3.     preserve
  4.     _r9_prep `varlist' `if' `in', firm(`firm') year(`year') from(`from') to(`to') ///
>         scale(`scale') setaside(`setaside')
  5.     tempname nset Ia Ib
  6.     scalar `nset' = r(n_setaside)
  7.     tempvar w0 w1
  8.     quietly generate double `w0' = s0 * a0
  9.     quietly generate double `w1' = s1 * a1
 10.     quietly summarize `w0', meanonly
 11.     scalar `Ia' = r(sum)
 12.     quietly summarize `w1', meanonly
 13.     scalar `Ib' = r(sum)
 14.     quietly count if status == "C"
 15.     local n_C = r(N)
 16.     quietly count if status == "N"
 17.     local n_N = r(N)
 18.     quietly count if status == "X"
 19.     local n_X = r(N)
 20.     tempname SCa SCb ICa ICb mCa mCb cCa cCb SNb INb SXa IXa pm pc pn px tsum
 21.     foreach q in SCa SCb ICa ICb mCa mCb cCa cCb pm pc {
 22.         scalar ``q'' = .
 23.     }
 24.     if `n_C' > 0 {
 25.         * Staying firms: share, own level, plain average, covariance (written out, see block header).
.         tempvar t
 26.         foreach k in 0 1 {
 27.             local sfx = cond(`k' == 0, "a", "b")
 28.             quietly summarize s`k' if status == "C", meanonly
 29.             scalar `SC`sfx'' = r(sum)
 30.             quietly summarize a`k' if status == "C", meanonly
 31.             scalar `mC`sfx'' = r(mean)
 32.             quietly generate double `t' = s`k' * a`k' / `SC`sfx'' if status == "C"
 33.             quietly summarize `t', meanonly
 34.             scalar `IC`sfx'' = r(sum)
 35.             quietly replace `t' = (s`k' / `SC`sfx'' - 1 / `n_C') * (a`k' - `mC`sfx'') if status == "C"
 36.             quietly summarize `t', meanonly
 37.             scalar `cC`sfx'' = r(sum)
 38.             drop `t'
 39.         }
 40.         scalar `pm' = `mCb' - `mCa'
 41.         scalar `pc' = `cCb' - `cCa'
 42.     }
 43.     * Entrants (end year) and leavers (start year): share and own level.
.     quietly summarize s1 if status == "N", meanonly
 44.     scalar `SNb' = r(sum)
 45.     tempvar u
 46.     quietly generate double `u' = s1 * a1 if status == "N"
 47.     quietly summarize `u', meanonly
 48.     scalar `INb' = cond(`SNb' > 0, r(sum) / `SNb', .)
 49.     quietly summarize s0 if status == "X", meanonly
 50.     scalar `SXa' = r(sum)
 51.     quietly replace `u' = s0 * a0 if status == "X"
 52.     quietly summarize `u' if status == "X", meanonly
 53.     scalar `IXa' = cond(`SXa' > 0, r(sum) / `SXa', .)
 54.     if `n_C' > 0 {
 55.         scalar `pn' = cond(`SNb' > 0, `SNb' * (`INb' - `ICb'), 0)
 56.         scalar `px' = cond(`SXa' > 0, `SXa' * (`ICa' - `IXa'), 0)
 57.         scalar `tsum' = `pm' + `pc' + `pn' + `px'
 58.     }
 59.     else {
 60.         * No staying firm: the method is not defined (its benchmark is the stayers' level).
.         scalar `pn'   = .
 61.         scalar `px'   = .
 62.         scalar `tsum' = .
 63.     }
 64.     restore
 65.     display as text "MP  " `from' "->" `to' ": level " %9.4g `Ia' " -> " %9.4g `Ib' ///
>         "  stayers' average " %9.4g `pm' "  stayers' reallocation " %9.4g `pc' ///
>         "  entry " %9.4g `pn' "  exit " %9.4g `px' "  gap " %9.2e (`Ib' - `Ia' - `tsum')
 66.     return scalar from         = `from'
 67.     return scalar to           = `to'
 68.     return scalar defined      = (`n_C' > 0)
 69.     return scalar I_from       = `Ia'
 70.     return scalar I_to         = `Ib'
 71.     return scalar change       = `Ib' - `Ia'
 72.     return scalar stayers_mean = `pm'
 73.     return scalar stayers_cov  = `pc'
 74.     return scalar entry        = `pn'
 75.     return scalar exit         = `px'
 76.     return scalar sum_parts    = `tsum'
 77.     return scalar gap          = (`Ib' - `Ia') - `tsum'
 78.     return scalar gap_rel      = abs((`Ib' - `Ia') - `tsum') / abs(`Ia')
 79.     return scalar n_stay       = `n_C'
 80.     return scalar n_enter      = `n_N'
 81.     return scalar n_exit       = `n_X'
 82.     return scalar mean_stay_from = `mCa'
 83.     return scalar mean_stay_to   = `mCb'
 84.     return scalar cov_stay_from  = `cCa'
 85.     return scalar cov_stay_to    = `cCb'
 86.     return scalar I_stay_from    = `ICa'
 87.     return scalar I_stay_to      = `ICb'
 88.     return scalar S_stay_from    = `SCa'
 89.     return scalar S_stay_to      = `SCb'
 90.     return scalar I_enter_to     = `INb'
 91.     return scalar S_enter_to     = `SNb'
 92.     return scalar I_exit_from    = `IXa'
 93.     return scalar S_exit_from    = `SXa'
 94.     return scalar n_setaside     = `nset'
 95. end

