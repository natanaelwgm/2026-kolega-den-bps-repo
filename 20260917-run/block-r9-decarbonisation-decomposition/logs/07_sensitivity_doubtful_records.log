. display "Step 3/7: split every period's change (FHK) under every version"
Step 3/7: split every period's change (FHK) under every version

. *---------------------------------------------------------------------------
. * Measures (per million units of the denominator; weights = the denominator's shares):
. *   co2_va  CO2 (tonnes) per unit of value added   <- drawn (all versions except output)
. *   gj_va   energy (GJ) per unit of value added     (tables)
. *   co2_out CO2 per unit of output, output weights  <- drawn for version "output"
. local num_co2_va  "co2_total_s1"

. local den_co2_va  "value_added_nominal"

. local num_gj_va   "total_gj_s1"

. local den_gj_va   "value_added_nominal"

. local num_co2_out "co2_total_s1"

. local den_co2_out "gross_output_nominal"

. local if_co2_out  "if !missing(r9_o_co2)"      // output above zero (always true in this file)

. tempfile firmyears res

. save `firmyears'
file /var/folders/0k/wcj_06q55_gd0c7z2x717jsc0000gn/T//S_32054.000002 saved as .dta format

. tempname h

. postfile `h' int(vord pord) str12 version str60 version_label byte(drawn mark) str9 interval ///
>     str10 kind str14 period int(start_year end_year years_between) str80 data_warning str8 measure ///
>     long(n_stayers n_entrants n_leavers n_records_set_aside n_stayers_set_aside n_stayers_outside_universe) ///
>     double(va_kept_start va_kept_end level_start level_end change within between cross entry exit ///
>            sum_parts gap_rel) using `res', replace
(file /var/folders/0k/wcj_06q55_gd0c7z2x717jsc0000gn/T//S_32054.000003 not found)

. local allp `"$R9_INTERVALS "$R9_LONG""'

. local vord 0

. local nruns 0

. foreach v of local vlist {
  2.     local ++vord
  3.     local mode  = cond("`v'" == "asfiled", "asfiled", "main")
  4.     local mlist = cond("`v'" == "output", "co2_out", "co2_va gj_va")
  5.     local pord 0
  6.     foreach p of local allp {
  7.         local ++pord
  8.         local a : word 1 of `p'
  9.         local b : word 2 of `p'
 10.         local kind = cond(`pord' <= 3, "main", "whole span")
 11.         local pname ""
 12.         if `pord' <= 3 local pname : word `pord' of $R9_PERIODS
 13.         r9_interval_note `a' `b'
 14.         local warn "`r(note)'"
 15.         use `firmyears', clear
 16.         * base for "value added kept": the as-filed universe of each year
.         foreach t in a b {
 17.             quietly summarize value_added_nominal if r9_U & year == ``t'', meanonly
 18.             local base_`t' = r(sum)
 19.         }
 20.         * the version: change the block's flags (r9_x = set aside, r9_U = universe) ...
.         if substr("`v'", 1, 3) == "cut" {
 21.             local k = substr("`v'", 4, .)
 22.             quietly replace r9_x = r9_U & r9_ratio > `k' * r9_med
 23.         }
 24.         if "`v'" == "noimp"      quietly replace r9_x = r9_x | (r9_U & imp_unk)
 25.         if "`v'" == "noimpdoubt" quietly replace r9_x = r9_x | (r9_U & imp_unk & doubt_yr)
 26.         if substr("`v'", 1, 3) == "low" {
 27.             local k = substr("`v'", 4, .)
 28.             quietly replace r9_x = r9_x | (r9_U & r9_ratio < r9_med / `k')
 29.         }
 30.         if "`v'" == "zero" {
 31.             * zero energy enters as a ratio of 0 (never an extreme record)
.             quietly replace r9_U = 1 if zero_e
 32.             foreach r in r9_ratio r9_a_co2 r9_a_gj {
 33.                 quietly replace `r' = 0 if zero_e
 34.             }
 35.             quietly replace r9_o_co2 = 0 if zero_e & gross_output_nominal > 0 & !missing(gross_output_nominal)
 36.             quietly replace r9_x = 0 if zero_e
 37.         }
 38.         * ... then build the period sample exactly as R9-02 does
.         r9_interval_sample `a' `b' `mode'
 39.         foreach r in n_stayers n_entrants n_leavers n_records_set_aside n_stayers_set_aside n_stayers_outside_unive
> rse {
 40.             local `r' = r(`r')
 41.         }
 42.         * as filed keeps every universe record: the program still counts the records the
.         * main rule would flag, so report zero set aside here
.         if "`mode'" == "asfiled" {
 43.             local n_records_set_aside 0
 44.             local n_stayers_set_aside 0
 45.         }
 46.         foreach t in a b {
 47.             quietly summarize value_added_nominal if year == ``t'', meanonly
 48.             local kept_`t' = 100 * r(sum) / `base_`t''
 49.         }
 50.         foreach m of local mlist {
 51.             quietly r9_fhk `num_`m'' `den_`m'' `if_`m'', firm(firm_id) year(year) from(`a') to(`b')
 52.             * parts add up to the change; shares sum to 1; level = total over total
.             assert r(gap_rel) < 1e-9
 53.             assert abs(r(sum_s_from) - 1) < 1e-9 & abs(r(sum_s_to) - 1) < 1e-9
 54.             assert reldif(r(ratio_from), r(I_from)) < 1e-9 & reldif(r(ratio_to), r(I_to)) < 1e-9
 55.             * the program finds the same stayers, entrants and leavers as the period sample
.             if "`if_`m''" == "" assert r(n_stay) == `n_stayers' & r(n_enter) == `n_entrants' & r(n_exit) == `n_leavers
> '
 56.             local ++nruns
 57.             post `h' (`vord') (`pord') ("`v'") ("`lab_`v''") (`draw_`v'') (`mark_`v'') ("`a'-`b'") ("`kind'") ///
>                 ("`pname'") (`a') (`b') (`b' - `a') ("`warn'") ("`m'") ///
>                 (`n_stayers') (`n_entrants') (`n_leavers') (`n_records_set_aside') (`n_stayers_set_aside') ///
>                 (`n_stayers_outside_universe') (`kept_a') (`kept_b') ///
>                 (r(I_from)) (r(I_to)) (r(change)) (r(within)) (r(between)) (r(cross)) (r(entry)) (r(exit)) ///
>                 (r(sum_parts)) (r(gap_rel))
 58.         }
 59.         if `pord' <= 3 display "   `v' `a'->`b': stayers `n_stayers', entrants `n_entrants', leavers `n_leavers'; "
>  ///
>             "records set aside `n_records_set_aside'; value added kept " %5.1f `kept_a' "% / " %5.1f `kept_b' "%"
 60.     }
 61. }
