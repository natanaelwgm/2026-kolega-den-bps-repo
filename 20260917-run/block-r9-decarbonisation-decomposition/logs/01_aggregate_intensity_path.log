. capture program drop r9_interval_sample

. program define r9_interval_sample, rclass
  1.     args a b mode
  2.     if !inlist("`mode'", "", "main", "asfiled") {
  3.         display as error "r9_interval_sample: third argument must be main or asfiled"
  4.         exit 198
  5.     }
  6.     quietly {
  7.         keep if inlist(year, `a', `b')
  8.         * a firm in both files but outside the universe in one year (energy 0 or
.         * value added <= 0) would look like an entrant or leaver: set aside in main
.         bysort firm_id: gen byte r9_fstay = _N == 2
  9.         bysort firm_id: egen byte r9_ufirm = min(r9_U)
 10.         count if r9_fstay & !r9_ufirm & r9_U
 11.         return scalar n_stayers_outside_universe = r(N)
 12.         if "`mode'" != "asfiled" drop if r9_fstay & !r9_ufirm
 13.         keep if r9_U
 14.         drop r9_fstay r9_ufirm
 15.         bysort firm_id: gen byte r9_stay = _N == 2
 16.         bysort firm_id: egen byte r9_xfirm = max(r9_x)
 17.         count if r9_stay & r9_xfirm & year == `a'
 18.         return scalar n_stayers_set_aside = r(N)
 19.         count if r9_x | (r9_stay & r9_xfirm)
 20.         return scalar n_records_set_aside = r(N)
 21.         if "`mode'" != "asfiled" drop if r9_x | (r9_stay & r9_xfirm)
 22.         gen byte r9_grp = cond(r9_stay, 1, cond(year == `b', 2, 3))
 23.         label define r9_grp 1 "stayer" 2 "entrant (appears)" 3 "leaver (disappears)", replace
 24.         label values r9_grp r9_grp
 25.         drop r9_stay r9_xfirm r9_s r9_so
 26.         bysort year: egen double r9_tva = total(value_added_nominal)
 27.         gen double r9_s = value_added_nominal / r9_tva
 28.         bysort year: egen double r9_tgo = total(cond(!missing(r9_o_co2), gross_output_nominal, .))
 29.         gen double r9_so = gross_output_nominal / r9_tgo if !missing(r9_o_co2)
 30.         drop r9_tva r9_tgo
 31.         count if r9_grp == 1 & year == `a'
 32.         return scalar n_stayers = r(N)
 33.         count if r9_grp == 2
 34.         return scalar n_entrants = r(N)
 35.         count if r9_grp == 3
 36.         return scalar n_leavers = r(N)
 37.     }
 38. end

. 
. capture program drop r9_interval_note

. program define r9_interval_note, rclass
  1.     args a b
  2.     local note ""
  3.     local yrs "$R9_YEARS"
  4.     forvalues y = `=`a' + 1'/`=`b' - 1' {
  5.         if !`: list y in yrs' local note = cond("`note'" == "", "", "`note'; ") + "no annual file for `y'"
  6.     }
  7.     foreach y of global R9_JUMP_YRS {
  8.         if inlist(`y', `a', `b') local note = cond("`note'" == "", "", "`note'; ") + "energy recording jump in `y'"
  9.     }
 10.     local d ""
 11.     foreach y of global R9_DOUBT_YRS {
 12.         if inlist(`y', `a', `b') local d "energy records partly doubtful"
 13.     }
 14.     if "`d'" != "" local note = cond("`note'" == "", "", "`note'; ") + "`d'"
 15.     return local note "`note'"
 16. end

