. * shared log axis: labels 1, 3, 10, 30, ... ; bottom leaves room for the period brackets
. quietly summarize ym

. local vmin = r(min)

. local vmax = r(max)

. quietly summarize ya

. local vmin = min(`vmin', r(min))

. local vmax = max(`vmax', r(max))

. local bot = 10^floor(log10(`vmin' / 3))

