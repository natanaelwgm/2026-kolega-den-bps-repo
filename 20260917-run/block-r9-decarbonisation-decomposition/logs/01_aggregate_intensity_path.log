. local allp `"$R9_INTERVALS "$R9_LONG" $R9_PAIRS"'

. local k 0

. foreach p of local allp {
  2.     local ++k
  3.     local a : word 1 of `p'
  4.     local b : word 2 of `p'
  5.     local kind "pair"
  6.     local pname ""
  7.     if `k' <= 3 {
  8.         local kind "main"
  9.         local pname : word `k' of $R9_PERIODS
 10.     }
 11.     if `k' == 4 local kind "whole span"
 12.     r9_interval_note `a' `b'
 13.     local warn "`r(note)'"
 14.     foreach m in asfiled main {
 15.         use `firmyears', clear
 16.         r9_interval_sample `a' `b' `m'
 17.         foreach r in n_stayers n_entrants n_leavers n_stayers_set_aside n_records_set_aside n_stayers_outside_unive
> rse {
 18.             local `r' = r(`r')
 19.         }
 20.         * Sum of shares is 1 in each year; the aggregate level equals the weighted firm ratios
.         bysort year: egen double chk = total(r9_s)
 21.         assert abs(chk - 1) < 1e-12
 22.         foreach t in `a' `b' {
 23.             quietly summarize co2_total_s1 if year == `t'
 24.             local c = r(sum)
 25.             quietly summarize total_gj_s1 if year == `t'
 26.             local e = r(sum)
 27.             quietly summarize value_added_nominal if year == `t'
 28.             local v = r(sum)
 29.             local I_`m'_`t'  = 1e6 * `c' / `v'
 30.             local G_`m'_`t'  = 1e6 * `e' / `v'
 31.             gen double w = r9_s * r9_a_co2 if year == `t'
 32.             quietly summarize w
 33.             assert reldif(r(sum), `I_`m'_`t'') < 1e-12
 34.             drop w
 35.         }
 36.         if "`m'" == "main" {
 37.             quietly summarize r9_s if r9_grp == 1 & year == `a'
 38.             local sca = r(sum)
 39.             quietly summarize r9_s if r9_grp == 1 & year == `b'
 40.             local scb = r(sum)
 41.             quietly summarize r9_s if r9_grp == 3
 42.             local sx = r(sum)
 43.             quietly summarize r9_s if r9_grp == 2
 44.             local sn = r(sum)
 45.             assert abs(`sca' + `sx' - 1) < 1e-12 & abs(`scb' + `sn' - 1) < 1e-12
 46.         }
 47.     }
 48.     post `h' ("`a'-`b'") ("`kind'") ("`pname'") (`a') (`b') (`b' - `a') ///
>         (`n_stayers') (`n_entrants') (`n_leavers') (`n_stayers_set_aside') (`n_records_set_aside') (`n_stayers_outside
> _universe') ///
>         (`sca') (`scb') (`sx') (`sn') (`I_main_`a'') (`I_main_`b'') (`G_main_`a'') (`G_main_`b'') ///
>         (`I_asfiled_`a'') (`I_asfiled_`b'') ("`warn'")
 49.     display "   `a'->`b' (`kind'): stayers `n_stayers', entrants `n_entrants', leavers `n_leavers'; " ///
>         "stayers set aside `n_stayers_set_aside'; CO2 per million VA " %8.2f `I_main_`a'' " -> " %8.2f `I_main_`b''
 50. }
