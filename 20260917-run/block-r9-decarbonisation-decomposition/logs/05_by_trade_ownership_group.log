. *---------------------------------------------------------------------------
. display "Step 3/7: split every period (FHK), add the firms' parts up by status group"
Step 3/7: split every period (FHK), add the firms' parts up by status group

. *---------------------------------------------------------------------------
. * Periods: the three of R9-02, the whole span, and every pair of neighbouring
. * files (2015->2017 spans the missing 2016 file). Measures (per million of value
. * added, value-added weights): co2_va (drawn) and gj_va (tables).
. * Firm by firm: r9_fhk gives each firm its five parts (saving()). Every firm's
. * parts are measured against the all-firms start level, so the parts of the
. * firms in a group add up to that group's part in the all-firms change, and
. * the groups of one status add up to the R9-02 total exactly.
. * A firm's group, for each status (export, import, foreign-owned):
. *   staying firm  = its answer in the start year; but if it answered yes or no
. *                   in both years and the answers differ: group 8 "answer changed"
. *   leaving firm  = its answer in the start year
. *   entering firm = its answer in the end year
. * Each group's own level (its CO2, or GJ, per million of value added) uses its
. * firms of that year: start = staying + leaving firms, end = staying + entering.
. * Check: group total = S_end * (I_g,end - I_start) - S_start * (I_g,start - I_start)
. * (S = the group's share of all firms' value added, I_g = its own level).
. tempfile firmyears

. save `firmyears'
file /var/folders/0k/wcj_06q55_gd0c7z2x717jsc0000gn/T//S_24685.000001 saved as .dta format

. local mlist "co2_va gj_va"

. local num_co2_va "co2_total_s1"

. local num_gj_va  "total_gj_s1"

. local fewn 10                       // "few firms": fewer than this in the group in either year

. tempfile acc psample firmst fparts

. local nacc 0

. local allp `"$R9_INTERVALS "$R9_LONG" $R9_PAIRS"'

. local k 0

. foreach p of local allp {
  2.     local ++k
  3.     local a : word 1 of `p'
  4.     local b : word 2 of `p'
  5.     local kind "pair"
  6.     local pname ""
  7.     if `k' <= 3 {
  8.         local kind "main"
  9.         local pname : word `k' of $R9_PERIODS
 10.     }
 11.     if `k' == 4 local kind "whole span"
 12.     r9_interval_note `a' `b'
 13.     local warn "`r(note)'"
 14.     foreach smp in main asfiled {
 15.         use `firmyears', clear
 16.         * the period sample: stayers, entrants, leavers; flagged stayers set aside in both years (main)
.         r9_interval_sample `a' `b' `smp'
 17.         foreach r in n_stayers n_entrants n_leavers {
 18.             local `r' = r(`r')
 19.         }
 20.         if "`smp'" == "main" local shown "stayers `n_stayers', entrants `n_entrants', leavers `n_leavers'"
 21.         quietly save `psample', replace
 22.         * for the notes (drawn periods): importers' share of firms, and export "no"
.         * answers, in the start and in the end year of the period sample
.         if `k' <= 3 & "`smp'" == "main" {
 23.             foreach t in a b {
 24.                 quietly count if year == ``t''
 25.                 local nf = r(N)
 26.                 quietly count if year == ``t'' & r9n_st_import == 1
 27.                 local imp_`t'_`k' = r(N) / `nf'
 28.                 quietly count if year == ``t'' & r9n_st_export == 0
 29.                 local exno_`t'_`k' = r(N)
 30.                 quietly count if year == ``t'' & r9n_st_export == 1
 31.                 local exyes_`t'_`k' = r(N)
 32.             }
 33.         }
 34.         * each firm's answers in the start and in the end year (missing = not in that year's file)
.         quietly {
 35.             foreach g of local glist {
 36.                 bysort firm_id (year): gen byte r9n_`g'_a = cond(year[1] == `a', r9n_st_`g'[1], .)
 37.                 by firm_id: gen byte r9n_`g'_b = cond(year[_N] == `b', r9n_st_`g'[_N], .)
 38.             }
 39.             by firm_id: keep if _n == 1
 40.             keep firm_id r9n_*_a r9n_*_b
 41.             save `firmst', replace
 42.         }
 43.         foreach m of local mlist {
 44.             use `psample', clear
 45.             quietly r9_fhk `num_`m'' value_added_nominal, firm(firm_id) year(year) from(`a') to(`b') ///
>                 saving(`fparts')
 46.             assert r(gap_rel) < 1e-9
 47.             assert r(n_stay) == `n_stayers' & r(n_enter) == `n_entrants' & r(n_exit) == `n_leavers'
 48.             foreach r in I_from I_to change within between cross entry exit {
 49.                 local ag_`r' = r(`r')
 50.             }
 51.             local tol = 1e-9 * abs(`ag_I_from')
 52.             use `fparts', clear
 53.             quietly merge 1:1 firm_id using `firmst', assert(3) nogen
 54.             foreach g of local glist {
 55.                 preserve
 56.                 quietly {
 57.                     * the firm's group: 1 yes, 0 no, 9 no answer, 8 staying firm whose answer changed
.                     gen byte grp = cond(status == "N", r9n_`g'_b, r9n_`g'_a)
 58.                     gen byte r9n_up   = status == "C" & r9n_`g'_a == 0 & r9n_`g'_b == 1
 59.                     gen byte r9n_down = status == "C" & r9n_`g'_a == 1 & r9n_`g'_b == 0
 60.                     replace grp = 8 if r9n_up | r9n_down
 61.                     assert inlist(grp, 0, 1, 8, 9)
 62.                     gen byte r9n_c  = status == "C"
 63.                     gen byte r9n_n  = status == "N"
 64.                     gen byte r9n_x  = status == "X"
 65.                     gen byte r9n_fa = status != "N"            // in the start year
 66.                     gen byte r9n_fb = status != "X"            // in the end year
 67.                     * staying firms that answered in the start year but not in the end year
.                     gen byte r9n_ne = status == "C" & r9n_`g'_a != 9 & r9n_`g'_b == 9
 68.                     gen double r9n_s0 = cond(status != "N", s0, 0)
 69.                     gen double r9n_s1 = cond(status != "X", s1, 0)
 70.                     gen double r9n_w0 = cond(status != "N", s0 * a0, 0)
 71.                     gen double r9n_w1 = cond(status != "X", s1 * a1, 0)
 72.                     * one empty row per group code, so every group has a row (zero firms if none)
.                     local n0 = _N
 73.                     set obs `=`n0' + 4'
 74.                     local j 0
 75.                     foreach c in 1 0 9 8 {
 76.                         local ++j
 77.                         replace grp = `c' in `=`n0' + `j''
 78.                     }
 79.                     foreach v of varlist fhk_* r9n_up r9n_down r9n_c r9n_n r9n_x r9n_fa r9n_fb r9n_ne ///
>                         r9n_s0 r9n_s1 r9n_w0 r9n_w1 {
 80.                         replace `v' = 0 in `=`n0' + 1'/`=`n0' + 4'
 81.                     }
 82.                     collapse (sum) within = fhk_within between = fhk_between cross = fhk_cross ///
>                         entry = fhk_entry exit = fhk_exit n_stayers = r9n_c n_entrants = r9n_n ///
>                         n_leavers = r9n_x n_firms_start = r9n_fa n_firms_end = r9n_fb ///
>                         n_changed_no_to_yes = r9n_up n_changed_yes_to_no = r9n_down ///
>                         n_stay_no_end_answer = r9n_ne va_share_start = r9n_s0 va_share_end = r9n_s1 ///
>                         r9n_w0 r9n_w1, by(grp)
 83.                     gen double group_level_start = r9n_w0 / va_share_start if va_share_start > 0
 84.                     gen double group_level_end   = r9n_w1 / va_share_end   if va_share_end > 0
 85.                 }
 86.                 * checks: the groups add up to the all-firms parts, shares to 1, firms to the
.                 * period sample; each group's total equals the form built from its own levels
.                 foreach r in within between cross entry exit {
 87.                     quietly summarize `r', meanonly
 88.                     assert abs(r(sum) - `ag_`r'') < `tol'
 89.                 }
 90.                 foreach t in start end {
 91.                     quietly summarize va_share_`t', meanonly
 92.                     assert abs(r(sum) - 1) < 1e-9
 93.                 }
 94.                 quietly summarize n_firms_start, meanonly
 95.                 assert r(sum) == `n_stayers' + `n_leavers'
 96.                 quietly summarize n_firms_end, meanonly
 97.                 assert r(sum) == `n_stayers' + `n_entrants'
 98.                 assert abs((within + between + cross + entry + exit) ///
>                     - (r9n_w1 - r9n_w0 - `ag_I_from' * (va_share_end - va_share_start))) < `tol'
 99.                 drop r9n_w0 r9n_w1
100.                 * the all-firms row (group 99) = the R9-02 split
.                 local n0 = _N + 1
101.                 quietly set obs `n0'
102.                 quietly replace grp = 99 in `n0'
103.                 foreach r in within between cross entry exit {
104.                     quietly replace `r' = `ag_`r'' in `n0'
105.                 }
106.                 foreach v of varlist n_* {
107.                     quietly summarize `v' if grp < 99, meanonly
108.                     quietly replace `v' = r(sum) in `n0'
109.                 }
110.                 quietly replace va_share_start = 1 in `n0'
111.                 quietly replace va_share_end = 1 in `n0'
112.                 quietly replace group_level_start = `ag_I_from' in `n0'
113.                 quietly replace group_level_end = `ag_I_to' in `n0'
114.                 gen int ord = `k'
115.                 gen str9 interval = "`a'-`b'"
116.                 gen str10 kind = "`kind'"
117.                 gen str14 period = "`pname'"
118.                 gen int start_year = `a'
119.                 gen int end_year = `b'
120.                 gen int years_between = `b' - `a'
121.                 gen str80 data_warning = "`warn'"
122.                 gen str8 measure = "`m'"
123.                 gen str8 sample = cond("`smp'" == "main", "main", "as filed")
124.                 gen str8 grouping = "`g'"
125.                 gen double level_start = `ag_I_from'
126.                 gen double level_end = `ag_I_to'
127.                 gen double change_all = `ag_change'
128.                 if `nacc' > 0 append using `acc'
129.                 quietly save `acc', replace
130.                 local ++nacc
131.                 restore
132.             }
133.         }
134.     }
135.     display "   `a'->`b' (`kind', main version): `shown'  `warn'"
136. }
