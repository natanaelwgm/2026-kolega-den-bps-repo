 64.             matrix W[1, `j'] = `w'
 65.             local tot = `tot' + `w'
 66.             drop L`j'
 67.         }
 68.         local used 0
 69.         forvalues j = 1/`nc' {
 70.             if `j' < `nc' {
 71.                 matrix W[1, `j'] = max(floor(100 * W[1, `j'] / `tot'), 3)
 72.                 local used = `used' + W[1, `j']
 73.             }
 74.             else matrix W[1, `j'] = 100 - `used'
 75.         }
 76.     }
