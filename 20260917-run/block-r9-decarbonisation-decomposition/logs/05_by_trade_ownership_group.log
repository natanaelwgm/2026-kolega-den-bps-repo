. *---------------------------------------------------------------------------
. display "Step 4/7: results table -> CSV (numbers written before drawing)"
Step 4/7: results table -> CSV (numbers written before drawing)

. *---------------------------------------------------------------------------
. use `acc', clear
(G0 -> G0.25 OBSCURED -> G0.5 DUMMY PANEL -> G1 RE-ESTIMATED)

. rename grp group_code

. * "Reallocation" in Bu Deasy's words = between + cross (value added moving among staying firms)
. gen double realloc = between + cross

. gen double entex   = entry + exit                 // firms appearing plus firms disappearing (net)

. gen double total   = within + between + cross + entry + exit

. * every part as % of the period's all-firms start level (the level of the period sample)
. foreach v in within between cross realloc entry exit entex total {
  2.     gen double pct_`v' = 100 * `v' / level_start
  3. }

. gen str40 grouping_label = cond(grouping == "export", "By export status", ///
>     cond(grouping == "import", "By import status", "By foreign ownership (10% or more)"))

. gen str40 group_label = ""
(900 missing values generated)

. replace group_label = "Exporters"                      if grouping == "export"  & group_code == 1
(60 real changes made)

. replace group_label = "Non-exporters"                  if grouping == "export"  & group_code == 0
(60 real changes made)

. replace group_label = "No export answer"               if grouping == "export"  & group_code == 9
(60 real changes made)

. replace group_label = "Importers"                      if grouping == "import"  & group_code == 1
(60 real changes made)

. replace group_label = "Non-importers"                  if grouping == "import"  & group_code == 0
(60 real changes made)

. replace group_label = "No import answer"               if grouping == "import"  & group_code == 9
(60 real changes made)

. replace group_label = "Foreign-owned (10% or more)"    if grouping == "foreign" & group_code == 1
(60 real changes made)

. replace group_label = "Not foreign-owned (under 10%)"  if grouping == "foreign" & group_code == 0
(60 real changes made)

. replace group_label = "No ownership answer"            if grouping == "foreign" & group_code == 9
(60 real changes made)

. replace group_label = "Staying firms that changed answer" if group_code == 8
(180 real changes made)

. replace group_label = "All firms"                      if group_code == 99
(180 real changes made)

. gen byte few_firms = group_code != 99 & min(n_firms_start, n_firms_end) < `fewn' ///
>     & n_firms_start + n_firms_end > 0

. gen str40 measure_label = cond(measure == "co2_va", "CO2 per unit of value added", "Energy (GJ) per unit of value adde
> d")

. * the chart: CO2 per value added, main version, the three periods of R9-02 (same
. * panel letters as Figures R9-02, R9-03 and R9-04); one panel each
. local drawk "1 2 3"

. gen byte drawn = sample == "main" & measure == "co2_va" & kind == "main" & inlist(ord, `: subinstr local drawk " " ","
> , all')

. gen str80 note = "Development data: firm links fictional; entry and exit = sample rotation"

. if !`fict_links' replace note = ""

. gen byte mo = cond(measure == "co2_va", 1, 2)

. gen byte so = cond(sample == "main", 1, 2)

. gen byte go = cond(grouping == "export", 1, cond(grouping == "import", 2, 3))

. gen byte co = cond(group_code == 1, 1, cond(group_code == 0, 2, cond(group_code == 9, 3, cond(group_code == 8, 4, 5)))
> )

. sort ord mo so go co

. order ord interval kind period start_year end_year years_between data_warning measure measure_label sample ///
>       grouping grouping_label group_code group_label drawn few_firms n_firms_start n_firms_end n_stayers ///
>       n_entrants n_leavers n_changed_no_to_yes n_changed_yes_to_no n_stay_no_end_answer ///
>       va_share_start va_share_end level_start level_end change_all group_level_start group_level_end ///
>       within between cross realloc entry exit entex total pct_* note

. drop mo so go co

. format va_share_* %9.4f

. format level_* change_all group_level_* within between cross realloc entry exit entex total %14.6f

. format pct_* %9.3f

. export delimited using "tables/`fname'.csv", datafmt replace
