. *---------------------------------------------------------------------------
. display "Step 5/7: notes (numbers, sectors and years read from the data, never typed)"
Step 5/7: notes (numbers, sectors and years read from the data, never typed)

. *---------------------------------------------------------------------------
. * signed whole number with a typographic minus, e.g. "−30" or "+31"
. capture program drop _r9s

. program define _r9s, rclass
  1.     args x
  2.     local r = round(`x')
  3.     return local s = cond(`r' > 0, "+", cond(`r' < 0, "−", "")) + strofreal(abs(`r'))
  4. end

. * panel letters of the drawn periods (same letters as Figures R9-02 and R9-03)
. local j 0

. foreach kk of local drawk {
  2.     local ++j
  3.     local L`kk' = char(96 + `j')
  4. }

. * (1) staying firms' own change vs reallocation, in the sector with the largest own change
. gen double r9n_aw = abs(pct_within) if drawn & sector_code > 0
(1,428 missing values generated)

. gsort -r9n_aw

. local w1 = pct_within[1]

. local r1 = pct_realloc[1]

. local s1 = sector_name[1]

. local o1 = ord[1]

. drop r9n_aw

. _r9s `w1'

. local w1s "`r(s)'"

. _r9s `r1'

. local r1s "`r(s)'"

. * (why they cancel is explained under Figure R9-02: staying firms whose value added falls)
. if abs(`w1' + `r1') < abs(`w1') / 3 local opp "In a few sectors within and reallocation are large but mostly cancel (l
> argest: `s1', (`L`o1''): `w1s'% and `r1s'%; why: Figure R9-02)."

. else local opp "Within and reallocation can pull in opposite directions (largest within: `s1', (`L`o1''): `w1s'%, real
> location `r1s'%)."

. * (2) sector bars in which firms appearing and disappearing weigh more than the staying firms
. quietly count if drawn & sector_code > 0 & abs(pct_entex) > abs(pct_within + pct_realloc)

. local nE = r(N)

. quietly count if drawn & sector_code > 0

. local nC = r(N)

. local fic "Firms appearing and disappearing = firms seen in one of the two years only."

. if `fict_links' local fic "Firms appearing and disappearing (gray) = firms seen in one of the two years only (on ficti
> onal links: the sample changing)."

. * the line under the title: this chart is not a ranking of sectors
. local warn1 "Bookkeeping, not a ranking: each row shows where a sector's firms fall in the all-firms change, not why t
> he change happened."

. if `fict_links' local warn1 "Not a ranking of sectors. Firm links in this development file are fictional, and in `nE' 
> of `nC' sector bars firms appearing and disappearing (gray) weigh more than the staying firms, so the sector totals me
> an nothing here."

. * (3) sectors as the units (Table R9-04c): inside sectors / between sectors, per panel
. local mix ""

. foreach kk of local drawk {
  2.     quietly summarize pct_inside_sector if drawn & ord == `kk' & sector_code == 0, meanonly
  3.     _r9s `r(mean)'
  4.     local mi "`r(s)'"
  5.     quietly summarize pct_sector_mix if drawn & ord == `kk' & sector_code == 0, meanonly
  6.     _r9s `r(mean)'
  7.     local mix = cond("`mix'" == "", "", "`mix', ") + "(`L`kk'') `mi'% / `r(s)'%"
  8. }

. local mix "Sectors as units (Table R9-04c, no firm links needed): inside sectors / value added moving between sectors 
> `mix'."

. * (4) few firms (marked next to the total, since the rows are shared by the panels)
. quietly count if drawn & few_firms

. local few ""

. if r(N) > 0 local few "† = fewer than `fewn' firms in the sector in one of the two years."

. * (5) period warnings of the drawn periods
. local pw ""

. foreach kk of local drawk {
  2.     local p : word `kk' of $R9_INTERVALS
  3.     local a : word 1 of `p'
  4.     local b : word 2 of `p'
  5.     r9_interval_note `a' `b'
  6.     if "`r(note)'" != "" local pw = cond("`pw'" == "", "", "`pw'; ") + "(`L`kk'') `r(note)'"
  7. }

. if "`pw'" != "" local pw "Records: `pw'."

. local ntext "Notes: Bookkeeping, not cause: each period's change in CO2 per unit of value added, all firms together (F
> igure R9-02), split firm by firm and added up by 2-digit sector (staying and disappearing firms: start-year sector; ap
> pearing firms: end-year sector), % of the start level; minus = lowers the level (cleaner). Each panel's sector rows ad
> d up exactly to its last row. Within = staying firms' own change; reallocation = value added moving among staying firm
> s (between + cross). `opp' `fic' `mix' `few' Levels as in Figure R9-02. Firm-years over $R9_RULE× their sector's media
> n energy per unit of value added are set aside (other cut-offs: R9-07). `pw' Value added (output minus materials, ener
> gy and services bought) is in current prices, so price rises alone lower ratios. Energy: tables."

. local notelines ""

. local line ""

. foreach w of local ntext {
  2.     if ustrlen("`line' `w'") > 148 & "`line'" != "" {
  3.         local notelines `"`notelines' "`line'""'
  4.         local line "`w'"
  5.     }
  6.     else local line = strtrim("`line' `w'")
  7. }

. local notelines `"`notelines' "`line'""'

. local nlines : word count `notelines'

. display "   notes: `nlines' lines"
   notes: 9 lines

. if `nlines' > 9 display as error "   WARNING: the notes run to `nlines' lines (limit 9)"

. * the warning line under the title, wrapped the same way
. local warnlines ""

. local line ""

. foreach w of local warn1 {
  2.     if ustrlen("`line' `w'") > 130 & "`line'" != "" {
  3.         local warnlines `"`warnlines' "`line'""'
  4.         local line "`w'"
  5.     }
  6.     else local line = strtrim("`line' `w'")
  7. }

. local warnlines `"`warnlines' "`line'""'

. 
. *---------------------------------------------------------------------------
. display "Step 6/7: draw: one panel per period, one row per sector (bar = total, marks = parts)"
Step 6/7: draw: one panel per period, one row per sector (bar = total, marks = parts)

. *---------------------------------------------------------------------------
. keep if drawn
(1,425 observations deleted)

. local ndr : word count `drawk'

. quietly count if sector_code == 0

. assert r(N) == `ndr'

. * panels (a), (b), (c) in the order of R9_INTERVALS
. gen byte panel = .
(75 missing values generated)

. local j 0

. foreach kk of local drawk {
  2.     local ++j
  3.     replace panel = `j' if ord == `kk'
  4.     local p : word `kk' of $R9_INTERVALS
  5.     local a : word 1 of `p'
  6.     local b : word 2 of `p'
  7.     local pn : word `kk' of $R9_PERIODS
  8.     label define panel `j' "(`=char(96 + `j')') `a'–`=substr("`b'", 3, 2)', `pn' (`=`b' - `a'' years)", add
  9. }
(25 real changes made)
(25 real changes made)
(25 real changes made)

. label values panel panel

. * rows top to bottom: sectors in code order, then a gap, then all sectors
. quietly summarize chart_row if sector_code > 0

. local nsec = r(max)

. gen double y = cond(sector_code > 0, chart_row, `nsec' + 1.8)

. * sector names as y-axis labels (printed once, left of the first panel)
. local ylab ""

. quietly levelsof chart_row if sector_code > 0, local(rows)

. foreach r of local rows {
  2.     quietly levelsof row_label if chart_row == `r' & sector_code > 0, local(nm) clean
  3.     local ylab `"`ylab' `r' "`nm'""'
  4. }

. local ylab `"`ylab' `=`nsec' + 1.8' "{bf:All sectors (Figure R9-02)}""'

. * shared x axis: symmetric around 0, about two labels each side (as R9-02)
. egen double r9n_m = rowmax(pct_within pct_realloc pct_entex pct_total)

. egen double r9n_n = rowmin(pct_within pct_realloc pct_entex pct_total)

. quietly summarize r9n_m

. local M = r(max)

. quietly summarize r9n_n

. local M = max(`M', abs(r(min)))

. drop r9n_m r9n_n

. local mag = 10^floor(log10(`M'))

. local half = `mag' * ceil(1.15 * `M' / `mag')

. local step = `mag'

. foreach f in 2 2.5 5 10 {
  2.     if `half' / `step' > 2.5 local step = `f' * `mag'
  3. }

. local xl = `step' * floor(`half' / `step')

. display "   x axis: -`half' to `half', labels every `step' (largest part `M')"
   x axis: -60 to 60, labels every 25 (largest part 51.60521564531185)

. local xlabs ""

. forvalues v = -`xl'(`step')`xl' {
  2.     local xlabs `"`xlabs' `v' "`=cond(`v' < 0, "−", "")'`=abs(`v')'""'
  3. }

. * room on the right of each panel for the totals column
. local xtot  = `half' * 1.06

. local xmax  = `half' * 1.55

. gen double xtot  = `xtot'

. gen str24 tlab = strofreal(round(pct_total), "%9.0f")

. replace tlab = "0" if tlab == "-0"
(0 real changes made)

. replace tlab = subinstr(tlab, "-", "−", 1)       // typographic minus, as in the notes
(36 real changes made)

. replace tlab = tlab + " †" if few_firms
(2 real changes made)

. replace tlab = "{bf:" + tlab + "}" if sector_code == 0
(3 real changes made)

. gen double zero = 0

. gen double gl = -`half'

. gen double gr = `half'

. * zero line and column head: one extra row per panel
. local n0 = _N

. set obs `=`n0' + `ndr''
Number of observations (_N) was 75, now 78.

. gen double zy0 = .
(78 missing values generated)

. gen double zy1 = .
(78 missing values generated)

. gen double zx  = .
(78 missing values generated)

. gen double hy  = .
(78 missing values generated)

. gen str10 hlab = ""
(78 missing values generated)

. forvalues j = 1/`ndr' {
  2.     local r = `n0' + `j'
  3.     replace panel = `j' in `r'
  4.     replace zy0 = 0.3 in `r'
  5.     replace zy1 = `nsec' + 2.5 in `r'
  6.     replace zx  = 0 in `r'
