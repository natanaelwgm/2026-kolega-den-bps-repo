. * scope 1 and scope 2 CO2 must be known wherever total CO2 is (the programs refuse missing numbers)
. assert !missing(co2_scope1_s1, co2_scope2_s1) & co2_scope1_s1 >= 0 & co2_scope2_s1 >= 0 if r9_U

. assert reldif(co2_scope1_s1 + co2_scope2_s1, co2_total_s1) < 1e-9 if r9_U

. * Measures: short name | numerator | denominator | extra condition | description
. *   co2_va   = tonnes CO2 per million of value added   (drawn, panel dots)
. *   gj_va    = GJ of energy per million of value added (drawn, panel diamonds)
. *   co2_out  = tonnes CO2 per million of output value, output weights (table only)
. *   co2s1_va / co2s2_va = scope 1 (fuels) / scope 2 (bought electricity) CO2 per million of value added (table only)
. local measures `""co2_va|co2_total_s1|value_added_nominal||CO2 (tonnes) per million of value added" "gj_va|total_gj_s1
> |value_added_nominal||Energy (GJ) per million of value added" "co2_out|co2_total_s1|gross_output_nominal|!missing(r9_o
> _co2)|CO2 (tonnes) per million of output value" "co2s1_va|co2_scope1_s1|value_added_nominal||Scope 1 CO2 (fuels) per m
> illion of value added" "co2s2_va|co2_scope2_s1|value_added_nominal||Scope 2 CO2 (bought electricity) per million of va
> lue added""'

. * Yearly levels of every measure on all main-universe (or as-filed) firms of the year:
. * the line of Figure R9-01. The period levels below differ slightly (see notes).
. tempfile firmyears yearly

. save `firmyears'
file /var/folders/0k/wcj_06q55_gd0c7z2x717jsc0000gn/T//S_68801.000001 saved as .dta format

. foreach smp in main asfiled {
  2.     foreach ms of local measures {
  3.         tokenize "`ms'", parse("|")
  4.         local mname `1'
  5.         local num `3'
  6.         local den `5'
  7.         local cnd = cond("`mname'" == "co2_out", "& !missing(r9_o_co2)", "")
  8.         use `firmyears', clear
  9.         if "`smp'" == "main"    keep if r9_M `cnd'
 10.         if "`smp'" == "asfiled" keep if r9_U `cnd'
 11.         collapse (sum) n = `num' d = `den', by(year)
 12.         gen double level_yearly = 1e6 * n / d
 13.         gen str8 sample = "`smp'"
 14.         gen str8 measure = "`mname'"
 15.         keep year sample measure level_yearly
 16.         capture append using `yearly'
 17.         save `yearly', replace
 18.     }
 19. }
