. display "Step 5/7: notes (numbers and years read from the data, never typed)"
Step 5/7: notes (numbers and years read from the data, never typed)

. *---------------------------------------------------------------------------
. * value-added share of staying firms at the two ends of the drawn periods
. quietly summarize S_stay_from if kind == "main" & sample == "main" & measure == "co2_va"

. local smin = r(min)

. local smax = r(max)

. quietly summarize S_stay_to if kind == "main" & sample == "main" & measure == "co2_va"

. local smin = strofreal(100 * min(`smin', r(min)), "%9.0f")

. local smax = strofreal(100 * max(`smax', r(max)), "%9.0f")

. * appearing and disappearing firms' share of value added = 100 minus the stayers' share
. local nmin = 100 - `smax'

. local nmax = 100 - `smin'

. * period warnings, read from the shared block (same sentence as R9-02)
. local pw ""

. local k 0

. foreach p of global R9_INTERVALS {
  2.     local ++k
  3.     local a : word 1 of `p'
  4.     local b : word 2 of `p'
  5.     r9_interval_note `a' `b'
  6.     local L = char(96 + `k')
  7.     if "`r(note)'" != "" local pw = cond("`pw'" == "", "", "`pw'; ") + "(`L') `r(note)'"
  8. }

. if "`pw'" != "" local pw "Records: `pw'."

. local fic "Entry and exit = share of value added times the gap to staying firms."

. if `fict_links' local fic "Entry and exit (gray) = share of value added times the gap to staying firms; firm links are
>  fictional, so they only show the sample changing and mean nothing (they hold `nmin'–`nmax'% of value added)."

. * Within here is NOT the within of R9-02: plain average here, value-added weights there.
. local ntext "Notes: Bookkeeping, not cause: each period's change in CO2 (or energy) per unit of value added, all firms
>  together, split the Melitz–Polanec way into parts adding up exactly to the total (last row), % of the start level; mi
> nus = lowers the level (cleaner). Within = change in staying firms' plain average: each firm counts once whatever its 
> size, so a few small firms with very high ratios can move it a lot. Figure R9-02's within weights firms by value added
> , so the two can differ, even in sign. Reallocation = change in how far staying firms' value-added-weighted level sits
>  from their plain average: it moves when value added shifts to cleaner (−) or dirtier (+) firms and when big firms cha
> nge differently from small ones. The two add up to the staying firms' own change (third row): read them together. `fic
> ' Levels: firms comparable in both years (slightly off Figure R9-01). Firm-years over $R9_RULE× their sector's median 
> energy per unit of value added are set aside. `pw' Value added (output minus materials, energy and services bought) is
>  in current prices, so price rises alone lower ratios."

. local notelines ""

. local line ""

. foreach w of local ntext {
  2.     if ustrlen("`line' `w'") > 155 & "`line'" != "" {
  3.         local notelines `"`notelines' "`line'""'
  4.         local line "`w'"
  5.     }
  6.     else local line = strtrim("`line' `w'")
  7. }

. local notelines `"`notelines' "`line'""'

. local nlines : word count `notelines'

. display "   notes: `nlines' lines"
   notes: 9 lines

. if `nlines' > 10 display as error "   WARNING: the notes run to `nlines' lines (limit 10)"

