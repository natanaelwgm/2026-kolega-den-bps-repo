 55.                     local sgF = max(`sgF', abs(`keepF_co2s1_va_`q'' + `keepF_co2s2_va_`q'' - `keepF_co2_va_`q'') / 
> `keepI_co2_va')
 56.                 }
 57.                 local sgM = 0
 58.                 foreach q in stayers_mean stayers_cov entry exit {
 59.                     local sgM = max(`sgM', abs(`keepM_co2s1_va_`q'' + `keepM_co2s2_va_`q'' - `keepM_co2_va_`q'') / 
> `keepI_co2_va')
 60.                 }
 61.             }
 62.             local ok = (`F_gap_rel' < `tol_data') & (`M_gap_rel' < `tol_data') & (`sh_err' < `tol_data') ///
>                      & (`lv_err' < `tol_data') & (missing(`ff_gap') | `ff_gap' < `tol_data') ///
>                      & (missing(`sgF') | (`sgF' < `tol_data' & `sgM' < `tol_data'))
 63.             post `dr' (`y0') (`y1') (`y1' - `y0') ("`it'") ("`caution'") ("`mname'") ("`smp'") ("all") (1) (0) ///
>                 (`F_n_stay') (`F_n_enter') (`F_n_exit') (`n_sa') (`n_ou') ///
>                 (`F_I_from') (`F_I_to') (`F_change') (`F_within') (`F_between') (`F_cross') (`F_entry') (`F_exit') ///
>                 (`M_stayers_mean') (`M_stayers_cov') (`M_entry') (`M_exit') ///
>                 (`F_gap_rel') (`M_gap_rel') (`sh_err') (`lv_err') (`sgF') (`sgM') (`ff_gap') (`ok')
 64.             * --- each group on its own (main intervals only) ---
.             if "`it'" == "main" {
 65.                 foreach g in sector export import foreign {
 66.                     local gF = 0
 67.                     local gM = 0
 68.                     local ng = 0
 69.                     local nu = 0
 70.                     quietly levelsof grp_`g', local(glev)
 71.                     foreach v of local glev {
 72.                         local ifg = cond("`ifc'" == "", "if grp_`g' == `v'", "`ifc' & grp_`g' == `v'")
 73.                         * a group needs firms in both end years to have a change at all
.                         quietly count if grp_`g' == `v' & year == `y0'
 74.                         local c0 = r(N)
 75.                         quietly count if grp_`g' == `v' & year == `y1'
 76.                         if `c0' == 0 | r(N) == 0 continue
 77.                         capture quietly r9_fhk `num' `den' `ifg', firm(firm_id) year(year) from(`y0') to(`y1')
 78.                         if _rc == 2000 continue          // no firm of the group left in one year
 79.                         else if _rc error _rc
 80.                         local gF = max(`gF', r(gap_rel))
 81.                         quietly r9_mp `num' `den' `ifg', firm(firm_id) year(year) from(`y0') to(`y1')
 82.                         if r(defined) local gM = max(`gM', r(gap_rel))
 83.                         else local ++nu
 84.                         local ++ng
 85.                     }
 86.                     local ok = (`gF' < `tol_data') & (`gM' < `tol_data')
 87.                     post `dr' (`y0') (`y1') (`y1' - `y0') ("`it'") ("`caution'") ("`mname'") ("`smp'") ("`g'") ///
>                         (`ng') (`nu') (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) ///
>                         (`gF') (`gM') (.) (.) (.) (.) (.) (`ok')
 88.                 }
 89.             }
 90.         }
 91.     }
