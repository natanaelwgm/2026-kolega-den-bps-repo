  6.     local L = char(96 + `k')
  7.     if "`r(note)'" != "" local pw = cond("`pw'" == "", "", "`pw'; ") + "(`L') `r(note)'"
  8. }

. if "`pw'" != "" local pw "Records: `pw'."

. local fic "Entry and exit compare firms seen in one year only with the start level."

. if `fict_links' local fic "Entry and exit (gray) = firms seen in one year only; firm links are fictional, so they only
>  show the sample changing and mean nothing (they hold `nmin'–`nmax'% of value added)."

. local ntext "Notes: Bookkeeping, not cause: each period's change in CO2 (or energy) per unit of value added, all firms
>  together, split into parts adding up exactly to the total (last row), % of the start level; minus = lowers the level 
> (cleaner). Within = staying firms' own change; between = value added moving to firms above (+) or below (−) the start 
> average; cross = both at once; reallocation = between + cross. `opp' `fic' Levels: firms comparable in both years (sli
> ghtly off Figure R9-01). Firm-years over $R9_RULE× their sector's median energy per unit of value added are set aside 
> (other cut-offs: R9-07). `pw' Value added (output minus materials, energy and services bought) is in current prices, s
> o price rises alone lower ratios."

. local notelines ""

. local line ""

. foreach w of local ntext {
  2.     if ustrlen("`line' `w'") > 155 & "`line'" != "" {
  3.         local notelines `"`notelines' "`line'""'
  4.         local line "`w'"
  5.     }
