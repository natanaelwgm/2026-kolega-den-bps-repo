. * Notes as one text, wrapped by printed width (R2-05's rule; widths in em).
. local txt "Notes: `headtxt' `parttxt' Starters = firms first seen exporting after a year seen not exporting (`nst';"

. local txt "`txt' they stay starters if they stop); never-exporters = firms never seen exporting (`ncf'). Each dot = st
> arters'"

. local txt "`txt' change since the year before the start minus never-exporters' change, averaged over years 0 to +`whi'
> ;"

. local txt "`txt' bars = 95% intervals. All rows use the same firm-years, so they combine exactly as written under thei
> r names."

. local txt "`txt' `btxt' `dtxt' `vtxt' `imptxt' CO2 = energy used x standard rates, not measured. Value added = output 
> minus"

. local txt "`txt' materials, energy and services bought (current prices); GJ = gigajoules. Shows timing, not which part
>  caused"

. local txt "`txt' what; firm links are fictional: this tests the method, not a finding."

. local maxw 53.5                                         // widest note line that fits the 9-inch PDF

. local nl 0

. local line ""

. local lw 0

. foreach w of local txt {
  2.     local n  = ustrlen(`"`w'"')
  3.     local na = `n' - ustrlen(ustrregexra(`"`w'"', "[ijltfr.,;:'()\-]", ""))
  4.     local wi = `n' - ustrlen(ustrregexra(`"`w'"', "[A-Zmw]", ""))
  5.     local pc = `n' - ustrlen(ustrregexra(`"`w'"', "%", ""))
  6.     local dg = `n' - ustrlen(ustrregexra(`"`w'"', "[0-9+=]", ""))
  7.     local ww = 0.29*`na' + 0.7*`wi' + 0.83*`pc' + 0.52*`dg' + 0.47*(`n' - `na' - `wi' - `pc' - `dg')
  8.     local try = `lw' + 0.25*(`"`line'"' != "") + `ww'
  9.     if `try' > `maxw' & `"`line'"' != "" {
 10.         local ++nl
 11.         local L`nl' `"`line'"'
 12.         local W`nl' = `lw'
 13.         local line `"`w'"'
 14.         local lw = `ww'
 15.     }
 16.     else {
 17.         local line = strtrim(`"`line' `w'"')
 18.         local lw = `try'
 19.     }
 20. }

. local ++nl

. local L`nl' `"`line'"'

. local W`nl' = `lw'

. local notes ""

. forvalues j = 1/`nl' {
  2.     display "   note line `j': " udstrlen(`"`L`j''"') " characters, width " %4.1f `W`j'' " of `maxw' em"
  3.     local notes `"`notes' "`L`j''""'
  4. }
