. *---------------------------------------------------------------------------
. display "Step 4/8: estimate every row under every set of rates with firm and year fixed effects (clustered by firm), f
> ive versions"
Step 4/8: estimate every row under every set of rates with firm and year fixed effects (clustered by firm), five version
> s

. *---------------------------------------------------------------------------
. * R6-01's model (R2-03's): the outcome on one marker per year since the start,
. * removing each firm's own average (firm fixed effects) and each year's average
. * (year fixed effects, set mostly by the comparison firms). A firm with one row
. * used cannot be compared with itself; reghdfe drops it and reports the number.
. * Log rows: b = log difference from the firm's year before the start, net of the
. * never-exporters' change; % = 100 x (exp(b) - 1). Share rows: b in percentage points.
. * Versions (the chart shows "main"; all are in the CSV):
. *   main       = the R6 sample
. *   nodoubt    = without doubtful energy records (Step 2)
. *   no2017     = drops the 2017 starters (no 2016 file: they may have started in 2016)
. *   exact      = keeps only starters seen not exporting the year just before
. *   no2017rows = without the 2017 rows (that year far more firms burn coal: a
. *                recording change is likely, and coal's rate differs between sets)
. local nv 5

. local v1 "main"

. local v2 "nodoubt"

. local v3 "no2017"

. local v4 "exact"

. local v5 "no2017rows"

. local e1 "1"

. local e2 "!doubt"

. local e3 "gA != 2017"                                   // comparison firms (gA missing) stay

. local e4 "missing(gA) | exactA == 1"

. local e5 "year != 2017"

. tempname h

. postfile `h' byte outcome str10 version str8 term int event_time byte(grouped reference) ///
>     double(b se lo hi p) long(firms rows firms_early firms_late start_years) using `est'

. forvalues s = 1/`nv' {
  2.     use `smp', clear
  3.     keep if `e`s''
  4.     * One marker per year since the start inside the window, except -1 (the year
.     * before the start = the reference, 0 by definition), plus one marker for each
.     * grouped end. Comparison firms are 0 on every marker. A marker with no starter
.     * row among a row's firm-years is left out (R2-08).
.     gen byte ev_lo = !missing(kA) & kA < `wlo'
  5.     local cand "ev_lo"
  6.     forvalues k = `wlo'/`whi' {
  7.         if `k' == -1 continue
  8.         local nm = cond(`k' < 0, "ev_m" + string(-`k'), "ev_p" + string(`k'))
  9.         gen byte `nm' = (kA == `k')
 10.         local cand `cand' `nm'
 11.     }
 12.     gen byte ev_hi = !missing(kA) & kA > `whi'
 13.     local cand `cand' ev_hi
 14.     gen byte ev_ref = (kA == -1)                        // for the counts only
 15.     forvalues o = 1/`nall' {
 16.         local terms ""
 17.         local pre ""
 18.         local pre_in ""
 19.         local post ""
 20.         foreach t of local cand {
 21.             quietly count if `t' & !missing(y`o')
 22.             if r(N) == 0 continue
 23.             local terms `terms' `t'
 24.             if "`t'" == "ev_lo" local pre `pre' `t'
 25.             else if substr("`t'", 4, 1) == "m" {
 26.                 local pre `pre' `t'
 27.                 local pre_in `pre_in' `t'               // years before the start, grouped end left out
 28.             }
 29.             else if "`t'" != "ev_hi" local post `post' `t'
 30.         }
 31.         local terms`o'_`s' `terms'
 32.         local lc = subinstr("`post'", " ", " + ", .)    // years 0..+`whi', for the average
 33.         local np : word count `post'
 34.         quietly reghdfe y`o' `terms', absorb(firm_id year) vce(cluster firm_id)
 35.         matrix B`o'_`s' = e(b)
 36.         local df = e(df_r)
 37.         local N`o'_`s'  = e(N)
 38.         local G`o'_`s'  = e(N_clust)
 39.         local sg`o'_`s' = e(num_singletons)
 40.         * rows on the same firm-years must use the same number of them
.         if "`smp`o''" == "s_use" & `o' > 1 assert e(N) == `N1_`s''
 41.         if `o' > 6 & inlist(`ms`o'', 4, 5) assert e(N) == `N`ms`o''_`s''
 42.         capture drop es
 43.         gen byte es = e(sample)
 44.         foreach t of local terms {
 45.             assert _se[`t'] > 0 & !missing(_se[`t'])     // no marker silently dropped
 46.         }
 47.         * Joint test: all years before the start (with and without the grouped end) are 0.
.         quietly test `pre'
 48.         local F`o'_`s'  = r(F)
 49.         local Fd`o'_`s' = r(df)
 50.         local Fp`o'_`s' = r(p)
 51.         quietly test `pre_in'
 52.         local Fq`o'_`s' = r(p)
 53.         * Average over the start year and the years after it inside the window.
.         quietly lincom (`lc') / `np'
 54.         local a`o'_`s'  = r(estimate)
 55.         local as`o'_`s' = r(se)
 56.         local al`o'_`s' = r(estimate) - invttail(`df', 0.025) * r(se)
 57.         local ah`o'_`s' = r(estimate) + invttail(`df', 0.025) * r(se)
 58.         local ap`o'_`s' = 2 * ttail(`df', abs(r(estimate) / r(se)))
 59.         egen byte ftag = tag(firm_id) if es
 60.         quietly count if ftag == 1 & !never
 61.         local st`o'_`s' = r(N)
 62.         quietly count if ftag == 1 & never
 63.         local cf`o'_`s' = r(N)
 64.         drop ftag
 65.         foreach t in `cand' ev_ref {
 66.             if "`t'" == "ev_lo"       local k = `wlo' - 1
 67.             else if "`t'" == "ev_hi"  local k = `whi' + 1
 68.             else if "`t'" == "ev_ref" local k = -1
 69.             else local k = cond(substr("`t'", 4, 1) == "m", -1, 1) * real(substr("`t'", 5, .))
 70.             * starters behind each point (a firm counts once in a grouped end)
.             egen byte ft = tag(firm_id) if es & `t'
 71.             quietly count if ft == 1
 72.             local nf = r(N)
 73.             quietly count if es & `t'
 74.             local nrw = r(N)
 75.             quietly count if ft == 1 & gA < 2016
 76.             local ne = r(N)
 77.             quietly count if ft == 1 & gA > 2016
 78.             local nl = r(N)
 79.             quietly levelsof gA if es & `t'
 80.             local ny : word count `r(levels)'
 81.             drop ft
 82.             local grp = inlist("`t'", "ev_lo", "ev_hi")
 83.             if "`t'" == "ev_ref" {
 84.                 post `h' (`o') ("`v`s''") ("`t'") (`k') (0) (1) (0) (.) (0) (0) (.) (`nf') (`nrw') (`ne') (`nl') (`
> ny')
 85.             }
 86.             else if !`: list t in terms' {
 87.                 post `h' (`o') ("`v`s''") ("`t'") (`k') (`grp') (0) (.) (.) (.) (.) (.) (0) (0) (0) (0) (0)
 88.             }
 89.             else {
 90.                 local b  = _b[`t']
 91.                 local se = _se[`t']
 92.                 post `h' (`o') ("`v`s''") ("`t'") (`k') (`grp') (0) (`b') (`se') ///
>                     (`b' - invttail(`df', 0.025) * `se') (`b' + invttail(`df', 0.025) * `se') ///
>                     (2 * ttail(`df', abs(`b' / `se'))) (`nf') (`nrw') (`ne') (`nl') (`ny')
 93.             }
 94.         }
 95.     }
 96.     * Exact links, marker by marker and in the average, under every set of rates:
.     *   (1) value added per tonne of CO2 = value added (19) - CO2 emitted (2)
.     *   (3) CO2 per GJ                   = CO2 emitted (2) - energy used (20)
.     *   (5) CO2 from bought electricity: identical under all three sets (the grid
.     *       rate is one number a year: the year fixed effects remove it)
.     *   (4) CO2 from fuels: identical under sets 1 and 2 (the same fuel rates)
.     forvalues r = 1/`nr' {
 97.         local b = 6 * (`r' - 1)
 98.         assert "`terms`=`b'+1'_`s''" == "`terms19_`s''" & "`terms`=`b'+3'_`s''" == "`terms19_`s''"
 99.         foreach t of local terms19_`s' {
100.             assert reldif(B`=`b'+1'_`s'[1, "`t'"], B19_`s'[1, "`t'"] - B`=`b'+2'_`s'[1, "`t'"]) < 1e-6
101.             assert reldif(B`=`b'+3'_`s'[1, "`t'"], B`=`b'+2'_`s'[1, "`t'"] - B20_`s'[1, "`t'"]) < 1e-6
102.         }
103.         assert reldif(`a`=`b'+1'_`s'', `a19_`s'' - `a`=`b'+2'_`s'') < 1e-6
104.         assert reldif(`a`=`b'+3'_`s'', `a`=`b'+2'_`s'' - `a20_`s'') < 1e-6
105.     }
106.     assert "`terms11_`s''" == "`terms5_`s''" & "`terms17_`s''" == "`terms5_`s''" & "`terms10_`s''" == "`terms4_`s''
> "
107.     foreach t of local terms5_`s' {
108.         assert reldif(B11_`s'[1, "`t'"], B5_`s'[1, "`t'"]) < 1e-6
109.         assert reldif(B17_`s'[1, "`t'"], B5_`s'[1, "`t'"]) < 1e-6
110.     }
111.     foreach t of local terms4_`s' {
112.         assert reldif(B10_`s'[1, "`t'"], B4_`s'[1, "`t'"]) < 1e-6
113.     }
114.     assert reldif(`a11_`s'', `a5_`s'') < 1e-6 & reldif(`a17_`s'', `a5_`s'') < 1e-6 & reldif(`a10_`s'', `a4_`s'') < 
> 1e-6
115.     assert reldif(`as11_`s'', `as5_`s'') < 1e-6 & reldif(`as17_`s'', `as5_`s'') < 1e-6 & reldif(`as10_`s'', `as4_`s
> '') < 1e-6
116.     display "   `v`s'': " %6.0fc `N1_`s'' " rows (" `st1_`s'' " starters); value added per tonne of CO2 " ///
>         %5.1f 100 * (exp(`a1_`s'') - 1) "% / " %5.1f 100 * (exp(`a7_`s'') - 1) "% / " %5.1f 100 * (exp(`a13_`s'') - 1)
>  ///
>         "%; CO2 per GJ " %5.1f 100 * (exp(`a3_`s'') - 1) "% / " %5.1f 100 * (exp(`a9_`s'') - 1) "% / " ///
>         %5.1f 100 * (exp(`a15_`s'') - 1) "% (main / grid fixed / scenario 2); links checked"
117. }
