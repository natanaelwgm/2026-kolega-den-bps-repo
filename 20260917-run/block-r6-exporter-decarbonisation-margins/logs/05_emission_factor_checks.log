  4.         display "   $R6DIR/tables/`xf`x''.csv not found: cross-check skipped"
  5.         continue
  6.     }
  7.     local nmatch 0
  8.     foreach pr of local xp`x' {
  9.         gettoken theirs mine : pr, parse(":")
 10.         local mine = substr("`mine'", 2, .)
 11.         preserve
 12.         quietly import delimited using "$R6DIR/tables/`xf`x''.csv", clear varnames(1)
 13.         * R6-03's rows are found by their name (its row numbers may change under review)
.         if "`theirs'" == "a2" quietly keep if strpos(outcome_label, "(a2) Electricity's share of CO2") == 1
 14.         else quietly keep if outcome == `theirs'
 15.         if _N == 0 {
 16.             restore
 17.             display "   `xf`x''.csv: row `theirs' not found: cross-check skipped"
 18.             continue
 19.         }
 20.         quietly keep if inlist(version, `xv`x'')
 21.         keep version event_time b avg_after_b
 22.         rename (b avg_after_b) (x_b x_avg)
 23.         tempfile xt
 24.         quietly save `xt'
 25.         restore, preserve
 26.         quietly keep if outcome == `mine' & inlist(version, `xv`x'')
 27.         quietly merge 1:1 version event_time using `xt'
 28.         quietly count if _merge != 3 | abs(b - x_b) > 0.00005 + 1e-9 | abs(avg_after_b - x_avg) > 0.00005 + 1e-9
 29.         if r(N) > 0 {
 30.             display as error "`xf`x''.csv row `theirs' does not match row `mine' here: the R6 sample or model diffe
> rs between the files."
 31.             exit 459
 32.         }
 33.         quietly count
 34.         local nmatch = `nmatch' + r(N)
 35.         restore
 36.         quietly replace cross_check = "= `xf`x'' row `theirs'" if outcome == `mine' & inlist(version, `xv`x'')
 37.     }
 38.     display "   `xf`x''.csv: all `nmatch' coefficients and averages reproduced to 4 decimals"
 39. }
