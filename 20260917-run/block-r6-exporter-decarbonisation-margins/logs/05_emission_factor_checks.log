. set linesize 120

. 
. *---------------------------------------------------------------------------
. display "Step 6/8: the notes' numbers, read from the table (never typed)"
Step 6/8: the notes' numbers, read from the table (never typed)

. *---------------------------------------------------------------------------
. * Per measure m, set of rates r and version v: the shown average ("+10.2%" or
. * "-1.9 points"), whether its 95% interval excludes 0 ("clear"), and before-start p.
. gen byte clear = avg_after_shown_lo > 0 | avg_after_shown_hi < 0

. gen double shr = round(avg_after_shown, 0.1)                      // round first: no "-0.0"

. gen str20 ptxt = cond(shr > 0, "+", "") + string(shr, "%9.1f") + cond(unit == "percentage points", " points", "%")

. gen byte rnum = 1 * (rates == "main") + 2 * (rates == "gridfixed") + 3 * (rates == "scen2")

. forvalues m = 1/`nmeas' {
  2.     forvalues r = 1/`nr' {
  3.         forvalues s = 1/`nv' {
  4.             local v "`v`s''"
  5.             quietly levelsof ptxt if measure == `m' & rnum == `r' & version == "`v'" & reference, local(tt) clean
  6.             local pt`m'_`r'`v' "`tt'"
  7.             quietly summarize clear if measure == `m' & rnum == `r' & version == "`v'" & reference, meanonly
  8.             local cl`m'_`r'`v' = r(mean)
  9.             quietly summarize avg_after_shown if measure == `m' & rnum == `r' & version == "`v'" & reference, meano
> nly
 10.             local av`m'_`r'`v' = r(mean)
 11.             quietly summarize before_p if measure == `m' & rnum == `r' & version == "`v'" & reference, meanonly
 12.             local bp`m'_`r'`v' = r(mean)
 13.         }
 14.     }
 15. }

. * (a) The answer first: how far the other rates move each drawn average (main
. * version), in the chart's own units, and whether any row changes between clear
. * and not clear.
. local dmax 0

. forvalues m = 1/`nmeas' {
  2.     if `u`m'' != 1 continue                                          // the % rows
  3.     local lo = min(`av`m'_1main', `av`m'_2main', `av`m'_3main')
  4.     local hi = max(`av`m'_1main', `av`m'_2main', `av`m'_3main')
  5.     if `hi' - `lo' > `dmax' {
  6.         local dmax = `hi' - `lo'
  7.         local dm `m'
  8.     }
  9. }

. local dsh = max(`av6_1main', `av6_2main', `av6_3main') - min(`av6_1main', `av6_2main', `av6_3main')

. local dmaxt = string(`dmax', "%9.1f")

. local dsht  = string(`dsh', "%9.1f")

. local headtxt "Other rates move each % change by at most `dmaxt' percentage points (`w`dm'') and the share in (b) by a
> t most `dsht' points."

. * rows clear under all three sets, under some only, under none (main version)
. local call ""

. local csome ""

. forvalues m = 1/`nmeas' {
  2.     local k = `cl`m'_1main' + `cl`m'_2main' + `cl`m'_3main'
  3.     if `k' == 3 local call = "`call'" + cond("`call'" != "", ", ", "") + "`w`m''"
  4.     if inrange(`k', 1, 2) local csome = "`csome'" + cond("`csome'" != "", ", ", "") + "`w`m''"
  5. }

. if "`call'" == "" & "`csome'" == "" local cltxt "No row is clearly different from 0 under any set."

. else if "`csome'" == "" local cltxt "Clearly different from 0 under all three sets: `call'; the other rows under none.
> "

. else local cltxt "Clear under some sets only: `csome'" + cond("`call'" != "", "; under all three: `call'", "") + "."

. * (b) Why the rates matter so little here.
. * Plain words for the year fixed effects: "the comparison removes whatever all firms share in a year".
. local whytxt "Row (5) cannot change: its grid rate is the same for all firms in a year, and the comparison removes wha
> t all firms share"

. local whytxt "`whytxt' in a year (checked); other rows move only through each firm's fuel and electricity mix."

. * (c) The three sets, from the file.
. local dlot = cond(`dlo' > 0, "+", "") + string(`dlo', "%9.0f") + "%"

. local dhit = cond(`dhi' > 0, "+", "") + string(`dhi', "%9.0f") + "%"

. local ratetxt "CO2 is not measured: GJ of each fuel × a rate per fuel, plus bought kWh × a national grid rate; the fil
> e stores all three"

. local ratetxt "`ratetxt' sets but not their outside source. Main: grid rate `gkg_first' kg CO2 per kWh (`gy0') rising 
> to `gkg_last' (`gy1'), then kept"

. local ratetxt "`ratetxt' (no later rate in the file). Grid rate fixed: `gkg_fix' in every year. Scenario 2: `gkg_fix',
>  and each fuel's rate `dlot'"

. local ratetxt "`ratetxt' to `dhit' of main (all rates: Table `exhibit')."

. local nb = uchar(160)                                   // no-break space: "p = 0.022" stays on one line

. * (d) Before-start check for the drawn rows (main rates, main version).
. local nfail 0

. local failtxt ""

. forvalues m = 1/`nmeas' {
  2.     if `bp`m'_1main' < 0.05 {
  3.         local ++nfail
  4.         local failtxt = "`failtxt'" + cond(`nfail' > 1, ", ", "") + "`w`m'' (p`nb'=`nb'" + string(`bp`m'_1main', "%
> 5.3f") + ")"
  5.     }
  6. }

. if `nfail' == 0 local btxt "Before the start no row differed clearly (right column; p below 0.05 would be a warning)."

. else local btxt "Warning: `failtxt' already differed before the start."

. * (e) Single years whose interval excludes 0 (main rates, main version), each
. * with the number of versions in which that year is clear; the chance rate; and
. * how many single years the other rates move between clear and not clear.
. local ndots 0

. local nsy 0

. local nflip 0

. local sytxt ""

. forvalues m = 1/`nmeas' {
  2.     quietly count if measure == `m' & rnum == 1 & version == "main" & !reference & !missing(b)
  3.     local ndots = `ndots' + r(N)
  4.     quietly levelsof event_time if measure == `m' & rnum == 1 & version == "main" & !reference & !missing(b), local
> (ka)
  5.     foreach k of local ka {
  6.         quietly count if measure == `m' & version == "main" & event_time == `k' & (lo > 0 | hi < 0)
  7.         if !inlist(r(N), 0, 3) local ++nflip                            // clear under some sets only
  8.     }
  9.     quietly levelsof event_time if measure == `m' & rnum == 1 & version == "main" & !reference & (lo > 0 | hi < 0),
>  local(ks)
 10.     local part ""
 11.     local nk 0
 12.     foreach k of local ks {
 13.         local ++nk
 14.         local ++nsy
 15.         quietly count if measure == `m' & rnum == 1 & event_time == `k' & (lo > 0 | hi < 0)
 16.         local nvc = r(N)
 17.         local kl = cond(`k' > 0, "+", "") + string(`k')
 18.         quietly summarize grouped if measure == `m' & rnum == 1 & event_time == `k' & version == "main", meanonly
 19.         if r(max) == 1 local kl = cond(`k' < 0, "≤ ", "≥ ") + "`kl'"
 20.         local part = "`part'" + cond(`nk' > 1, ", ", "") + "`kl' (`nvc')"
 21.     }
 22.     if `nk' > 0 local sytxt = "`sytxt'" + cond("`sytxt'" != "", "; ", "") + "(`m') `part'"
 23. }

. local fliptxt = cond(`nflip' == 0, "none", "`nflip'")

. * The full list goes under the regression table (Panel A shows every single year);
. * the chart, which draws only averages, gives the count and points there.
. if "`sytxt'" == "" {
.     local sytxt "No single year in Panel A has a 95% interval that excludes 0."
.     local sychart "No single year's interval excludes 0 (Table `exhibit', regression)."
. }

. else {
.     local sytxt "Single years in Panel A whose 95% interval excludes 0, with the number of the `nv' versions in which 
> they do: `sytxt'; `nsy' of `ndots', about `=round(0.05*`ndots')' by chance. Other rates move `fliptxt' of the `ndots' 
> between clear and not clear."
.     local sychart "Single years: `nsy' of `ndots' clear, about `=round(0.05*`ndots')' by chance (listed under Table `e
> xhibit', regression)."
. }

. * (f) The five versions (CSV): each drawn average's range under the main rates,
. * with the versions in which it is clear; and every case in which the three sets
. * disagree on clear / not clear.
. local vs_main       "all"

. local vs_nodoubt    "no doubtful records"

. local vs_no2017     "no 2017 starters"

. local vs_exact      "exact starters"

. local vs_no2017rows "no 2017 rows"

. * the same versions in words for the chart (no undefined short names there)
. local vc_nodoubt    "without doubtful energy records"

. local vc_no2017     "without 2017 starters"

. local vc_exact      "starters seen not exporting the year before"

. local vc_no2017rows "without the 2017 rows"

. local rngtxt ""

. forvalues m = 1/`nmeas' {
  2.     quietly summarize avg_after_shown if measure == `m' & rnum == 1 & reference
  3.     local dec = cond(`u`m'' == 1, 1, 0.1)
  4.     local fmt = cond(`u`m'' == 1, "%9.0f", "%9.1f")
  5.     local rlo = round(r(min), `dec')
  6.     local rhi = round(r(max), `dec')
  7.     local un = cond(`u`m'' == 1, "%", " points")
  8.     local rlo = cond(`rlo' > 0, "+", "") + string(`rlo', "`fmt'") + cond(`u`m'' == 1, "%", "")
  9.     local rhi = cond(`rhi' > 0, "+", "") + string(`rhi', "`fmt'") + "`un'"
 10.     local nclr 0
 11.     local clist ""
 12.     foreach v in main nodoubt no2017 no2017rows exact {
 13.         if `cl`m'_1`v'' {
 14.             local ++nclr
 15.             local clist = "`clist'" + cond(`nclr' > 1, ", ", "") + "`vs_`v''"
 16.         }
 17.     }
 18.     local ctx = cond(`nclr' == 0, "never clear", cond(`nclr' == `nv', "clear in all", "clear only: `clist'"))
 19.     local rngtxt = "`rngtxt'" + cond(`m' > 1, "; ", "") + "(`m') `rlo' to `rhi' (`ctx')"
 20. }

. local dis ""

. local ndis 0

. local ndisf 0                                           // ... of which already differ before the start

. forvalues s = 1/`nv' {
  2.     local v "`v`s''"
  3.     forvalues m = 1/`nmeas' {
  4.         forvalues r = 2/`nr' {
  5.             if `cl`m'_`r'`v'' != `cl`m'_1`v'' {
  6.                 local ++ndis
  7.                 local st = cond(`cl`m'_`r'`v'', "clear", "not clear")
