  7.     local rhi = round(r(max), `dd')
  8.     local rlo = cond(`rlo' > 0, "+", "") + string(`rlo', "`fm'")
  9.     local rhi = cond(`rhi' > 0, "+", "") + string(`rhi', "`fm'") + "`uu'"
 10.     local nclr 0
 11.     local clist ""
 12.     local nlist ""
 13.     forvalues s = 1/`nv' {
 14.         local v "`v`s''"
 15.         if `cl`o'`v'' {
 16.             local ++nclr
 17.             local clist = "`clist'" + cond("`clist'" != "", "; ", "") + "`vs_`v''"
 18.         }
 19.         else local nlist = "`nlist'" + cond("`nlist'" != "", "; ", "") + "`vs_`v''"
 20.     }
 21.     if `nclr' == 0             local ctx "never clear"
 22.     else if `nclr' == `nv'     local ctx "clear in all"
 23.     else if 2 * `nclr' > `nv'  local ctx "clear in `nclr' of `nv'; not in: `nlist'"
 24.     else                       local ctx "clear only in: `clist'"
 25.     local rngtxt = "`rngtxt'" + cond(`o' > 1, "; ", "") + "`L`o'' `rlo' to `rhi' (`ctx')"
 26. }

