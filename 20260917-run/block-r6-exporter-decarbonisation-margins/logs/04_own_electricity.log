. *---------------------------------------------------------------------------
. display "Step 5/8: estimate each measure with firm and year fixed effects (clustered by firm), seven versions"
Step 5/8: estimate each measure with firm and year fixed effects (clustered by firm), seven versions

. *---------------------------------------------------------------------------
. * R2-03's model (block file 01, Step 5): outcome on one marker per year since the
. * start, except -1 (the year before the start = the reference, 0 by definition),
. * plus one marker for each grouped end, with firm and year fixed effects.
. * Never-exporters are 0 on every marker. (a), (b): b is in percentage points.
. * (c) and the table-only row: logs, % = 100 x (exp(b) - 1).
. * A marker with no starter row in a measure and version is left out (R2-08).
. gen byte ev_lo = !missing(kA) & kA < `wlo'

. local cand "ev_lo"

. forvalues k = `wlo'/`whi' {
  2.     if `k' == -1 continue
  3.     local nm = cond(`k' < 0, "ev_m" + string(-`k'), "ev_p" + string(`k'))
  4.     gen byte `nm' = (kA == `k')
  5.     local cand `cand' `nm'
  6. }

. gen byte ev_hi = !missing(kA) & kA > `whi'

. local cand `cand' ev_hi

. gen byte ev_ref = (kA == -1)                            // for the counts only

. tempname h

. postfile `h' byte outcome str8 version str8 term int event_time byte(grouped reference estimated) ///
>     double(b se lo hi p) long(firms rows firms_early firms_late start_years) ///
>     double(n_rows n_firms n_starters n_comparison n_one_year_dropped before_F before_df before_p ///
>     before_p_no_grouped avg_after_b avg_after_se avg_after_p avg_after_lo avg_after_hi n_after_years ///
>     level_starters_ref level_never) using `est'

. forvalues s = 1/`nv' {
  2.     forvalues o = 1/`nall' {
  3.         local cond "!missing(y`o') & `e`s''"
  4.         local terms ""
  5.         foreach t of local cand {
  6.             quietly count if `t' & `cond'
  7.             if r(N) > 0 local terms `terms' `t'
  8.         }
  9.         quietly reghdfe y`o' `terms' if `cond', absorb(firm_id year) vce(cluster firm_id)
 10.         local df = e(df_r)
 11.         local NN = e(N)
 12.         local GG = e(N_clust)
 13.         local SG = e(num_singletons)
 14.         capture drop es
 15.         gen byte es = e(sample)
 16.         * A marker whose rows all drop out (firms with one row) cannot be estimated.
.         local est_t ""
 17.         foreach t of local terms {
 18.             if _se[`t'] > 0 & !missing(_se[`t']) local est_t `est_t' `t'
 19.         }
 20.         local pre ""
 21.         local pre_in ""
 22.         local post ""
 23.         foreach t of local est_t {
 24.             if "`t'" == "ev_lo" local pre `pre' `t'
 25.             else if substr("`t'", 4, 1) == "m" {
 26.                 local pre `pre' `t'
 27.                 local pre_in `pre_in' `t'               // years before the start, grouped end left out
 28.             }
 29.             else if "`t'" != "ev_hi" local post `post' `t'
 30.         }
 31.         * Joint test: all years before the start are 0 (with and without the grouped end).
.         quietly test `pre'
 32.         local F  = r(F)
 33.         local Fd = r(df)
 34.         local Fp = r(p)
 35.         quietly test `pre_in'
 36.         local Fq = r(p)
 37.         * Average over the start year and the years after it inside the window.
.         local lc = subinstr("`post'", " ", " + ", .)
 38.         local np : word count `post'
 39.         quietly lincom (`lc') / `np'
 40.         local a  = r(estimate)
 41.         local as = r(se)
 42.         local al = r(estimate) - invttail(`df', 0.025) * r(se)
 43.         local ah = r(estimate) + invttail(`df', 0.025) * r(se)
 44.         local ap = 2 * ttail(`df', abs(r(estimate) / r(se)))
 45.         egen byte ftag = tag(firm_id) if es
 46.         quietly count if ftag == 1 & !never
 47.         local ST = r(N)
 48.         quietly count if ftag == 1 & never
 49.         local CF = r(N)
 50.         drop ftag
 51.         * Levels, for reading (a) and (b): starters' average the year before the start,
.         * never-exporters' average over all their rows (same estimation rows).
.         local lvs = .
 52.         local lvn = .
 53.         if `o' <= 2 {
 54.             quietly summarize y`o' if es & kA == -1
 55.             local lvs = r(mean)
 56.             quietly summarize y`o' if es & never
 57.             local lvn = r(mean)
 58.         }
 59.         foreach t in `cand' ev_ref {
 60.             if "`t'" == "ev_lo"       local k = `wlo' - 1
 61.             else if "`t'" == "ev_hi"  local k = `whi' + 1
 62.             else if "`t'" == "ev_ref" local k = -1
 63.             else local k = cond(substr("`t'", 4, 1) == "m", -1, 1) * real(substr("`t'", 5, .))
 64.             * starters behind each point (a firm counts once in a grouped end)
.             egen byte ft = tag(firm_id) if es & `t'
 65.             quietly count if ft == 1
 66.             local nf = r(N)
 67.             quietly count if es & `t'
 68.             local nr = r(N)
 69.             quietly count if ft == 1 & gA < 2016
 70.             local ne = r(N)
 71.             quietly count if ft == 1 & gA > 2016
 72.             local nl = r(N)
 73.             quietly levelsof gA if es & `t'
 74.             local ny : word count `r(levels)'
 75.             drop ft
 76.             local grp = inlist("`t'", "ev_lo", "ev_hi")
 77.             local whole (`NN') (`GG') (`ST') (`CF') (`SG') (`F') (`Fd') (`Fp') (`Fq') (`a') (`as') (`ap') (`al') (`
> ah') (`np') (`lvs') (`lvn')
 78.             if "`t'" == "ev_ref" {
 79.                 post `h' (`o') ("`v`s''") ("`t'") (`k') (0) (1) (0) (0) (.) (0) (0) (.) (`nf') (`nr') (`ne') (`nl')
>  (`ny') `whole'
 80.             }
 81.             else if !`: list t in est_t' {
 82.                 post `h' (`o') ("`v`s''") ("`t'") (`k') (`grp') (0) (0) (.) (.) (.) (.) (.) (`nf') (`nr') (`ne') (`
> nl') (`ny') `whole'
 83.             }
 84.             else {
 85.                 local b  = _b[`t']
 86.                 local se = _se[`t']
 87.                 post `h' (`o') ("`v`s''") ("`t'") (`k') (`grp') (0) (1) (`b') (`se') ///
>                     (`b' - invttail(`df', 0.025) * `se') (`b' + invttail(`df', 0.025) * `se') ///
>                     (2 * ttail(`df', abs(`b' / `se'))) (`nf') (`nr') (`ne') (`nl') (`ny') `whole'
 88.             }
 89.         }
 90.     }
 91.     display "   `v`s'': done"
 92. }
   main: done
   nodoubt: done
   no2017: done
   exact: done
   no2017r: done
   allyrs: done
   allyrsnd: done

