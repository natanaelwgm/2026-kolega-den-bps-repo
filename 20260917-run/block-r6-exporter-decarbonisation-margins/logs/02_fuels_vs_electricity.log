  2.     local n  = ustrlen(`"`w'"')
  3.     local na = `n' - ustrlen(ustrregexra(`"`w'"', "[ijltfr.,;:'()\-]", ""))
  4.     local wi = `n' - ustrlen(ustrregexra(`"`w'"', "[A-Zmw]", ""))
  5.     local pc = `n' - ustrlen(ustrregexra(`"`w'"', "%", ""))
  6.     local dg = `n' - ustrlen(ustrregexra(`"`w'"', "[0-9+=]", ""))
  7.     local ww = 0.29*`na' + 0.7*`wi' + 0.83*`pc' + 0.52*`dg' + 0.47*(`n' - `na' - `wi' - `pc' - `dg')
  8.     local try = `lw' + 0.25*(`"`line'"' != "") + `ww'
