 10.         local ++nl
 11.         local L`nl' `"`line'"'
 12.         local W`nl' = `lw'
 13.         local line `"`w'"'
 14.         local lw = `ww'
 15.     }
 16.     else {
 17.         local line = strtrim(`"`line' `w'"')
 18.         local lw = `try'
 19.     }
 20. }

