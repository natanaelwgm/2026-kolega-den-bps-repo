. display "Step 4/8: estimate every row with firm and year fixed effects (clustered by firm), five versions"
Step 4/8: estimate every row with firm and year fixed effects (clustered by firm), five versions

. *---------------------------------------------------------------------------
. * R6-01's model (R2-03's): the outcome on one marker per year since the start,
. * removing each firm's own average (firm fixed effects) and each year's average
. * (year fixed effects, set mostly by the comparison firms). A firm with one row
. * used cannot be compared with itself; reghdfe drops it and reports the number.
. * Log rows: b = log difference from the firm's year before the start, net of the
. * never-exporters' change; % = 100 x (exp(b) - 1). Share rows (0 or 100): b =
. * difference in percentage points.
. * Versions (the chart shows "main"; all are in the CSV):
. *   main       = the R6 sample
. *   nodoubt    = without doubtful energy records (Step 2)
. *   no2017     = drops the 2017 starters (no 2016 file: they may have started in 2016)
. *   exact      = keeps only starters seen not exporting the year just before
. *   no2017rows = without the 2017 rows (that year far more firms burn coal: a
. *                recording change is likely)
. local nv 5

. local v1 "main"

. local v2 "nodoubt"

. local v3 "no2017"

. local v4 "exact"

. local v5 "no2017rows"

. local e1 "1"

. local e2 "!doubt"

. local e3 "gA != 2017"                                   // comparison firms (gA missing) stay

. local e4 "missing(gA) | exactA == 1"

. local e5 "year != 2017"

. tempname h

. postfile `h' byte outcome str10 version str8 term int event_time byte(grouped reference) ///
>     double(b se lo hi p) long(firms rows firms_early firms_late start_years) using `est'

. forvalues s = 1/`nv' {
  2.     use `all', clear
  3.     keep if `e`s''
  4.     forvalues o = 1/`nall' {
  5.         gen double y`o' = `y`o'' if `smp`o''
  6.     }
  7.     * One marker per year since the start inside the window, except -1 (the year
.     * before the start = the reference, 0 by definition), plus one marker for each
.     * grouped end. Comparison firms are 0 on every marker. A marker with no starter
.     * row among a row's firm-years is left out (R2-08).
.     gen byte ev_lo = !missing(kA) & kA < `wlo'
  8.     local cand "ev_lo"
  9.     forvalues k = `wlo'/`whi' {
 10.         if `k' == -1 continue
 11.         local nm = cond(`k' < 0, "ev_m" + string(-`k'), "ev_p" + string(`k'))
 12.         gen byte `nm' = (kA == `k')
 13.         local cand `cand' `nm'
 14.     }
 15.     gen byte ev_hi = !missing(kA) & kA > `whi'
 16.     local cand `cand' ev_hi
 17.     gen byte ev_ref = (kA == -1)                        // for the counts only
 18.     forvalues o = 1/`nall' {
 19.         local terms ""
 20.         local pre ""
 21.         local pre_in ""
 22.         local post ""
 23.         foreach t of local cand {
 24.             quietly count if `t' & !missing(y`o')
 25.             if r(N) == 0 continue
 26.             local terms `terms' `t'
 27.             if "`t'" == "ev_lo" local pre `pre' `t'
 28.             else if substr("`t'", 4, 1) == "m" {
 29.                 local pre `pre' `t'
 30.                 local pre_in `pre_in' `t'               // years before the start, grouped end left out
 31.             }
 32.             else if "`t'" != "ev_hi" local post `post' `t'
 33.         }
 34.         local terms`o'_`s' `terms'
 35.         local lc = subinstr("`post'", " ", " + ", .)    // years 0..+`whi', for the average
 36.         local np : word count `post'
 37.         quietly reghdfe y`o' `terms', absorb(firm_id year) vce(cluster firm_id)
 38.         matrix B`o'_`s' = e(b)
 39.         local df = e(df_r)
 40.         local N`o'_`s'  = e(N)
 41.         local G`o'_`s'  = e(N_clust)
 42.         local sg`o'_`s' = e(num_singletons)
 43.         if `o' <= 7 assert e(N) == `N1_`s''             // rows 1-7: the same firm-years
 44.         capture drop es
 45.         gen byte es = e(sample)
 46.         foreach t of local terms {
 47.             assert _se[`t'] > 0 & !missing(_se[`t'])     // no marker silently dropped
 48.         }
 49.         * Joint test: all years before the start (with and without the grouped end) are 0.
.         quietly test `pre'
 50.         local F`o'_`s'  = r(F)
 51.         local Fd`o'_`s' = r(df)
 52.         local Fp`o'_`s' = r(p)
 53.         quietly test `pre_in'
 54.         local Fq`o'_`s' = r(p)
 55.         * Average over the start year and the years after it inside the window.
.         quietly lincom (`lc') / `np'
 56.         local a`o'_`s'  = r(estimate)
 57.         local as`o'_`s' = r(se)
 58.         local al`o'_`s' = r(estimate) - invttail(`df', 0.025) * r(se)
 59.         local ah`o'_`s' = r(estimate) + invttail(`df', 0.025) * r(se)
 60.         local ap`o'_`s' = 2 * ttail(`df', abs(r(estimate) / r(se)))
 61.         egen byte ftag = tag(firm_id) if es
 62.         quietly count if ftag == 1 & !never
 63.         local st`o'_`s' = r(N)
 64.         quietly count if ftag == 1 & never
 65.         local cf`o'_`s' = r(N)
 66.         drop ftag
 67.         foreach t in `cand' ev_ref {
 68.             if "`t'" == "ev_lo"       local k = `wlo' - 1
 69.             else if "`t'" == "ev_hi"  local k = `whi' + 1
 70.             else if "`t'" == "ev_ref" local k = -1
 71.             else local k = cond(substr("`t'", 4, 1) == "m", -1, 1) * real(substr("`t'", 5, .))
 72.             * starters behind each point (a firm counts once in a grouped end)
.             egen byte ft = tag(firm_id) if es & `t'
 73.             quietly count if ft == 1
 74.             local nf = r(N)
 75.             quietly count if es & `t'
 76.             local nr = r(N)
 77.             quietly count if ft == 1 & gA < 2016
 78.             local ne = r(N)
 79.             quietly count if ft == 1 & gA > 2016
 80.             local nl = r(N)
 81.             quietly levelsof gA if es & `t'
 82.             local ny : word count `r(levels)'
 83.             drop ft
