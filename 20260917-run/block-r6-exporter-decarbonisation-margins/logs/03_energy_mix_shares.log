. forvalues o = 1/`nall' {
  2.     foreach v in main every4 no2017rows nodoubt no2017 exact no1819 {
  3.         quietly levelsof ptxt if outcome == `o' & version == "`v'", local(tt) clean
  4.         local pt`o'`v' "`tt'"
  5.         quietly summarize clear if outcome == `o' & version == "`v'"
  6.         local cl`o'`v' = r(mean)
  7.         quietly summarize sgn if outcome == `o' & version == "`v'"
  8.         local sg`o'`v' = r(mean)
  9.         quietly summarize before_p if outcome == `o' & version == "`v'"
 10.         local bp`o'`v' = r(mean)
 11.     }
 12. }

. * (a) the answer first: which drawn rows are clearly different from 0 (main)
. local nclr 0

. local nunc 0

. forvalues o = 1/`nmeas' {
  2.     if `cl`o'main' {
  3.         local ++nclr
  4.         local clr`nclr' "`w`o'' (`pt`o'main')"
  5.     }
  6.     else {
  7.         local ++nunc
  8.         local unc`nunc' "`w`o''"
  9.     }
 10. }

. local clrtxt ""

. forvalues j = 1/`nclr' {
  2.     local sep = cond(`j' == 1, "", cond(`j' == `nclr', " and ", ", "))
  3.     local clrtxt "`clrtxt'`sep'`clr`j''"
  4. }

. local unctxt ""

. forvalues j = 1/`nunc' {
  2.     local sep = cond(`j' == 1, "", cond(`j' == `nunc', " and ", ", "))
  3.     local unctxt "`unctxt'`sep'`unc`j''"
  4. }

. if `nclr' == 0 local headtxt "After the start, no row is clearly different from 0."

. else local headtxt "After the start, clearly different from 0: `clrtxt'."

. local othtxt ""

. if `nunc' > 0 & `nclr' > 0 local othtxt "The other rows are not clear."

. * (b) before-start check (main)
. local nfail 0

. forvalues o = 1/`nmeas' {
  2.     quietly summarize before_p if outcome == `o' & version == "main"
  3.     if r(mean) < 0.05 {
  4.         local ++nfail
  5.         local fail`nfail' "`w`o''"
  6.     }
  7. }

. local failtxt ""

. forvalues j = 1/`nfail' {
  2.     local sep = cond(`j' == 1, "", cond(`j' == `nfail', " and ", ", "))
  3.     local failtxt "`failtxt'`sep'`fail`j''"
  4. }

. if `nfail' == 0 local btxt "Before the start, no row differed clearly (a before-start p below 0.05 would be a warning)
> ."

. else local btxt "Warning: `failtxt' already differed before the start (before-start p < 0.05)."

. * (c) the four-fuels version (hollow squares, their numbers in their own column):
. * do the clear answers survive when only fuels asked in every file count? This
. * sentence follows the answer directly, so no reader sees the answer without it.
. local e4txt ""

. local nlost4 0

. local k 0

. forvalues o = 1/`nmeas' {
  2.     if !`cl`o'main' continue
  3.     local ++k
  4.     local sep = cond(`k' == 1, "", cond(`k' == `nclr', " and ", ", "))
  5.     local e4txt = "`e4txt'`sep'`w`o'' `pt`o'every4' (" + cond(`cl`o'every4' & `sg`o'every4' == `sg`o'main', "clear"
> , "not clear") + ")"
  6.     if !(`cl`o'every4' & `sg`o'every4' == `sg`o'main') local ++nlost4
  7. }

. if `nclr' == 0 local e4txt ""

. else {
.     local e4txt "Counting only the four fuels asked in every file (squares): `e4txt'"
.     if `nlost4' > 0 local e4txt "`e4txt'. So part of this shift reflects fuels added to or dropped from the questions,
>  not firms changing fuel."
.     else local e4txt "`e4txt'."
. }

. * (d) the five other versions (hollow triangles = the first; the rest in the table):
. * for each clear row, in how many it stays clear in the same direction; and
. * unclear rows that become clear.
. local vs_no2017rows "without `coal_yr' rows"

. local vs_nodoubt    "without doubtful records"

. local vs_no2017     "without the 2017 starters"

. local vs_exact      "starters seen not exporting the year before"

. local vs_no1819     "without `gapyrs_txt'"

. local nov 5

. local stay ""

. local k 0

. forvalues o = 1/`nmeas' {
  2.     if !`cl`o'main' continue
  3.     local ++k
  4.     local ns 0
  5.     foreach v in no2017rows nodoubt no2017 exact no1819 {
  6.         if `cl`o'`v'' & `sg`o'`v'' == `sg`o'main' local ++ns
  7.     }
  8.     local sep = cond(`k' == 1, "", cond(`k' == `nclr', " and ", ", "))
  9.     local stay "`stay'`sep'`w`o'' in `ns' of `nov'"
 10. }

. * An unclear row that turns clear in one version is named, with a warning when that
. * version fails the before-start check for the row.
. local gaintxt ""

. local ngain 0

. forvalues o = 1/`nmeas' {
  2.     if `cl`o'main' continue
  3.     foreach v in no2017rows nodoubt no2017 exact no1819 {
  4.         if `cl`o'`v'' {
  5.             local gaintxt = "`gaintxt'" + cond(`ngain' > 0, "; ", "") + "`w`o'' (`vs_`v''" ///
>                 + cond(`bp`o'`v'' < 0.05, ", already different before the start there", "") + ")"
  6.             local ++ngain
  7.         }
  8.     }
  9. }

. local vtxt "Without `coal_yr' rows (triangles) and in 4 more versions (table):"

. if `nclr' > 0 local vtxt "`vtxt' `stay' stay clear"

. else local vtxt "`vtxt' no answer is clear in main"

. local vtxt = "`vtxt'" + cond(`ngain' == 0, "; no unclear answer becomes clear.", "; clear in one version only: `gaintx
> t'.")

. * (e) the questionnaire, the coal jump and what is outside the energy total (Step 3)
. local qsent "Some fuels are asked only in some files: `qtxt'."     // table notes (with years)

. local qnames ""

. forvalues j = 1/`nq' {
