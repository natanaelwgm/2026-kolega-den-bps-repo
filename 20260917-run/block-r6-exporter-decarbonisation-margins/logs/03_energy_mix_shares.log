. * x-axis per panel: a round step that grows with the numbers; 0 always inside (R6-01's rule).
. forvalues p = 1/2 {
  2.     quietly summarize avg_after_shown_lo if version == "main" & pan == `p'
  3.     local xmin = min(r(min), 0)
  4.     quietly summarize avg_after_shown_hi if version == "main" & pan == `p'
  5.     local xmax = max(r(max), 0)
  6.     quietly summarize avg_after_shown if pan == `p'
  7.     local xmin = min(`xmin', r(min))
  8.     local xmax = max(`xmax', r(max))
  9.     local rng = `xmax' - `xmin'
 10.     local step = 10^floor(log10(`rng'))
 11.     if `rng'/`step' < 2       local step = `step'/5
 12.     else if `rng'/`step' < 5  local step = `step'/2
 13.     if `rng'/`step' > 6       local step = `step'*2
 14.     local xbot`p' = `step' * floor(`xmin'/`step')
 15.     local xtop`p' = `step' * ceil(`xmax'/`step')
 16.     local step`p' = `step'
 17.     local xfmt`p' = cond(`step' >= 1, "%9.0f", "%9.1f")
 18. }

. local span = `xtop1' - `xbot1'

. local k2 = `span' / (`xtop2' - `xbot2')                 // panel (b) units -> panel (a) units

. foreach v in avg_after_shown avg_after_shown_lo avg_after_shown_hi {
  2.     gen double px_`v' = cond(pan == 1, `v', `xbot1' + (`v' - `xbot2') * `k2')
  3. }

. * Layout left to right (panel (a) units): row names, the dots, the squares' numbers
. * (four every-year fuels), the before-start check.
