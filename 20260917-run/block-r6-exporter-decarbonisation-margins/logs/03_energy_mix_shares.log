. display "Step 4/8: estimate every row with firm and year fixed effects (clustered by firm), seven versions"
Step 4/8: estimate every row with firm and year fixed effects (clustered by firm), seven versions

. *---------------------------------------------------------------------------
. * R6-01's model (R2-03's): the row's measure on one marker per year since the
. * start, removing each firm's own average (firm fixed effects) and each year's
. * average (year fixed effects, set mostly by the comparison firms). A firm with one
. * usable year cannot be compared with itself; reghdfe drops it and reports it.
. * b = difference from the firm's year before the start, net of the comparison
. * firms' change: in percentage points for shares; for CO2 per GJ (logs),
. * % = 100 x (exp(b) - 1).
. * Versions (the chart draws the first three; all are in the CSV):
. *   main       = R6-01's sample and model, all fuels in the file
. *   every4     = only the four fuels asked in every file (Step 3)
. *   no2017rows = without every row of the coal jump year (both groups)
. *   nodoubt    = without doubtful energy records (sample block)
. *   no2017     = drops the 2017 starters (no 2016 file: they may have started in 2016)
. *   exact      = keeps only starters seen not exporting the year just before
. *   no1819     = without the years flagged for an energy-unit gap
. local nv 7

. local v1 "main"

. local v2 "every4"

. local v3 "no2017rows"

. local v4 "nodoubt"

. local v5 "no2017"

. local v6 "exact"

. local v7 "no1819"

. local e1 "1"

. local e2 "1"

. local e3 "year != `coal_yr'"

. local e4 "!doubt"

. local e5 "gA != 2017"                                   // comparison firms (gA missing) stay

. local e6 "missing(gA) | exactA == 1"

. local e7 "energy_unit_gap_2018_19 != 1"

. tempname h

. postfile `h' byte outcome str12 version str8 term int event_time byte(grouped reference) ///
>     double(b se lo hi p) long(firms rows firms_early firms_late start_years) using `est'

. forvalues s = 1/`nv' {
  2.     use `smp2', clear
  3.     keep if `e`s''
  4.     if "`v`s''" == "every4" {
  5.         forvalues o = 1/`nall' {
  6.             quietly replace y`o' = z`o'
  7.         }
  8.     }
  9.     local lo_s = `wlo'
 10.     local hi_s = `whi'
 11.     * One marker per year since the start inside the window, except -1 (the year
.     * before the start = the reference, 0 by definition), plus one marker for each
.     * grouped end. Comparison firms are 0 on every marker. A marker with no starter
.     * row in this version is left out (R2-08). (R6-01 Step 5, unchanged.)
.     gen byte ev_lo = !missing(kA) & kA < `lo_s'
 12.     local cand "ev_lo"
 13.     forvalues k = `lo_s'/`hi_s' {
 14.         if `k' == -1 continue
 15.         local nm = cond(`k' < 0, "ev_m" + string(-`k'), "ev_p" + string(`k'))
 16.         gen byte `nm' = (kA == `k')
 17.         local cand `cand' `nm'
 18.     }
 19.     gen byte ev_hi = !missing(kA) & kA > `hi_s'
 20.     local cand `cand' ev_hi
 21.     gen byte ev_ref = (kA == -1)                        // for the counts only
 22.     local terms ""
 23.     local pre ""
 24.     local pre_in ""
 25.     local post ""
 26.     foreach t of local cand {
 27.         quietly count if `t'
 28.         if r(N) == 0 continue
 29.         local terms `terms' `t'
 30.         if "`t'" == "ev_lo" local pre `pre' `t'
 31.         else if substr("`t'", 4, 1) == "m" {
 32.             local pre `pre' `t'
 33.             local pre_in `pre_in' `t'                   // years before the start, grouped end left out
 34.         }
 35.         else if "`t'" != "ev_hi" local post `post' `t'
 36.     }
 37.     local terms`s' `terms'
 38.     local lc = subinstr("`post'", " ", " + ", .)        // years 0..+`hi_s', for the average
 39.     local np : word count `post'
 40.     forvalues o = 1/`nall' {
 41.         quietly reghdfe y`o' `terms', absorb(firm_id year) vce(cluster firm_id)
 42.         foreach t of local terms {
 43.             if _se[`t'] == 0 {
 44.                 display as error "`v`s'', row `o': marker `t' has no starter row left; the version cannot be estima
> ted as set up."
 45.                 exit 459
 46.             }
 47.         }
 48.         matrix B`o'_`s' = e(b)
 49.         local df = e(df_r)
 50.         local N`o'_`s'  = e(N)
 51.         local G`o'_`s'  = e(N_clust)
 52.         local sg`o'_`s' = e(num_singletons)
 53.         * rows (a1), (a2), (b1) use the same firm-years; so do (a3)-(a5), (b2) and row 8
.         if inlist(`o', 2, 6) assert e(N) == `N1_`s''
 54.         if inlist(`o', 4, 5, 7, 8) assert e(N) == `N3_`s''
 55.         capture drop es
 56.         gen byte es = e(sample)
 57.         * Joint test: all years before the start (with and without the grouped end) are 0.
.         quietly test `pre'
 58.         local F`o'_`s'  = r(F)
 59.         local Fd`o'_`s' = r(df)
 60.         local Fp`o'_`s' = r(p)
 61.         quietly test `pre_in'
 62.         local Fq`o'_`s' = r(p)
 63.         * Average over the start year and the years after it inside the window.
.         quietly lincom (`lc') / `np'
 64.         local a`o'_`s'  = r(estimate)
 65.         local as`o'_`s' = r(se)
 66.         local al`o'_`s' = r(estimate) - invttail(`df', 0.025) * r(se)
 67.         local ah`o'_`s' = r(estimate) + invttail(`df', 0.025) * r(se)
 68.         local ap`o'_`s' = 2 * ttail(`df', abs(r(estimate) / r(se)))
 69.         egen byte ftag = tag(firm_id) if es
 70.         quietly count if ftag == 1 & !never
 71.         local st`o'_`s' = r(N)
 72.         quietly count if ftag == 1 & never
 73.         local cf`o'_`s' = r(N)
 74.         drop ftag
 75.         foreach t in `cand' ev_ref {
 76.             if "`t'" == "ev_lo"       local k = `lo_s' - 1
 77.             else if "`t'" == "ev_hi"  local k = `hi_s' + 1
 78.             else if "`t'" == "ev_ref" local k = -1
 79.             else local k = cond(substr("`t'", 4, 1) == "m", -1, 1) * real(substr("`t'", 5, .))
 80.             * starters behind each point (a firm counts once in a grouped end)
.             egen byte ft = tag(firm_id) if es & `t'
 81.             quietly count if ft == 1
 82.             local nf = r(N)
 83.             quietly count if es & `t'
 84.             local nr = r(N)
 85.             quietly count if ft == 1 & gA < 2016
 86.             local ne = r(N)
 87.             quietly count if ft == 1 & gA > 2016
 88.             local nl = r(N)
 89.             quietly levelsof gA if es & `t'
 90.             local ny : word count `r(levels)'
 91.             drop ft
 92.             local grp = inlist("`t'", "ev_lo", "ev_hi")
 93.             if "`t'" == "ev_ref" {
 94.                 post `h' (`o') ("`v`s''") ("`t'") (`k') (0) (1) (0) (.) (0) (0) (.) (`nf') (`nr') (`ne') (`nl') (`n
> y')
 95.             }
 96.             else if !`: list t in terms' {
 97.                 post `h' (`o') ("`v`s''") ("`t'") (`k') (`grp') (0) (.) (.) (.) (.) (.) (0) (0) (0) (0) (0)
 98.             }
 99.             else {
100.                 local b  = _b[`t']
101.                 local se = _se[`t']
102.                 post `h' (`o') ("`v`s''") ("`t'") (`k') (`grp') (0) (`b') (`se') ///
>                     (`b' - invttail(`df', 0.025) * `se') (`b' + invttail(`df', 0.025) * `se') ///
>                     (2 * ttail(`df', abs(`b' / `se'))) (`nf') (`nr') (`ne') (`nl') (`ny')
103.             }
104.         }
105.     }
106.     * Oil + coal + gas = 100 on every row, so their coefficients add to 0 at every
.     * marker and in the average (same firm-years).
.     foreach t of local terms {
107.         assert abs(B3_`s'[1, "`t'"] + B4_`s'[1, "`t'"] + B5_`s'[1, "`t'"]) < 1e-6
108.     }
109.     assert abs(`a3_`s'' + `a4_`s'' + `a5_`s'') < 1e-6
110.     local pshow = cond(`Fp3_`s'' < 0.001, "< 0.001", "= " + string(`Fp3_`s'', "%5.3f"))
111.     display "   `v`s'': " %6.0fc `N1_`s'' " rows (" %6.0fc `N3_`s'' " with fuel), " %5.0fc `G1_`s'' " firms (" `st1
> _`s'' " starters); electricity " ///
>         %5.1f `a1_`s'' " pts, oil " %5.1f `a3_`s'' ", coal " %5.1f `a4_`s'' ", gas " %5.1f `a5_`s'' " pts; CO2 per GJ 
> " ///
>         %5.1f 100 * (exp(`a6_`s'') - 1) "%, of fuels " %5.1f 100 * (exp(`a7_`s'') - 1) "%; shares add to 100 checked"
112. }
