. * (In this file the markers and the model of the sample block are in Step 4.)
. * A fuel not asked in a year is missing; inside a firm's fuel total it counts as 0
. * (the file's fuel total gj_fuel_s1 adds only the fuels asked that year).
. capture program drop r6_yranges

. program define r6_yranges, rclass
  1.     * Turns a list of years into ranges, e.g. "2012–2014 and 2017–2019".
.     * Years next to each other in the list of annual files count as a run
.     * (there is no 2016 file, so 2015 and 2017 are next to each other).
.     args years fileyears
  2.     local txt ""
  3.     local start ""
  4.     local prev ""
  5.     foreach y of local years {
  6.         if "`start'" == "" {
  7.             local start `y'
  8.             local prev `y'
  9.             continue
 10.         }
 11.         local nxt ""
 12.         local found 0
 13.         foreach z of local fileyears {
 14.             if `found' & "`nxt'" == "" local nxt `z'
 15.             if `z' == `prev' local found 1
 16.         }
 17.         if "`y'" == "`nxt'" local prev `y'
 18.         else {
 19.             local txt = "`txt'" + cond("`txt'" == "", "", " and ") + cond(`start' == `prev', "`start'", "`start'–`p
> rev'")
 20.             local start `y'
 21.             local prev `y'
 22.         }
 23.     }
 24.     if "`start'" != "" local txt = "`txt'" + cond("`txt'" == "", "", " and ") + cond(`start' == `prev', "`start'", 
> "`start'–`prev'")
 25.     return local txt "`txt'"
 26. end

