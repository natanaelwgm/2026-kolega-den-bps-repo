. forvalues p = 1/2 {
  2.     local nt = round((`xtop`p'' - `xbot`p'') / `step`p'')
  3.     local ylo = cond(`p' == 1, `ya_lo', `yb_lo')
  4.     local yhi = cond(`p' == 1, `ya_hi', `yb_hi')
  5.     local ylb = cond(`p' == 1, `ya_lab', `yb_lab')
  6.     forvalues j = 0/`nt' {
  7.         local v  = `xbot`p'' + `j' * `step`p''
  8.         local xv = cond(`p' == 1, `v', `xbot1' + (`v' - `xbot2') * `k2')
  9.         local grid `grid' `ylo' `xv' `yhi' `xv'
 10.         local lab = string(`v', "`xfmt`p''") + cond(`p' == 2, "%", "")
 11.         local tx `tx' text(`ylb' `xv' "`lab'", size(vsmall) placement(c))
 12.     }
 13.     local x0 = cond(`p' == 1, 0, `xbot1' + (0 - `xbot2') * `k2')
 14.     local zero `zero' `ylo' `x0' `yhi' `x0'
 15. }

