. foreach spec in "01_margins_export_start|3|1" "01_margins_export_start|4|2" "01_margins_export_start|5|3" ///
>                 "01_margins_export_start|1|6" "03_energy_mix_shares|1|4" "04_own_electricity|1|5" {
  2.     gettoken tf rest : spec, parse("|")
  3.     gettoken bar rest : rest, parse("|")
  4.     gettoken ro rest : rest, parse("|")
  5.     gettoken bar mo : rest, parse("|")
  6.     capture confirm file "tables/`tf'.csv"
  7.     if _rc {
  8.         display "   tables/`tf'.csv not found: cross-check of (`mo') skipped"
  9.         continue
 10.     }
 11.     preserve
 12.     import delimited using "tables/`tf'.csv", clear varnames(1)
 13.     keep if outcome == `ro' & inlist(version, "main", "nodoubt", "exact")
 14.     gen str8 method = cond(version == "main", "twfe", cond(version == "nodoubt", "twfe_nd", "twfe_ex"))
 15.     keep if reference == 0 & !missing(b)
 16.     keep method event_time b avg_after_b before_p n_rows
 17.     rename (b avg_after_b before_p n_rows) (f_b f_avg f_bp f_n)
 18.     tempfile fig
 19.     save `fig'
 20.     restore, preserve
 21.     keep if outcome == `mo' & inlist(method, "twfe", "twfe_nd", "twfe_ex")
 22.     bysort method: egen double m_avg = max(cond(row_type == "avg", b, .))
 23.     bysort method: egen double m_bp  = max(cond(row_type == "before_check", p, .))
 24.     bysort method: egen double m_n   = max(cond(row_type == "avg", rows, .))
 25.     keep if row_type == "event"
 26.     keep method event_time b m_avg m_bp m_n
 27.     quietly merge 1:1 method event_time using `fig'
 28.     quietly count if _merge != 3 | abs(b - f_b) > 0.00005 + 1e-9 | abs(m_avg - f_avg) > 0.00005 + 1e-9 ///
>         | abs(m_bp - f_bp) > 0.0005 + 1e-9 | m_n != f_n
 29.     if r(N) > 0 {
 30.         display as error "tables/`tf'.csv (its outcome `ro') does not match this file's margin (`mo'): the margins 
> no longer equal the reviewed files."
 31.         exit 459
 32.     }
 33.     quietly count
 34.     display "   tables/`tf'.csv, its outcome `ro' = margin (`mo'): all " r(N) " year coefficients, averages, before
> -start p and rows reproduced (3 versions)"
 35.     restore
 36.     replace r6_check = "`tf'.csv outcome `ro' (main, nodoubt, exact)" if outcome == `mo' & inlist(method, "twfe", "
> twfe_nd", "twfe_ex")
 37. }
