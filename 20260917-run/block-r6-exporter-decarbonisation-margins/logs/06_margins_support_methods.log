. *---------------------------------------------------------------------------
. display "Step 6/8: numbers for the rows and notes (read from the table, never typed)"
Step 6/8: numbers for the rows and notes (read from the table, never typed)

. *---------------------------------------------------------------------------
. local nb = uchar(160)                                   // no-break space: "p < 0.001" stays on one line

. local mname1 "one regression"

. local mname2 "Callaway–Sant'Anna"

. local mname3 "Sun–Abraham"

. local mname4 "Borusyak–Jaravel–Spiess"

. local mname5 "de Chaisemartin–D'Haultfœuille"

. gen byte ok = status == "ok" & !missing(b)

. gen byte clear = ok & (lo > 0 | hi < 0)                 // interval does not cross 0

. * Decimals as drawn: shares always 1; % changes whole, or 1 decimal for a margin
. * whose averages are all small (so no "-0%").
. forvalues o = 1/`nmeas' {
  2.     quietly summarize shown if outcome == `o' & row_type == "avg" & method_order <= 5 & ok
  3.     local dec`o' = cond(`u`o'' == 2 | max(abs(r(min)), abs(r(max))) < 5, 1, 0)
  4.     local suf`o' = cond(`u`o'' == 1, "%", " points")
  5. }

. * a number as drawn, with its sign: program r606_fmt value decimals suffix
. capture program drop r606_fmt

. program define r606_fmt, rclass
  1.     args v d suf
  2.     local r = round(`v', 10^(-`d'))
  3.     return local s = cond(`r' > 0, "+", "") + string(`r', "%9.`d'f") + "`suf'"
  4. end

. * (a) the single regression's answer per margin (= R6-01, R6-03, R6-04)
. local headtxt ""

. local nclr 0

. local clrlist ""

. forvalues o = 1/`nmeas' {
  2.     quietly summarize shown if outcome == `o' & method == "twfe" & row_type == "avg"
  3.     r606_fmt `r(mean)' `dec`o'' "`suf`o''"
  4.     local tw`o' "`r(s)'"
  5.     quietly summarize clear if outcome == `o' & method == "twfe" & row_type == "avg"
  6.     local twc`o' = r(mean)
  7.     if `twc`o'' {
  8.         local ++nclr
  9.         local clrlist = "`clrlist'" + cond(`nclr' > 1, " and ", "") + "`w`o''"
 10.     }
 11.     local sep = cond(`o' == 1, "", cond(`o' == `nmeas', " and ", ", "))
 12.     local headtxt "`headtxt'`sep'`w`o'' `tw`o''"
 13. }

. local headtxt "One regression (as in R6-01, R6-03, R6-04): `headtxt'"

. local headtxt = "`headtxt'; " + cond(`nclr' == 0, "none is clearly different from 0.", "clearly different from 0: `clr
> list'.")

. * (b) the five methods: each margin's range and in how many it is clear
. local rngtxt ""

. forvalues o = 1/`nmeas' {
  2.     quietly summarize shown if outcome == `o' & row_type == "avg" & method_order <= 5 & ok
  3.     local nav = r(N)
  4.     r606_fmt `r(min)' `dec`o'' "`=cond(`u`o'' == 1, "%", "")'"
  5.     local smin "`r(s)'"
  6.     quietly summarize shown if outcome == `o' & row_type == "avg" & method_order <= 5 & ok
  7.     r606_fmt `r(max)' `dec`o'' "`suf`o''"
  8.     local smax "`r(s)'"
  9.     quietly count if outcome == `o' & row_type == "avg" & method_order <= 5 & clear
 10.     local nc = r(N)
 11.     local ctx = cond(`nc' == 0, "never clear", cond(`nc' == `nav', "clear in all `nav'", "clear in `nc' of `nav'"))
 12.     * clear in some methods only: name them, with their own before-start p
.     if `nc' > 0 & `nc' < `nav' {
 13.         local ctx ""
 14.         forvalues m = 1/5 {
 15.             quietly count if outcome == `o' & method_order == `m' & row_type == "avg" & clear
 16.             if r(N) == 0 continue
 17.             quietly summarize p if outcome == `o' & method_order == `m' & row_type == "before_check"
 18.             local pq = cond(r(mean) < 0.001, "p`nb'<`nb'0.001", "p`nb'=`nb'" + string(r(mean), "%5.3f"))
 19.             local ctx = "`ctx'" + cond("`ctx'" != "", ", ", "") + "`mname`m'' (before the start `pq')"
 20.         }
 21.         local ctx "clear only in `ctx'"
 22.     }
 23.     local sep = cond(`o' == 1, "", "; ")
 24.     local rngtxt "`rngtxt'`sep'`w`o'' `smin' to `smax' (`ctx')"
 25. }

. local rngtxt "Across the five methods: `rngtxt'."

. * (c) before-start checks: each method's own check, per margin (p below 0.05 = fails)
. local bftxt ""

. local nbf 0

. forvalues o = 1/`nmeas' {
  2.     local lst ""
  3.     local nf 0
  4.     forvalues m = 1/5 {
  5.         quietly summarize p if outcome == `o' & method_order == `m' & row_type == "before_check"
  6.         if r(N) > 0 & r(mean) < 0.05 {
  7.             local ++nf
  8.             local lst = "`lst'" + cond(`nf' > 1, ", ", "") + "`mname`m''"
  9.         }
 10.     }
 11.     if `nf' > 0 {
 12.         local ++nbf
 13.         local bf`nbf' "`w`o'' (`lst')"
 14.     }
 15. }

. local bftxt ""

. forvalues j = 1/`nbf' {
  2.     local sep = cond(`j' == 1, "", cond(`j' == `nbf', " and ", "; "))
  3.     local bftxt "`bftxt'`sep'`bf`j''"
  4. }

. if `nbf' == 0 local bftxt "Before the start, no method's own check fails for any row (p below 0.05 would be a warning)
> ."

. else local bftxt "Before the start, the method's own check (p below 0.05 = starters already differed) fails for `bftxt
> '."

. * Callaway-Sant'Anna over all years before the start, and exact starters (table)
. local cslist ""

. local ncs 0

. local exlist ""

. local nex 0

. forvalues o = 1/`nmeas' {
  2.     quietly summarize p if outcome == `o' & method == "cs" & row_type == "before_all"
  3.     if r(N) > 0 & r(mean) < 0.05 {
  4.         local ++ncs
  5.         local cs`ncs' "`w`o''"
  6.     }
  7.     quietly summarize p if outcome == `o' & method == "twfe_ex" & row_type == "before_check"
  8.     if r(N) > 0 & r(mean) < 0.05 {
  9.         local ++nex
 10.         local ex`nex' "`w`o''"
 11.     }
 12. }

. foreach g in cs ex {
  2.     local `g'list ""
  3.     forvalues j = 1/`n`g'' {
  4.         local sep = cond(`j' == 1, "", cond(`j' == `n`g'', " and ", ", "))
  5.         local `g'list "``g'list'`sep'``g'`j''"
  6.     }
  7. }

. local cstxt = cond(`ncs' == 0, "no margin", "`cslist'")

. local extxt = cond(`nex' == 0, "no margin", "`exlist'")

. local bf2txt "Over all years before the start (Callaway–Sant'Anna, gray line) it fails for `cstxt'; with only starters
>  seen not exporting the year before (table) for `extxt'."

. local bf2short "Callaway–Sant'Anna's check over all years before the start (gray) fails for `ncs' of `nmeas' blocks."

. * (d) single years: those whose interval excludes 0 in the single regression, each
. * with the number of the five methods in which the same year is clear.
. local ndots 0

. local nsyc 0

. local nsyb 0                                            // of them: years before the start

. local sytxt ""

. forvalues o = 1/`nmeas' {
  2.     quietly count if outcome == `o' & method == "twfe" & row_type == "event" & !missing(b)
  3.     local ndots = `ndots' + r(N)
  4.     quietly levelsof event_time if outcome == `o' & method == "twfe" & row_type == "event" & clear, local(ks)
  5.     local part ""
  6.     local nk 0
  7.     foreach k of local ks {
  8.         local ++nk
  9.         if `k' < 0 local ++nsyb
 10.         quietly summarize shown if outcome == `o' & method == "twfe" & row_type == "event" & event_time == `k'
 11.         r606_fmt `r(mean)' `=cond(`u`o'' == 2, 1, 0)' "`suf`o''"
 12.         local pv "`r(s)'"
 13.         quietly count if outcome == `o' & method_order <= 5 & row_type == "event" & event_time == `k' & clear
 14.         local nmc = r(N)
 15.         local kl = cond(`k' > 0, "+", "") + string(`k')
 16.         if `k' < `wlo' local kl "≤`nb'`kl'"
 17.         if `k' > `whi' local kl "≥`nb'`kl'"
 18.         local part = "`part'" + cond(`nk' > 1, ", ", "") + "`kl' (`pv', `nmc' of 5)"
 19.     }
 20.     if `nk' > 0 local sytxt = "`sytxt'" + cond("`sytxt'" != "", "; ", "") + "`w`o'' `part'"
 21.     local nsyc = `nsyc' + `nk'
 22. }

. if "`sytxt'" == "" local sytxt "No single year's interval excludes 0 in the single regression."

. else local sytxt "Single years clear in the one regression (table; in how many of the 5 methods that year is clear): `
> sytxt'. Negative years are before the start: a warning, not a result. Of `ndots' years about `=round(0.05*`ndots')' wo
> uld be clear by chance, so read the averages."

. local sy_short "Single years (not drawn; table notes): `nsyc' of `ndots' clear in the one regression (`nsyb' of them b
> efore the start), about `=round(0.05*`ndots')' expected by chance."

. * (e) start years each method leaves out (Sun-Abraham: no row the year before)
. local g1 : word 1 of `gapyr'

. local sa_main = subinstr("`sa_yrs1'", " ", " and ", .)

. local satxt ""

. local extra5 : list sa_yrs5 - sa_yrs1

. local extra5 = subinstr(strtrim("`extra5'"), " ", " and ", .)

. if "`g1'" != "" {
.     local satxt "Callaway–Sant'Anna, Sun–Abraham and de Chaisemartin–D'Haultfœuille leave out firms that started in `=
> `g1'+1' (no `gapyr' file)"
.     if "`extra5'" != "" local satxt "`satxt' and, in (5), in `extra5' (the year before is not used there)"
.     local satxt "`satxt'."
. }

. * the years dCDH's check covers in (5), in words ("-2 and -3", or "-2 to -4")
. local dyr5 = cond(`dpl5' == 1, "-2", cond(`dpl5' == 2, "-2 and -3", "-2 to `=-1-`dpl5''"))

. if `dpl5' < -`wlo' - 1 local satxt "`satxt' De Chaisemartin–D'Haultfœuille's check in (5) covers years `dyr5' only (gr
> ay line)."

. * (f) the firm-years behind each margin (gray line under each name)
. local n5r = string(`nrow5', "%9.0fc")

. local rowtxt "Each block uses its own firm-years (gray line under its name); all use firm-years with energy, CO2 and v
> alue added"

. local rowtxt "`rowtxt' above 0 (`=string(`n_zero', "%9.0fc")' of these firms' firm-years record no energy)."

. quietly summarize starters if outcome == 1 & method == "twfe" & row_type == "avg"

. local nst = string(r(mean), "%9.0fc")

. quietly summarize comp_firms if outcome == 1 & method == "twfe" & row_type == "avg"

. local ncf = string(r(mean), "%9.0fc")

. display "   `headtxt'"
   One regression (as in R6-01, R6-03, R6-04): value added +19%, energy used +9%, CO2 per GJ -1.3%, bought electricity's
>  share -1.3 points and firms making own electricity +8.1 points; clearly different from 0: value added and firms makin
> g own electricity.

. display "   `rngtxt'"
   Across the five methods: value added +14% to +22% (clear in all 5); energy used +3% to +17% (clear only in Borusyak–J
> aravel–Spiess (before the start p = 0.050)); CO2 per GJ -2.3% to -0.3% (never clear); bought electricity's share -2.2 
> to -0.8 points (never clear); firms making own electricity +5.9 to +8.1 points (clear in all 5).

. display "   `bftxt'"
   Before the start, the method's own check (p below 0.05 = starters already differed) fails for value added (Callaway–S
> ant'Anna); energy used (one regression, Callaway–Sant'Anna) and CO2 per GJ (Callaway–Sant'Anna).

. display "   `bf2txt'"
   Over all years before the start (Callaway–Sant'Anna, gray line) it fails for value added, energy used, CO2 per GJ and
>  bought electricity's share; with only starters seen not exporting the year before (table) for energy used, CO2 per GJ
> , bought electricity's share and firms making own electricity.

. display "   `sytxt'"
   Single years clear in the one regression (table; in how many of the 5 methods that year is clear): value added 0 (+15
> %, 5 of 5), +1 (+17%, 5 of 5), +2 (+18%, 4 of 5), +3 (+21%, 2 of 5), +5 (+27%, 2 of 5); energy used ≤ -6 (-26%, 1 of 5
> ), -5 (-31%, 2 of 5), 0 (+21%, 5 of 5); CO2 per GJ -4 (-5%, 1 of 5), -2 (-4%, 2 of 5), +3 (-5%, 1 of 5); bought electr
> icity's share +2 (-4.2 points, 4 of 5), +3 (-4.7 points, 1 of 5); firms making own electricity -5 (+8.9 points, 2 of 5
> ), +1 (+9.0 points, 5 of 5), +2 (+7.1 points, 1 of 5), +3 (+10.2 points, 3 of 5), +4 (+12.1 points, 3 of 5), +5 (+9.4 
> points, 1 of 5), ≥ +6 (+9.9 points, 2 of 5). Negative years are before the start: a warning, not a result. Of 60 years
>  about 3 would be clear by chance, so read the averages.

. display "   `satxt'"
   Callaway–Sant'Anna, Sun–Abraham and de Chaisemartin–D'Haultfœuille leave out firms that started in 2017 (no 2016 file
> ) and, in (5), in 2015 (the year before is not used there). De Chaisemartin–D'Haultfœuille's check in (5) covers years
>  -2 and -3 only (gray line).

. display "   `rowtxt'"
   Each block uses its own firm-years (gray line under its name); all use firm-years with energy, CO2 and value added ab
> ove 0 (345 of these firms' firm-years record no energy).

. * Per margin: the gray line under its name.
. forvalues o = 1/`nmeas' {
  2.     quietly summarize rows if outcome == `o' & method == "twfe" & row_type == "avg"
  3.     local rw = string(r(mean), "%9.0fc")
  4.     local fk = `fk`o'_1'
  5.     local fkl = cond(`fk' > 0, "+", "") + string(`fk')
  6.     local gl`o' "`rw' firm-years in the one regression (= `src`o''); fewest starters in a single year: `fw`o'_1' (y
> ear `fkl')"
  7. }

. 
. *---------------------------------------------------------------------------
. display "Step 7/8: dot-and-whisker chart: one block per margin, one row per method"
Step 7/8: dot-and-whisker chart: one block per margin, one row per method

. *---------------------------------------------------------------------------
. * Notes as one text, wrapped by printed width (R6-01's rule; widths in em).
. local mtxt "Rows 2 to 5 are the previous paper's four methods, named after their authors; they differ only in how they
>  combine firms"

. local mtxt "`mtxt' that start in different years (the one regression can mix them)."

. local mtxt_t "`mtxt' Callaway–Sant'Anna, Sun–Abraham and de Chaisemartin–D'Haultfœuille compare each start year only w
> ith never-exporters;"

. local mtxt_t "`mtxt_t' Borusyak–Jaravel–Spiess also uses later starters' years before their start."

. local nsta = string(`nst_any', "%9.0fc")

. local tail "Starters: first seen exporting after a year seen not exporting (`nsta' in (1), as in R6-01; the Starters c
> olumn counts those with"

. local tail "`tail' a row from the start year on; still starters if they stop); never-exporters:"

. local tail "`tail' never seen exporting (`ncf'). Dot = change since the year before the start, averaged over years 0 t
> o +`whi'; bar = 95%"

. local tail "`tail' interval (crossing 0 = not clear). (5) uses only firm-years with own electricity recorded, without 
> `badtxt' (recorded"

. local tail "`tail' for too few firms, as R6-04). Value added = output minus materials, energy and services bought (cur
> rent prices);"

. local tail "`tail' GJ = gigajoules; CO2 = energy x standard rates, not measured. Shows timing, not cause; firm links a
> re fictional:"

. local tail "`tail' this tests the method, not a finding."

. * The chart: the answer across methods first, then how to read the rows, the
. * checks, and the definitions. The points table's notes add the single-regression
. * sentence, the exact-starter check and every clear single year.
. local txt   "Notes: `rngtxt' `mtxt' `satxt' `bftxt' `bf2short' `sy_short' `tail'"

. local txt_t "Notes: `headtxt' `rngtxt' `mtxt_t' `satxt' `bftxt' `bf2txt' `sytxt' `rowtxt' `tail'"

. local maxw 53.5                                         // widest note line that fits the 9-inch PDF

. local nl 0

. local line ""

. local lw 0

. foreach w of local txt {
  2.     local n  = ustrlen(`"`w'"')
  3.     local na = `n' - ustrlen(ustrregexra(`"`w'"', "[ijltfr.,;:'()\-]", ""))
  4.     local wi = `n' - ustrlen(ustrregexra(`"`w'"', "[A-Zmw]", ""))
  5.     local pc = `n' - ustrlen(ustrregexra(`"`w'"', "%", ""))
  6.     local dg = `n' - ustrlen(ustrregexra(`"`w'"', "[0-9+=]", ""))
  7.     local ww = 0.29*`na' + 0.7*`wi' + 0.83*`pc' + 0.52*`dg' + 0.47*(`n' - `na' - `wi' - `pc' - `dg')
  8.     local try = `lw' + 0.25*(`"`line'"' != "") + `ww'
  9.     if `try' > `maxw' & `"`line'"' != "" {
 10.         local ++nl
 11.         local L`nl' `"`line'"'
 12.         local W`nl' = `lw'
 13.         local line `"`w'"'
 14.         local lw = `ww'
 15.     }
 16.     else {
 17.         local line = strtrim(`"`line' `w'"')
 18.         local lw = `try'
 19.     }
 20. }

. local ++nl

. local L`nl' `"`line'"'

. local W`nl' = `lw'

. local notes ""

. forvalues j = 1/`nl' {
  2.     display "   note line `j': " udstrlen(`"`L`j''"') " characters, width " %4.1f `W`j'' " of `maxw' em"
  3.     local notes `"`notes' "`L`j''""'
  4. }
   note line 1: 113 characters, width 46.7 of 53.5 em
   note line 2: 130 characters, width 53.3 of 53.5 em
   note line 3: 135 characters, width 52.3 of 53.5 em
   note line 4: 136 characters, width 53.1 of 53.5 em
   note line 5: 125 characters, width 52.4 of 53.5 em
   note line 6: 131 characters, width 51.6 of 53.5 em
   note line 7: 118 characters, width 45.9 of 53.5 em
   note line 8: 107 characters, width 47.1 of 53.5 em
   note line 9: 135 characters, width 53.2 of 53.5 em
   note line 10: 137 characters, width 53.1 of 53.5 em
   note line 11: 137 characters, width 52.5 of 53.5 em
   note line 12: 131 characters, width 52.3 of 53.5 em
   note line 13: 134 characters, width 52.7 of 53.5 em
   note line 14: 130 characters, width 53.2 of 53.5 em
   note line 15: 120 characters, width 46.8 of 53.5 em

. * The before-start column and Callaway-Sant'Anna's all-years line, per margin.
. foreach o of numlist 1/`nmeas' {
  2.     forvalues m = 1/5 {
  3.         quietly summarize p if outcome == `o' & method_order == `m' & row_type == "before_check"
  4.         local bp`o'_`m' = cond(r(N) > 0, r(mean), .)
  5.     }
  6.     quietly summarize p if outcome == `o' & method == "cs" & row_type == "before_all"
  7.     local bpall`o' = cond(r(N) > 0, r(mean), .)
  8. }

. keep if row_type == "avg" & method_order <= 5 & outcome <= `nmeas'
(579 observations deleted)

. gen byte pnl = cond(unit_label == "% change", 1, 2)

. * Vertical layout (y units): block header at yh, its gray line 0.6 below, the five
. * method rows (a little more room under row 2 for its gray second line), then the
. * block's axis labels. A little more room between the % blocks and the points blocks.
. gen double yh = 48 - 8.1 * (outcome - 1) - 0.8 * (pnl == 2)

. gen double ypos = yh - 1.55 - 1.0 * (method_order - 1) - 0.55 * (method_order >= 3)

. gen double ysub = ypos - 0.55                           // gray second line under a row

. * x-axis per unit: a round step (1, 2 or 5 times a power of 10); 0 always inside;
. * at most 5 steps (R2-10's rule, one fewer: the axis is narrow). The points blocks are drawn in the % blocks'
. * horizontal units, with their own labels (R6-03's way), so the columns line up.
. forvalues q = 1/2 {
  2.     quietly summarize shown_lo if ok & pnl == `q'
  3.     local xmin = min(r(min), 0)
  4.     quietly summarize shown_hi if ok & pnl == `q'
  5.     local xmax = max(r(max), 0)
  6.     local rng = `xmax' - `xmin'
  7.     local step = 10^floor(log10(`rng'))
  8.     if `rng'/`step' < 2       local step = `step'/5
  9.     else if `rng'/`step' < 5  local step = `step'/2
 10.     local xbot = `step' * floor(`xmin'/`step')
 11.     local xtop = `step' * ceil(`xmax'/`step')
 12.     while (`xtop' - `xbot')/`step' > 5 {
 13.         local mant = round(`step' / 10^floor(log10(`step')))    // 1, 2 or 5
 14.         local step = cond(`mant' == 2, 2.5, 2) * `step'         // 1 -> 2 -> 5 -> 10 ...
 15.         local xbot = `step' * floor(`xmin'/`step')
 16.         local xtop = `step' * ceil(`xmax'/`step')
 17.     }
 18.     local xbot`q' = `xbot'
 19.     local xtop`q' = `xtop'
 20.     local step`q' = `step'
 21.     local xfmt`q' = cond(`step' >= 1, "%9.0f", "%9.1f")
 22. }

. local span = `xtop1' - `xbot1'

. local k2 = `span' / (`xtop2' - `xbot2')                 // points units -> % units

. foreach v in shown shown_lo shown_hi {
  2.     gen double px_`v' = cond(pnl == 1, `v', `xbot1' + (`v' - `xbot2') * `k2')
  3. }

. local x0_2 = `xbot1' + (0 - `xbot2') * `k2'             // the zero line of the points blocks

. * Left to right (x-axis units): row names, the dots, then two columns: starters,
. * and the before-start check (placed clear of the value labels).
. local xn  = `xbot1' - 1.15 * `span'

