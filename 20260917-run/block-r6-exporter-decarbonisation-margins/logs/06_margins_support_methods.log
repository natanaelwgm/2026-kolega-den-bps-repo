          4   twfe_nd   -0.22      -3.39       2.95   0.892        738         2657   16864       ok  
          4   twfe_ex   -3.12      -6.75       0.52   0.093        510         2832   18121       ok  
          5      twfe    8.07       3.73      12.42   0.000        693         2640   16589       ok  
          5        cs    6.39       1.36      11.42   0.013        568         2640   15997       ok  
          5        sa    7.88       3.01      12.74   0.002        571         2640   15701       ok  
          5       bjs    5.85       2.17       9.54   0.002        667         4529   17780       ok  
          5      dcdh    6.39       1.35      11.43   0.013        485            .    9265       ok  
          5   twfe_nd    5.21       0.89       9.52   0.018        672         2430   13369       ok  
          5   twfe_ex   12.28       7.42      17.14   0.000        470         2640   15003       ok  
          6      twfe   10.23      -6.16      29.48   0.236        740         2832   20070       ok  
          6        cs   10.71      -7.33      32.25   0.262        698         2776   19594       ok  
          6        sa   12.24      -5.12      32.77   0.178        703         2832   19787       ok  
          6       bjs    4.58     -10.11      21.67   0.562        739         4849   21483       ok  
          6      dcdh   10.71      -7.42      32.39   0.265        694            .   11429       ok  
          6   twfe_nd    9.55      -5.85      27.48   0.238        738         2657   16864       ok  
