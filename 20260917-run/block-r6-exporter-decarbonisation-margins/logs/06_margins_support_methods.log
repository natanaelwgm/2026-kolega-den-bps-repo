. program define r606_cell, rclass
  1.     args o c cond dec
  2.     quietly count if outcome == `o' & col == `c' & `cond' & !missing(b)
  3.     if r(N) == 0 {
  4.         return local b "—"
  5.         return local s ""
  6.         exit
  7.     }
  8.     quietly summarize b if outcome == `o' & col == `c' & `cond', meanonly
  9.     return local b = string(r(mean), "%9.`dec'f")
 10.     quietly summarize se if outcome == `o' & col == `c' & `cond', meanonly
 11.     return local s = cond(missing(r(mean)), "", "(" + string(r(mean), "%9.`dec'f") + ")")
 12. end

