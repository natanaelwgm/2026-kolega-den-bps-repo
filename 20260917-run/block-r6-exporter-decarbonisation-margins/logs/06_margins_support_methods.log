. *---------------------------------------------------------------------------
. display "Step 4/8: each margin under the single regression and the four methods (R2-07's code)"
Step 4/8: each margin under the single regression and the four methods (R2-07's code)

. *---------------------------------------------------------------------------
. * All: the margin on markers of years since the start, firm and year effects,
. * starters compared with firms never seen exporting, clustered by firm, no
. * control variables. What differs is how start years and years since the start
. * are combined (R2-07). Main number per method = average of years 0 to +`whi'
. * with each year counting equally (as R6-01); each method's own single overall
. * number is kept too (CSV and regression table).
. * Counts behind each estimate: starters with a row from the start year on,
. * comparison firms and rows, all inside the estimation sample (variable es).
. capture program drop r606_used

. program define r606_used, rclass
  1.     quietly {
  2.         egen byte r606_fs = tag(firm_id) if es & !never & year >= gA
  3.         count if r606_fs == 1
  4.         return scalar starters = r(N)
  5.         egen byte r606_fc = tag(firm_id) if es & never
  6.         count if r606_fc == 1
  7.         return scalar comp = r(N)
  8.         count if es
  9.         return scalar rows = r(N)
 10.         drop r606_fs r606_fc
 11.     }
 12. end

. tempname h

. postfile `h' byte outcome byte morder str8 method str12 row_type int event_time double(b se df) ///
>     long(starters comp_firms rows) str80 status str160 note double pin using `est'

. timer clear 2

. timer on 2

. forvalues o = 1/`nall' {
  2.     use `mk', clear
  3.     keep if !missing(y`o')                              // the margin's own firm-years
  4.     gen double y = y`o'
  5.     quietly count
  6.     local nrow`o' = r(N)
  7.     tempfile smpo
  8.     save `smpo'
  9.     display "   [`o'] `n`o'': " %6.0fc `nrow`o'' " firm-years"
 10. 
.     * ---- (1) one regression, all start years together (R6-01's model), and two
.     * table-only versions of it: without doubtful energy records (R6-01's
.     * "nodoubt") and only starters seen not exporting the year before ("exact").
.     foreach s in 1 6 7 {
 11.         use `smpo', clear
 12.         if `s' == 6 keep if !doubt
 13.         if `s' == 7 keep if missing(gA) | exactA == 1
 14.         local mth = cond(`s' == 1, "twfe", cond(`s' == 6, "twfe_nd", "twfe_ex"))
 15.         * A marker with no starter row in this version is left out (R6-01).
.         local terms ""
 16.         local pre ""
 17.         local post ""
 18.         foreach t of local cand {
 19.             quietly count if `t'
 20.             if r(N) == 0 continue
 21.             local terms `terms' `t'
 22.             if "`t'" == "ev_lo" | substr("`t'", 4, 1) == "m" local pre `pre' `t'
 23.             else if "`t'" != "ev_hi" local post `post' `t'
 24.         }
 25.         local lc = subinstr("`post'", " ", " + ", .)     // years 0..+`whi', for the average
 26.         local np : word count `post'
 27.         quietly reghdfe y `terms', absorb(firm_id year) vce(cluster firm_id)
 28.         local df = e(df_r)
 29.         capture drop es
 30.         gen byte es = e(sample)
 31.         r606_used
 32.         local st = r(starters)
 33.         local cf = r(comp)
 34.         local rw = r(rows)
 35.         * R6-01 counts every starter in the regression (also those with rows only
.         * before the start); the Starters column counts those with a row from the
.         * start year on. Keep both so the notes can say which is which.
.         if `o' == 1 & `s' == 1 {
 36.             egen byte r606_fa = tag(firm_id) if es & !never
 37.             quietly count if r606_fa == 1
 38.             local nst_any = r(N)
 39.             drop r606_fa
 40.         }
 41.         if `s' == 1 local terms`o' `terms'
 42.         local sg`o'_`s' = e(num_singletons)             // firm-years of firms with one row (dropped)
 43.         * The fewest starters behind any single year from `wlo' to +`whi' (-1 included).
.         local fw`o'_`s' = .
 44.         local fk`o'_`s' = .
 45.         forvalues k = `wlo'/`whi' {
 46.             egen byte ft = tag(firm_id) if es & kA == `k'
 47.             quietly count if ft == 1
 48.             if r(N) < `fw`o'_`s'' {
 49.                 local fw`o'_`s' = r(N)
 50.                 local fk`o'_`s' = `k'
 51.             }
 52.             drop ft
 53.         }
 54.         foreach t of local terms {
 55.             if "`t'" == "ev_lo"      local k = `wlo' - 1
 56.             else if "`t'" == "ev_hi" local k = `whi' + 1
 57.             else local k = cond(substr("`t'", 4, 1) == "m", -1, 1) * real(substr("`t'", 5, .))
 58.             local nt = cond(inlist("`t'", "ev_lo", "ev_hi"), "grouped end", "")
 59.             post `h' (`o') (`s') ("`mth'") ("event") (`k') (_b[`t']) (_se[`t']) (`df') (.) (.) (.) ("ok") ("`nt'") 
> (.)
 60.         }
 61.         quietly lincom (`lc') / `np'
 62.         post `h' (`o') (`s') ("`mth'") ("avg") (.) (r(estimate)) (r(se)) (`df') (`st') (`cf') (`rw') ("ok") ("reghd
> fe, R6-01's markers") (.)
 63.         quietly test `pre'
 64.         post `h' (`o') (`s') ("`mth'") ("before_check") (.) (.) (.) (.) (.) (.) (.) ("ok") ("F test, years before t
> he start (grouped end included) = 0; p in column p") (r(p))
 65.         * The previous paper's two-way model: one on/off marker from the start year on.
.         gen byte after = !never & year >= gA
 66.         quietly reghdfe y after, absorb(firm_id year) vce(cluster firm_id)
 67.         post `h' (`o') (`s') ("`mth'") ("own_overall") (.) (_b[after]) (_se[after]) (e(df_r)) (.) (.) (e(N)) ("ok")
>  ("one on/off marker from the start year on (the previous paper's two-way model)") (.)
 68.     }
 69.     * The four methods use the main version's markers.
.     local terms `terms`o''
 70.     local pre ""
 71.     local post ""
 72.     foreach t of local terms {
 73.         if "`t'" == "ev_lo" | substr("`t'", 4, 1) == "m" local pre `pre' `t'
 74.         else if "`t'" != "ev_hi" local post `post' `t'
 75.     }
 76.     local lc = subinstr("`post'", " ", " + ", .)
 77.     local np : word count `post'
 78. 
.     * ---- (2) Callaway-Sant'Anna (csdid): each start year vs never-exporters ----
.     * csdid lays out calendar years one by one, so the year with no file is a
.     * real gap: starters whose year before the start has no file get no
.     * after-start estimate. Its before-start check compares each year before
.     * the start with the year before that, inside the window.
.     if !`ok_cs' {
 79.         post `h' (`o') (2) ("cs") ("avg") (.) (.) (.) (.) (.) (.) (.) ("unavailable: package not installed (`=strtr
> im("`miss_cs'")')") ("ssc install csdid; ssc install drdid") (.)
 80.     }
 81.     else {
 82.         use `smpo', clear
 83.         gen int gcs = cond(never, 0, gA)                   // csdid wants 0 = never started
 84.         capture quietly csdid y, ivar(firm_id) time(year) gvar(gcs)
 85.         if _rc {
 86.             post `h' (`o') (2) ("cs") ("avg") (.) (.) (.) (.) (.) (.) (.) ("failed: csdid stopped with error r(`=_r
> c')") ("") (.)
 87.         }
 88.         else {
 89.             capture drop es
 90.             gen byte es = e(sample)
 91.             r606_used
 92.             local st = r(starters)
 93.             local cf = r(comp)
 94.             local rw = r(rows)
 95.             quietly estat simple
 96.             matrix bb = r(b)
 97.             matrix vv = r(V)
 98.             post `h' (`o') (2) ("cs") ("own_overall") (.) (bb[1,1]) (sqrt(vv[1,1])) (.) (.) (.) (.) ("ok") ("estat 
> simple: all years after the start, weighted by start-year size") (.)
 99.             quietly estat event, window(`wlo' `whi')
100.             matrix bb = r(b)
101.             matrix vv = r(V)
102.             local cn : colnames bb
103.             foreach c of local cn {
104.                 local j = colnumb(bb, "`c'")
105.                 if "`c'" == "Post_avg" {
106.                     post `h' (`o') (2) ("cs") ("avg") (.) (bb[1,`j']) (sqrt(vv[`j',`j'])) (.) (`st') (`cf') (`rw') 
> ("ok") ("estat event Post_avg: years 0 to +`whi', each counts equally") (.)
107.                 }
108.                 else if inlist(substr("`c'", 1, 2), "Tm", "Tp") {
109.                     local k = cond(substr("`c'", 2, 1) == "m", -1, 1) * real(substr("`c'", 3, .))
110.                     local nt = cond(`k' < 0, "change from the year before (csdid's own base for years before the st
> art)", "vs the year before the start")
111.                     post `h' (`o') (2) ("cs") ("event") (`k') (bb[1,`j']) (sqrt(vv[`j',`j'])) (.) (.) (.) (.) ("ok"
> ) ("`nt'") (.)
112.                 }
113.             }
114.             capture quietly estat pretrend, window(`wlo' -1)
115.             local ptxt "estat pretrend inside the window"
116.             if _rc {
117.                 quietly estat pretrend                    // older csdid: no window option
118.                 local ptxt "estat pretrend, all years before the start"
119.             }
120.             post `h' (`o') (2) ("cs") ("before_check") (.) (.) (.) (.) (.) (.) (.) ("ok") ("`ptxt'; p in column p")
>  (r(pchi2))
121.             if "`ptxt'" == "estat pretrend inside the window" {
122.                 quietly estat pretrend
123.                 post `h' (`o') (2) ("cs") ("before_all") (.) (.) (.) (.) (.) (.) (.) ("ok") ("estat pretrend, all y
> ears before the start (table only); p in column p") (r(pchi2))
124.             }
125.         }
126.     }
127. 
.     * ---- (3) Sun-Abraham (eventstudyinteract): R6-01's markers, start years kept apart ----
.     local sa_yrs`o' ""
128.     local sa_out`o' 0
129.     if !`ok_sa' {
130.         post `h' (`o') (3) ("sa") ("avg") (.) (.) (.) (.) (.) (.) (.) ("unavailable: package not installed (`=strtr
> im("`miss_sa'")')") ("ssc install eventstudyinteract; ssc install avar") (.)
131.     }
132.     else {
133.         use `smpo', clear
134.         * A start year whose year before has no row in this margin (the year after
.         * the missing file; for own electricity also the year after a thinly
.         * recorded year) has no reference year: the package would silently measure
.         * those starters against their last years instead (it drops one of their
.         * markers). Leave such start years out, as Callaway-Sant'Anna and
.         * de Chaisemartin-D'Haultfoeuille do by construction (R2-10's fix).
.         bysort gA: egen byte has_ref = max(kA == -1)
135.         egen byte ft0 = tag(firm_id) if !never & !has_ref
136.         quietly count if ft0 == 1
137.         local sa_out`o' = r(N)
138.         quietly levelsof gA if !never & !has_ref, local(sa_yrs`o')
139.         drop if !never & !has_ref
140.         drop ft0 has_ref
141.         display "   Sun-Abraham: start years left out (no row the year before): `sa_yrs`o'' (`sa_out`o'' starters)"
142.         local sa_terms ""
143.         foreach t of local terms {
144.             quietly count if `t'
145.             if r(N) > 0 local sa_terms `sa_terms' `t'
146.         }
147.         assert "`sa_terms'" == "`terms'"                 // every marker still has starter rows
148.         capture quietly eventstudyinteract y `terms', cohort(gA) control_cohort(never) absorb(i.firm_id i.year) vce
> (cluster firm_id)
149.         if _rc {
150.             post `h' (`o') (3) ("sa") ("avg") (.) (.) (.) (.) (.) (.) (.) ("failed: eventstudyinteract stopped with
>  error r(`=_rc')") ("") (.)
151.         }
152.         else {
153.             capture drop es
154.             gen byte es = e(sample)
155.             r606_used
156.             local st = r(starters)
157.             local cf = r(comp)
158.             local rw = r(rows)
159.             local df = e(df_r)
160.             matrix bsa = e(b_iw)
161.             matrix vsa = e(V_iw)
162.             ereturn post bsa vsa, dof(`df')
163.             foreach t of local terms {
164.                 if "`t'" == "ev_lo"      local k = `wlo' - 1
165.                 else if "`t'" == "ev_hi" local k = `whi' + 1
166.                 else local k = cond(substr("`t'", 4, 1) == "m", -1, 1) * real(substr("`t'", 5, .))
167.                 local nt = cond(inlist("`t'", "ev_lo", "ev_hi"), "grouped end", "")
168.                 post `h' (`o') (3) ("sa") ("event") (`k') (_b[`t']) (_se[`t']) (`df') (.) (.) (.) ("ok") ("`nt'") (
> .)
169.             }
170.             quietly lincom (`lc') / `np'
171.             local syl = cond("`sa_yrs`o''" == "", "none", subinstr("`sa_yrs`o''", " ", ", ", .))
172.             post `h' (`o') (3) ("sa") ("avg") (.) (r(estimate)) (r(se)) (`df') (`st') (`cf') (`rw') ("ok") ("years 
> 0 to +`whi', each counts equally; start years left out (no row the year before): `syl' (`sa_out`o'' starters)") (.)
173.             quietly test `pre'
174.             post `h' (`o') (3) ("sa") ("before_check") (.) (.) (.) (.) (.) (.) (.) ("ok") ("F test, years before th
> e start (grouped end included) = 0; p in column p") (r(p))
175.         }
176.     }
177. 
.     * ---- (4) Borusyak-Jaravel-Spiess (did_imputation) ----
.     * Fits firm and year effects on rows not yet (or never) exporting, predicts
.     * each starter's path without the start, and averages actual minus
.     * predicted. Its before-start check asks whether the years just before the
.     * start already differ from the firm's earlier years.
.     if !`ok_bjs' {
178.         post `h' (`o') (4) ("bjs") ("avg") (.) (.) (.) (.) (.) (.) (.) ("unavailable: package not installed (`=strt
> rim("`miss_bjs'")')") ("ssc install did_imputation") (.)
179.     }
180.     else {
181.         use `smpo', clear
182.         gen int Ei = gA                                  // start year; missing = never started
183.         * minn(0): report every year; the window rule already needs 30+ starters per year.
.         capture quietly did_imputation y firm_id year Ei, horizons(0/`whi') pretrends(`=-`wlo'') autosample minn(0)
184.         if _rc {
185.             post `h' (`o') (4) ("bjs") ("avg") (.) (.) (.) (.) (.) (.) (.) ("failed: did_imputation stopped with er
> ror r(`=_rc')") ("") (.)
186.         }
187.         else {
188.             capture drop es
189.             gen byte es = e(sample)
190.             r606_used
191.             local st = r(starters)
192.             local cf = r(comp)
193.             local rw = r(rows)
194.             local p_bjs = e(pre_p)
195.             forvalues k = 0/`whi' {
196.                 post `h' (`o') (4) ("bjs") ("event") (`k') (_b[tau`k']) (_se[tau`k']) (.) (.) (.) (.) ("ok") ("vs p
> redicted path without the start") (.)
197.             }
198.             forvalues k = 1/`=-`wlo'' {
199.                 post `h' (`o') (4) ("bjs") ("event") (-`k') (_b[pre`k']) (_se[pre`k']) (.) (.) (.) (.) ("ok") ("bef
> ore-start check: vs the firm's earlier years") (.)
200.             }
201.             local lcb "tau0"
202.             forvalues k = 1/`whi' {
203.                 local lcb "`lcb' + tau`k'"
204.             }
205.             quietly lincom (`lcb') / `=`whi' + 1'
206.             post `h' (`o') (4) ("bjs") ("avg") (.) (r(estimate)) (r(se)) (.) (`st') (`cf') (`rw') ("ok") ("years 0 
> to +`whi', each counts equally") (.)
207.             post `h' (`o') (4) ("bjs") ("before_check") (.) (.) (.) (.) (.) (.) (.) ("ok") ("joint test of the `=-`
> wlo'' years before the start; p in column p") (`p_bjs')
208.             capture quietly did_imputation y firm_id year Ei, autosample minn(0)
209.             if !_rc post `h' (`o') (4) ("bjs") ("own_overall") (.) (_b[tau]) (_se[tau]) (.) (.) (.) (e(N)) ("ok") (
> "one average over all starter rows from the start on") (.)
210.         }
211.     }
212. 
.     * ---- (5) de Chaisemartin-D'Haultfoeuille (did_multiplegt_dyn) ----
.     * It numbers periods as they appear in the data, so every calendar year
.     * missing inside a firm's span (the year with no file included) gets an
.     * empty row with the start status filled in (R2-07's fix). Only
.     * never-exporters are comparisons; starters whose year before the start has
.     * no row drop out. "Effect_1" = the start year (year 0), Effect_2 = year +1,
.     * ...; "Placebo_1" = year -2, Placebo_2 = -3, ...
.     local dpl`o' = .
213.     if !`ok_dcdh' {
214.         post `h' (`o') (5) ("dcdh") ("avg") (.) (.) (.) (.) (.) (.) (.) ("unavailable: package not installed (`=str
> trim("`miss_dcdh'")')") ("ssc install did_multiplegt_dyn; ssc install gtools") (.)
215.     }
216.     else {
217.         use `smpo', clear
218.         * Starters with no row from their start year on would look like firms
.         * that never start: leave them out (as the other methods do).
.         bysort firm_id: egen byte has_after = max(!never & year >= gA)
219.         drop if !never & !has_after
220.         keep firm_id year y gA never
221.         tsset firm_id year
222.         tsfill                                          // empty rows for missing years inside each firm's span
223.         bysort firm_id (gA): replace gA = gA[1]
224.         bysort firm_id (never): replace never = never[1]
225.         gen byte D = !never & year >= gA                // start status: on from the start year, stays on
226.         keep firm_id year y D
227.         local ne  = `whi' + 1                           // Effect_1..Effect_`ne' = years 0..+`whi'
228.         local npl = -`wlo' - 1                          // Placebo_1..Placebo_`npl' = years -2..`wlo'
229.         * The package updates itself from the internet in 1 run in 100 unless
.         * told not to. This file never installs or updates anything.
.         * A placebo with no starter or no comparison firm behind it (e.g. year -4
.         * for own electricity, whose 2014 and 2015 are not used) is left empty,
.         * and the package then posts no covariances (or stops). Then ask for fewer
.         * placebos (years -2, -3, ...) until every one asked for is estimated;
.         * the number used is in the CSV note, the notes and the regression table.
.         local npl0 = `npl'
230.         local upd "_no_updates"
231.         local redo 1
232.         while `redo' {
233.             local redo 0
234.             capture quietly did_multiplegt_dyn y firm_id year D, effects(`ne') placebo(`npl') only_never_switchers 
> graph_off `upd'
235.             local rc = _rc
236.             if `rc' == 198 & "`upd'" == "_no_updates" {
237.                 local upd "no_updates"                  // older versions spell the switch-off this way
238.                 local redo 1
239.                 continue
240.             }
241.             if `rc' == 198 | `npl' == 0 continue
242.             if `rc' {                                   // stopped without results: one placebo fewer
243.                 local --npl
244.                 local redo 1
245.                 continue
246.             }
247.             local first0 0                              // first placebo left empty
248.             forvalues l = 1/`npl' {
249.                 if `first0' == 0 & missing(e(Placebo_`l')) local first0 `l'
250.             }
251.             if `first0' > 0 {
252.                 local npl = `first0' - 1
253.                 local redo 1
254.             }
255.         }
256.         local pltxt = cond(`npl' < `npl0', "; only years -2 to `=-1-`npl'' (year `=-2-`npl'' has no starter with th
> e rows it needs)", "")
257.         local dpl`o' = `npl'                            // placebos used (for the notes and tables)
258.         if `rc' == 198 {
259.             post `h' (`o') (5) ("dcdh") ("avg") (.) (.) (.) (.) (.) (.) (.) ("failed: this did_multiplegt_dyn versi
> on cannot switch off its self-update") ("update it once: ssc install did_multiplegt_dyn, replace") (.)
260.         }
261.         else if `rc' {
262.             post `h' (`o') (5) ("dcdh") ("avg") (.) (.) (.) (.) (.) (.) (.) ("failed: did_multiplegt_dyn stopped wi
> th error r(`rc')") ("") (.)
263.         }
264.         else {
265.             local st = e(N_switchers_effect_1)
266.             local rw = e(N_effect_1)
267.             local p_dcdh = e(p_jointplacebo)
268.             forvalues l = 1/`ne' {
269.                 post `h' (`o') (5) ("dcdh") ("event") (`l' - 1) (e(Effect_`l')) (e(se_effect_`l')) (.) (e(N_switche
> rs_effect_`l')) (.) (e(N_effect_`l')) ("ok") ("Effect_`l' (package name) = year `=`l'-1' since the start") (.)
270.             }
271.             forvalues l = 1/`npl' {
272.                 post `h' (`o') (5) ("dcdh") ("event") (-1 - `l') (e(Placebo_`l')) (e(se_placebo_`l')) (.) (e(N_swit
> chers_placebo_`l')) (.) (e(N_placebo_`l')) ("ok") ("Placebo_`l' (package name) = year `=-1-`l'' vs the year before the
>  start") (.)
273.             }
274.             post `h' (`o') (5) ("dcdh") ("own_overall") (.) (e(Av_tot_effect)) (e(se_avg_total_effect)) (.) (.) (.)
>  (e(N_avg_total_effect)) ("ok") ("average total effect: all its effects, weighted by starters behind each") (.)
275.             post `h' (`o') (5) ("dcdh") ("before_check") (.) (.) (.) (.) (.) (.) (.) ("ok") ("joint test of its pla
> cebos (years -2 to `=-1-`npl''`pltxt'); p in column p") (`p_dcdh')
276.             local lcd "Effect_1"
277.             forvalues l = 2/`ne' {
278.                 local lcd "`lcd' + Effect_`l'"
279.             }
280.             capture quietly lincom (`lcd') / `ne'
281.             if !_rc post `h' (`o') (5) ("dcdh") ("avg") (.) (r(estimate)) (r(se)) (.) (`st') (.) (`rw') ("ok") ("ye
> ars 0 to +`whi', each counts equally; starters and rows = those behind year 0") (.)
282.             else    post `h' (`o') (5) ("dcdh") ("avg") (.) (.) (.) (.) (`st') (.) (`rw') ("failed: no covariances 
> in this package version") ("update: ssc install did_multiplegt_dyn, replace") (.)
283.         }
284.     }
285.     timer off 2
286.     quietly timer list 2
287.     display "   [`o'] five methods done (" %5.1f r(t2) " s so far)"
288.     timer on 2
289. }
