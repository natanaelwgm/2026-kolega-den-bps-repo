. display "Step 4/8: gaps between each group and the other firms, with `reps' random redraws"
Step 4/8: gaps between each group and the other firms, with 999 random redraws

. *---------------------------------------------------------------------------
. * Gap (1) = group's median as % of the other firms' median (100 = same).
. * Gap (2), (3) = group minus other firms, in percentage points (0 = same).
. * The 95% range: redraw each year's firms at random within each group (bootstrap, percentile).
. capture program drop r107gap

. program define r107gap, rclass
  1.     args ok1 ok2 ok3
  2.     foreach k in 1 3 {
  3.         if `ok`k'' {
  4.             quietly _pctile m`k' if grp == 1, p(50)
  5.             local a = r(r1)
  6.             quietly _pctile m`k' if grp == 0, p(50)
  7.             local b = r(r1)
  8.             return scalar gap`k' = cond(`k' == 1, 100 * `a' / `b', `a' - `b')
  9.         }
 10.         else return scalar gap`k' = 0
 11.     }
 12.     if `ok2' {
 13.         quietly summarize m2 if grp == 1, meanonly
 14.         local a = r(mean)
 15.         quietly summarize m2 if grp == 0, meanonly
 16.         return scalar gap2 = `a' - r(mean)
 17.     }
 18.     else return scalar gap2 = 0
 19. end

. tempname h

. tempfile gaps

. postfile `h' byte gi int year byte k double(gap gap_lo95 gap_hi95) using `gaps', replace
(file /var/folders/0k/wcj_06q55_gd0c7z2x717jsc0000gn/T//S_30056.00000c not found)

. local i 0

. foreach g of local gvars {
  2.     local ++i
  3.     use `base', clear
  4.     gen byte grp = `g'
  5.     drop if missing(grp)
  6.     levelsof year, local(yrs)
  7.     foreach y of local yrs {
  8.         * a measure's gap is computed only if both groups have at least min_n firms with it
.         local any 0
  9.         forvalues k = 1/3 {
 10.             quietly count if year == `y' & grp == 1 & !missing(m`k')
 11.             local c1 = r(N)
 12.             quietly count if year == `y' & grp == 0 & !missing(m`k')
 13.             local ok`k' = `c1' >= `min_n' & r(N) >= `min_n'
 14.             if `ok`k'' local any 1
 15.         }
 16.         if !`any' continue
 17.         preserve
 18.         quietly keep if year == `y'
 19.         quietly bootstrap gap1 = r(gap1) gap2 = r(gap2) gap3 = r(gap3), reps(`reps') seed(20260925) ///
>             strata(grp) double nodots: r107gap `ok1' `ok2' `ok3'
 20.         matrix b  = e(b)
 21.         quietly estat bootstrap, percentile
 22.         matrix ci = e(ci_percentile)
 23.         forvalues k = 1/3 {
 24.             if `ok`k'' post `h' (`i') (`y') (`k') (b[1,`k']) (ci[1,`k']) (ci[2,`k'])
 25.         }
 26.         restore
 27.     }
 28.     display "   `g': gaps done"
 29. }
