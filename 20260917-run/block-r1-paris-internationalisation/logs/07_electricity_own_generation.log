. * For the log (and INDEX): average gap before Paris (drawn years up to 2015) vs 2018
. display "   average gap in drawn years before Paris vs in 2018 (ratio gaps averaged in logs):"
   average gap in drawn years before Paris vs in 2018 (ratio gaps averaged in logs):

. forvalues i = 1/3 {
  2.     forvalues k = 1/3 {
  3.         quietly summarize gap if gi == `i' & measure_id == `k' & drawn & year <= 2015
  4.         local pre = r(mean)
  5.         if `k' == 1 {
  6.             tempvar lg
  7.             quietly gen double `lg' = ln(gap) if gi == `i' & measure_id == `k' & drawn & year <= 2015
  8.             quietly summarize `lg'
  9.             local pre = exp(r(mean))
 10.             drop `lg'
 11.         }
 12.         quietly summarize gap if gi == `i' & measure_id == `k' & year == 2018
 13.         display "      " word("`gvars'", `i') ", measure `k': before " %7.1f `pre' "   2018 " %7.1f r(mean)
 14.     }
 15. }
      export_flag, measure 1: before   144.1   2018   111.6
      export_flag, measure 2: before    10.4   2018    22.6
      export_flag, measure 3: before     3.1   2018    -1.3
      import_flag, measure 1: before   119.6   2018    58.6
      import_flag, measure 2: before    28.3   2018    62.4
      import_flag, measure 3: before   -14.1   2018    -8.1
      fdi_10_flag, measure 1: before   141.6   2018   120.2
      fdi_10_flag, measure 2: before     0.3   2018    -4.3
      fdi_10_flag, measure 3: before    13.5   2018    -2.6

. 
. *---------------------------------------------------------------------------
. display "Step 6/8: numbers for the notes (read from the data, never typed)"
Step 6/8: numbers for the notes (read from the data, never typed)

. *---------------------------------------------------------------------------
. * own electricity recorded, % of all firms, in the years left out of (d)-(i)
. use `base', clear
(G0 -> G0.25 OBSCURED -> G0.5 DUMMY PANEL -> G1 RE-ESTIMATED)

. collapse (mean) rec, by(year)

. quietly summarize rec if rec < `og_min' / 100

. local rec_lo = strtrim(string(100 * r(min), "%4.0f"))

. local rec_hi = strtrim(string(100 * r(max), "%4.0f"))

. levelsof year if rec < `og_min' / 100, local(lowyrs)
2014 2015

. local ly1 : word 1 of `lowyrs'

. local nly : word count `lowyrs'

. local ly2 : word `nly' of `lowyrs'

. local lowtxt = cond(`nly' > 1, "`ly1'–`ly2'", "`ly1'")

. display "   own electricity recorded for `rec_lo'–`rec_hi'% of firms in `lowtxt'"
   own electricity recorded for 56–60% of firms in 2014–2015

. * the notes mention left-out years only if there are any (on complete records there are none)
. local recrng = cond("`rec_lo'" == "`rec_hi'", "`rec_lo'", "`rec_lo'–`rec_hi'")

. local lowsent ""

. if `nly' > 0 local lowsent "; `lowtxt' left out (recorded for only `recrng'% of firms, mostly those making none)"

. * makers' own share of their electricity, all firms: middle value before vs after Paris,
. * using only the years drawn in (g)-(i) (the low-recorded years above are left out here too)
. use `base', clear
(G0 -> G0.25 OBSCURED -> G0.5 DUMMY PANEL -> G1 RE-ESTIMATED)

. gen byte lowyr = 0

. foreach y of local lowyrs {
  2.     quietly replace lowyr = 1 if year == `y'
  3. }

. quietly summarize year if year > 2016

. local post1 = r(min)                                  // first annual file after the 2016 gap

. quietly summarize m3 if year < 2016 & !lowyr, detail

. local own_pre = strtrim(string(r(p50), "%4.0f"))

. quietly summarize m3 if year > 2016 & !lowyr, detail

. local own_post = strtrim(string(r(p50), "%4.0f"))

. display "   makers' own share of their electricity (all makers): `own_pre'% before Paris, `own_post'% after"
   makers' own share of their electricity (all makers): 22% before Paris, 4% after

. * firms with no export answer, first file after the gap: share of importers, and how often
. * they make their own electricity (they are left out of the exporter panels, not the others)
. quietly count if year == `post1' & import_flag == 1

. local nimp = r(N)

. quietly count if year == `post1' & import_flag == 1 & missing(export_flag)

. local imp_unk = strtrim(string(100 * r(N) / `nimp', "%4.0f"))

. quietly summarize m2 if year == `post1' & missing(export_flag)

. local unk_mk = strtrim(string(r(mean), "%4.0f"))

. quietly summarize m2 if year == `post1' & !missing(export_flag)

. local kn_mk = strtrim(string(r(mean), "%4.0f"))

. display "   `post1': `imp_unk'% of importers have no export answer; `unk_mk'% of such firms make own electricity, `kn_
> mk'% of firms with an answer"
   2017: 90% of importers have no export answer; 77% of such firms make own electricity, 14% of firms with an answer

. 
. *---------------------------------------------------------------------------
. display "Step 7/8: draw three rows of three panels, then combine"
Step 7/8: draw three rows of three panels, then combine

. *---------------------------------------------------------------------------
. * Each row is one plain twoway: the three groups sit side by side, shifted by `sh' years
. * (graph combine handles plain graphs better than by() graphs; same method as R3-06).
. local sh = 17

. local ytl1 "thousand kWh"

. local ytl2 "% of firms"

. local ytl3 "% of electricity used"

. local row1 "Bought electricity: thousand kWh per million of value added, middle firm"

. local row2 "Firms making some of their own electricity, % of firms"

. local row3 "Own electricity as % of the electricity used, middle firm among those making some"

. local letters "a b c d e f g h i"

. forvalues r = 1/3 {
  2.     use `table', clear
  3.     keep if measure_id == `r'
  4.     keep gi year drawn flagged flag_other value_grp1 value_grp0
  5.     gen double x = year + (gi - 1) * `sh'
  6.     gen double y1  = value_grp1 if drawn & !flagged
  7.     gen double y1f = value_grp1 if drawn & flagged
  8.     gen double y0  = value_grp0 if drawn & !flag_other
  9.     gen double y0f = value_grp0 if drawn & flag_other
 10.     * one empty row after each panel, so no line runs from one panel into the next
.     local n0 = _N
 11.     set obs `=_N + 3'
 12.     forvalues i = 1/3 {
 13.         replace gi = `i' in `=`n0' + `i''
 14.         replace x = 2023.5 + (`i' - 1) * `sh' in `=`n0' + `i''
 15.     }
 16.     * shared scale for the row: a round number above the highest mark
.     egen double pmax = rowmax(y1 y1f y0 y0f)
 17.     quietly summarize pmax
 18.     local top = r(max)
 19.     local mag = 10^floor(log10(`top'))
 20.     local step = cond(`top' / `mag' < 2, `mag' / 5, cond(`top' / `mag' < 5, `mag' / 2, `mag'))
 21.     if `top' / `step' > 5 local step = 2 * `step'        // at most about five steps per axis
 22.     local top = `step' * ceil(1.02 * `top' / `step')
 23.     if `r' == 2 {
 24.         local top 100
 25.         local step 25
 26.     }
 27.     * endpoint labels: first and last drawn year of each line in each panel; higher line above
.     gen double v1 = cond(!missing(y1), y1, y1f)
 28.     gen double v0 = cond(!missing(y0), y0, y0f)
 29.     bysort gi: egen fy = min(cond(!missing(v1), year, .))
 30.     bysort gi: egen ly = max(cond(!missing(v1), year, .))
 31.     gen byte endpt = inlist(year, fy, ly) & !missing(v1)
 32.     local fmt = cond(`r' == 1, "%9.1f", "%9.0f")
 33.     gen str8 l1  = string(y1,  "`fmt'") if endpt & !missing(y1)
 34.     gen str8 l1f = string(y1f, "`fmt'") if endpt & !missing(y1f)
 35.     gen str8 l0  = string(y0,  "`fmt'") if endpt & !missing(y0)
 36.     gen str8 l0f = string(y0f, "`fmt'") if endpt & !missing(y0f)
 37.     gen byte p1 = cond(year == fy, cond(v1 >= v0, 10, 8), cond(v1 >= v0, 2, 4)) if endpt
 38.     gen byte p0 = cond(year == fy, cond(v0 >  v1, 10, 8), cond(v0 >  v1, 2, 4)) if endpt
 39.     sort x
 40.     * per panel: gridlines, 2016 band, Paris line, title, x labels, "not drawn" line
.     local grid ""
 41.     local band ""
 42.     local paris ""
 43.     local txt ""
 44.     local xl ""
 45.     local xm ""
 46.     forvalues i = 1/3 {
 47.         local o = (`i' - 1) * `sh'
 48.         forvalues gv = `step'(`step')`top' {
 49.             local grid `grid' `gv' `=2009.2 + `o'' `gv' `=2022.8 + `o''
 50.         }
 51.         local band  `band' `top' `=2016 + `o'' 0 `=2016 + `o''
 52.         local paris `paris' 0 `=2015.5 + `o'' `top' `=2015.5 + `o''
 53.         local li = (`r' - 1) * 3 + `i'
 54.         local lt : word `li' of `letters'
 55.         local txt `"`txt' text(`=1.13 * `top'' `=2008.6 + `o'' "(`lt') `g1_`i''", place(e) size(`sm'))"'
 56.         foreach y in 2010 2013 2016 2019 2022 {
 57.             local xl `"`xl' `=`y' + `o'' "`y'""'
 58.         }
 59.         * years with an annual file that this panel does not draw, listed under its axis
.         quietly levelsof year if gi == `i' & !drawn & year != 2016 & !missing(year), local(nd)
 60.         if "`nd'" != "" {
 61.             local ndt ""
 62.             local start ""
 63.             local prev ""
 64.             foreach y of local nd {
 65.                 if "`prev'" == "" local start `y'
 66.                 else if `y' != `prev' + 1 {
 67.                     local run = cond(`start' == `prev', "`start'", "`start'–`prev'")
 68.                     local ndt = cond("`ndt'" == "", "`run'", "`ndt', `run'")
 69.                     local start `y'
 70.                 }
 71.                 local prev `y'
 72.             }
 73.             local run = cond(`start' == `prev', "`start'", "`start'–`prev'")
 74.             local ndt = cond("`ndt'" == "", "`run'", "`ndt', `run'")
 75.             local xm `"`xm' `=2016 + `o'' "Not drawn: `ndt'""'
 76.         }
 77.     }
 78.     if `"`xm'"' != "" local xm `"xmlabel(`xm', noticks tlength(0) labsize(`vs') labcolor(gs6) labgap(15pt))"'
 79.     * flagged layers only where such years exist in this row
.     local fl ""
 80.     local fk ""
 81.     local hasg 0
 82.     quietly count if !missing(y1f)
 83.     if r(N) > 0 {
 84.         local hasg 1
 85.         local fl `"`fl' (connected y1f x, cmissing(n) lcolor(gs8) lpattern(solid) lwidth(0.6pt) msymbol(Oh) msize(4
> .5pt) mcolor(gs8) mlabel(l1f) mlabvposition(p1) mlabsize(`vs') mlabcolor(gs6))"'
 86.         local fk `"`fk' 6 "Records in doubt: the panel's group""'
 87.     }
 88.     quietly count if !missing(y0f)
 89.     if r(N) > 0 {
 90.         local nf = 6 + `hasg'
 91.         local fl `"`fl' (connected y0f x, cmissing(n) lcolor(gs11) lpattern(shortdash) lwidth(0.6pt) msymbol(Sh) ms
> ize(4.5pt) mcolor(gs11) mlabel(l0f) mlabvposition(p0) mlabsize(`vs') mlabcolor(gs9))"'
 92.         local fk `"`fk' `nf' "Records in doubt: other firms""'
 93.     }
 94.     local leg "legend(off)"
 95.     local fys 30
 96.     if `r' == 3 {
 97.         local leg `"legend(order(4 "Exporters, importers or foreign-owned (panel title)" 5 "Other firms whose statu
> s is known" `fk' 3 "Paris Agreement adopted (December 2015)" 2 "No annual file") pos(6) cols(2) region(lcolor(none)) s
> ize(`vs') symxsize(8) keygap(1) colgap(4) rowgap(0.3))"'
 98.         local fys 47
 99.     }
100.     twoway (pci `grid', lcolor(gs15) lwidth(vthin)) ///
>         (pci `band', lcolor(gs14) lwidth(9pt)) ///
>         (pci `paris', lcolor(gs4) lpattern(shortdash) lwidth(0.5pt)) ///
>         (connected y1 x, cmissing(n) lcolor(black) lpattern(solid) lwidth(0.8pt) msymbol(O) msize(4.5pt) mcolor(black)
>  ///
>             mlabel(l1) mlabvposition(p1) mlabsize(`vs') mlabcolor(black)) ///
>         (connected y0 x, cmissing(n) lcolor(gs6) lpattern(shortdash) lwidth(0.8pt) msymbol(Sh) msize(4.5pt) mcolor(gs6
> ) ///
>             mlabel(l0) mlabvposition(p0) mlabsize(`vs') mlabcolor(gs6)) ///
>         `fl', ///
>         `txt' ///
>         subtitle("`row`r''", size(`sm') pos(11) nobox) ///
>         ytitle("`ytl`r''", size(`vs')) ///
>         ylabel(0(`step')`top', angle(0) noticks tlength(0) nogrid labsize(`vs') format(%9.0f)) ///
>         yscale(noline range(0 `=1.18 * `top'')) ///
