 20.                 quietly by year: egen double _sw  = total(cond(t == 0 & _m, _w, 0))
 21.                 quietly by year: egen double _sw2 = total(cond(t == 0 & _m, _w^2, 0))
 22.                 quietly by year: egen double _swl = total(cond(t == 0 & _m, _w * lw, 0))
 23.                 quietly by year: egen double _sl1 = total(cond(t == 1 & _m, lw, 0))
 24.                 quietly by year: egen double _slg = total(cond(t == 1 & _in, lw, 0))
 25.                 quietly by year: egen double _slo = total(cond(t == 0 & _in, lw, 0))
 26.                 quietly replace _ne = _sw^2 / _sw2            // effective number of other firms
 27.                 quietly replace _wg = exp(_slg / _k1)         // typical (geometric-mean) workers: all group firms
 28.                 quietly replace _wa = exp(_slo / _k0)         // ... all other firms
 29.                 quietly replace _w1 = exp(_sl1 / _m1)         // ... matched group firms
 30.                 quietly replace _w0 = exp(_swl / _sw)         // ... their similar firms (weighted)
 31.                 drop _w _sw _sw2 _swl _sl1 _slg _slo
 32.             }
 33.             preserve
 34.             quietly collapse (first) _gap _k1 _k0 _m1 _m0 _mc _ne _wg _wa _w1 _w0, by(year)
 35.             forvalues i = 1/`=_N' {
 36.                 * a gap is kept only if both kinds of firm reach min_n after matching
