>         n_energy_scope2_pos = energy_scope2_pos n_co2_total_pos = co2_total_pos ///
>         n_co2_scope1_pos = co2_scope1_pos n_co2_scope2_pos = co2_scope2_pos ///
>         n_selfgen_known = selfgen_known n_selfgen_pos = selfgen_pos, by(year status_code)
 13.     * Make sure all three status rows exist for every year (an empty group shows as 0).
.     tempfile col
 14.     save `col'
 15.     clear
 16.     local ny : word count `yrs'
 17.     set obs `=3 * `ny''
 18.     gen int year = real(word("`yrs'", ceil(_n / 3)))
 19.     gen byte status_code = cond(mod(_n, 3) == 1, 1, cond(mod(_n, 3) == 2, 0, 9))
 20.     merge 1:1 year status_code using `col', nogenerate
 21.     foreach c of varlist n_* {
 22.         replace `c' = 0 if missing(`c')
 23.     }
 24.     gen str13 measure = "`m'"
 25.     if !`first' append using `cells'
 26.     save `cells', replace
 27.     local first 0
 28. }
