. local first 1

. foreach m in export_any export_direct import fdi_any fdi_10 {
  2.     use `base', clear
  3.     if "`m'" == "export_any"    local v export_flag
  4.     if "`m'" == "export_direct" local v export_direct_flag
  5.     if "`m'" == "import"        local v import_flag
  6.     if "`m'" == "fdi_any"       local v fdi_any_flag
  7.     if "`m'" == "fdi_10"        local v fdi_10_flag
