. isid firm_id year

. assert year != 2016

. assert inlist(export_flag, 0, 1, .) & inlist(import_flag, 0, 1, .) & inlist(fdi_10_flag, 0, 1, .)

. local base_in = subinstr("`base_yrs'", " ", ",", .)

