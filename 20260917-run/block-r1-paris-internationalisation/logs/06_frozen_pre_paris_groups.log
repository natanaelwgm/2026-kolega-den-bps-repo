. 
. * program: from firm-year data in memory (fz, year, o1-o3), each frozen group's yearly
. * median, as % of the average of its base-year medians; posts the group-minus-other difference and the group counts
. capture program drop r106diff

. program define r106diff
  1.     args h rep baseyrs minn
  2.     quietly {
  3.         collapse (p50) o1 o2 o3 (count) c1 = o1 c2 = o2 c3 = o3, by(fz year)
  4.         gen byte isb = 0
  5.         foreach y of local baseyrs {
  6.             replace isb = 1 if year == `y'
  7.         }
  8.         forvalues k = 1/3 {
  9.             replace o`k' = . if c`k' < `minn'
 10.             bysort fz: egen double b`k' = mean(cond(isb, o`k', .))
 11.             gen double ix`k' = 100 * o`k' / b`k'
 12.         }
 13.         sort year fz
 14.         forvalues k = 1/3 {
 15.             by year: gen double d`k' = ix`k'[_N] - ix`k'[1] if _N == 2
 16.         }
 17.         keep if fz == 1
 18.         forvalues i = 1/`=_N' {
 19.             post `h' (`rep') (year[`i']) (d1[`i']) (d2[`i']) (d3[`i']) (c1[`i']) (c2[`i']) (c3[`i'])
 20.         }
 21.     }
 22. end

. 
. display "Step 4/8: yearly medians, indices and differences per grouping, with `reps' redraws"
Step 4/8: yearly medians, indices and differences per grouping, with 999 redraws

. local groupings "export_flag import_flag fdi_10_flag"

. local gi 0

. foreach g of local groupings {
  2.     local ++gi
  3.     use `basedata', clear
  4.     keep if !missing(fz_`g')              // frozen firms only (all years of each)
  5.     gen byte fz = fz_`g'
  6.     gen byte cur = `g'                    // the firm's answer in the current year (table only)
  7.     * (1) point values
.     preserve
  8.     collapse (count) obs = one n1 = o1 n2 = o2 n3 = o3 wn1 = w1 wn2 = w2 wn3 = w3 curn = cur ///
>              (p50) o1 o2 o3 w1 w2 w3 (mean) cur dbt, by(fz year)
  9.     gen byte isb = inlist(year, `base_in')
 10.     forvalues k = 1/3 {
 11.         replace o`k' = . if n`k' < `min_n'
 12.         replace w`k' = . if wn`k' < `min_n'
 13.         bysort fz: egen double b`k' = mean(cond(isb, o`k', .))
 14.         gen double ix`k' = 100 * o`k' / b`k'
 15.     }
 16.     drop isb
 17.     reshape wide obs n1 n2 n3 wn1 wn2 wn3 curn o1 o2 o3 w1 w2 w3 cur dbt b1 b2 b3 ix1 ix2 ix3, i(year) j(fz)
 18.     gen str12 grouping = "`g'"
 19.     tempfile pt`gi'
 20.     save `pt`gi''
 21.     restore
 22.     * (2) redraws: whole firms (all their years) drawn with replacement within each frozen group
.     keep if cs
 23.     gen byte fzs = fzs_`g'
 24.     keep firm_id year fz fzs o1 o2 o3
 25.     tempfile bdata
 26.     save `bdata'
 27.     * (3) the same for the stricter check: mixed firms left out of the group
.     keep if !missing(fzs)
 28.     replace fz = fzs
 29.     tempfile sdata
 30.     save `sdata'
 31.     foreach set in main strict {
 32.         local src = cond("`set'" == "main", "`bdata'", "`sdata'")
 33.         local pf  = cond("`set'" == "main", "bs", "ss")
 34.         quietly use `src', clear
 35.         tempname h
 36.         tempfile `pf'`gi'
 37.         postfile `h' int rep int year double(d1 d2 d3) long(c1 c2 c3) using ``pf'`gi'', replace
 38.         r106diff `h' 0 "`base_yrs'" `min_n'
 39.         display "   `g' (`set' groups): redrawing firms `reps' times"
 40.         set seed 20260925
 41.         forvalues r = 1/`reps' {
 42.             quietly use `src', clear     // quietly: otherwise the data label fills the log
 43.             bsample, cluster(firm_id) strata(fz)
 44.             r106diff `h' `r' "`base_yrs'" `min_n'
 45.             if mod(`r', 250) == 0 display "      `r' of `reps' done"
 46.         }
 47.         postclose `h'
 48.         use ``pf'`gi'', clear
 49.         gen str12 grouping = "`g'"
 50.         save ``pf'`gi'', replace
 51.     }
 52. }
