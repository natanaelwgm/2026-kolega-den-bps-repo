. display "Step 5/8: 95% ranges of the differences (middle 95% of the redrawn values)"
Step 5/8: 95% ranges of the differences (middle 95% of the redrawn values)

. foreach pf in bs ss {
  2.     use ``pf'1', clear
  3.     append using ``pf'2' ``pf'3'
  4.     tempfile allbs
  5.     save `allbs'
  6.     keep if rep >= 1
  7.     forvalues k = 1/3 {
  8.         egen double d`k'_lo95 = pctile(d`k'), by(grouping year) p(2.5)
  9.         egen double d`k'_hi95 = pctile(d`k'), by(grouping year) p(97.5)
 10.     }
 11.     bysort grouping year (rep): keep if _n == 1
 12.     keep grouping year d*_lo95 d*_hi95
 13.     tempfile ci
 14.     save `ci'
 15.     use `allbs', clear
 16.     keep if rep == 0
 17.     keep grouping year d1 d2 d3 c1 c2 c3
 18.     merge 1:1 grouping year using `ci', nogenerate keep(master match)
 19.     if "`pf'" == "ss" {
 20.         * stricter check: prefix s (sd = difference, sn = firms in the stricter group with the outcome)
.         rename (d1 d2 d3 d1_lo95 d2_lo95 d3_lo95 d1_hi95 d2_hi95 d3_hi95 c1 c2 c3) ///
>                (sd1 sd2 sd3 sd1_lo95 sd2_lo95 sd3_lo95 sd1_hi95 sd2_hi95 sd3_hi95 sn1 sn2 sn3)
 21.     }
 22.     else drop c1 c2 c3
 23.     tempfile dd_`pf'
 24.     save `dd_`pf''
 25. }
