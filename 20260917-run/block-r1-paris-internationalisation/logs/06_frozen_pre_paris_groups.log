. display "   CHECK ON REAL DATA: skip_yrs (`skip_yrs') and flag_yrs (`flag_yrs') were chosen on the development files (
> see the far above / far below list in Step 3); confirm those years still look wrong before publishing"
   CHECK ON REAL DATA: skip_yrs (2017) and flag_yrs (2019 2020 2021 2022) were chosen on the development files (see the 
> far above / far below list in Step 3); confirm those years still look wrong before publishing

. 
. display "Step 7/8: draw: one row per grouping (exporters, importers, foreign-owned), energy left, CO2 right, one share
> d scale"
Step 7/8: draw: one row per grouping (exporters, importers, foreign-owned), energy left, CO2 right, one shared scale

. * numbers for the notes, read from the table (never typed)
. local attr ""

. foreach g in export_flag import_flag fdi_10_flag {
  2.     quietly summarize obs_g1 if grouping == "`g'" & year == `post_yr' & outcome_id == 1
  3.     local o = r(mean)
  4.     quietly summarize firms_g1 if grouping == "`g'" & outcome_id == 1
  5.     local f = r(mean)
  6.     * share of the group still recorded as in it that year (of those with a known answer)
.     quietly summarize share_flag_now_g1 if grouping == "`g'" & year == `post_yr' & outcome_id == 1
  7.     local sh = r(mean)
  8.     local nm = cond("`g'" == "export_flag", "exporters", cond("`g'" == "import_flag", "importers", "foreign-owned")
> )
  9.     local st = cond("`g'" == "export_flag", "exporting", cond("`g'" == "import_flag", "importing", "foreign-owned")
> )
 10.     quietly summarize known_now_g1 if grouping == "`g'" & year == `post_yr' & outcome_id == 1
 11.     local ans = cond(r(mean) < `o', " of those answering", "")      // some records give no answer that year
 12.     local attr "`attr'; `nm' `=string(`o', "%9.0fc")' of `=string(`f', "%9.0fc")' (`=string(`sh', "%9.0f")'%`ans' s
> till `st')"
 13. }

. local attr = substr("`attr'", 3, .)

. * stricter check for the notes: panels whose printed difference is clear once mixed firms are left out
. local sclr ""

. foreach p in 1 2 3 4 5 6 {
  2.     local gg = ceil(`p' / 2)
  3.     local oo = 2 - mod(`p', 2)
  4.     quietly count if gi == `gg' & outcome_id == `oo' & year == `post_yr' & sclear == 1
  5.     if r(N) > 0 local sclr "`sclr' (`=word("a b c d e f", `p')')"
  6. }

. local sclr = strtrim("`sclr'")

. local nw : word count `sclr'

. if `nw' > 1 local sclr = subinstr("`sclr'", " " + word("`sclr'", `nw'), " and " + word("`sclr'", `nw'), 1)

. if "`sclr'" == "" local stxt "it is clear in no panel"

. else local stxt = "it is clear in " + cond(`nw' == 1, "panel ", "panels ") + "`sclr'"

. * the base years as text, "2013–14" style (first year, en dash, last two digits of the last year)
. local nb : word count `base_yrs'

. local b1 : word 1 of `base_yrs'

. local bl : word `nb' of `base_yrs'

. local base_txt = cond(`nb' == 1, "`b1'", "`b1'–" + substr("`bl'", 3, 2))

