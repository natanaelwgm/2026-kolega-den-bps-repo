> /
>         xmtick(`xlo'(50)`xhi', noticks tlength(0) grid glcolor(gs15) glwidth(vthin)) ///
>         xtitle("Change from `base_txt': group minus similar firms, % (electricity rows: points)", size(vsmall)) ///
