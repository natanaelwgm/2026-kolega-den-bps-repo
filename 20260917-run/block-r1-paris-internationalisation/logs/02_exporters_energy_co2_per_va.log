. bysort panel: egen fy = min(cond(drawn, year, .))

. bysort panel: egen ly = max(cond(drawn, year, .))

. gen byte endpt = drawn & inlist(year, fy, ly)

. gen str8 l1 = string(y1, cond(panel == 1, "%9.0f", "%9.1f")) if endpt & inlist(panel, 1, 2)
