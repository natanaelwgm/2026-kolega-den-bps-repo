. display "Step 5/10: weights: other firms made to match each group's 2013-14 averages, and the balance check"
Step 5/10: weights: other firms made to match each group's 2013-14 averages, and the balance check

. * Three sets of weights per grouping:
. *   m  = main: match the group's averages of the seven measures, industry shares and island shares;
. *   sd = check: also match the spreads of the five measures m1-m5 (their squared distance from
. *        the group's average);
. *   st = the stricter group (flagged in every known 2013-14 year), main measures;
. *   s18 = check: main measures, balanced only among the firms also recorded in the drawn later
. *        year (only they carry the drawn comparison, and the main weights need not balance them).
. * Group firms keep weight 1; the other firms' weights add up to the number of group firms.
. tempname hb

. tempfile balance

. postfile `hb' str12 grouping str3 weights str14 measure double(mean_g mean_o mean_ow sd_pool ///
>     std_before std_after vratio_before vratio_after) long(firms_g1 firms_g0 drop_g1 drop_g0 ///
>     drop_nomeas iter) double(worth_g0 wmax_ratio gap_max) byte balanced using `balance', replace
(file /var/folders/0k/wcj_06q55_gd0c7z2x717jsc0000gn/T//S_35532.000005 not found)

. local wfiles ""

. foreach g in export_flag import_flag fdi_10_flag {
  2.     foreach wv in m sd st s18 {
  3.         use `firmdata', clear
  4.         local G = cond("`wv'" == "st", "fzs_`g'", "fz_`g'")
  5.         keep if !missing(`G')                       // frozen firms of this grouping
  6.         if "`wv'" == "s18" keep if h18 == 1         // check: only firms also recorded in the drawn later year
  7.         quietly count if missing(m1) | missing(ind, island)
  8.         local dnm = r(N)                            // no usable 2013-14 record (or no industry or
  9.         drop if missing(m1) | missing(ind, island)  // province code): cannot be balanced
 10.         gen byte t  = `G'
 11.         gen byte t0 = 1 - t
 12.         * an industry or island with firms of only one kind cannot be balanced: its firms are left out
.         bysort ind: egen long n1i = total(t)
 13.         bysort ind: egen long n0i = total(t0)
 14.         bysort island: egen long n1r = total(t)
 15.         bysort island: egen long n0r = total(t0)
 16.         gen byte off = n1i == 0 | n0i == 0 | n1r == 0 | n0r == 0
 17.         quietly count if off & t == 1
 18.         local d1 = r(N)
 19.         quietly count if off & t == 0
 20.         local d0 = r(N)
 21.         drop if off
 22.         quietly count if t == 1
 23.         local n1 = r(N)
 24.         quietly count if t == 0
 25.         local n0 = r(N)
 26.         * industry and island shares as 0/100 columns; one category of each is left out (shares add to 100)
.         quietly tab ind, gen(I_)
 27.         quietly tab island, gen(R_)
 28.         foreach v of varlist I_* R_* {
 29.             quietly replace `v' = 100 * `v'
 30.         }
 31.         drop I_1 R_1
 32.         local X "m1 m2 m3 m4 m5 m6 m7 I_* R_*"
 33.         if "`wv'" == "sd" {
 34.             forvalues j = 1/5 {
 35.                 quietly summarize m`j' if t == 1
 36.                 gen double v`j' = (m`j' - r(mean))^2
 37.             }
 38.             local X "`X' v1-v5"
 39.         }
 40.         unab X : `X'
 41.         * a measure that is the same for every other firm cannot be moved by weights: left out of the
.         * targets here; the balance check below still tests it
.         local XX ""
 42.         foreach v of local X {
 43.             quietly summarize `v' if t == 0
 44.             if r(sd) > 0 local XX "`XX' `v'"
 45.         }
 46.         mata: r110w = r110eb(st_data(., "`XX'", "t0"), mean(st_data(., "`XX'", "t")), `eb_tol', `eb_maxit')
 47.         gen double w = 1 if t == 1
 48.         mata: st_store(., "w", "t0", r110w * `n1')
 49.         local it  = scalar(r110_iter)
 50.         local gap = scalar(r110_gap)
 51.         * what the weighted other firms are worth: as many equally weighted firms as (sum w)^2 / sum w^2
.         gen double w2 = w^2
 52.         quietly summarize w if t == 0
 53.         local sw = r(sum)
 54.         local wmr = r(max) / r(mean)                // largest weight / average weight
 55.         quietly summarize w2 if t == 0
 56.         local worth = `sw'^2 / r(sum)
 57.         * balance check on every target (asserted below): weighted gap in spreads
.         local bal = `gap' < `eb_tol'
 58.         foreach v of local X {
 59.             quietly summarize `v' if t == 1
 60.             local mg = r(mean)
 61.             local vg = r(Var)
 62.             quietly summarize `v' if t == 0
 63.             local vo = r(Var)
 64.             quietly summarize `v' [aw = w] if t == 0
 65.             if abs(`mg' - r(mean)) > 1e-5 * sqrt((`vg' + `vo') / 2) local bal 0
 66.         }
 67.         display "   `g' (`wv'): `n1' in group, `n0' others, worth " %6.1f `worth' ///
>             "; steps `it'; balanced: " cond(`bal', "yes", "NO")
 68.         if !`bal' {
 69.             display as error "   balance NOT reached for `g' (`wv'): its reweighted rows are left empty"
 70.             replace w = .
 71.         }
 72.         * the table: every measure, each industry and island, before and after weighting
.         quietly levelsof ind, local(inds)
 73.         foreach l of local inds {
