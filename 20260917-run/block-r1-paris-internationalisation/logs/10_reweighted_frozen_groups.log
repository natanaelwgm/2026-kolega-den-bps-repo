. foreach g in export_flag import_flag fdi_10_flag {
  2.     display "   `g': 19 outcomes x 7 versions + 2 yearly"
  3.     use `basedata', clear
  4.     keep if !missing(wm_`g') | !missing(wst_`g')     // firms in a balancing sample of this grouping
  5.     foreach v of local versions {
  6.         capture drop X gcnt wreg wreg2 t_*
  7.         local wv = cond(inlist("`v'", "unw_st", "eb_st"), "st", cond("`v'" == "eb_sd", "sd", cond("`v'" == "eb_s18"
> , "s18", "m")))
  8.         if "`wv'" == "st" gen double X = fzs_`g'
  9.         else gen double X = fz_`g'
 10.         gen byte gcnt = X                              // who counts as "the group" for the counts
 11.         * the weight each row gets (1 = not reweighted); rows without a weight are not used
.         gen double wreg = cond(substr("`v'", 1, 3) == "unw", 1, w`wv'_`g') if !missing(w`wv'_`g')
 12.         gen double wreg2 = wreg^2
 13.         local wexp = cond(substr("`v'", 1, 3) == "unw", "", "[pw = wreg]")
 14.         local ab "`fe2'"
 15.         if "`v'" == "eb_fe1" local ab "`fe1'"
 16.         if "`v'" == "eb_yearly" {
 17.             local terms ""
 18.             foreach y of local allyrs {
 19.                 if !inlist(`y', `base_in') {
 20.                     gen double t_e`y' = X * (year == `y')
 21.                     local terms "`terms' t_e`y'"
 22.                 }
 23.             }
 24.             local ks "3 6"
 25.         }
 26.         else {
 27.             foreach p in pre trans jump post doubt {
 28.                 gen double t_`p' = X * p_`p'
 29.             }
 30.             local terms "t_pre t_trans t_jump t_post t_doubt"
 31.             local ks "`ylist'"
 32.         }
 33.         quietly count if !missing(wreg, X)
 34.         local nuse = r(N)
 35.         foreach k of local ks {
 36.             capture drop es
 37.             if `nuse' > 0 {
 38.                 quietly reghdfe y`k' `terms' if !missing(wreg, X) `wexp', absorb(`ab') vce(cluster firm_id)
 39.                 gen byte es = e(sample)
 40.                 local N  = e(N)
 41.                 local G  = e(N_clust)
 42.                 local df = e(df_r)
 43.                 local S  = e(num_singletons)
 44.                 if "`S'" == "" local S 0
 45.                 r110min "`base_yrs'"
 46.                 local r1 = r(m1)
 47.                 local r0 = r(m0)
 48.                 local re = r(e0)
 49.             }
 50.             foreach t of local terms {
 51.                 local tn = substr("`t'", 3, .)
 52.                 if "`tn'" == "pre"   local tyrs "`pre_yrs'"
 53.                 if "`tn'" == "trans" local tyrs "`trans_yr'"
 54.                 if "`tn'" == "jump"  local tyrs "`jump_yrs'"
 55.                 if "`tn'" == "post"  local tyrs "`post_yr'"
 56.                 if "`tn'" == "doubt" local tyrs "`doubt_yrs'"
 57.                 if substr("`tn'", 1, 1) == "e" local tyrs = substr("`tn'", 2, .)
 58.                 if `nuse' == 0 {
 59.                     * balance not reached: row left empty (said in the note column)
.                     post `P' ("`g'") ("`v'") (`k') ("`tn'") (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.)
 60.                     continue
 61.                 }
 62.                 r110min "`tyrs'"
 63.                 local n1 = r(m1)
 64.                 local n0 = r(m0)
 65.                 local e0 = r(e0)
 66.                 * a period with no rows (e.g. 2015 for own electricity) is dropped by reghdfe: left empty
.                 capture local sechk = _se[`t']
 67.                 if _rc local sechk = .
 68.                 if `sechk' == 0 | missing(`sechk') {
 69.                     post `P' ("`g'") ("`v'") (`k') ("`tn'") (.) (.) (`df') (`N') (`G') (`S') (`n1') (`n0') (`r1') (
> `r0') (`e0') (`re')
 70.                 }
 71.                 else {
 72.                     post `P' ("`g'") ("`v'") (`k') ("`tn'") (_b[`t']) (_se[`t']) (`df') (`N') (`G') (`S') (`n1') (`
> n0') (`r1') (`r0') (`e0') (`re')
 73.                 }
 74.             }
 75.         }
 76.         * row 14 (GJ per tonne of CO2, bought electricity): the same for every firm, no regression
.         if "`v'" != "eb_yearly" {
 77.             foreach tn in pre trans jump post doubt {
 78.                 post `P' ("`g'") ("`v'") (14) ("`tn'") (0) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.)
 79.             }
 80.         }
 81.     }
 82. }
