 95.             local sa = cond(`sdp' > 0, (`mg' - `mow') / `sdp', .)
 96.             local vb = cond(`vo' > 0 & inlist("`v'", "m1", "m2", "m3", "m4", "m5"), `vg' / `vo', .)
 97.             local va = cond(`vow' > 0 & inlist("`v'", "m1", "m2", "m3", "m4", "m5"), `vg' / `vow', .)
 98.             post `hb' ("`g'") ("`wv'") ("`v'") (`mg') (`mo') (`mow') (`sdp') (`sb') (`sa') (`vb') (`va') ///
>                 (`n1') (`n0') (`d1') (`d0') (`dnm') (`it') (`worth') (`wmr') (`gap') (`bal')
 99.         }
100.         * the main weights, checked only among the firms also recorded in the drawn later year (they
.         * carry the drawn comparison; the weights were not asked to balance them): rows "m18"
.         if "`wv'" == "m" & `bal' {
101.             quietly count if t == 1 & h18 == 1
102.             local n1s = r(N)
103.             quietly count if t == 0 & h18 == 1
104.             local n0s = r(N)
105.             quietly summarize w if t == 0 & h18 == 1
106.             local sws = r(sum)
107.             local wmrs = r(max) / r(mean)
108.             quietly summarize w2 if t == 0 & h18 == 1
109.             local worths = `sws'^2 / r(sum)
110.             foreach v of varlist m1 m2 m3 m4 m5 m6 m7 ind_* isl_* {
111.                 quietly summarize `v' if t == 1 & h18 == 1
112.                 local mg = r(mean)
113.                 local vg = r(Var)
114.                 quietly summarize `v' if t == 0 & h18 == 1
115.                 local mo = r(mean)
116.                 local vo = r(Var)
117.                 quietly summarize `v' [aw = w] if t == 0 & h18 == 1
118.                 local mow = r(mean)
119.                 local vow = r(Var)
120.                 local sdp = sqrt((`vg' + `vo') / 2)
121.                 local sb = cond(`sdp' > 0, (`mg' - `mo') / `sdp', .)
122.                 local sa = cond(`sdp' > 0, (`mg' - `mow') / `sdp', .)
123.                 local vb = cond(`vo' > 0 & inlist("`v'", "m1", "m2", "m3", "m4", "m5"), `vg' / `vo', .)
124.                 local va = cond(`vow' > 0 & inlist("`v'", "m1", "m2", "m3", "m4", "m5"), `vg' / `vow', .)
125.                 post `hb' ("`g'") ("m18") ("`v'") (`mg') (`mo') (`mow') (`sdp') (`sb') (`sa') (`vb') (`va') ///
>                     (`n1s') (`n0s') (`d1') (`d0') (`dnm') (`it') (`worths') (`wmrs') (.) (.)
126.             }
127.             display "      of which also recorded in `post_yr': `n1s' in group, `n0s' others, worth " %6.1f `worths
> '
128.         }
129.         keep firm_id w
130.         rename w w`wv'_`g'
131.         tempfile wf_`g'_`wv'
132.         save `wf_`g'_`wv''
133.         local wfiles "`wfiles' `wf_`g'_`wv''"
134.     }
135. }
