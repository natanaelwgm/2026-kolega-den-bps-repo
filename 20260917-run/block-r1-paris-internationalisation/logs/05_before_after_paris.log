file /var/folders/0k/wcj_06q55_gd0c7z2x717jsc0000gn/T//S_21164.000001 saved as .dta format

. 
. * Program: from firm-level data in memory (year, grp, o1-o26) compute each group's yearly
. * median (for o17-o18 the average: they are shares of firms, mostly 0), drop yearly values
. * resting on fewer than min_n firms, average them over the before years and over the after
. * years, and post the % changes. rel = the group's change set against the other firms':
. * (1 + group's change) / (1 + other firms' change) - 1, in %; 0 = both changed by the same %.
. capture program drop r105stat

. program define r105stat
  1.     args h rep preyrs postyrs K minn ogmin
  2.     quietly {
  3.         gen byte per = .
  4.         foreach y of local preyrs {
  5.             replace per = 1 if year == `y'
  6.         }
  7.         foreach y of local postyrs {
  8.             replace per = 2 if year == `y'
  9.         }
 10.         keep if !missing(per)
 11.         local cnt ""
 12.         local med ""
 13.         local all ""
 14.         forvalues k = 1/`K' {
 15.             local cnt "`cnt' c`k' = o`k'"
 16.             local all "`all' o`k'"
 17.             if !inlist(`k', 17, 18) local med "`med' o`k'"
 18.         }
 19.         collapse (p50) `med' (mean) o17 o18 (count) `cnt', by(grp per year)
 20.         forvalues k = 1/`K' {
 21.             replace o`k' = . if c`k' < `minn'
 22.         }
 23.         foreach k in 17 18 {        // own electricity: skip years where too few firms record it
 24.             replace o`k' = . if c`k' < `ogmin' / 100 * c3
 25.         }
 26.         * a year dropped for one group is dropped for the other too, so both use the same years
.         sort per year grp
 27.         forvalues k = 1/`K' {
 28.             by per year: replace o`k' = . if missing(o`k'[1]) | missing(o`k'[_N])
 29.         }
 30.         collapse (mean) `all', by(grp per)
 31.         sort grp per
 32.         assert inlist(_N, 2, 4) & per == 2 - mod(_n, 2)   // rows: (grp, before), (grp, after)
 33.         forvalues k = 1/`K' {
 34.             if _N == 4 {            // rows 1-2 = other firms (grp 0), rows 3-4 = the group (grp 1)
 35.                 local c0 = 100 * (o`k'[2] / o`k'[1] - 1)
 36.                 local c1 = 100 * (o`k'[4] / o`k'[3] - 1)
 37.                 local rr = 100 * ((o`k'[4] / o`k'[3]) / (o`k'[2] / o`k'[1]) - 1)
 38.                 post `h' (`rep') (`k') (o`k'[3]) (o`k'[4]) (`c1') (o`k'[1]) (o`k'[2]) (`c0') (`rr')
 39.             }
 40.             else {                  // all firms: one group
 41.                 local c1 = 100 * (o`k'[2] / o`k'[1] - 1)
 42.                 post `h' (`rep') (`k') (o`k'[1]) (o`k'[2]) (`c1') (.) (.) (.) (.)
 43.             }
 44.         }
 45.     }
 46. end

. 
. display "Step 3/7: yearly group values and counts, every year (for the table)"
Step 3/7: yearly group values and counts, every year (for the table)

. local groupings "all export_flag import_flag fdi_10_flag"

. local i 0

. foreach g of local groupings {
  2.     local ++i
  3.     use `base', clear
  4.     if "`g'" == "all" gen byte grp = 1
  5.     else gen byte grp = `g'
  6.     drop if missing(grp)          // unknown status is left out, never counted as "no"
  7.     local cnt ""
  8.     local med ""
  9.     forvalues k = 1/`K' {
 10.         local cnt "`cnt' n`k' = o`k'"
 11.         if !inlist(`k', 17, 18) local med "`med' o`k'"
 12.     }
 13.     collapse (p50) `med' (mean) o17 o18 (count) `cnt', by(grp year)
 14.     gen byte og_used = n17 >= `og_min' / 100 * n3    // own electricity recorded for enough firms
 15.     gen str12 grouping = "`g'"
 16.     tempfile yr`i'
 17.     save `yr`i''
 18. }
