. display "Step 4/7: before/after changes, the check window, and `reps' random redraws per grouping"
Step 4/7: before/after changes, the check window, and 999 random redraws per grouping

. local pre_in  = subinstr("`pre_yrs'", " ", ",", .)

. local post_in = subinstr("`post_yrs'", " ", ",", .)

. tempname h

. local i 0

. foreach g of local groupings {
  2.     local ++i
  3.     use `base', clear
  4.     if "`g'" == "all" gen byte grp = 1
  5.     else gen byte grp = `g'
  6.     drop if missing(grp)
  7.     keep year grp o1-o`K'
  8.     tempfile gdata bdata pts`i'
  9.     save `gdata'
 10.     if "`g'" == "export_flag" local chk "`chk_export'"
 11.     if "`g'" == "import_flag" local chk "`chk_import'"
 12.     if "`g'" == "fdi_10_flag" local chk "`chk_fdi'"
 13.     if "`g'" == "all"         local chk "`chk_all'"
 14.     local chk_`i' "`chk'"
 15.     postfile `h' int rep int k double(pre1 post1 pct1 pre0 post0 pct0 rel) using `pts`i'', replace
 16.     r105stat `h' 0 "`pre_yrs'" "`post_yrs'" `K' `min_n' `og_min'   // rep 0  = the result
 17.     use `gdata', clear
 18.     r105stat `h' -1 "`pre_yrs'" "`chk'" `K' `min_n' `og_min'       // rep -1 = check window
 19.     use `gdata', clear
 20.     keep if inlist(year, `pre_in', `post_in')
 21.     save `bdata'
 22.     display "   `g': redrawing firms `reps' times"
 23.     set seed 20260925
 24.     forvalues r = 1/`reps' {
 25.         quietly use `bdata', clear     // quietly: otherwise the data label fills the log 999 times
 26.         bsample, strata(year grp)      // redraw firms within each year and group
 27.         r105stat `h' `r' "`pre_yrs'" "`post_yrs'" `K' `min_n' `og_min'
 28.         if mod(`r', 250) == 0 display "      `r' of `reps' done"
 29.     }
 30.     postclose `h'
 31. }
