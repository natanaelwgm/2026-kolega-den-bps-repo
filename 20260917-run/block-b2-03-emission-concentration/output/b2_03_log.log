######## B2-03: 02-06_top_emitter_shares ########

. /*==========================================================================
>   Lines 2-6: "Hitung share total emissions dari:"
>              "Top 1% firms" / "Top 5% firms" / "Top 10% firms" / "Top 20% fir
> ms"
>   Data  : SI 2010-2022 (data/b203_si.dta), clean == 1
>   Method: within each year, plants with CO2 > 0 are ranked from largest to
>           smallest emitter. The top p% = the first ceil(n x p / 100) plants.
>           Share = CO2 of the top p% / CO2 of all plants with CO2 > 0, in %.
>           Pool = the yearly top groups added up over all years.
>   Output sheets:
>     t02_06_top_shares   n plants, size of each top group and its % of total
>                         CO2, pool + by year (clean sample)
>     t02_06_all_records  the same without the outlier filter (clean 0 and 1),
>                         to show how much the 30 outlier records change it
>   Output data:
>     data/b203_ranked.dta  every clean plant-year with its emission rank and
>                           top-group flags (used by lines 7 and 10)
> 
>   NOTE: the unit is the plant-year (firm links in the development data are
>   fictional). CO2 = scope 1 (diesel, petrol, coal, LPG) + scope 2.
> ==========================================================================*/
. if "$B203" == "" {
.     display as error "Run 00_run.do first (it sets the paths)."
.     exit 198
. }

. 
. * ---- the ranking, saved for lines 7 and 10 ----
. use "$B203_DATA/b203_si.dta", clear
(G0 -> G0.25 OBSCURED -> G0.5 DUMMY PANEL -> G1 RE-ESTIMATED)

. keep if clean == 1
(30 observations deleted)

. generate emitter = (co2_total > 0 & !missing(co2_total))

. * largest emitter first; plants with no CO2 come after the emitters
. gsort year -emitter -co2_total

. by year: generate rank = _n if emitter == 1
(547 missing values generated)

. bysort year: egen n_emitters = total(emitter)

. foreach p in 1 5 10 20 {
  2.     generate top`p' = (rank <= ceil(n_emitters * `p' / 100)) if emitter ==
>  1
  3.     replace  top`p' = 0 if emitter == 0
  4. }
(547 missing values generated)
(547 real changes made)
(547 missing values generated)
(547 real changes made)
(547 missing values generated)
(547 real changes made)
(547 missing values generated)
(547 real changes made)

. label variable rank       "Emission rank within the year (1 = largest emitter
> )"

. label variable n_emitters "Plants with CO2 > 0 in the year"

. label variable top1       "1 = in the top 1% of emitters of the year"

. save "$B203_DATA/b203_ranked.dta", replace
(file
    /private/tmp/claude-501/sp/pr-worktree/20260917-run/block-b2-03-emission-
    > concentration/data/b203_ranked.dta not found)
file
    /private/tmp/claude-501/sp/pr-worktree/20260917-run/block-b2-03-emission-
    > concentration/data/b203_ranked.dta saved

. 
. * ---- shares: clean sample, then all records ----
. foreach sample in clean all {
  2.     use "$B203_DATA/b203_si.dta", clear
  3.     if "`sample'" == "clean" keep if clean == 1
  4.     keep if co2_total > 0 & !missing(co2_total)
  5.     gsort year -co2_total
  6.     by year: generate rank = _n
  7.     by year: generate n = _N
  8.     generate n_plants = 1
  9.     foreach p in 1 5 10 20 {
 10.         generate n_top`p'   = (rank <= ceil(n * `p' / 100))
 11.         generate co2_top`p' = co2_total * n_top`p'
 12.     }
 13.     expand 2, generate(copy)              // copy of every row with year =
>  0 for "pool"
 14.     replace year = 0 if copy == 1
 15.     collapse (sum) n_plants n_top1 n_top5 n_top10 n_top20 co2_total ///
>              co2_top1 co2_top5 co2_top10 co2_top20, by(year)
 16.     foreach p in 1 5 10 20 {
 17.         generate share_top`p' = 100 * co2_top`p' / co2_total
 18.     }
 19.     generate period = cond(year == 0, "pool", string(year))
 20.     order period n_plants n_top1 n_top5 n_top10 n_top20 share_top1 share_t
> op5 share_top10 share_top20 co2_total
 21.     keep  period n_plants n_top1 n_top5 n_top10 n_top20 share_top1 share_t
> op5 share_top10 share_top20 co2_total
 22.     if "`sample'" == "clean" {
 23.         list period n_plants n_top1 share_top1 share_top5 share_top10 shar
> e_top20, clean noobs
 24.         export excel using "$B203_XLSX", sheet("t02_06_top_shares", replac
> e) firstrow(variables)
 25.     }
 26.     else export excel using "$B203_XLSX", sheet("t02_06_all_records", repl
> ace) firstrow(variables)
 27. }
