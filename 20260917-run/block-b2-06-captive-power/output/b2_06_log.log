. * ---- (b) output change around the 2020 shock ----
. * loop: base year 2018 (normal year) and 2019 (shock year follows)
. tempfile next result

. local first 1

. foreach b in 2018 2019 {
  2.     * output in the following year
.     use "$B206_DATA/b206_si.dta", clear
  3.     keep if year == `b' + 1 & clean == 1 & output > 0 & !missing(output)
  4.     keep firm_id output
  5.     rename output output_next
  6.     save `next', replace
  7. 
.     * base year: own-generation status and output
.     use "$B206_DATA/b206_si.dta", clear
  8.     keep if year == `b' & clean == 1 & !missing(has_owngen) & output > 0 &
>  !missing(output)
  9.     keep firm_id has_owngen output
 10.     merge 1:1 firm_id using `next', keep(master match)
 11.     generate linked   = (_merge == 3)
 12.     generate dln_out  = ln(output_next) - ln(output) if linked == 1
 13.     generate out_fell = (output_next < output) if linked == 1
 14.     generate n_firms  = 1
 15.     collapse (sum) n_firms n_linked = linked ///
>              (p50) med_dln_output = dln_out (mean) mean_dln_output = dln_out 
> pct_output_fell = out_fell, ///
>              by(has_owngen)
 16.     replace pct_output_fell = 100 * pct_output_fell
 17.     generate change = "`b'-" + string(`b' + 1)
 18.     if `first' == 0 append using `result'
 19.     save `result', replace
 20.     local first 0
 21. }
