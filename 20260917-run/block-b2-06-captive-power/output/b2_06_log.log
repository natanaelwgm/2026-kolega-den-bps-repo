######## B2-06: 09_resilience ########

. /*==========================================================================
>   Line 9: "pertanyaan: aapakah self generation terutama merupakan resilience
>            strategy?"
>   Data  : SI 2010-2022 (data/b206_si.dta), clean == 1
>   Two simple, DESCRIPTIVE tests (not causal; nothing in the data records why 
> a
>   firm generates, and there is no outage or tariff variable):
>   (a) Grid reliability. The grid is weaker outside Java. If self generation i
> s
>       mainly insurance against a bad grid, the own-generation rate (and the
>       own share of electricity) should be much higher outside Java.
>         t09a_by_java      Java vs outside Java, pool + by year
>         t09a_by_province  per province (with java flag), pool + by year
>   (b) Shock performance. If own power protects production, own-generators
>       should lose less output in the 2020 shock. Firms present in both years,
>       own-generation status in the BASE year, change = ln(output t+1) -
>       ln(output t). 2018->2019 is shown as a normal-year benchmark.
>         t09b_output_change  by own-generation status and period
>   Read together with t06_share_bands: most own-generators make <10% of their
>   power (standby-like) -> consistent with back-up / resilience use.
>   NOTE (b): firm links are FICTIONAL in the development data, so (b) only
>   means something on the real BPS data. Output is nominal and masked.
> ==========================================================================*/
. if "$B206" == "" {
.     display as error "Run 00_run.do first (it sets the paths)."
.     exit 198
. }

. 
. * ---- (a) Java vs outside Java, and by province ----
. foreach loc in java prov {
  2.     use "$B206_DATA/b206_si.dta", clear
  3.     keep if clean == 1 & !missing(`loc') & !missing(has_owngen)
  4.     generate n_firms   = 1
  5.     generate share_gen = owngen_share if has_owngen == 1
  6.     generate java_flag = java             // copy, so the province table k
> eeps the Java flag
  7.     expand 2, generate(copy)              // copy of every row with year =
>  0 for "pool"
  8.     replace year = 0 if copy == 1
  9.     collapse (sum) n_firms n_owngen = has_owngen (mean) pct_owngen = has_o
> wngen ///
>              pct_nonpln = has_nonpln java_flag (p50) med_share = share_gen, b
> y(`loc' year)
 10.     replace pct_owngen = 100 * pct_owngen
 11.     replace pct_nonpln = 100 * pct_nonpln
 12.     generate period = cond(year == 0, "pool", string(year))
 13.     sort `loc' year
 14.     order `loc' period n_firms n_owngen pct_owngen med_share pct_nonpln
 15.     drop year
 16.     if "`loc'" == "java" {
 17.         drop java_flag
 18.         list, clean noobs
 19.         export excel using "$B206_XLSX", sheet("t09a_by_java", replace) fi
> rstrow(variables)
 20.     }
 21.     else {
 22.         rename java_flag java
 23.         label values java java
 24.         order prov java
 25.         export excel using "$B206_XLSX", sheet("t09a_by_province", replace
> ) firstrow(variables)
 26.     }
 27. }
