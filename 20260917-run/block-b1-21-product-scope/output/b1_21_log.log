######## B1-21: 02_n_products ########

. /*==========================================================================
>   Line 2: "Construct n-number of product per firms"
>   Data  : Proman roster 2021-2022 (data/b21_pm_firm.dta, built in 01b)
>           n_products = number of distinct products (KBKI code, or the name
>           when the code is blank) a firm produces in a year
>   Output sheets:
>     t02_n_products  n / mean / sd / percentiles of n_products and its ln,
>                     pool + 2021 + 2022
>     t02_dist        % of firms with 1, 2, 3, 4-5, 6-10, 11+ products
>   NOTE: Kipb is masked, so a "firm" is a cell (province x KBLI5). A cell
>         holds several plants, so n_products is too high compared with real
>         firms. With the real data (Kipb) this becomes a firm count.
> ==========================================================================*/
. if "$B21" == "" {
.     display as error "Run 00_run.do first (it sets the paths)."
.     exit 198
. }

. use "$B21_DATA/b21_pm_firm.dta", clear

. do "$B21/_sumstats.do" "n_products ln_n_products" "" "t02_n_products"

. /*==========================================================================
>   _sumstats.do -- helper: descriptive statistics table, POOLED + BY YEAR
> 
>   Usage (data already loaded, must contain variable year):
>       do "$B21/_sumstats.do" "n_products ln_n_products" "exporter" "t08_by_ex
> porter"
> 
>       argument 1 = list of variables
>       argument 2 = grouping variable ("" for no grouping)
>       argument 3 = sheet name in output/b1_21_tables.xlsx (max 31 characters)
> 
>   Result: 1 row = variable x group x period (pool, 2010, 2011, ...)
>           columns n mean sd p10 p25 p50 p75 p90 min max
>   Rows with a missing group are not counted.
>   The data in memory are unchanged after this file runs.
> ==========================================================================*/
. args vars grp sheet

. 
. tempfile result original

. save `original'
file /var/folders/7l/7f30l8dj7219j21dhg9glmwc0000gn/T//St65806.000002 saved
    as .dta format

. local first 1

. if "`grp'" == "" {
.     generate byte all = 1
.     local grp all
. }

. foreach v of local vars {
  2.     foreach period in pool year {
  3.         preserve
  4.         keep `v' `grp' year
  5.         keep if !missing(`v') & !missing(`grp')
  6.         if _N > 0 {
  7.             if "`period'" == "pool" replace year = 0
  8.             collapse (count) n = `v' (mean) mean = `v' (sd) sd = `v' ///
>                      (p10) p10 = `v' (p25) p25 = `v' (p50) p50 = `v' ///
>                      (p75) p75 = `v' (p90) p90 = `v' (min) min = `v' (max) ma
> x = `v', ///
>                      by(`grp' year)
  9.             generate str32 variable = "`v'"
 10.             if `first' == 0 append using `result'
 11.             save `result', replace
 12.             local first 0
 13.         }
 14.         restore
 15.     }
 16. }
