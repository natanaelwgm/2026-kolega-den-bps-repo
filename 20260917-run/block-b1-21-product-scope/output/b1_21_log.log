. keep  firm_id year source_row kbli2 kbli5 prov prov_s java importer exporter 
> fdi ///
>       export_share prod_innov va output workers clean

. order firm_id year source_row kbli2 kbli5 prov prov_s java importer exporter 
> fdi

. label variable prod_innov "1 = introduced a new or improved product (2017-201
> 8 only)"

. label variable clean "1 = not an energy outlier"

