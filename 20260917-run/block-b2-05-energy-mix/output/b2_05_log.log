######## B2-05: 01a_prep_si ########

. /*==========================================================================
>   Line 1: "Energy transition and carbon lock in at plant level"
>   (the row's subject -> data preparation)
>   Prepare Statistik Industri (SI) 2010-2022 for B2-05
>   Input : $SI_DATA  (analysis_ready_data.dta from block 0)
>   Output: data/b205_si.dta  -- 1 row = 1 firm x year
>           (open with: use "$B205_DATA/b205_si.dta", clear  then browse)
> 
>   Copied from block-b1-18's 01a_prep_si.do (same corrections), plus the
>   energy-by-source variables this row needs:
>     gj_coal2 gj_coalbriq gj_coke                     coal family (GJ)
>     gj_diesel gj_petrol gj_kerosene gj_dieseloil gj_fueloil   oil family
>     gj_lpg gj_citygas gj_othergas gj_natgas          gas family
>     gj_biodiesel                                     biofuel (asked 2020+, re
> ported 2021+)
>     gj_elec_pln gj_elec_nonpln gj_elec_owngen        electricity by source
>     biomass_qty    biomass quantity in block 0's column (unit NOT settled)
>   Other variables: exporter, importer, fdi, large, kbli2, kbli5, prov, java,
>     va, workers, co2_s1 co2_s2 co2_total gj_s1 gj_s2 gj_total, clean
> 
>   NOTE: the 2020+ fuels (diesel oil, fuel oil, natural gas, biodiesel) have n
> o
>   GJ column in block 0. GJ per unit: IPCC 2006 default net calorific values
>   (Vol 2 Ch 1, Table 1.2). Biomass gets no GJ: block 0 calls the column kg,
>   the 2020 form says tonne, and nothing settles which.
> ==========================================================================*/
. if "$B205" == "" {
.     display as error "Run 00_run.do first (it sets the paths)."
.     exit 198
. }

. use "$SI_DATA", clear
(G0 -> G0.25 OBSCURED -> G0.5 DUMMY PANEL -> G1 RE-ESTIMATED)

. 
. * ---- identifiers ------------------------------------------------------
. * year = survey year (there is no 2016 file)
. generate kbli2 = real(substr(industry_code, 1, 2))

. generate kbli5 = industry_code

. generate prov  = real(province_code)

. generate java  = inlist(prov, 31, 32, 33, 34, 35, 36) if !missing(prov)

. label define java 0 "Outside Java" 1 "Java"

. label values java java

. 
. * ---- firm size: medium vs large (100-worker threshold) ----------------
. generate large = (workers > 100) if !missing(workers)

. label define large 0 "Medium (<=100)" 1 "Large (>100)"

. label values large large

. 
. * ---- imports, exports & FDI -------------------------------------------
. * importer is only defined where the import question can be evaluated
. generate importer = import_flag if import_observed == 1

. label define importer 0 "Non-importer" 1 "Importer"

. label values importer importer

. 
. generate exporter = export_flag
(15,321 missing values generated)

. generate fdi      = fdi_10_flag                     // foreign ownership >= 1
> 0%
(311 missing values generated)

. * 2022: the form only asks about DIRECT exports, a "no" is never recorded -> 
> missing
. replace exporter = . if year == 2022
(344 real changes made, 344 to missing)

. * 2020: foreign ownership is inconsistent (47% FDI vs 8-11% other years) -> m
> issing
. replace fdi = . if year == 2020
(2,936 real changes made, 2,936 to missing)

. label define exporter 0 "Non-exporter" 1 "Exporter"

. label values exporter exporter

. label define fdi 0 "Domestic" 1 "FDI"

. label values fdi fdi

. 
. * ---- firm characteristics (nominal) -----------------------------------
. generate va      = value_added_nominal

. generate output  = gross_output_nominal

. generate va_pw   = va / workers      if workers > 0
(28 missing values generated)

. 
. * ---- energy & emissions -----------------------------------------------
. * COAL 2017 CORRECTION: block 0 multiplies by 1000 (treats it as tonnes),
. * but the price per unit shows the data are already in kg. Divide back.
. generate co2_coal = co2_coal_s1

. generate gj_coal2 = gj_coal

. replace  co2_coal = co2_coal_s1 / 1000 if year == 2017
(1,181 real changes made)

. replace  gj_coal2 = gj_coal / 1000     if year == 2017
(1,181 real changes made)

. 
. * scope 1 = the 4 fuels asked in every year: diesel, petrol, coal, LPG
. egen co2_s1 = rowtotal(co2_diesel_s1 co2_petrol_s1 co2_coal co2_lpg_s1), miss
> ing

. egen gj_s1  = rowtotal(gj_diesel gj_petrol gj_coal2 gj_lpg), missing

. * scope 2 = purchased electricity
. generate co2_s2 = co2_scope2_s1

. generate gj_s2  = gj_electricity

. egen co2_total = rowtotal(co2_s1 co2_s2), missing

. egen gj_total  = rowtotal(gj_s1 gj_s2), missing

. 
. * ---- energy (GJ) per source, for the energy mix (line 2) --------------
. * block 0 publishes GJ for the legacy fuels; coal uses the corrected gj_coal2
> .
. * The fuels the 2020 form added have no GJ column in block 0: GJ per unit
. * from the IPCC 2006 default net calorific values (Vol 2 Ch 1, Table 1.2),
. * one plain line each.
. generate gj_dieseloil = fuel_dieseloil_ltr * 0.03655 if fuel_dieseloil_ltr >=
>  0   // per litre
(23,858 missing values generated)

. generate gj_fueloil   = fuel_fueloil_ltr   * 0.03838 if fuel_fueloil_ltr >= 0
>      // per litre
(23,858 missing values generated)

. generate gj_natgas    = fuel_natgas_mmbtu  * 1.05506 if fuel_natgas_mmbtu >= 
> 0    // per MMBTU
(23,858 missing values generated)

. generate gj_biodiesel = fuel_biodiesel_ltr * 0.02376 if fuel_biodiesel_ltr >=
>  0   // per litre
(30,450 missing values generated)

. * electricity by source: 1 kWh = 3.6 MJ = 0.0036 GJ
. generate gj_elec_pln    = elec_pln_kwh    * 0.0036     // purchased from PLN

. generate gj_elec_nonpln = elec_nonpln_kwh * 0.0036     // purchased from othe
> rs

. generate gj_elec_owngen = elec_owngen_kwh * 0.0036     // generated by the fi
> rm itself
(2,125 missing values generated)

. * biomass: quantity only, in block 0's own column (kg or tonne: not settled)
. generate biomass_qty = fuel_biomass_kg if fuel_biomass_kg >= 0
(23,858 missing values generated)

. 
. * ---- energy outlier flag (clean) --------------------------------------
. * a record is left out of the analysis (clean = 0) if any of its energy
. * quantities is above 100x that year's 99th percentile. Nothing is deleted.
. generate coal_kg_fix = fuel_coal_kg

. replace  coal_kg_fix = fuel_coal_kg / 1000 if year == 2017
(1,181 real changes made)

. generate clean = 1

. levelsof year, local(years)
2010 2011 2012 2013 2014 2015 2017 2018 2019 2020 2021 2022

. foreach q in fuel_diesel_ltr fuel_petrol_ltr fuel_kerosene_ltr coal_kg_fix fu
> el_lpg_kg ///
>              fuel_citygas_m3 fuel_othergas_m3 fuel_coalbriq_kg fuel_coke_kg /
> //
>              elec_pln_kwh elec_nonpln_kwh elec_owngen_kwh fuel_dieseloil_ltr 
> ///
>              fuel_fueloil_ltr fuel_natgas_mmbtu fuel_biodiesel_ltr fuel_bioma
> ss_kg {
  2.     foreach y of local years {
  3.         quietly count if year == `y' & `q' > 0 & !missing(`q')
  4.         if r(N) > 2 {
  5.             quietly summarize `q' if year == `y' & `q' > 0, detail
  6.             quietly replace clean = 0 if year == `y' & `q' > 100 * r(p99) 
> & !missing(`q')
  7.         }
  8.     }
  9. }

. replace clean = 0 if workers == 0 & co2_s1 > 0 & !missing(co2_s1)
(20 real changes made)

. count if clean == 0
  30

. display as result "Outlier records (clean = 0): " r(N)
Outlier records (clean = 0): 30

. 
. * ---- save -------------------------------------------------------------
. keep  firm_id year source_row kbli2 kbli5 prov java large importer exporter f
> di ///
>       va output va_pw workers co2_s1 co2_s2 co2_total gj_s1 gj_s2 gj_total //
> /
>       gj_coal2 gj_coalbriq gj_coke gj_diesel gj_petrol gj_kerosene gj_dieselo
> il gj_fueloil ///
>       gj_lpg gj_citygas gj_othergas gj_natgas gj_biodiesel ///
>       gj_elec_pln gj_elec_nonpln gj_elec_owngen biomass_qty clean

. order firm_id year source_row kbli2 kbli5 prov java large importer exporter f
> di

. label variable gj_coal2       "Coal energy (GJ), 2017 divided by 1000"

. label variable gj_dieseloil   "Diesel oil energy (GJ), 2020+ only"

. label variable gj_fueloil     "Fuel oil energy (GJ), 2020+ only"

. label variable gj_natgas      "Natural gas energy (GJ), 2020+ only"

. label variable gj_biodiesel   "Biodiesel energy (GJ), asked from 2020 (report
> ed from 2021)"

. label variable gj_elec_pln    "Electricity bought from PLN (GJ)"

. label variable gj_elec_nonpln "Electricity bought from non-PLN (GJ)"

. label variable gj_elec_owngen "Electricity generated by the firm itself (GJ)"

. label variable biomass_qty    "Biomass quantity, unit NOT settled (kg or tonn
> e), 2020+ only"

. label variable clean "1 = not an energy outlier"

. compress
  variable kbli2 was double now byte
  variable prov was double now byte
  variable java was double now byte
  variable large was double now byte
  variable importer was double now byte
  variable exporter was double now byte
  variable fdi was double now byte
  variable clean was double now byte
  (1,850,744 bytes saved)

. save "$B205_DATA/b205_si.dta", replace
(file
    /private/tmp/claude-501/sp/pr-worktree/20260917-run/block-b2-05-energy-mi
    > x/data/b205_si.dta not found)
file
    /private/tmp/claude-501/sp/pr-worktree/20260917-run/block-b2-05-energy-mi
    > x/data/b205_si.dta saved

. display as result "01a done: $B205_DATA/b205_si.dta (" _N " rows)"
01a done: /private/tmp/claude-501/sp/pr-worktree/20260917-run/block-b2-05-energ
> y-mix/data/b205_si.dta (33049 rows)

. 
end of do-file

######## B2-05: 02_energy_mix ########

. /*==========================================================================
>   Line 2: "Construct firm energy mix per year: coal, diesel/fuel oil, gas/lpg
> ,
>            electicity pln, non pln, self generation, biomass."
>   Data  : SI 2010-2022 (data/b205_si.dta), clean == 1
>   Output: data/b205_mix.dta  -- 1 row = 1 firm x year, GJ and % share per sou
> rce
>   Output sheets:
>     t02_mix_mean        mean of firm shares (%) per source, pool + by year
>     t02_mix_aggregate   all firms' GJ per source / all firms' GJ (%), pool + 
> by year
>     t02_share_stats     n mean sd p10-p90 min max of every share, pool + by y
> ear
>     t02_self_generation % firms generating their own electricity, and own
>                         generation as % of the electricity they use
>     t02_biomass         biomass reporters (2020+), shown apart, see NOTE
> 
>   Sources (GJ):
>     coal         coal (2017 corrected) + coal briquettes + coke
>     oil          diesel + petrol + kerosene + diesel oil + fuel oil
>     gas          LPG + city gas + other gas + natural gas
>     pln          electricity bought from PLN
>     nonpln       electricity bought from others
>     biofuel      biodiesel
>   The denominator gj_mix = the sum of these six (= 100%).
> 
>   SELF GENERATION is NOT one of the six. The generator burns diesel, coal or
>   gas that the firm already reports among its fuels, so adding the kWh it
>   makes would count the same energy twice (the shares would sum to > 100).
>   It is reported apart: own kWh / (PLN + non-PLN + own kWh).
>   BIOMASS is NOT in the six either. Block 0 calls the column kg, the 2020 for
> m
>   says tonne; nothing settles which, and the GJ differ by 1000x. t02_biomass
>   shows how many firms report it and what the share would be under each unit.
>   NOTE: diesel oil, fuel oil, natural gas, biodiesel and biomass are asked
>   from 2020 only; city gas, other gas, kerosene and briquettes are not asked
>   every year. A step in 2020 is partly the new form, not a transition.
>   Lubricant is not energy (not burned) and is left out.
> ==========================================================================*/
. if "$B205" == "" {
.     display as error "Run 00_run.do first (it sets the paths)."
.     exit 198
. }

. use "$B205_DATA/b205_si.dta", clear
(G0 -> G0.25 OBSCURED -> G0.5 DUMMY PANEL -> G1 RE-ESTIMATED)

. keep if clean == 1
(30 observations deleted)

. 
. * ---- GJ per source -----------------------------------------------------
. egen gj_c_coal   = rowtotal(gj_coal2 gj_coalbriq gj_coke)

. egen gj_c_oil    = rowtotal(gj_diesel gj_petrol gj_kerosene gj_dieseloil gj_f
> ueloil)

. egen gj_c_gas    = rowtotal(gj_lpg gj_citygas gj_othergas gj_natgas)

. egen gj_c_pln    = rowtotal(gj_elec_pln)

. egen gj_c_nonpln = rowtotal(gj_elec_nonpln)

. egen gj_c_bio    = rowtotal(gj_biodiesel)

. egen gj_mix      = rowtotal(gj_c_coal gj_c_oil gj_c_gas gj_c_pln gj_c_nonpln 
> gj_c_bio)

. 
. * ---- share of each source in the firm's GJ (%) -------------------------
. foreach c in coal oil gas pln nonpln bio {
  2.     generate sh_`c' = 100 * gj_c_`c' / gj_mix if gj_mix > 0
  3. }
(489 missing values generated)
(489 missing values generated)
(489 missing values generated)
(489 missing values generated)
(489 missing values generated)
(489 missing values generated)

. generate sh_elec = sh_pln + sh_nonpln
(489 missing values generated)

. label variable sh_coal   "Coal, briquettes, coke (% of GJ)"

. label variable sh_oil    "Diesel, petrol, kerosene, diesel oil, fuel oil (% o
> f GJ)"

. label variable sh_gas    "LPG, city gas, other gas, natural gas (% of GJ)"

. label variable sh_pln    "Electricity bought from PLN (% of GJ)"

. label variable sh_nonpln "Electricity bought from non-PLN (% of GJ)"

. label variable sh_bio    "Biodiesel (% of GJ)"

. label variable sh_elec   "Electricity bought, PLN + non-PLN (% of GJ)"

. 
. * ---- self generation (apart from the mix) ------------------------------
. generate owngen = (gj_elec_owngen > 0) if !missing(gj_elec_owngen)
(2,123 missing values generated)

. egen gj_elec_all = rowtotal(gj_elec_pln gj_elec_nonpln gj_elec_owngen)

. generate sh_owngen_elec = 100 * gj_elec_owngen / gj_elec_all if gj_elec_all >
>  0 & !missing(gj_elec_owngen)
(3,359 missing values generated)

. label variable owngen         "1 = generates some of its own electricity"

. label variable sh_owngen_elec "Own generation as % of all electricity used"

. 
. generate has_energy = (gj_mix > 0)

. generate ln_gj_mix  = ln(gj_mix) if gj_mix > 0
(489 missing values generated)

. label variable gj_mix "Energy used (GJ): the six sources, excl. own generatio
