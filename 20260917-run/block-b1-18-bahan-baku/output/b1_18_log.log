. * ---- importer premium (simple regression) ----
. * coefficient on importer = average gap between importers and non-importers,
. * comparing firms in the same year and sector.
. * for ln variables: coefficient x 100 = roughly the gap in %.
. tempname res

. tempfile premium

. postfile `res' str20 variable double coef se pvalue n using `premium'

. foreach y in tfp_op tfp_lp tfp_acf tfp_wrdg ln_va_pw ln_out_pw exporter ln_co
> 2_total ln_gj_total ln_co2_per_va ln_gj_per_va {
  2.     quietly count if !missing(`y') & !missing(importer)
  3.     if r(N) > 30 {
  4.         quietly regress `y' importer i.year i.kbli2, vce(robust)
  5.         local p = 2 * ttail(e(df_r), abs(_b[importer] / _se[importer]))
  6.         post `res' ("`y'") (_b[importer]) (_se[importer]) (`p') (e(N))
  7.     }
  8. }

. postclose `res'

. use `premium', clear

