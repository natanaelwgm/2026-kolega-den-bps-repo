######## B1-18: 11_import_origin ########

. /*==========================================================================
>   Line 11: "Impor dari mana"
>   Data  : Bahan Baku roster 2021-2022, imported material rows
>           (data/b18_bb_rows.dta)
>   Output sheets:
>     t11_coverage          % of imported value whose origin country is reporte
> d
>     t11_origin            per origin country: imported value, % of total,
>                           number of rows & firms, pool + by year
>     t11_origin_by_sector  origin country x KBLI 2-digit (pool)
>   Chart: fig11 (drawn in 12_figures.do)
> 
>   NOTE: in the sample data only a small part of the imported rows report an
>   origin country -> check t11_coverage before reading the country shares.
> ==========================================================================*/
. if "$B18" == "" {
.     display as error "Run 00_run.do first (it sets the paths)."
.     exit 198
. }

. use "$B18_DATA/b18_bb_rows.dta", clear

. keep if imported == 1
(22,482 observations deleted)

. 
. * ---- coverage: origin country reported or not ----
. preserve

. generate reported = (origin_name != "(not reported)")

. generate one = 1

. generate val_reported = val_import * reported

. collapse (sum) rows = one rows_reported = reported val_import val_reported, b
> y(year)

. generate pct_rows_reported  = 100 * rows_reported / rows

. generate pct_value_reported = 100 * val_reported / val_import

. list, clean noobs

    year   rows   rows_r~d   val_imp~t   val_re~d   pct_ro~d   pct_va~d  
    2021   6194        738   1.051e+11   2.30e+10   11.91476   21.88888  
    2022   3461       1097   7.553e+10   3.55e+10   31.69604   46.98707  

. export excel using "$B18_XLSX", sheet("t11_coverage", replace) firstrow(varia
> bles)
file /private/tmp/claude-501/sp/pr-worktree/20260917-run/block-b1-18-bahan-baku
> /output/b1_18_tables.xlsx saved

. restore

. 
. * from here on: only rows with a reported origin country
. drop if origin_name == "(not reported)"
(7,820 observations deleted)

. egen tag_firm = tag(firm_key year origin_name)      // counts each firm once 
> per country

. generate one = 1

. 
. * ---- by origin country, by year + pool ----
. preserve

. expand 2, generate(copy)              // copy of every row with year = 0 for 
> "pool"
(1,835 observations created)

. replace year = 0 if copy == 1
(1,835 real changes made)

. collapse (sum) val_import n_rows = one n_firms = tag_firm, by(origin_name yea
> r)

. bysort year: egen total = total(val_import)

. generate share_pct = 100 * val_import / total

. generate period = cond(year == 0, "pool", string(year))

. gsort year -share_pct

. order period origin_name share_pct val_import n_rows n_firms

. drop year total

. export excel using "$B18_XLSX", sheet("t11_origin", replace) firstrow(variabl
> es)
file /private/tmp/claude-501/sp/pr-worktree/20260917-run/block-b1-18-bahan-baku
> /output/b1_18_tables.xlsx saved

. restore

. 
. * ---- origin country x KBLI 2-digit sector (pool) ----
. collapse (sum) val_import, by(kbli2 origin_name)

. bysort kbli2: egen total = total(val_import)

. generate share_in_sector_pct = 100 * val_import / total

. gsort kbli2 -share_in_sector_pct

. drop total

. export excel using "$B18_XLSX", sheet("t11_origin_by_sector", replace) firstr
> ow(variables)
file /private/tmp/claude-501/sp/pr-worktree/20260917-run/block-b1-18-bahan-baku
> /output/b1_18_tables.xlsx saved

. 
end of do-file

######## B1-18: 13_construct ########

. /*==========================================================================
>   Line 13: "Construct:"
>   Builds the firm-level construct variables used in lines 14-18 (and the
>   product-scope part of line 19) from the Bahan Baku roster.
> 
>   Input : data/b18_bb_rows.dta  (1 row = 1 raw material x firm x year)
>   Output: data/b18_bb_firm.dta  (1 row = 1 firm x year)
> 
>   Variables:
>     val_local val_import val_total   domestic / imported / total value
>     import_share      val_import / val_total                     (line 14)
>     any_import        1 = imports at least one raw material
>     n_items           number of distinct raw materials (KBKI)
>     n_items_imp       number of distinct imported raw materials  (line 15)
>     share_items_imp   n_items_imp / n_items                      (line 15)
>     mix               1 all domestic, 2 mixed, 3 all imported    (line 16)
>     n_origins         number of origin countries (reported only) (line 17)
>     origin_hhi        HHI of imported value across countries     (line 17)
> ==========================================================================*/
. if "$B18" == "" {
.     display as error "Run 00_run.do first (it sets the paths)."
.     exit 198
. }

. use "$B18_DATA/b18_bb_rows.dta", clear

. 
. * ---- 1. origin concentration per firm ----
. preserve

. keep if imported == 1 & origin_name != "(not reported)"
(30,302 observations deleted)

. collapse (sum) v = val_import, by(firm_key year origin_name)   // value per c
> ountry

. bysort firm_key year: egen v_total = total(v)

. generate s2 = (v / v_total)^2                                  // squared sha
> re

. collapse (sum) origin_hhi = s2 (count) n_origins = s2, by(firm_key year)

. tempfile hhi

. save `hhi'
file /var/folders/7l/7f30l8dj7219j21dhg9glmwc0000gn/T//St65806.000002 saved
    as .dta format

. restore

. 
. * ---- 2. number of distinct (imported) raw materials ----
. * a raw material is identified by its KBKI code; if blank, by its name
. generate item = kbki
(3,610 missing values generated)

. replace  item = upper(strtrim(material)) if item == "" | item == "0000000000"
variable item was str10 now str374
(8,282 real changes made)

. egen tag_item     = tag(firm_key year item)               // 1 per distinct m
> aterial

. egen tag_item_imp = tag(firm_key year item imported)

. generate item_imp = tag_item_imp * imported               // 1 per distinct i
> mported material

. 
. * ---- 3. collapse to firms ----
. collapse (sum) val_local val_import val_total n_items = tag_item n_items_imp 
> = item_imp ///
>          (first) prov kbli5 kbli2 java key_type, by(firm_key year)

. merge 1:1 firm_key year using `hhi', nogenerate

    Result                      Number of obs
    -----------------------------------------
    Not matched                         3,656
        from master                     3,656  
        from using                          0  

    Matched                               806  
    -----------------------------------------

. replace n_origins = 0 if missing(n_origins)
(3,656 real changes made)

. 
. generate import_share    = val_import / val_total

. generate any_import      = (val_import > 0)

. generate share_items_imp = n_items_imp / n_items

. label define any_import 0 "Non-importer" 1 "Importer"

. label values any_import any_import

. 
. * ---- 4. domestic / import mix ----
. generate mix = 1 if val_import == 0
(2,039 missing values generated)

. replace  mix = 2 if val_import > 0 & val_local > 0
(1,880 real changes made)

. replace  mix = 3 if val_local == 0
(159 real changes made)

. label define mix 1 "All domestic" 2 "Mixed" 3 "All imported"

