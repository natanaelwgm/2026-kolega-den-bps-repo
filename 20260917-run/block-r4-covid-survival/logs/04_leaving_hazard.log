. display "Step 3/8: the trait markers, and which traits have enough firms to estimate"
Step 3/8: the trait markers, and which traits have enough firms to estimate

. *---------------------------------------------------------------------------
. use `stack', clear
(G0 -> G0.25 OBSCURED -> G0.5 DUMMY PANEL -> G1 RE-ESTIMATED)

. * 0/1 marker per trait (reference groups: 20-99 workers; known non-exporters)
. gen byte d1 = (sizeb == 1) if !missing(sizeb)   // fewer than 20 workers

. gen byte d2 = (sizeb == 3) if !missing(sizeb)   // 100 or more workers

. gen byte d3 = hiprod                            // value added per worker above its sector's median

. gen byte d4 = (expst == 1)                      // exporter

. gen byte d5 = (expst == 2)                      // export answer not known

. gen byte d6 = imp                               // importer

. gen byte d7 = fdi                               // 10% or more foreign-owned

. gen byte d8 = new_to_file                       // in neither of the two files before

. local nterm 8

. local t1 "Fewer than 20 workers"

. local t2 "100 or more workers"

. local t3 "Value added per worker above its sector's median"

. local t4 "Exporter"

. local t5 "Export answer not known"

. local t6 "Importer"

. local t7 "Foreign-owned (10% or more)"

. local t8 "New to the files (not in the two files before)"

. * a firm is usable when every trait is known (value added per worker needs workers > 0)
. egen byte n_miss = rowmiss(d1-d8)

. gen byte usable = (n_miss == 0)

. * firm-level counts per starting file (period 1 = one row per firm), kept as scalars
. foreach c of local cohorts {
  2.     quietly count if coh == `c' & period == 1
  3.     local nf_`c' = r(N)
  4.     quietly count if coh == `c' & period == 1 & usable
  5.     local nfu_`c' = r(N)
  6.     quietly count if coh == `c' & usable
  7.     local nr_`c' = r(N)
  8.     quietly count if coh == `c' & usable & left
  9.     local ne_`c' = r(N)
 10.     * the whole file is left out when leaving (or staying) is rare
.     quietly count if coh == `c' & usable & !left
 11.     local model_`c' = (`ne_`c'' >= `min_firms' & r(N) >= `min_firms')
 12.     local terms_`c' ""
 13.     forvalues t = 1/`nterm' {
 14.         quietly count if coh == `c' & period == 1 & usable & d`t' == 1
 15.         scalar nw_`t'_`c' = r(N)                       // firms with the trait
 16.         quietly count if coh == `c' & period == 1 & usable & d`t' == 0
 17.         scalar nwo_`t'_`c' = r(N)                      // firms without it
 18.         quietly count if coh == `c' & usable & d`t' == 1
 19.         scalar rw_`t'_`c' = r(N)                       // rows (firm x later file) with it
 20.         quietly count if coh == `c' & usable & d`t' == 1 & left
 21.         scalar ev_`t'_`c' = r(N)                       // of which: left the files
 22.         local ok = (nw_`t'_`c' >= `min_firms' & nwo_`t'_`c' >= `min_firms' & `model_`c'')
 23.         scalar est_`t'_`c' = `ok'
 24.         if `ok' local terms_`c' `terms_`c'' `t'
 25.         * one marker per trait and starting file (0 in the other file's rows), so one
.         * pooled model gives each starting file its own coefficients
.         if `ok' gen byte x`t'_`c' = d`t' * (coh == `c')
 26.     }
 27.     display "   `c' firms: `nf_`c'' (usable `nfu_`c''), rows `nr_`c'', leaving events `ne_`c''; traits estimated: `
> terms_`c''"
 28. }
