. local r 1

. forvalues t = 1/`nterm' {
  2.     if "`hd`t''" != "" {
  3.         local ++r
  4.         putpdf table A(`r', 1) = ("`h`hd`t'''"), bold colspan(4)
  5.     }
  6.     local ++r
  7.     putpdf table A(`r', 1) = ("`c`t''"), halign(left)
  8.     local trowsA `trowsA' `r'
  9.     forvalues k = 1/2 {
 10.         quietly summarize ame_pp if section == "effect" & row_id == `t' & cohort_year == `cc`k''
 11.         local bb = r(mean)
 12.         quietly summarize ame_se_pp if section == "effect" & row_id == `t' & cohort_year == `cc`k''
 13.         local ss = r(mean)
 14.         if `bb' < . {
 15.             putpdf table A(`r', `=`k' + 1') = ("`=string(`bb', "%9.2f")'"), halign(right) linebreak
 16.             putpdf table A(`r', `=`k' + 1') = ("(`=string(`ss', "%9.2f")')"), append
 17.         }
 18.         else putpdf table A(`r', `=`k' + 1') = ("not estimated"), halign(right)
 19.     }
 20.     quietly summarize diff_pp if section == "effect" & row_id == `t' & cohort_year == `cc1'
 21.     local bb = r(mean)
 22.     quietly summarize diff_se_pp if section == "effect" & row_id == `t' & cohort_year == `cc1'
