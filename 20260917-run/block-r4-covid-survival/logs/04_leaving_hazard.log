. scalar z_ = invnormal(0.975)

. tempname pf

. tempfile res

. postfile `pf' str12 section int cohort_year str14 later_files int row_id str60 label byte estimated str60 status ///
>     double ame_pp ame_se_pp ame_lo_pp ame_hi_pp logit_b logit_se odds_ratio or_se or_lo or_hi ///
>     diff_pp diff_se_pp diff_p firms_with firms_without rows_with events_with ///
>     firms_model rows_model events_model pred_pct actual_pct stat_value using `res', replace
(file /var/folders/0k/wcj_06q55_gd0c7z2x717jsc0000gn/T//S_36669.000005 not found)

. foreach c of local cohorts {
  2.     local lf "`f1_`c'' `f2_`c'' `f3_`c''"
  3.     * (a) one row per trait: the dots
.     forvalues t = 1/`nterm' {
  4.         local isest : list t in terms_`c'
  5.         local isest = `isest' & `model_ok'
  6.         local st = cond(`isest', "estimated", "not estimated: too few firms (fewer than `min_firms' with or without
> )")
  7.         if !`model_ok' local st "not estimated: the model did not run"
  8.         if `isest' {
  9.             scalar a_ = 100 * ame_`t'_`c'
 10.             scalar s_ = 100 * ase_`t'_`c'
 11.             scalar lb_ = lb_`t'_`c'
 12.             scalar ls_ = lse_`t'_`c'
 13.             scalar dd_ = .
 14.             scalar ds_ = .
 15.             scalar dp_ = .
 16.             local inboth : list t in both
 17.             if `inboth' & `c' == `cohort_covid' {
 18.                 scalar dd_ = 100 * dif_`t'
 19.                 scalar ds_ = 100 * dse_`t'
 20.                 scalar dp_ = dp_`t'
 21.             }
 22.             post `pf' ("effect") (`c') ("`lf'") (`t') ("`t`t''") (1) ("`st'") ///
>                 (a_) (s_) (a_ - z_ * s_) (a_ + z_ * s_) (lb_) (ls_) (exp(lb_)) (exp(lb_) * ls_) ///
>                 (exp(lb_ - z_ * ls_)) (exp(lb_ + z_ * ls_)) (dd_) (ds_) (dp_) ///
>                 (nw_`t'_`c') (nwo_`t'_`c') (rw_`t'_`c') (ev_`t'_`c') (nfirm_`c') (nrow_`c') (nev_`c') (.) (.) (.)
 23.         }
 24.         else {
 25.             post `pf' ("effect") (`c') ("`lf'") (`t') ("`t`t''") (0) ("`st'") ///
>                 (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) ///
>                 (nw_`t'_`c') (nwo_`t'_`c') (rw_`t'_`c') (ev_`t'_`c') (.) (.) (.) (.) (.) (.)
 26.         }
 27.     }
 28.     * (b) leaving rate at each later file
.     forvalues k = 1/3 {
 29.         post `pf' ("leaving_rate") (`c') ("`lf'") (`k') ("Missing from the `f`k'_`c'' file (first time)") (.) ("") 
> ///
>             (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) ///
>             (.) (lr_n_`k'_`c') (lr_e_`k'_`c') (lr_p_`k'_`c') (100 * lr_e_`k'_`c' / lr_n_`k'_`c') (.)
 30.     }
 31.     * (c) calibration by tenth of predicted risk
.     if `model_ok' & "`terms_`c''" != "" {
 32.         forvalues d = 1/`ndec_`c'' {
 33.             post `pf' ("calibration") (`c') ("`lf'") (`d') ("Tenth `d' of predicted risk") (.) ("") ///
>                 (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) ///
>                 (.) (cal_n_`d'_`c') (.) (cal_p_`d'_`c') (cal_a_`d'_`c') (.)
 34.         }
 35.     }
 36.     * (d) model checks, one statistic per row
.     local k 0
 37.     foreach s in "firms in the starting file|nf_`c'" "firms with every trait known|nfu_`c'" ///
>         "firms in the model|nfirm_`c'" "rows in the model|nrow_`c'" "leaving events in the model|nev_`c'" ///
>         "coefficients estimated|rank_`c'" "rows dropped: perfect prediction|drop_`c'" ///
>         "area under ROC curve|auc_`c'" "Hosmer-Lemeshow statistic|hl_`c'" "Hosmer-Lemeshow p|hlp_`c'" ///
>         "largest calibration gap (points)|gap_`c'" "importer share of firms (%)|impsh_`c'" ///
>         "firms in the model, both files (clusters)|nclust" ///
>         "all traits `cohort_covid' = `cohort_normal', joint p|joint_p" {
 38.         local ++k
 39.         tokenize "`s'", parse("|")
 40.         if inlist("`3'", "joint_p", "nclust") & `c' != `cohort_covid' continue   // one value for both files
 41.         scalar v_ = .
 42.         if inlist("`3'", "nf_`c'", "nfu_`c'") scalar v_ = ``3''
 43.         else if "`3'" == "impsh_`c'" scalar v_ = impsh_`c'
 44.         else if `model_ok' capture scalar v_ = `3'
 45.         post `pf' ("check") (`c') ("`lf'") (`k') ("`1'") (.) ("") ///
>             (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (v_)
 46.     }
 47. }

. postclose `pf'

. use `res', clear

