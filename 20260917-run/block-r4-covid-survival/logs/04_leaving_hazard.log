.     matrix mb = e(b)
.     matrix mV = e(V)
.     local cn : colfullnames e(b)
.     local j 0
.     foreach nm of local cn {
  2.         local ++j
  3.         local cl = subinstr("`nm'", "bn.coh", ".coh", 1)
  4.         foreach c of local cohorts {
  5.             foreach t of local terms_`c' {
  6.                 if "`cl'" == "1.x`t'_`c':`c'.coh" {
  7.                     local nm_`t'_`c' "`nm'"
  8.                     scalar ame_`t'_`c' = mb[1, `j']
  9.                     scalar ase_`t'_`c' = sqrt(mV[`j', `j'])
 10.                 }
 11.             }
 12.         }
 13.     }
.     foreach c of local cohorts {
  2.         foreach t of local terms_`c' {
  3.             assert "`nm_`t'_`c''" != ""
  4.             assert abs(ame_`t'_`c' - amesep_`t'_`c') < 1e-6   // same as the separate logit
  5.         }
  6.     }
.     * 2019 minus 2012, trait by trait, and all traits together
.     local both : list terms_`cohort_covid' & terms_`cohort_normal'
.     local jt ""
.     foreach t of local both {
  2.         quietly lincom _b[`nm_`t'_`cohort_covid''] - _b[`nm_`t'_`cohort_normal'']
  3.         scalar dif_`t' = r(estimate)
  4.         scalar dse_`t' = r(se)
  5.         scalar dp_`t'  = r(p)
  6.         local jt `jt' (_b[`nm_`t'_`cohort_covid''] = _b[`nm_`t'_`cohort_normal''])
  7.     }
.     scalar joint_p = .
.     if "`jt'" != "" {
.         quietly test `jt'
.         scalar joint_p = r(p)
.         scalar joint_chi2 = r(chi2)
.         scalar joint_df = r(df)
.     }
.     if "`jt'" != "" display "   all traits, `cohort_covid' vs `cohort_normal' together: chi2(" joint_df ") = " %6.2f j
> oint_chi2 ", p = " %6.4f joint_p
