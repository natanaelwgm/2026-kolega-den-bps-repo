. putpdf table A(1, 3) = ("(2) `cohort_normal' firms,"), halign(right) linebreak

. putpdf table A(1, 3) = ("followed `lf2'"), append

. putpdf table A(1, 4) = ("(3) Difference"), halign(right) linebreak

