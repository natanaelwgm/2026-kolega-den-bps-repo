. local nenote = cond(r(N) > 0, " (n.e. = not estimated: fewer than `min_firms' firms with or without the trait)", "")

. local ntext "Notes: Firm links are fictional in the development data, so who stays, leaves or comes back means nothing
>  here; read this chart on the real BPS files. Each firm of the starting file is followed until the first later file it
>  is missing from ('leaves'; not proof of closure: the files record no closures). Dot = percentage points more (right o
> f 0) or less likely to leave at each next file than a similar firm without the trait (same sector, province and other 
> traits)`nenote'. Traits come only from the starting file and the two files before it. Where a 95% bar crosses 0 there 
> is no clear difference. The gap between the two dots is an association, not the effect of COVID; the gaps are clear to
> gether only if p < 0.05 (here `jp'). Importers are not like for like (`impsh_`cohort_normal''% of the `cohort_normal' 
> firms, `impsh_`cohort_covid''% of the `cohort_covid' firms: the recorded share jumps). Firms not in the two files befo
> re leave far more partly because of how the fictional links were drawn. Value added = output minus inputs bought (curr
> ent prices)."

. local notelines ""

. local line ""

. foreach w of local ntext {
  2.     if ustrlen("`line' `w'") > 108 & "`line'" != "" {
  3.         local notelines `"`notelines' "`line'""'
  4.         local line "`w'"
  5.     }
  6.     else local line = strtrim("`line' `w'")
  7. }

. local notelines `"`notelines' "`line'""'

. display `"   note lines: `notelines'"'
