. local model_ok = (_rc == 0)

. if !`model_ok' display as error "   the model did not run: every trait is written as 'not estimated'"

. if `model_ok' {
.     estimates store pooled
.     scalar nclust = e(N_clust)                        // firms in the model (a firm in both files counts once)
.     gen byte in_est = e(sample)
.     * rows dropped because a sector or province predicts leaving (or staying) perfectly
.     foreach c of local cohorts {
  2.         quietly count if coh == `c'
  3.         local a = r(N)
  4.         quietly count if coh == `c' & in_est
  5.         scalar drop_`c' = `a' - r(N)
  6.         scalar nrow_`c' = r(N)
  7.         quietly count if coh == `c' & in_est & left
  8.         scalar nev_`c' = r(N)
  9.         quietly count if coh == `c' & in_est & period == 1
 10.         scalar nfirm_`c' = r(N)
 11.         foreach t of local terms_`c' {
 12.             scalar lb_`t'_`c'  = _b[1.x`t'_`c']       // log odds ratio of the trait
 13.             scalar lse_`t'_`c' = _se[1.x`t'_`c']
 14.         }
 15.     }
.     * check: two separate logits give the same coefficients and effects
.     foreach c of local cohorts {
  2.         if "`terms_`c''" == "" continue
  3.         local xs ""
  4.         foreach t of local terms_`c' {
  5.             local xs `xs' x`t'_`c'
  6.         }
  7.         quietly logit left i.(`xs') i.cper i.csec i.cprov if coh == `c', vce(cluster firm_id)
  8.         scalar rank_`c' = e(rank)                     // coefficients estimated for this file
  9.         foreach t of local terms_`c' {
 10.             assert reldif(_b[1.x`t'_`c'], lb_`t'_`c') < 1e-6
 11.         }
 12.         quietly margins, dydx(`xs')
 13.         matrix ms = r(b)
 14.         foreach t of local terms_`c' {
 15.             scalar amesep_`t'_`c' = ms[1, colnumb(ms, "1.x`t'_`c'")]
 16.         }
 17.     }
.     * table-only check (not drawn, not in the CSV): value added per worker as a continuous
.     * measure (log distance from its sector's median, per standard deviation across the
.     * starting file's firms) in place of the yes/no marker; otherwise the same model
.     foreach c of local cohorts {
  2.         if "`terms_`c''" == "" continue
  3.         local xs ""
  4.         foreach t of local terms_`c' {
  5.             if `t' != 3 local xs `xs' x`t'_`c'
  6.         }
  7.         capture drop zc
  8.         quietly summarize lvr if coh == `c' & period == 1
  9.         local sdz = r(sd)                             // SD across the firms of this starting file
 10.         gen double zc = lvr / `sdz' if coh == `c'
 11.         capture {
 12.             quietly logit left `=cond("`xs'" != "", "i.(`xs')", "")' c.zc i.cper i.csec i.cprov if coh == `c', vce(
> cluster firm_id)
 13.             quietly margins, dydx(zc)
 14.             matrix mz = r(b)
 15.             matrix vz = r(V)
 16.             scalar cz_b_`c'  = 100 * mz[1, 1]
 17.             scalar cz_se_`c' = 100 * sqrt(vz[1, 1])
 18.         }
 19.         display "   check `c': value added per worker, continuous (per SD): " %6.2f cz_b_`c' " points (SE " %5.2f c
> z_se_`c' ")"
 20.     }
