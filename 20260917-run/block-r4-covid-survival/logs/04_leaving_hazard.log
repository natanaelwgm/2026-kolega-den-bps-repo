. display "Step 5/8: model checks: rare outcomes, perfect prediction, calibration"
Step 5/8: model checks: rare outcomes, perfect prediction, calibration

. *---------------------------------------------------------------------------
. * leaving rate per later file (actual, and average predicted)
. foreach c of local cohorts {
  2.     forvalues k = 1/3 {
  3.         quietly count if coh == `c' & period == `k'
  4.         scalar lr_n_`k'_`c' = r(N)
  5.         quietly count if coh == `c' & period == `k' & left
  6.         scalar lr_e_`k'_`c' = r(N)
  7.         scalar lr_p_`k'_`c' = .
  8.         if `model_ok' {
  9.             quietly summarize phat if coh == `c' & period == `k'
 10.             scalar lr_p_`k'_`c' = 100 * r(mean)
 11.         }
 12.     }
 13. }

. * calibration: rows sorted into tenths of predicted risk; predicted vs actual share;
. * Hosmer-Lemeshow statistic = sum over tenths of (actual - predicted)^2 / (pred x (1 - pred/n)), 8 df
. foreach c of local cohorts {
  2.     scalar auc_`c' = .
  3.     scalar hl_`c' = .
  4.     scalar hlp_`c' = .
  5.     scalar gap_`c' = .
  6.     if !`model_ok' | "`terms_`c''" == "" continue
  7.     quietly roctab left phat if coh == `c' & in_est
  8.     scalar auc_`c' = r(area)                          // 0.5 = no better than chance, 1 = perfect sorting
  9.     quietly xtile dec_`c' = phat if coh == `c' & in_est, nquantiles(10)
 10.     scalar hl_`c' = 0
 11.     scalar gap_`c' = 0
 12.     quietly levelsof dec_`c', local(decs)
 13.     local ndec : word count `decs'
 14.     foreach d of local decs {
 15.         quietly count if dec_`c' == `d'
 16.         scalar cal_n_`d'_`c' = r(N)
 17.         quietly summarize left if dec_`c' == `d'
 18.         scalar cal_a_`d'_`c' = 100 * r(mean)
 19.         scalar cal_o = r(sum)
 20.         quietly summarize phat if dec_`c' == `d'
 21.         scalar cal_p_`d'_`c' = 100 * r(mean)
 22.         scalar cal_e = r(sum)
 23.         scalar hl_`c' = hl_`c' + (cal_o - cal_e)^2 / (cal_e * (1 - cal_e / cal_n_`d'_`c'))
 24.         scalar gap_`c' = max(gap_`c', abs(cal_a_`d'_`c' - cal_p_`d'_`c'))
 25.     }
 26.     scalar hlp_`c' = chi2tail(`ndec' - 2, hl_`c')
 27.     local ndec_`c' `ndec'
 28.     display "   `c': rows " nrow_`c' ", leaving events " nev_`c' ", coefficients " rank_`c' ", dropped for perfect 
