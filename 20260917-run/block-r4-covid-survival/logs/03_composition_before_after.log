. *---------------------------------------------------------------------------
. * Read back the CSV just written, so the table shows exactly the charted numbers.
. import delimited using "tables/03_composition_before_after.csv", clear varnames(1) encoding("utf-8") stringcols(2 3 5 
> 7)
(46 vars, 30 obs)

. keep if drawn == 1 | group == "Exporter"        // plotted rows, plus the row that cannot be drawn
(2 observations deleted)

. sort row_order

. local nall = _N

. local nsec = 0

. local prev ""

. forvalues i = 1/`nall' {
  2.     if section[`i'] != "`prev'" local ++nsec
  3.     local prev = section[`i']
  4. }

. local ntab = `nall' + `nsec' + 2                 // two header rows + section headings

. putpdf clear

. putpdf begin, landscape font("Times New Roman", 9) margin(all, 0.5in)

. putpdf paragraph, spacing(after, 6pt)

. putpdf text ("Table R4-03. `=substr("`charttitle'", strpos("`charttitle'", ".") + 2, .)' — every plotted point"), bold
>  font("Times New Roman", 10)

. matrix colw = (22, 5.1, 5.1, 5.1, 5.1, 5.1, 5.1, 5.1, 5.1, 5.1, 5.1, 5.1, 5.4, 5.4, 11.1)

. putpdf table T = (`ntab', 15), border(all, nil) width(colw)

. * header row 1: panels; header row 2: series. Rules first, then merge cells from the
. * right, so the cell numbers on the left do not move.
. forvalues c = 1/15 {
  2.     putpdf table T(1, `c') = (""), border(top, single)
  3. }

. putpdf table T(1, 13) = ("Firms in the group"), bold halign(center) colspan(2) border(top, single)

. putpdf table T(1, 10) = ("(c) Split of (a), points"), bold halign(center) colspan(3) border(top, single)

. putpdf table T(1, 6)  = ("(b) Share of workers, change (points)"), bold halign(center) colspan(4) border(top, single)

. putpdf table T(1, 2)  = ("(a) Share of firms, change (points)"), bold halign(center) colspan(4) border(top, single)

. local cy2 = substr("`covid_end'", 3, 2)

. local py2 = substr("`placebo_end'", 3, 2)

. local h1  "Row on the chart"

. local h2  "`covid_year'–`cy2'"

. local h3  "`placebo_year'–`py2'"

. local h4  "Normal low"

. local h5  "Normal high"

. local h6  "`covid_year'–`cy2'"

. local h7  "`placebo_year'–`py2'"

. local h8  "Normal low"

. local h9  "Normal high"

. local h10 "Left"

. local h11 "Came in"

. local h12 "Both files"

. local h13 "`covid_year'"

. local h14 "`covid_end'"

. local h15 "Status"

. forvalues c = 1/15 {
  2.     local al = cond(inlist(`c', 1, 15), "left", "right")
  3.     putpdf table T(2, `c') = ("`h`c''"), bold halign(`al') border(bottom, single)
  4. }

. local r 2

. local prev ""

. forvalues i = 1/`nall' {
  2.     local sec = section[`i']
  3.     if "`sec'" != "`prev'" {
  4.         local ++r
  5.         putpdf table T(`r', 1) = ("`head`sec''"), bold
  6.         local prev "`sec'"
  7.     }
  8.     local ++r
  9.     local lab = group[`i']
 10.     if doubt[`i'] local lab "`lab' (`covid_end' records in doubt)"
 11.     putpdf table T(`r', 1) = ("`lab'")
 12.     local c 1
 13.     foreach v in chg_firms norm_chg_firms nmin_firms nmax_firms chg_workers norm_chg_workers nmin_workers nmax_work
> ers ///
>                  part_left_firms part_came_in_firms part_changed_firms {
 14.         local ++c
 15.         local x = `v'[`i']
 16.         local s = cond(missing(`x'), "", strtrim(string(`x', "%6.2f")))
 17.         putpdf table T(`r', `c') = ("`s'"), halign(right)
 18.     }
 19.     foreach v in firms_base firms_end {
 20.         local ++c
 21.         local x = `v'[`i']
 22.         local s = cond(missing(`x'), "", strtrim(string(`x', "%12.0fc")))
 23.         putpdf table T(`r', `c') = ("`s'"), halign(right)
 24.     }
 25.     putpdf table T(`r', 15) = ("`=status[`i']'"), margin(left, 6pt)
 26. }

. assert `r' == `ntab'

. forvalues c = 1/15 {
  2.     putpdf table T(`ntab', `c'), border(bottom, single)
  3. }

. putpdf paragraph, spacing(before, 6pt)

. putpdf text ("Values in percentage points, two decimals (the chart labels round the `covid_year'–`covid_end' dot to on
> e). Normal low and high = the ends of the gray bar. Firms in the group = firms in that row's group in each file (each 
> share is taken over every firm with a known answer; the CSV gives those counts). Every pair of files and every share i
> s in tables/03_composition_before_after_pairs.csv."), font("Times New Roman", 9)

. putpdf paragraph

. putpdf text ("`ntext'"), font("Times New Roman", 9)

. putpdf paragraph

. putpdf text ("`srcnote'"), font("Times New Roman", 9)

. putpdf paragraph

. putpdf text ("`devnote'"), font("Times New Roman", 9)

. putpdf save "tables/03_composition_before_after_table.pdf", replace
