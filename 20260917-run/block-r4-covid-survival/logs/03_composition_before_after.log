. * structural checks: shares of the size bands and of the sectors add up to 100 in each file
. foreach d in siz sec {
  2.     foreach v in share_firms_base share_firms_end share_workers_base share_workers_end {
  3.         quietly summarize `v' if dim == "`d'"
  4.         assert abs(r(sum) - 100) < 1e-6
  5.     }
  6. }

