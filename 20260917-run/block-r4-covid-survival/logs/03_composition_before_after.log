. * y positions: a bold heading per section, one blank row between sections
. gen double y = .
(27 missing values generated)

. local pos 0

. local ylab ""

. local prevsec ""

. local headsize   "Size (workers in the file)"

. local headtrade  "Imports and foreign ownership"

. local headsector "Sector (two-digit code), largest rise first"

. forvalues i = 1/`=_N' {
  2.     local sec = section[`i']
  3.     if "`sec'" != "`prevsec'" {
  4.         if "`prevsec'" != "" local pos = `pos' + 0.5
  5.         local ++pos
  6.         local ylab `"`ylab' `pos' "{bf:`head`sec''}""'
  7.         local prevsec "`sec'"
  8.     }
  9.     local ++pos
 10.     replace y = `pos' in `i'
 11.     local lab = group[`i']
 12.     if doubt[`i'] local lab "`lab' (`covid_end' records in doubt)"
 13.     local ylab `"`ylab' `pos' "`lab'""'
 14. }
