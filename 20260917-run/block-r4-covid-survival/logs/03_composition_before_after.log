. foreach m in firms workers {
  2.     local c = cond("`m'" == "firms", "n", "w")
  3.     local T = cond("`m'" == "firms", "K", "W")
  4.     gen double share_`m'_base = 100 * (`c'11 + `c'12) / (`T'11 + `T'12)
  5.     gen double share_`m'_end  = 100 * (`c'21 + `c'23) / (`T'21 + `T'23)
  6.     gen double chg_`m'        = share_`m'_end - share_`m'_base
  7.     gen double s_both_b = `c'11 / `T'11
  8.     gen double s_left   = cond(`T'12 > 0, `c'12 / `T'12, 0)
  9.     gen double s_both_e = `c'21 / `T'21
 10.     gen double s_came   = cond(`T'23 > 0, `c'23 / `T'23, 0)
 11.     gen double part_left_`m'    = -100 * `T'12 / (`T'11 + `T'12) * (s_left   - s_both_b)
 12.     gen double part_came_in_`m' =  100 * `T'23 / (`T'21 + `T'23) * (s_came   - s_both_e)
 13.     gen double part_changed_`m' =  100 * (s_both_e - s_both_b)
 14.     * the three parts add up to the change (exact identity)
.     assert abs(part_left_`m' + part_came_in_`m' + part_changed_`m' - chg_`m') < 1e-9 if !missing(s_both_b, s_both_e)
 15.     drop s_both_b s_left s_both_e s_came
 16. }

