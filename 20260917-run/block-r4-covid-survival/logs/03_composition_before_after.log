. quietly summarize known_came_in if row_order == 1

. local n_came = strtrim(string(r(mean), "%12.0fc"))

. quietly summarize known_both_base if row_order == 1

. local n_both = strtrim(string(r(mean), "%12.0fc"))

. keep if drawn
