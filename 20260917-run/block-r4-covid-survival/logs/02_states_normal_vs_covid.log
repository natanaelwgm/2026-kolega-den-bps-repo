. *---------------------------------------------------------------------------
. * Read back the CSV just written, so the table shows exactly the charted numbers.
. import delimited using "tables/02_states_normal_vs_covid.csv", clear varnames(1) encoding("utf-8") ///
>     stringcols(1 2 4 6 7 9 17)
(18 vars, 189 obs)

. keep if drawn == 1
