136.     post `pf' ("A") (`cohort_year') ("`f1' `f2' `f3'") (`st') ("`sttxt'") ("newcomers") (`j') ("Not in the starting
>  file, first in the `f' file") (0) ///
>         (r(N)) (`N') (100 * r(N) / `N') (.) (.) ("`outbasis'") (`band_pct')
137. }
