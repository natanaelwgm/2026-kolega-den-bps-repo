. *---------------------------------------------------------------------------
. display "Step 4/6: numbers for the notes (read from the data, never typed)"
Step 4/6: numbers for the notes (read from the data, never typed)

. *---------------------------------------------------------------------------
. quietly summarize firms if drawn & section == "A" & item_order == 2

. local n_back = r(sum)

. local outbasis = outcome_basis[1]

. local covidfile ""

. local reach ""

. local across ""

. foreach c of local starts {
  2.     if `st_`c'' == 1 local covidfile `c'
  3.     if `st_`c'' == 2 local reach `reach' `c'
  4.     if `st_`c'' == 3 local across `across' `c'
  5. }

. * word lists for the notes, e.g. "2013, 2014 and 2015"
. foreach w in reach across {
  2.     local n`w' : word count ``w''
  3.     local t`w' ""
  4.     forvalues i = 1/`n`w'' {
  5.         local x : word `i' of ``w''
  6.         if `i' == 1 local t`w' "`x'"
  7.         else if `i' == `n`w'' local t`w' "`t`w'' and `x'"
  8.         else local t`w' "`t`w'', `x'"
  9.     }
 10. }

. * Reading rule for the notes: the COVID-years stayed share against the range of the
. * starting files followed only before COVID reached Indonesia (status 3 and 4).
. foreach g in A B {
  2.     quietly summarize pct if drawn & section == "`g'" & item_order == 1 & status_code >= 3
  3.     local rmin`g' = strtrim(string(r(min), "%5.1f"))
  4.     local rmax`g' = strtrim(string(r(max), "%5.1f"))
  5.     local nnorm`g' = r(N)
  6.     quietly summarize pct if drawn & section == "`g'" & item_order == 1 & status_code == 1
  7.     local rcov`g' = strtrim(string(r(mean), "%5.1f"))
  8.     local rpos`g' = cond(r(mean) < real("`rmin`g''"), "below", cond(r(mean) > real("`rmax`g''"), "above", "inside")
> )
  9. }

. local reading ""

. if `nnormA' > 0 & `nnormB' > 0 & "`rcovA'" != "." & "`rcovB'" != "." {
.     local reading "Reading: the `covidfile' firms' stayed share (dashed line, `rcovA'%) is `rposA' the range of the fi
> les followed only before `covid_first' (`rminA'% to `rmaxA'%; lower group: `rcovB'%, `rposB' `rminB'% to `rmaxB'%); wi
> th the fictional firm links of the development data this says nothing about COVID either way."
. }

. local gapall ""

. foreach c of local across {
  2.     local gapall : list gapall | gap_`c'
  3. }

. local gapall : list sort gapall

. local gapt = subinstr("`gapall'", " ", ", ", .)

. 
. *---------------------------------------------------------------------------
. display "Step 5/6: 100% bars, one per starting file, two groups of firms"
Step 5/6: 100% bars, one per starting file, two groups of firms

. *---------------------------------------------------------------------------
. keep if drawn
(133 observations deleted)

. * y positions: a bold heading per group, one row per starting file (oldest on top),
. * and an empty row for every year with no annual file between starting files.
. gen double y = .
(56 missing values generated)

. local pos 0

. local ylab ""

. local headtext ""

. local gaprows ""

. local nstarts : word count `starts'

. foreach g in A B {
  2.     if "`g'" == "B" local pos = `pos' + 0.8
  3.     local ++pos
  4.     local head = cond("`g'" == "A", "All firms in the starting file", "Only firms also in one of the two files befo
> re")
  5.     local headtext `"`headtext' text(`=`pos' - 0.15' 0 "{bf:`head'}", placement(e) size(vsmall))"'   // heading ove
> r the bars
  6.     local first_`g' = `pos' + 1
  7.     forvalues i = 1/`nstarts' {
  8.         local c : word `i' of `starts'
  9.         if `i' > 1 {
 10.             local cprev : word `=`i' - 1' of `starts'
 11.             forvalues gy = `=`cprev' + 1'/`=`c' - 1' {
 12.                 local ++pos
 13.                 local ylab `"`ylab' `pos' "`gy': no annual file""'
 14.                 local gaprows `gaprows' `g'`gy'
 15.             }
 16.         }
 17.         local ++pos
 18.         quietly replace y = `pos' if section == "`g'" & cohort_year == `c'
 19.         local rl "`c' file, then `lf_`c''"
 20.         if `st_`c'' == 1 local rl "{bf:`rl'}"
 21.         local ylab `"`ylab' `pos' "`rl'""'
 22.     }
 23.     local last_`g' = `pos'
 24. }

. local ymax = `pos' + 0.6

. assert !missing(y)

. * pieces left to right: stayed, absent then back, left later, left at once
. sort section cohort_year item_order

. by section cohort_year: gen double x1 = sum(pct)

. gen double x0 = x1 - pct

. gen double mid = (x0 + x1) / 2

. gen double ylab_y = y - 0.10                                  // text sits low in Stata: centre it in the bar

. gen str8 in_lbl = strtrim(string(pct, "%5.1f")) if pct >= 7   // label a piece only when it is wide enough
(14 missing values generated)

. * status text right of each bar
. gen double st_x = 101.5

. gen str40 st_lbl = status_text if item_order == 1
(42 missing values generated)

. * dashed line: the COVID-years stayed share, over each group's rows
. quietly summarize pct if status_code == 1 & section == "A" & item_order == 1

. local refA = r(mean)

. quietly summarize pct if status_code == 1 & section == "B" & item_order == 1

. local refB = r(mean)

. local yA0 = `first_A' - 0.45

. local yA1 = `last_A' + 0.5

. local yB0 = `first_B' - 0.45

. local yB1 = `last_B' + 0.5

. local charttitle "Figure R4-02. Stayed in the files or left them: the `covidfile' firms against earlier years"

. 
. * Notes: one text, wrapped into lines of at most 108 characters (PDF text runs wider than the PNG)
. local ntext "Notes: Each bar = the firms of one annual file (the starting file), followed in its next three annual fil
> es. Absent, then back = missed the first or second later file, in the third again (`n_back' firms here); left later = 
> in the first or second, not in the third. Lower group: only firms also in one of the two files before (firms new to th
> e files leave more often). Starting files `tacross' are followed across the missing `gapt' file. `reading' Shares only
> , not the effect of COVID. Left the files is not proof of closure: a firm may have closed, fallen out of the survey or
>  stopped answering. Firm links are fictional in the development data, so who stays, leaves or comes back means nothing
>  here; read these results on the real BPS files."

. local notelines ""

. local line ""

. foreach w of local ntext {
  2.     if ustrlen("`line' `w'") > 108 & "`line'" != "" {
  3.         local notelines `"`notelines' "`line'""'
  4.         local line "`w'"
  5.     }
  6.     else local line = strtrim("`line' `w'")
  7. }

. local notelines `"`notelines' "`line'""'

. display `"   note lines: `notelines'"'
   note lines:  "Notes: Each bar = the firms of one annual file (the starting file), followed in its next three annual f
> iles." "Absent, then back = missed the first or second later file, in the third again (0 firms here); left later =" "i
> n the first or second, not in the third. Lower group: only firms also in one of the two files before (firms" "new to t
> he files leave more often). Starting files 2013, 2014 and 2015 are followed across the missing 2016" "file. Reading: t
> he 2019 firms' stayed share (dashed line, 55.8%) is inside the range of the files followed" "only before 2020 (54.7% t
> o 58.0%; lower group: 65.5%, inside 63.8% to 68.0%); with the fictional firm links" "of the development data this says
>  nothing about COVID either way. Shares only, not the effect of COVID. Left" "the files is not proof of closure: a fir
> m may have closed, fallen out of the survey or stopped answering." "Firm links are fictional in the development data, 
> so who stays, leaves or comes back means nothing here;" "read these results on the real BPS files."

