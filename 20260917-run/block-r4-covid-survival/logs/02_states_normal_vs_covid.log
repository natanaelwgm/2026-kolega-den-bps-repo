. local nrow = _N

. gen byte sorder = cond(section == "A", 1, 2)

. sort sorder cohort_year item_order

. local ngap : word count `gaprows'

. local ntab = `nrow' + `ngap' + 3                           // header + two group headings + gap rows

. putpdf clear

. putpdf begin, font("Times New Roman", 9) margin(all, 0.6in) landscape

. putpdf paragraph, spacing(after, 6pt)

. putpdf text ("Table R4-02. `=substr("`charttitle'", strpos("`charttitle'", ".") + 2, .)': every plotted point"), bold

. matrix colw = (19, 28, 7, 7, 7, 7, 8, 17)                  // column widths, % of the page width

. putpdf table T = (`ntab', 8), border(all, nil) width(colw)

. local h1 "Starting file (row on the chart)"

. local h2 "Piece of the bar"

. local h3 "Percent"

. local h4 "95% low"

. local h5 "95% high"

. local h6 "Firms"

. local h7 "Firms in bar"

. local h8 "Status"

. forvalues c = 1/8 {
  2.     local al = cond(inlist(`c', 1, 2, 8), "left", "right")
  3.     putpdf table T(1, `c') = ("`h`c''"), bold halign(`al') border(top, single) border(bottom, single)
  4.     if `c' == 8 putpdf table T(1, 8), margin(left, 8pt)
  5. }

. local r 1

. local prevs ""

. local prevc ""

. forvalues i = 1/`nrow' {
  2.     local s = section[`i']
  3.     local c = cohort_year[`i']
  4.     if "`s'" != "`prevs'" {
  5.         local ++r
  6.         putpdf table T(`r', 1) = ("`=section_name[`i']'"), bold colspan(8)
  7.         local prevs "`s'"
  8.         local prevc ""
  9.     }
 10.     * a row for every year with no annual file, where the chart leaves an empty row
.     if "`prevc'" != "" {
 11.         forvalues gy = `=`prevc' + 1'/`=`c' - 1' {
 12.             local ++r
 13.             putpdf table T(`r', 1) = ("`gy': no annual file")
 14.             putpdf table T(`r', 8) = ("not drawn: no file"), margin(left, 8pt)
 15.         }
 16.     }
 17.     local prevc `c'
 18.     local ++r
 19.     local rl = cond(item_order[`i'] == 1, "`c' file, then `lf_`c''", "")
 20.     putpdf table T(`r', 1) = ("`rl'")
 21.     putpdf table T(`r', 2) = ("`=item[`i']'")
 22.     putpdf table T(`r', 3) = ("`=strtrim(string(pct[`i'], "%5.1f"))'"), halign(right)
 23.     putpdf table T(`r', 4) = ("`=strtrim(string(ci_lo[`i'], "%5.1f"))'"), halign(right)
 24.     putpdf table T(`r', 5) = ("`=strtrim(string(ci_hi[`i'], "%5.1f"))'"), halign(right)
 25.     putpdf table T(`r', 6) = ("`=strtrim(string(firms[`i'], "%12.0fc"))'"), halign(right)
 26.     putpdf table T(`r', 7) = ("`=strtrim(string(base_firms[`i'], "%12.0fc"))'"), halign(right)
 27.     local stt = cond(pct[`i'] == 0, "drawn (zero width)", cond(pct[`i'] < 7, "drawn (no label: narrow)", "drawn"))
 28.     if item_order[`i'] == 1 local stt "`stt'; `=status_text[`i']'"
 29.     putpdf table T(`r', 8) = ("`stt'"), margin(left, 8pt)
 30. }

. assert `r' == `ntab'

. forvalues c = 1/8 {
  2.     putpdf table T(`ntab', `c'), border(bottom, single)
  3. }

. putpdf paragraph, spacing(before, 6pt)

. putpdf text ("95% interval: Wilson interval for a share, treating the firms of the starting file as a sample; the star
