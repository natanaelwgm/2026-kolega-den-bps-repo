. *---------------------------------------------------------------------------
. * Both starting files in one multinomial logit, every term (traits, sector and province
. * groups, hence also the constants) specific to its starting file: the same model as the
. * two separate ones (checked), but one covariance matrix, so the difference between the
. * files can use firms that are in both (clustered by firm). Needs the same modelled
. * outcomes in both files; otherwise the differences are left empty and said so.
. foreach m in wk out {
  2.     local both_`m' : list terms_`m'_`cohort_covid' & terms_`m'_`cohort_normal'
  3.     local sameouts : list outs_`m'_`cohort_covid' === outs_`m'_`cohort_normal'
  4.     scalar pooled_`m' = 0
  5.     scalar maxdev_`m' = .
  6.     if !(ok_`m'_`cohort_covid' & ok_`m'_`cohort_normal' & `sameouts') | "`both_`m''" == "" {
  7.         display "   `mw_`m'': differences not computed (a model did not run, or the files model different outcomes)
> "
  8.         continue
  9.     }
 10.     * one marker per trait, 0 in the rows of a file where that trait is not estimated;
.     * ibn.coh# gives every marker its own coefficient per starting file
.     local alls : list terms_`m'_`cohort_covid' | terms_`m'_`cohort_normal'
 11.     local evars ""
 12.     local efv ""
 13.     foreach t of local alls {
 14.         capture drop e`t'
 15.         gen byte e`t' = 0
 16.         foreach c of local cohorts {
 17.             local inc : list t in terms_`m'_`c'
 18.             if `inc' replace e`t' = d`t' if coh == `c'
 19.         }
 20.         local evars `evars' e`t'
 21.         local efv `efv' ibn.coh#i.e`t'
 22.     }
 23.     capture noisily mlogit outcome5_`m' `efv' i.csec i.cprov if ms_`m', ///
>         baseoutcome(`base_`m'_`cohort_covid'') vce(cluster firm_id) iterate(100)
 24.     if _rc | e(converged) != 1 {
 25.         display as error "   `mw_`m'': the pooled model did not run: differences left empty"
 26.         continue
 27.     }
 28.     scalar pooled_`m' = 1
 29.     estimates store pool_`m'
 30.     scalar maxdev_`m' = 0
 31.     * the same "with minus without" pairs as the separate models, per starting file
.     local atl ""
 32.     local na 0
 33.     foreach t of local alls {
 34.         local pt ""
 35.         if "`pair`t''" != "" {
 36.             local inp : list pair`t' in alls
 37.             if `inp' local pt " e`pair`t''=0"
 38.         }
 39.         local atl `atl' at(e`t'=0`pt') at(e`t'=1`pt')
 40.         local na = `na' + 2
 41.         local at1_`t' = `na'                               // "with" position; "without" = one before
 42.     }
 43.     foreach j of local outs_`m'_`cohort_covid' {
 44.         estimates restore pool_`m'
 45.         quietly margins, `atl' predict(outcome(`j')) over(coh) post
 46.         matrix mb = e(b)
 47.         local cn : colfullnames e(b)
 48.         * find each (at, file) cell by name (Stata may add "bn" to base levels)
.         local q 0
 49.         foreach nm of local cn {
 50.             local ++q
 51.             local cl = subinstr("`nm'", "bn", "", .)
 52.             foreach c of local cohorts {
 53.                 forvalues a = 1/`na' {
 54.                     if "`cl'" == "`a'._at#`c'.coh" {
 55.                         local nm_`a'_`c' "`nm'"
 56.                         local qq_`a'_`c' `q'
 57.                     }
 58.                 }
 59.             }
 60.         }
 61.         foreach c of local cohorts {
 62.             foreach t of local terms_`m'_`c' {
 63.                 local a1 = `at1_`t''
 64.                 local a0 = `a1' - 1
 65.                 assert "`nm_`a1'_`c''" != "" & "`nm_`a0'_`c''" != ""
 66.                 scalar maxdev_`m' = max(maxdev_`m', abs(mb[1, `qq_`a1'_`c''] - mb[1, `qq_`a0'_`c''] - ame_`m'_`c'_`
> j'_`t'))
 67.             }
 68.         }
 69.         * 2019 minus 2012, trait by trait, and all traits together
.         local jt ""
 70.         foreach t of local both_`m' {
 71.             local a1 = `at1_`t''
 72.             local a0 = `a1' - 1
 73.             local ex "_b[`nm_`a1'_`cohort_covid''] - _b[`nm_`a0'_`cohort_covid''] - _b[`nm_`a1'_`cohort_normal''] +
>  _b[`nm_`a0'_`cohort_normal'']"
 74.             quietly lincom `ex'
 75.             scalar dif_`m'_`j'_`t' = r(estimate)
 76.             scalar dse_`m'_`j'_`t' = r(se)
 77.             scalar dp_`m'_`j'_`t'  = r(p)
 78.             local jt `jt' (`ex' = 0)
 79.         }
 80.         quietly test `jt'
 81.         scalar jp_`m'_`j' = r(p)
 82.     }
 83.     * the pooled model reproduces the separate models' effects (a gross-error guard;
.     * the two fits stop at slightly different points of the same maximum)
.     display "   `mw_`m'': largest gap pooled vs separate effects " %9.2e maxdev_`m'
 84.     assert maxdev_`m' < 1e-4
 85. }
