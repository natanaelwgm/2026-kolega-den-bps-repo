 19.                             scalar dd_ = 100 * dif_`m'_`j'_`t'
 20.                             scalar ds_ = 100 * dse_`m'_`j'_`t'
 21.                             scalar dp_ = dp_`m'_`j'_`t'
 22.                         }
 23.                     }
 24.                     scalar lb_ = .
 25.                     scalar ls_ = .
 26.                     if `j' != `base_`m'_`c'' {
 27.                         scalar lb_ = lb_`m'_`c'_`j'_`t'
 28.                         scalar ls_ = lse_`m'_`c'_`j'_`t'
 29.                     }
 30.                     post `pf' ("effect") ("`m'") (`c') ("`lf'") (`j') ("`o`j''") (`t') ("`t`t''") (1) ("`m'" == "wk
> ") ("`st'") ///
>                         (a_) (s_) (a_ - z_ * s_) (a_ + z_ * s_) (dd_) (ds_) (dp_) (lb_) (ls_) ///
>                         (nw_`m'_`c'_`t') (nwo_`m'_`c'_`t') (nwj_`m'_`c'_`t'_`j') (nfm_`m'_`c') (no_`m'_`c'_`j') (.) (.
> ) (.)
 31.                 }
 32.                 else {
 33.                     local st "not estimated: the model did not run"
 34.                     if !`test' local st "not estimated: too few firms with or without the trait (fewer than `min_fi
> rms')"
 35.                     if !`oest' local st "not estimated: too few firms in this outcome: `=no_`m'_`c'_`j'' (fewer tha
> n `min_firms')"
 36.                     post `pf' ("effect") ("`m'") (`c') ("`lf'") (`j') ("`o`j''") (`t') ("`t`t''") (0) (0) ("`st'") 
> ///
>                         (.) (.) (.) (.) (.) (.) (.) (.) (.) ///
>                         (nw_`m'_`c'_`t') (nwo_`m'_`c'_`t') (nwj_`m'_`c'_`t'_`j') (nfm_`m'_`c') (no_`m'_`c'_`j') (.) (.
> ) (.)
 37.                 }
 38.             }
 39.             * (b) one row per outcome: how many firms, share of the starting file's firms
.             local st = cond(`oest', "modelled", "not modelled: too few firms: `=no_`m'_`c'_`j'' (fewer than `min_firms
> ')")
 40.             if `j' == `base_`m'_`c'' local st "modelled (base outcome of the raw coefficients)"
 41.             post `pf' ("outcome") ("`m'") (`c') ("`lf'") (`j') ("`o`j''") (0) ("`o`j''") (`oest') (0) ("`st'") ///
>                 (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (nfm_`m'_`c') (no_`m'_`c'_`j') (.) ///
>                 (100 * no_`m'_`c'_`j' / nfu_`m'_`c') (.)
 42.             * (c) calibration by tenth of predicted chance
.             if `oest' & ok_`m'_`c' {
 43.                 forvalues d = 1/`ndec_`m'_`c'_`j'' {
 44.                     post `pf' ("calibration") ("`m'") (`c') ("`lf'") (`j') ("`o`j''") (`d') ("Tenth `d' of predicte
> d chance") (.) (0) ("") ///
>                         (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (cn_`m'_`c'_`j'_`d') ///
>                         (cp_`m'_`c'_`j'_`d') (ca_`m'_`c'_`j'_`d') (.)
 45.                 }
 46.                 foreach s in "area under ROC curve|auc" "largest calibration gap (points)|gap" {
 47.                     tokenize "`s'", parse("|")
 48.                     post `pf' ("check") ("`m'") (`c') ("`lf'") (`j') ("`o`j''") (0) ("`1'") (.) (0) ("") ///
>                         (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (`3'_`m'_`c'_`j')
 49.                 }
 50.                 if `c' == `cohort_covid' & pooled_`m' {
 51.                     post `pf' ("check") ("`m'") (`c') ("`lf'") (`j') ("`o`j''") (0) ("all traits `cohort_covid' = `
> cohort_normal', joint p") (.) (0) ("") ///
>                         (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (jp_`m'_`j')
 52.                 }
 53.                 * table-only check (workers): value added per worker, continuous, per SD
.                 if "`m'" == "wk" {
 54.                     post `pf' ("check") ("`m'") (`c') ("`lf'") (`j') ("`o`j''") (0) ("value added per worker, conti
> nuous (per SD): effect") (.) (0) ("table-only check, not drawn") ///
>                         (cz_b_`c'_`j') (cz_se_`c'_`j') (cz_b_`c'_`j' - z_ * cz_se_`c'_`j') (cz_b_`c'_`j' + z_ * cz_se_
> `c'_`j') ///
>                         (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.)
 55.                 }
 56.             }
 57.         }
 58.         * (d) model checks, one statistic per row
.         local k 0
 59.         foreach s in "firms in the starting file|nf" "firms with every trait known|nfu" ///
>             "stayers left out: size change not comparable|nnc" "firms left out: outcome with too few firms|nrare" ///
>             "firms in the model|nfm" "model ran and converged|ok" "pseudo R-squared (McFadden)|r2p" ///
>             "coefficients above 10 (near perfect prediction)|nbig" "largest gap pooled vs separate effects|maxdev" {
 60.             local ++k
 61.             tokenize "`s'", parse("|")
 62.             if "`3'" == "maxdev" & `c' != `cohort_covid' continue
 63.             local sc = cond("`3'" == "maxdev", "maxdev_`m'", "`3'_`m'_`c'")
 64.             post `pf' ("check") ("`m'") (`c') ("`lf'") (0) ("") (`k') ("`1'") (.) (0) ("") ///
>                 (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (`sc')
 65.         }
 66.         post `pf' ("check") ("`m'") (`c') ("`lf'") (0) ("") (`++k') ("importer share of firms (%)") (.) (0) ("") //
> /
>             (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (`impsh_`c'')
 67.     }
 68. }

. postclose `pf'

. use `res', clear

. gen str80 outcome_basis = cond(measure == "wk", "workers", "`outbasis_`cohort_covid''")

. gen double band_pct = `band_pct'

. format ame_pp-stat_value %12.6f

. format firms_with-firms_outcome %12.0f

. export delimited using "tables/`fname'.csv", datafmt replace
