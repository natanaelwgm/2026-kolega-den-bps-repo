. foreach m in wk out {
  2.     local ptitle = cond("`m'" == "wk", "Panel A. Stayers split by workers (drawn in the figure)", "Panel B. Stayers
>  split by `mw_out'; not drawn")
  3.     local e ""
  4.     forvalues q = 1/`ncol' {
  5.         local e `"`e' ("")"'
  6.     }
  7.     post `P' ("`ptitle'") `e'
  8.     local ++nrow
  9.     forvalues t = 1/`nterm' {
 10.         local lb ""
 11.         local ls ""
 12.         foreach cj of local cols {
 13.             if "`cj'" == "sp" {
 14.                 local lb `"`lb' ("")"'
 15.                 local ls `"`ls' ("")"'
 16.                 continue
 17.             }
 18.             gettoken c j : cj, parse("_")
 19.             local j = subinstr("`j'", "_", "", 1)
 20.             quietly summarize ame_pp if section == "effect" & measure == "`m'" & cohort_year == `c' & outcome_id ==
>  `j' & row_id == `t' & estimated, meanonly
 21.             if r(N) == 0 {
 22.                 local lb `"`lb' ("—")"'
 23.                 local ls `"`ls' ("")"'
 24.                 continue
 25.             }
 26.             local bb = cond(round(r(mean), 0.01) > 0, "+", "") + string(r(mean), "%9.2f")
 27.             quietly summarize ame_se_pp if section == "effect" & measure == "`m'" & cohort_year == `c' & outcome_id
>  == `j' & row_id == `t', meanonly
 28.             local ss = "(" + string(r(mean), "%9.2f") + ")"
 29.             local lb `"`lb' ("`bb'")"'
 30.             local ls `"`ls' ("`ss'")"'
 31.         }
 32.         post `P' ("`t`t''") `lb'
 33.         post `P' ("") `ls'
 34.         local nrow = `nrow' + 2
 35.     }
 36.     local rl `rl' `nrow'
 37.     * table-only check under Panel A (as R4-04): value added per worker, continuous
.     if "`m'" == "wk" {
 38.         local lb ""
 39.         local ls ""
 40.         foreach cj of local cols {
 41.             local b ""
 42.             local se ""
 43.             if "`cj'" != "sp" {
 44.                 gettoken c j : cj, parse("_")
 45.                 local j = subinstr("`j'", "_", "", 1)
 46.                 quietly summarize ame_pp if section == "check" & measure == "wk" & cohort_year == `c' & outcome_id 
> == `j' & label == "value added per worker, continuous (per SD): effect", meanonly
 47.                 if r(N) > 0 & r(mean) < . {
 48.                     local b = cond(round(r(mean), 0.01) > 0, "+", "") + string(r(mean), "%9.2f")
 49.                     quietly summarize ame_se_pp if section == "check" & measure == "wk" & cohort_year == `c' & outc
> ome_id == `j' & label == "value added per worker, continuous (per SD): effect", meanonly
 50.                     local se = "(" + string(r(mean), "%9.2f") + ")"
 51.                 }
 52.                 else local b "—"
 53.             }
 54.             local lb `"`lb' ("`b'")"'
 55.             local ls `"`ls' ("`se'")"'
 56.         }
 57.         post `P' ("Check, not drawn: value added per worker, continuous (per SD)") `lb'
 58.         post `P' ("") `ls'
 59.         local nrow = `nrow' + 2
 60.         local rl `rl' `nrow'
 61.     }
 62.     * whole-model rows, one statistic per column
.     foreach s in "Firms in this outcome|n" "Share of the model's firms (%)|sh" "Firms in the model|nm" ///
>         "Sector and province groups|fe" "Pseudo R-squared (McFadden)|r2" ///
>         "Coefficients above 10 in the model (near perfect prediction)|nb" "Area under ROC curve, this outcome|auc" ///
>         "Largest calibration gap (points)|gap" "All traits same in `cohort_covid' and `cohort_normal', joint p|jp" ///
>         "Standard errors clustered by|cl" {
 63.         tokenize "`s'", parse("|")
 64.         local lab "`1'"
 65.         local key "`3'"
 66.         local vals ""
 67.         foreach cj of local cols {
 68.             if "`cj'" == "sp" {
 69.                 local vals `"`vals' ("")"'
 70.                 continue
 71.             }
 72.             gettoken c j : cj, parse("_")
 73.             local j = subinstr("`j'", "_", "", 1)
 74.             local v ""
 75.             quietly summarize firms_outcome if section == "outcome" & measure == "`m'" & cohort_year == `c' & outco
> me_id == `j', meanonly
 76.             local nj = r(mean)
 77.             quietly summarize firms_model if section == "outcome" & measure == "`m'" & cohort_year == `c' & outcome
> _id == `j', meanonly
 78.             local nm = r(mean)
 79.             quietly count if section == "outcome" & measure == "`m'" & cohort_year == `c' & outcome_id == `j' & est
> imated
 80.             local oe = r(N)
 81.             if "`key'" == "n"  local v = string(`nj', "%12.0fc")
 82.             if "`key'" == "sh" & `oe' local v = string(100 * `nj' / `nm', "%5.1f")
 83.             if "`key'" == "nm" & `oe' local v = string(`nm', "%12.0fc")
 84.             if "`key'" == "fe" & `oe' local v "Yes"
 85.             if "`key'" == "cl" & `oe' local v "Firm"
 86.             foreach kk in r2 nb auc gap jp {
 87.                 if "`key'" != "`kk'" continue
 88.                 local lk = cond("`kk'" == "r2", "pseudo R-squared (McFadden)", cond("`kk'" == "auc", "area under RO
> C curve", ///
>                     cond("`kk'" == "gap", "largest calibration gap (points)", cond("`kk'" == "nb", ///
>                     "coefficients above 10 (near perfect prediction)", "all traits `cohort_covid' = `cohort_normal', j
> oint p"))))
 89.                 local oc = cond(inlist("`kk'", "r2", "nb"), 0, `j')
 90.                 quietly summarize stat_value if section == "check" & measure == "`m'" & cohort_year == `c' & outcom
> e_id == `oc' & label == "`lk'", meanonly
 91.                 if r(N) > 0 & r(mean) < . {
 92.                     if "`kk'" == "gap" local v = string(r(mean), "%5.1f")
 93.                     else if "`kk'" == "jp" local v = cond(r(mean) < 0.001, "< 0.001", string(r(mean), "%5.3f"))
 94.                     else if "`kk'" == "nb" local v = string(r(mean), "%9.0f")
 95.                     else local v = string(r(mean), "%5.3f")
 96.                 }
 97.             }
 98.             if "`v'" == "" & !`oe' & "`key'" != "n" local v "—"
 99.             local vals `"`vals' ("`v'")"'
100.         }
101.         post `P' ("`lab'") `vals'
102.         local ++nrow
103.     }
104.     local rl `rl' `nrow'
105. }

