. display "Step 3/9: trait markers; which outcomes and traits have enough firms to estimate"
Step 3/9: trait markers; which outcomes and traits have enough firms to estimate

. *---------------------------------------------------------------------------
. use `stack', clear
(G0 -> G0.25 OBSCURED -> G0.5 DUMMY PANEL -> G1 RE-ESTIMATED)

. * 0/1 marker per trait (reference groups: 20-99 workers; known non-exporters) - as R4-04
. gen byte d1 = (sizeb == 1) if !missing(sizeb)   // fewer than 20 workers

. gen byte d2 = (sizeb == 3) if !missing(sizeb)   // 100 or more workers

. gen byte d3 = hiprod                            // value added per worker above its sector's median

. gen byte d4 = (expst == 1)                      // exporter

. gen byte d5 = (expst == 2)                      // export answer not known

. gen byte d6 = imp                               // importer

. gen byte d7 = fdi                               // 10% or more foreign-owned

. gen byte d8 = new_to_file                       // in neither of the two files before

. local nterm 8

. * Size band and export answer have three groups each, so their two markers are one trait:
. * an effect compares a group with the reference group (20-99 workers; known non-exporters),
. * the other marker of the pair switched off in both (a factor contrast; R4-04 does the same)
. local pair1 2

. local pair2 1

. local pair4 5

. local pair5 4

. local t1 "Fewer than 20 workers"

. local t2 "100 or more workers"

. local t3 "Value added per worker above its sector's median"

. local t4 "Exporter"

. local t5 "Export answer not known"

. local t6 "Importer"

. local t7 "Foreign-owned (10% or more)"

. local t8 "New to the files (not in the two files before)"

. * the five outcomes (codes of the shared block's outcome5_wk / outcome5_out)
. local o1 "Left the files"

. local o2 "Absent, then back"

. local o3 "Stayed, shrank"

. local o4 "Stayed, same size"

. local o5 "Stayed, grew"

. local mw_wk  "workers"

. local mw_out = cond("`outbasis_`cohort_covid''" == "gross_output_real", "output (constant prices)", "output (current p
> rices)")

. * a firm is usable when every trait is known (value added per worker needs workers > 0)
. egen byte n_miss = rowmiss(d1-d8)

. gen byte usable = (n_miss == 0)

. label values outcome5_wk outcome5_out .       // numeric outcome codes = equation names 1 ... 5

. * cohort-specific sector and province groups (each starting file its own dummies)
. egen long csec  = group(coh sector)

. egen long cprov = group(coh prov)

. * importer share of each starting file's usable firms (for the notes: not like for like)
. foreach c of local cohorts {
  2.     quietly summarize d6 if coh == `c' & usable
  3.     local impsh_`c' = strtrim(string(100 * r(mean), "%5.0f"))
  4. }

. foreach m in wk out {
  2.     gen byte ms_`m' = 0                        // 1 = firm is in this measure's model
  3.     foreach c of local cohorts {
  4.         quietly count if coh == `c'
  5.         scalar nf_`m'_`c' = r(N)                               // firms in the starting file
  6.         quietly count if coh == `c' & usable
  7.         scalar nfu_`m'_`c' = r(N)                              // every trait known
  8.         quietly count if coh == `c' & usable & missing(outcome5_`m')
  9.         scalar nnc_`m'_`c' = r(N)                              // stayers not comparable (no size change)
 10.         * outcomes: modelled only with min_firms or more firms; the firms of a rarer
.         * outcome are left out of the model (and counted)
.         local outs_`m'_`c' ""
 11.         scalar nrare_`m'_`c' = 0
 12.         forvalues j = 1/5 {
 13.             quietly count if coh == `c' & usable & outcome5_`m' == `j'
 14.             scalar no_`m'_`c'_`j' = r(N)
 15.             if r(N) >= `min_firms' local outs_`m'_`c' `outs_`m'_`c'' `j'
 16.             else scalar nrare_`m'_`c' = nrare_`m'_`c' + r(N)
 17.         }
 18.         local nouts : word count `outs_`m'_`c''
 19.         local model_`m'_`c' = (`nouts' >= 2)
 20.         foreach j of local outs_`m'_`c' {
 21.             replace ms_`m' = 1 if coh == `c' & usable & outcome5_`m' == `j'
 22.         }
 23.         quietly count if coh == `c' & ms_`m'
 24.         scalar nfm_`m'_`c' = r(N)                              // firms in the model
 25.         local base_`m'_`c' : word 1 of `outs_`m'_`c''          // base outcome (effects do not depend on it)
 26.         * traits: estimated only with min_firms or more model firms with and without it
.         local terms_`m'_`c' ""
 27.         forvalues t = 1/`nterm' {
 28.             quietly count if coh == `c' & ms_`m' & d`t' == 1
 29.             scalar nw_`m'_`c'_`t' = r(N)
 30.             quietly count if coh == `c' & ms_`m' & d`t' == 0
 31.             scalar nwo_`m'_`c'_`t' = r(N)
 32.             forvalues j = 1/5 {
 33.                 quietly count if coh == `c' & ms_`m' & d`t' == 1 & outcome5_`m' == `j'
 34.                 scalar nwj_`m'_`c'_`t'_`j' = r(N)              // firms with the trait in outcome j
 35.             }
 36.             if nw_`m'_`c'_`t' >= `min_firms' & nwo_`m'_`c'_`t' >= `min_firms' & `model_`m'_`c'' ///
>                 local terms_`m'_`c' `terms_`m'_`c'' `t'
 37.         }
 38.         display "   `mw_`m'', `c' firms: " nf_`m'_`c' " (traits known " nfu_`m'_`c' ", in the model " nfm_`m'_`c' /
> //
>             "); outcomes modelled: `outs_`m'_`c''; traits: `terms_`m'_`c''"
 39.         forvalues j = 1/5 {
 40.             display "      outcome `j' (`o`j''): " no_`m'_`c'_`j' " firms"
 41.         }
 42.     }
 43. }
