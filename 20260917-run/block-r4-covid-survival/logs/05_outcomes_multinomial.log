  8.     local j = subinstr("`j'", "_", "", 1)
  9.     local oname = lower(substr("`o`j''", 1, 1)) + substr("`o`j''", 2, .)
 10.     local oname = subinstr("`oname'", "stayed, ", "", 1)
 11.     local hdr `"`hdr' "(`q')|`c':|`oname'""'
