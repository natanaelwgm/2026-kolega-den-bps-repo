. *---------------------------------------------------------------------------
. display "Step 4/9: one multinomial logit per starting file; effects in points; model checks"
Step 4/9: one multinomial logit per starting file; effects in points; model checks

. *---------------------------------------------------------------------------
. * Model, per firm i of starting file c:
. *   Pr(firm i ends in outcome j by the third later file)
. *     = exp(a_j + traits x b_j + sector_j + province_j) / sum over outcomes of the same
. * Effects (the dots) = average marginal effects: for each firm, the chance of outcome j
. * with the trait minus without it (everything else as observed), averaged over the
. * firms of the starting file, in percentage points. For one trait the effects of all
. * modelled outcomes add up to zero (checked).
. foreach c of local cohorts {
  2.     forvalues j = 1/5 {
  3.         scalar cz_b_`c'_`j'  = .                  // continuous check, filled below
  4.         scalar cz_se_`c'_`j' = .
  5.     }
  6. }

. foreach m in wk out {
  2.     foreach j in 1 2 3 4 5 {
  3.         gen double pr_`m'_`j' = .               // predicted chance of each outcome
  4.     }
  5.     foreach c of local cohorts {
  6.         scalar ok_`m'_`c' = 0
  7.         scalar conv_`m'_`c' = .
  8.         scalar r2p_`m'_`c' = .
  9.         scalar nbig_`m'_`c' = .
 10.         local xs ""
 11.         foreach t of local terms_`m'_`c' {
 12.             local xs `xs' d`t'
 13.         }
 14.         if !`model_`m'_`c'' | "`xs'" == "" continue
 15.         capture noisily mlogit outcome5_`m' i.(`xs') i.csec i.cprov if coh == `c' & ms_`m', ///
>             baseoutcome(`base_`m'_`c'') vce(cluster firm_id) iterate(100)
 16.         if _rc {
 17.             display as error "   `mw_`m'' `c': the model did not run: its dots are written as 'not estimated'"
 18.             continue
 19.         }
 20.         scalar conv_`m'_`c' = e(converged)
 21.         if e(converged) != 1 {
 22.             display as error "   `mw_`m'' `c': the model did not converge: its dots are written as 'not estimated'"
 23.             continue
 24.         }
 25.         scalar ok_`m'_`c' = 1
 26.         scalar r2p_`m'_`c' = e(r2_p)                          // McFadden pseudo R-squared
 27.         assert e(N) == nfm_`m'_`c'                            // every model firm used
 28.         * near perfect prediction: coefficients above 10 in absolute value (log odds)
.         matrix B = e(b)
 29.         matrix V = e(V)
 30.         scalar nbig_`m'_`c' = 0
 31.         forvalues k = 1/`=colsof(B)' {
 32.             if abs(B[1, `k']) > 10 & V[`k', `k'] > 0 scalar nbig_`m'_`c' = nbig_`m'_`c' + 1
 33.         }
 34.         * raw coefficients (log odds against the base outcome), CSV only
.         foreach j of local outs_`m'_`c' {
 35.             foreach t of local terms_`m'_`c' {
 36.                 scalar lb_`m'_`c'_`j'_`t'  = _b[`j':1.d`t']
 37.                 scalar lse_`m'_`c'_`j'_`t' = _se[`j':1.d`t']
 38.             }
 39.             tempvar p
 40.             predict double `p' if e(sample), pr outcome(`j')
 41.             replace pr_`m'_`j' = `p' if e(sample)
 42.             drop `p'
 43.         }
 44.         estimates store sep_`m'_`c'
 45.         * average marginal effects, outcome by outcome: for each trait, the average predicted
.         * chance with the trait (at 1) minus without it (at 0), over the file's firms; for size
.         * band and export answer the partner marker is 0 in both (group against reference group)
.         local atl ""
 46.         foreach t of local terms_`m'_`c' {
 47.             local pt ""
 48.             if "`pair`t''" != "" {
 49.                 local inp : list pair`t' in terms_`m'_`c'
 50.                 if `inp' local pt " d`pair`t''=0"
 51.             }
 52.             local atl `atl' at(d`t'=0`pt') at(d`t'=1`pt')
 53.         }
 54.         foreach j of local outs_`m'_`c' {
 55.             estimates restore sep_`m'_`c'
 56.             quietly margins, `atl' predict(outcome(`j')) post
 57.             local k 0
 58.             foreach t of local terms_`m'_`c' {
 59.                 local k = `k' + 2
 60.                 quietly lincom _b[`k'._at] - _b[`=`k' - 1'._at]
 61.                 scalar ame_`m'_`c'_`j'_`t' = r(estimate)
 62.                 scalar ase_`m'_`c'_`j'_`t' = r(se)
 63.             }
 64.         }
 65.         * check: for each trait the effects over the modelled outcomes add up to zero
.         foreach t of local terms_`m'_`c' {
 66.             scalar s_ = 0
 67.             foreach j of local outs_`m'_`c' {
 68.                 scalar s_ = s_ + ame_`m'_`c'_`j'_`t'
 69.             }
 70.             assert abs(s_) < 1e-8
 71.         }
 72.         * calibration: firms sorted into tenths of the predicted chance of outcome j;
.         * predicted vs actual share per tenth; the largest gap; area under the ROC curve
.         foreach j of local outs_`m'_`c' {
 73.             tempvar y dec
 74.             gen byte `y' = (outcome5_`m' == `j') if coh == `c' & ms_`m'
 75.             quietly roctab `y' pr_`m'_`j' if coh == `c' & ms_`m'
 76.             scalar auc_`m'_`c'_`j' = r(area)                  // 0.5 = no better than chance
 77.             quietly xtile `dec' = pr_`m'_`j' if coh == `c' & ms_`m', nquantiles(10)
 78.             scalar gap_`m'_`c'_`j' = 0
 79.             quietly levelsof `dec', local(decs)
 80.             local ndec_`m'_`c'_`j' : word count `decs'
 81.             foreach d of local decs {
 82.                 quietly count if `dec' == `d'
 83.                 scalar cn_`m'_`c'_`j'_`d' = r(N)
 84.                 quietly summarize `y' if `dec' == `d'
 85.                 scalar ca_`m'_`c'_`j'_`d' = 100 * r(mean)
 86.                 quietly summarize pr_`m'_`j' if `dec' == `d'
 87.                 scalar cp_`m'_`c'_`j'_`d' = 100 * r(mean)
 88.                 scalar gap_`m'_`c'_`j' = max(gap_`m'_`c'_`j', abs(ca_`m'_`c'_`j'_`d' - cp_`m'_`c'_`j'_`d'))
 89.             }
 90.             drop `y' `dec'
 91.         }
 92.         display "   `mw_`m'' `c': firms " nfm_`m'_`c' ", pseudo R2 " %5.3f r2p_`m'_`c' ///
>             ", coefficients above 10 (near perfect prediction) " nbig_`m'_`c'
 93.         * table-only check (as R4-04; not drawn): value added per worker as a continuous
.         * measure (log distance from its sector's median, per standard deviation across the
.         * starting file's firms) in place of the yes/no marker; otherwise the same model
.         if "`m'" == "wk" {
 94.             local dd3 d3
 95.             local xz : list xs - dd3
 96.             capture drop zc
 97.             quietly summarize lvr if coh == `c' & usable
 98.             gen double zc = lvr / r(sd) if coh == `c'
 99.             capture {
100.                 quietly mlogit outcome5_`m' `=cond("`xz'" != "", "i.(`xz')", "")' c.zc i.csec i.cprov if coh == `c'
>  & ms_`m', ///
>                     baseoutcome(`base_`m'_`c'') vce(cluster firm_id) iterate(100)
101.                 foreach j of local outs_`m'_`c' {
102.                     quietly margins, dydx(zc) predict(outcome(`j'))
103.                     matrix mz = r(b)
104.                     matrix vz = r(V)
105.                     scalar cz_b_`c'_`j'  = 100 * mz[1, 1]
106.                     scalar cz_se_`c'_`j' = 100 * sqrt(vz[1, 1])
107.                 }
108.             }
109.             capture drop zc
110.             foreach j of local outs_`m'_`c' {
111.                 display "   check `c', outcome `j': value added per worker, continuous (per SD): " %6.2f cz_b_`c'_`
> j' " points (SE " %5.2f cz_se_`c'_`j' ")"
112.             }
113.         }
114.     }
115. }
