 13.             local nval .
 14.             local nst "no earlier file in the data"
 15.         }
 16.         post `pf' ("count") ("") (`c') ("`lf'") ("all") ("") ("`ob_`c''") (.) (.) (`c') ("`lab'") ///
>             (.) (.) (.) (`nval') (.) (0) ("`nst'")
 17.     }
 18.     * -- the middle level of all firms in each file (not the same firms), start = 100 --
.     foreach m in wk out {
 19.         local mname = cond("`m'" == "wk", "workers", "output")
 20.         local pn = cond("`m'" == "wk", "a", "b")
 21.         forvalues k = 0/3 {
 22.             local yy `c'
 23.             if `k' > 0 local yy `f`k'_`c''
 24.             local fv = 100 * `fm_`m'_`c'_`k'' / `fm_`m'_`c'_0'
 25.             post `pf' ("file_med") ("`pn'") (`c') ("`lf'") ("all_firms_in_file") ("`mname'") ("`ob_`c''") (.) (`k')
>  ///
>                 (`yy') ("middle level of all firms in the file, starting file = 100") (`fv') (.) (.) ///
>                 (`fn_`m'_`c'_`k'') (.) (0) ("table only: all firms in the file")
 26.         }
 27.     }
 28.     foreach smp in all also_in_earlier_file {
 29.         local sc = cond("`smp'" == "all", "1", "new_to_file == 0")
 30.         * a starting file with no file before it has no "also in an earlier file" firms
.         local noearl = ("`smp'" == "also_in_earlier_file" & "`p1_`c''" == "")
 31.         foreach m in wk out {
 32.             local mname = cond("`m'" == "wk", "workers", "output")
 33.             local pn = cond("`m'" == "wk", "a", "b")
 34.             local crow = `drawn' & "`smp'" == "all"
 35.             * -- position 0: the starting file, 100 by definition --
.             quietly count if cohort_year == `c' & (`sc') & (!missing(r_`m'1) | !missing(r_`m'2) | !missing(r_`m'3))
 36.             post `pf' ("median") ("`pn'") (`c') ("`lf'") ("`smp'") ("`mname'") ("`ob_`c''") (.) (0) (`c') ///
>                 ("starting file = 100") (100) (.) (.) (r(N)) (.) (`crow') ("")
 37.             * -- positions 1-3: the median of the later level against the starting level --
.             forvalues k = 1/3 {
 38.                 quietly count if cohort_year == `c' & (`sc') & !missing(ix_`m'`k')
 39.                 local n = r(N)
 40.                 local med = .
 41.                 local mlo = .
 42.                 local mhi = .
 43.                 if `n' > 0 {
 44.                     quietly centile ix_`m'`k' if cohort_year == `c' & (`sc'), centile(50)
 45.                     local med = r(c_1)
 46.                     local mlo = r(lb_1)
 47.                     local mhi = r(ub_1)
 48.                 }
 49.                 local stt = cond(`n' >= `min_firms', "", "not drawn: fewer than `min_firms' firms")
 50.                 if `noearl' local stt "no earlier file in the data"
 51.                 post `pf' ("median") ("`pn'") (`c') ("`lf'") ("`smp'") ("`mname'") ("`ob_`c''") (.) (`k') ///
>                     (`f`k'_`c'') ("median, starting file = 100") (`med') (`mlo') (`mhi') (`n') (.) (`crow') ("`stt'")
 52.             }
 53.             * -- shares by the third later file, and "came back up", for each band --
.             foreach b of local bands {
 54.                 local blo = 1 - `b'/100
 55.                 local bhi = 1 + `b'/100
 56.                 local crowb = `crow' & `b' == `band_pct'
 57.                 * class: 1 down more than b%, 2 within b% either way, 3 up more than b% (the block's rule)
.                 capture drop cl1 cl3
 58.                 gen byte cl1 = cond(r_`m'1 < `blo', 1, cond(r_`m'1 > `bhi', 3, 2)) if !missing(r_`m'1)
 59.                 gen byte cl3 = cond(r_`m'3 < `blo', 1, cond(r_`m'3 > `bhi', 3, 2)) if !missing(r_`m'3)
 60.                 if `b' == `band_pct' assert cl3 == size_`m'          // same firms as the block's classes
 61.                 quietly count if cohort_year == `c' & (`sc') & !missing(cl3)
 62.                 local N = r(N)
 63.                 forvalues j = 1/3 {
 64.                     if `j' == 1 local lab "down more than `b'%"
 65.                     if `j' == 2 local lab "within `b'% either way"
 66.                     if `j' == 3 local lab "up more than `b'%"
 67.                     quietly count if cohort_year == `c' & (`sc') & cl3 == `j'
 68.                     local kk = r(N)
 69.                     local sh = .
 70.                     local slo = .
 71.                     local shi = .
 72.                     if `N' > 0 {
 73.                         quietly cii proportions `N' `kk', wilson
 74.                         local sh  = 100 * `kk' / `N'
 75.                         local slo = 100 * r(lb)
 76.                         local shi = 100 * r(ub)
 77.                     }
 78.                     local stt = cond(`N' >= `min_firms', "", "not drawn: fewer than `min_firms' firms")
 79.                     if `noearl' local stt "no earlier file in the data"
 80.                     post `pf' ("share") ("c") (`c') ("`lf'") ("`smp'") ("`mname'") ("`ob_`c''") (`b') (3) ///
>                         (`f3_`c'') ("`lab'") (`sh') (`slo') (`shi') (`N') (`kk') (`crowb') ("`stt'")
 81.                 }
 82.                 * down more than b% in the first later file (CSV only)
.                 quietly count if cohort_year == `c' & (`sc') & !missing(cl1)
 83.                 local N1 = r(N)
 84.                 quietly count if cohort_year == `c' & (`sc') & cl1 == 1
 85.                 local k1 = r(N)
 86.                 local sh = .
 87.                 local slo = .
 88.                 local shi = .
 89.                 if `N1' > 0 {
 90.                     quietly cii proportions `N1' `k1', wilson
 91.                     local sh  = 100 * `k1' / `N1'
 92.                     local slo = 100 * r(lb)
 93.                     local shi = 100 * r(ub)
 94.                 }
 95.                 post `pf' ("share_f1") ("") (`c') ("`lf'") ("`smp'") ("`mname'") ("`ob_`c''") (`b') (1) ///
>                     (`f1_`c'') ("down more than `b'% in the first later file") (`sh') (`slo') (`shi') (`N1') (`k1') (0
> ) ///
>                     (cond(`noearl', "no earlier file in the data", ""))
 96.                 * came back up: down more than b% in the first later file, and within b% or
.                 * above by the third (share of the firms down in the first)
.                 quietly count if cohort_year == `c' & (`sc') & cl1 == 1 & !missing(cl3)
 97.                 local D = r(N)
 98.                 quietly count if cohort_year == `c' & (`sc') & cl1 == 1 & inlist(cl3, 2, 3)
 99.                 local R = r(N)
100.                 local sh = .
101.                 local slo = .
102.                 local shi = .
103.                 if `D' > 0 {
104.                     quietly cii proportions `D' `R', wilson
105.                     local sh  = 100 * `R' / `D'
106.                     local slo = 100 * r(lb)
107.                     local shi = 100 * r(ub)
108.                 }
109.                 local stt = cond(`D' >= `min_firms', "", "not drawn: fewer than `min_firms' firms")
110.                 if `noearl' local stt "no earlier file in the data"
111.                 post `pf' ("recovered") ("d") (`c') ("`lf'") ("`smp'") ("`mname'") ("`ob_`c''") (`b') (3) ///
>                     (`f3_`c'') ("back within `b'% or above") (`sh') (`slo') (`shi') (`D') (`R') (`crowb') ("`stt'")
112.             }
113.         }
114.     }
115. }

. postclose `pf'

