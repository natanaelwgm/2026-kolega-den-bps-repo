. 
. *---------------------------------------------------------------------------
. display "Step 2/8: the starting files"
Step 2/8: the starting files

. *---------------------------------------------------------------------------
. * The two drawn starting files, as in R4-04: the last file before COVID reached
. * Indonesia (March 2020) and a normal-years file whose three later files end
. * before COVID (2012, followed 2013, 2014, 2015 - three consecutive years).
. local cohort_covid  2019

. local cohort_normal 2012

. local covid_first   2020        // first annual file after COVID reached Indonesia

. local band_pct      10          // the shared block's neutral band: within 10% either way

. local bands         5 10 20     // the 5% and 20% bands go to the CSV only

. local min_firms     30          // a point is drawn only if it rests on at least 30 firms

. * Other normal-years starting files, CSV only (the R4-03 rule): the next three files
. * are the next three calendar years and end before the COVID starting file.
. quietly levelsof year, local(files)

. local normal_bases ""

. foreach b of local files {
  2.     local ok = (`b' + 3 < `cohort_covid')
  3.     forvalues k = 1/3 {
  4.         local nx = `b' + `k'
  5.         local isin : list posof "`nx'" in files
  6.         if `isin' == 0 local ok 0
  7.     }
  8.     if `ok' local normal_bases `normal_bases' `b'
  9. }

. local isin : list posof "`cohort_normal'" in normal_bases

. if `isin' == 0 {
.     display as error "the normal-years starting file `cohort_normal' needs three later consecutive files"
.     exit 198
. }

. local cohorts `cohort_covid' `cohort_normal'

. foreach b of local normal_bases {
  2.     if `b' != `cohort_normal' local cohorts `cohorts' `b'
  3. }

. display "   drawn: `cohort_covid' and `cohort_normal'; all starting files: `cohorts'"
   drawn: 2019 and 2012; all starting files: 2019 2012 2010 2011

. 
. *---------------------------------------------------------------------------
. display "Step 3/8: for each starting file: the shared cohort block, then each stayer's levels in the later files"
Step 3/8: for each starting file: the shared cohort block, then each stayer's levels in the later files

. *---------------------------------------------------------------------------
. * How this file and R10-03 (block-r10 03_survivors_output_jobs_productivity.do) agree
. * and differ. Same: stayers = the block's state "stayed" (in all three later files),
. * the same output variable rule (constant prices when filled, else current prices)
. * and workers = persons engaged. Different: (1) R10-03 keeps only firms also in one
. * of the two files before (new_to_file == 0); here every firm of the starting file
. * counts, and R10-03's firms are the CSV sample "also_in_earlier_file"; (2) R10-03
. * compares groups with similar firms in regressions on logs; here each firm is set
. * against its own starting level and the middle firm is shown, with no model;
. * (3) a firm with 0 workers in a later file drops out of R10-03's logs; here it
. * counts as down 100% (as in the block).
. tempfile stack

. local first 1

. foreach cohort_year of local cohorts {
  2.     use `panel', clear
  3. *===========================================================================
. * COVID COHORT AND STATES (copy exactly into later R4 and R10 files)
. *   Version 2 - written and reviewed in R4-01 (28 Sep 2026). Do not edit a copy;
. *   change R4-01 and re-copy. Set -local cohort_year- before the block; R4-02
. *   runs it once per starting file (2012 ... 2019).
. *   In : firm-year rows in memory (one row per firm and year): firm_id year
. *        workers gross_output_nominal (gross_output_real is used instead when
. *        present and filled for 95%+ of the cohort-file and last-file rows).
. *        The block collapses to one row per firm: every other variable in memory
. *        is dropped. Build traits in a tempfile first and merge them back by
. *        firm_id after the block.
. *   Out: one row per firm in the cohort file or in one of the next three files.
. *        in_cohort = 1 for the firms of the cohort file (the cohort); the others
. *        are newcomers (new_in_file = the later file they first appear in).
. *        Locals: f1 f2 f3 = the next three files, p1 p2 = the two files before,
. *        outbasis = output variable used, band_pct = neutral band in percent
. *        (10 = within 10% either way), band_lo band_hi = its limits as ratios.
. *   The years come from the data, so the block runs unchanged on the real files.
. *===========================================================================
. isid firm_id year
  4. * -- the annual files in the data, and the files around the cohort file --
. quietly levelsof year, local(c_files)
  5. local c_pos : list posof "`cohort_year'" in c_files
  6. local c_nf : word count `c_files'
  7. if `c_pos' == 0 | `c_pos' + 3 > `c_nf' {
  8.     display as error "cohort file `cohort_year' must be a file year with three later files"
  9.     exit 198
 10. }
 11. local f1 : word `=`c_pos' + 1' of `c_files'
 12. local f2 : word `=`c_pos' + 2' of `c_files'
 13. local f3 : word `=`c_pos' + 3' of `c_files'
 14. local p1 ""
 15. local p2 ""
 16. if `c_pos' > 1 local p1 : word `=`c_pos' - 1' of `c_files'
 17. if `c_pos' > 2 local p2 : word `=`c_pos' - 2' of `c_files'
 18. * -- output: constant prices when the file has them, else current prices --
. local outbasis "gross_output_nominal"
 19. capture confirm numeric variable gross_output_real
 20. if !_rc {
 21.     quietly count if inlist(year, `cohort_year', `f3')
 22.     local c_nrows = r(N)
 23.     quietly count if inlist(year, `cohort_year', `f3') & !missing(gross_output_real)
 24.     if r(N) >= 0.95 * `c_nrows' & `c_nrows' > 0 local outbasis "gross_output_real"
 25. }
 26. * -- neutral band: a stayer is "about the same" if its last-file level is
. *    within band_pct percent of its cohort-file level, up or down (10: 0.90 to 1.10 times);
. *    the limits match the words on the chart ("down more than 10%") exactly --
. if "`band_pct'" == "" local band_pct 10
 27. local band_lo = 1 - `band_pct'/100
 28. local band_hi = 1 + `band_pct'/100
 29. * -- which files each firm is in (1 = in the file, 0 = not) --
. gen byte c_base    = (year == `cohort_year')
 30. gen byte c_f1      = (year == `f1')
 31. gen byte c_f2      = (year == `f2')
 32. gen byte c_f3      = (year == `f3')
 33. gen byte c_earlier = (year <  `cohort_year')                    // any file before the cohort file
 34. gen byte c_p1      = cond("`p1'" == "", ., (year == real("`p1'")))
 35. gen byte c_p2      = cond("`p2'" == "", ., (year == real("`p2'")))
 36. gen double c_wk0   = workers     if year == `cohort_year'
 37. gen double c_wk3   = workers     if year == `f3'
 38. gen double c_out0  = `outbasis'  if year == `cohort_year'
 39. gen double c_out3  = `outbasis'  if year == `f3'
 40. keep if year <= `f3'
 41. collapse (max) seen_base = c_base seen_f1 = c_f1 seen_f2 = c_f2 seen_f3 = c_f3 ///
>     seen_earlier = c_earlier seen_p1 = c_p1 seen_p2 = c_p2 ///
>     workers_base = c_wk0 workers_f3 = c_wk3 output_base = c_out0 output_f3 = c_out3, by(firm_id)
 42. keep if seen_base | seen_f1 | seen_f2 | seen_f3                  // firms of the cohort file or a later one
 43. gen int  cohort_year = `cohort_year'
 44. gen byte in_cohort   = (seen_base == 1)
 45. * -- new_to_file = 1: in the cohort file but in neither of the two files before
. *    (it may still be in an older file); 0 = "incumbent" (R10 uses 0 as incumbent) --
. gen byte new_to_file = .
 46. if "`p1'" != "" replace new_to_file = (seen_p1 == 0 & (seen_p2 == 0 | missing(seen_p2))) if in_cohort
 47. * -- presence in the next three files, e.g. "110" = in f1 and f2, not in f3 --
. gen str3 pattern = string(seen_f1) + string(seen_f2) + string(seen_f3) if in_cohort
 48. * -- state by the last file (f3) --
. *    1 stayed           = in all three later files
. *    2 absent then back = missed f1 and/or f2, in f3 again ("temporary disappearance")
. *    3 left the files   = not in f3 (the file has no closure record: not proof of closure)
. gen byte state_file = cond(pattern == "111", 1, cond(seen_f3 == 1, 2, 3)) if in_cohort
 49. *    left_when: 1 = gone from f1 on ("000"), 2 = in f1 or f2, gone by f3
. gen byte left_when = cond(pattern == "000", 1, 2) if state_file == 3
 50. * -- stayers: change from the cohort file to f3; 0 in f3 counts as shrank;
. *    no positive cohort-file level (or no f3 level) = not classified (missing) --
. gen double ratio_wk  = workers_f3 / workers_base if state_file == 1 & workers_base > 0 & !missing(workers_base, worker
> s_f3)
 51. gen double ratio_out = output_f3  / output_base  if state_file == 1 & output_base  > 0 & !missing(output_base,  out
> put_f3)
 52. foreach m in wk out {
 53.     gen byte size_`m' = cond(ratio_`m' < `band_lo', 1, cond(ratio_`m' > `band_hi', 3, 2)) if !missing(ratio_`m')
 54.     *   outcome5: 1 left the files, 2 absent then back, 3 shrank, 4 about the same, 5 grew
.     gen byte outcome5_`m' = cond(state_file == 3, 1, cond(state_file == 2, 2, 2 + size_`m')) if in_cohort
 55.     replace  outcome5_`m' = . if state_file == 1 & missing(size_`m')
 56. }
 57. * -- newcomers: the later file a firm not in the cohort file first appears in --
. gen int new_in_file = cond(seen_f1, `f1', cond(seen_f2, `f2', `f3')) if !in_cohort
 58. gen str80 outcome_basis = "`outbasis'"
 59. label define c_state 1 "stayed" 2 "absent then back" 3 "left the files", replace
 60. label define c_left  1 "gone from the first later file" 2 "gone later", replace
 61. label define c_size  1 "shrank" 2 "about the same" 3 "grew", replace
 62. label define c_out5  1 "left the files" 2 "absent then back" 3 "stayed, shrank" 4 "stayed, about the same" 5 "staye
> d, grew", replace
 63. label values state_file c_state
 64. label values left_when c_left
 65. label values size_wk size_out c_size
 66. label values outcome5_wk outcome5_out c_out5
 67. * -- structural checks (hold on any data) --
. isid firm_id
 68. assert !missing(state_file, pattern) if in_cohort
 69. assert missing(state_file) & !missing(new_in_file) if !in_cohort
 70. assert (state_file == 1) == (pattern == "111") if in_cohort
 71. assert !missing(outcome5_wk) if in_cohort & state_file != 1
 72. order firm_id cohort_year in_cohort new_to_file seen_* pattern state_file left_when ///
>     workers_base workers_f3 ratio_wk size_wk outcome5_wk output_base output_f3 ratio_out size_out ///
>     outcome5_out new_in_file outcome_basis
 73. display "   cohort file `cohort_year'; later files `f1' `f2' `f3'; earlier files `p2' `p1'; output: `outbasis'; ban
> d +/-`band_pct'%"
 74. *===========================================================================
. * END OF COVID COHORT AND STATES
. *===========================================================================
.     * -- counts for the whole starting file (CSV section "count") --
.     quietly count if in_cohort
 75.     local nc_`cohort_year' = r(N)
 76.     quietly count if state_file == 1
 77.     local ns_`cohort_year' = r(N)
 78.     quietly count if state_file == 2
 79.     local nb_`cohort_year' = r(N)
 80.     quietly count if state_file == 3
 81.     local nl_`cohort_year' = r(N)
 82.     quietly count if state_file == 1 & new_to_file == 0
 83.     local ni_`cohort_year' = r(N)
 84.     local f1_`cohort_year' `f1'
 85.     local f2_`cohort_year' `f2'
 86.     local f3_`cohort_year' `f3'
 87.     local ob_`cohort_year' `outbasis'
 88.     local p1_`cohort_year' `p1'
 89.     local p2_`cohort_year' `p2'
 90.     * the normal-years files must be followed only through files before COVID
.     if `cohort_year' != `cohort_covid' assert `f3' < `covid_first'
 91.     * -- the stayers: in all three later files --
.     keep if in_cohort & state_file == 1
 92.     keep firm_id cohort_year new_to_file workers_base output_base ratio_wk ratio_out size_wk size_out
 93.     tempfile st
 94.     save `st'
 95.     * -- each stayer's workers and output in each later file (from the firm-year rows) --
.     use `panel', clear
 96.     keep if inlist(year, `f1', `f2', `f3')
 97.     gen byte k = cond(year == `f1', 1, cond(year == `f2', 2, 3))
 98.     gen double lv_wk  = workers
 99.     gen double lv_out = `outbasis'
100.     keep firm_id k lv_wk lv_out
101.     quietly reshape wide lv_wk lv_out, i(firm_id) j(k)
102.     merge 1:1 firm_id using `st', keep(using match)
103.     assert _merge == 3                        // every stayer is in all three later files
104.     drop _merge
105.     * level in each later file against the starting file, the block's rule: no positive
.     * starting level (or no later level) = not comparable (missing); 0 later = ratio 0
.     forvalues k = 1/3 {
106.         gen double r_wk`k'  = lv_wk`k'  / workers_base if workers_base > 0 & !missing(workers_base, lv_wk`k')
107.         gen double r_out`k' = lv_out`k' / output_base  if output_base  > 0 & !missing(output_base,  lv_out`k')
108.     }
109.     * the third later file must give exactly the block's own ratios
.     assert r_wk3 == ratio_wk
110.     assert r_out3 == ratio_out
111.     if `first' {
112.         save `stack'
113.         local first 0
114.     }
115.     else {
116.         append using `stack'
117.         save `stack', replace
118.     }
119. }
