  2.     foreach s in "firms in the starting file" "stayed: in all three later files" "absent, then back in the third la
> ter file" {
  3.         quietly summarize n_firms if section == "count" & cohort_year == `c' & stat == "`s'"
  4.         local v = strtrim(string(r(mean), "%12.0fc"))
  5.         if "`s'" == "firms in the starting file"             local ncoh_`c' "`v'"
  6.         if "`s'" == "stayed: in all three later files"       local nst_`c'  "`v'"
  7.         if "`s'" == "absent, then back in the third later file" local nbk_`c' "`v'"
  8.     }
  9. }

