. keep if drawn
(12 observations deleted)

. drop if row_label == "Stayed, workers not comparable" & firms == 0   // drawn only when it occurs
(1 observation deleted)

. sort row_order

. * section headings (also used in the companion table)
. local headA "The `cohort_year' firms, file by file"

. local headB "Where the `cohort_year' firms were by the `f3' file"

. local headC "Firms in later files that were not in the `cohort_year' file"

. local charttitle "Figure R4-01. The firms of the `cohort_year' file: how many stayed in the `f1'–`f3' files, left, or 
> came back"

. * y positions: a bold heading per section, one blank row between sections
. gen double y = .
(14 missing values generated)

. local pos 0

. local ylab ""

. local prevsec ""

. forvalues i = 1/`=_N' {
  2.     local sec = section[`i']
  3.     if "`sec'" != "`prevsec'" {
  4.         if "`prevsec'" != "" local pos = `pos' + 0.6
  5.         local ++pos
  6.         local head "`head`sec''"
  7.         local ylab `"`ylab' `pos' "{bf:`head'}""'
  8.         local prevsec "`sec'"
  9.     }
 10.     local ++pos
 11.     replace y = `pos' in `i'
 12.     local lab = row_label[`i']
 13.     local ylab `"`ylab' `pos' "`lab'""'
 14. }
