. * Reconciliation: every split adds up to the cohort (structural, holds on any data).
. foreach v in firms incumbents new_in_cohort_file {
  2.     quietly summarize `v' if row_order == 1
  3.     local tot = r(sum)
  4.     quietly summarize `v' if inlist(row_order, 5, 10, 11, 12)          // stayed + back + left + left later
  5.     assert r(sum) == `tot'
  6.     quietly summarize `v' if section == "P"                           // the eight presence patterns
  7.     assert r(sum) == `tot'
  8.     quietly summarize `v' if inrange(row_order, 6, 9)                 // stayers split by workers
  9.     local s1 = r(sum)
 10.     quietly summarize `v' if section == "O"                           // stayers split by output
 11.     local s2 = r(sum)
 12.     quietly summarize `v' if row_order == 5
 13.     assert `s1' == r(sum) & `s2' == r(sum)
 14. }

. assert incumbents + new_in_cohort_file == firms if section != "C" & `n_nonew' == 0

. assert first_time_in_files + seen_before_cohort_file == firms if section == "C"

