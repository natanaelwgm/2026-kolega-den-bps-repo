(1 real change made)

. gen str12 c_firms = strtrim(string(firms, "%12.0fc"))

. gen str8  c_pct   = cond(missing(pct_of_cohort), "", strtrim(string(pct_of_cohort, "%5.1f")))
(3 missing values generated)

. gen double left_piece  = cond(section_name == "newcomers", first_time_in_files, incumbents)

. gen double right_piece = cond(section_name == "newcomers", seen_before_cohort_file, new_in_cohort_file)

. gen str12 c_left  = strtrim(string(left_piece, "%12.0fc"))

. gen str12 c_right = strtrim(string(right_piece, "%12.0fc"))

. local nrow = _N

. quietly tab section_name

. local ntab = `nrow' + 1 + r(r)                            // header + one heading per section

. local headD "Stayed, split by output (`outword'): not drawn"

. putpdf clear

. putpdf begin, font("Times New Roman", 10) margin(all, 0.6in)

. putpdf paragraph, spacing(after, 6pt)

. putpdf text ("Table R4-01. `=substr("`charttitle'", strpos("`charttitle'", ".") + 2, .)' — every plotted point and the
>  output split"), bold

. matrix colw = (34, 9, 12, 11, 12, 22)                  // column widths, % of the page width

. putpdf table T = (`ntab', 6), border(all, nil) width(colw)

. local h1 "Row on the chart"

. local h2 "Firms"

. local h3 "% of the `cohort_year' firms"

. local h4 "Dark or gray piece"

. local h5 "White or dashed piece"

. local h6 "Status"

. forvalues c = 1/6 {
  2.     local al = cond(inlist(`c', 1, 6), "left", "right")
  3.     putpdf table T(1, `c') = ("`h`c''"), bold halign(`al') border(top, single) border(bottom, single) margin(left, 
> 6pt)
  4. }

. local r 1

. local prev ""

. forvalues i = 1/`nrow' {
  2.     local sec = section_name[`i']
  3.     local key = cond("`sec'" == "file_by_file", "A", cond("`sec'" == "final_state", "B", cond("`sec'" == "newcomers
> ", "C", "D")))
  4.     if "`key'" != "`prev'" {
  5.         local ++r
  6.         putpdf table T(`r', 1) = ("`head`key''"), bold colspan(6)
  7.         local prev "`key'"
  8.     }
  9.     local ++r
 10.     putpdf table T(`r', 1) = ("`=row_label[`i']'")
 11.     putpdf table T(`r', 2) = ("`=c_firms[`i']'"), halign(right)
 12.     putpdf table T(`r', 3) = ("`=c_pct[`i']'"), halign(right)
 13.     putpdf table T(`r', 4) = ("`=c_left[`i']'"), halign(right)
 14.     putpdf table T(`r', 5) = ("`=c_right[`i']'"), halign(right)
 15.     putpdf table T(`r', 6) = ("`=status[`i']'"), margin(left, 6pt)
 16. }

. assert `r' == `ntab'

. forvalues c = 1/6 {
  2.     putpdf table T(`ntab', `c'), border(bottom, single)
  3. }

. putpdf paragraph, spacing(before, 6pt)

. putpdf text ("Pieces: dark = also `incword'; white = not `incword'; gray = not in the `cohort_year' file, new to the f
> iles; dashed = not in the `cohort_year' file, seen in a file before `cohort_year'. The chart prints a piece count only
>  where it fits; this table gives all."), font("Times New Roman", 9)

. putpdf paragraph

