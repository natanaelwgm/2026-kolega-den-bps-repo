. *---------------------------------------------------------------------------
. display "Step 5/9: regressions: group x each file (start file = reference), pooled, COVID minus normal"
Step 5/9: regressions: group x each file (start file = reference), pooled, COVID minus normal

. *---------------------------------------------------------------------------
. * Model (linear probability): exports (100 or 0) = firm's own average + one average per
. * industry and file + one per province and file + the group's extra change in each file,
. * against the start file:
. *   b_year = (group's change in % exporting since the start file) - (other firms' change),
. *   in percentage points.
. * Versions: covid  = COVID start file, files p2 to the last file before the direct-only file
. *           normal = normal-years start file, the same number of files after it
. *           with22 = covid plus the direct-only file(s) (table only)
. *           stay   = covid, firms in every later file only (table only)
. *           fy     = covid, firm + year averages only (table only)
. * Printed in each panel: the average of the covid (and normal) markers after the start file
. * (against the start file alone), the pooled term (Bu Deasy's "x Post2020": group x every
. * later file, against the start file and the two before together; its own regression, same
. * rows), and COVID minus normal (both start files in one model; errors clustered by firm).
. local versions "covid normal stay fy"

. if "`dir_yrs'" != "" local versions "covid normal with22 stay fy"

. tempname P

. tempfile res

. postfile `P' byte section str8 grouping str8 version str20 term int year byte pos double(b se df_r) ///
>     long(rows firms singletons n_g1 n_g0 ref_g1 ref_g0 firms_g1 firms_g0) double before_p using `res', replace
(file /var/folders/0k/wcj_06q55_gd0c7z2x717jsc0000gn/T//S_19164.000006 not found)

. foreach x in exp imp fdi {
  2.     display "   group `x'"
  3.     foreach v of local versions {
  4.         local s = cond("`v'" == "normal", 2, 1)
  5.         local wl "`mw_`s''"
  6.         if "`v'" == "with22" local wl "`win_1'"
  7.         local sf `start_`s''
  8.         use `panel', clear
  9.         keep if section == `s' & !missing(grp_main_`x', ex)
 10.         gen byte inw = 0
 11.         foreach y of local wl {
 12.             quietly replace inw = 1 if year == `y'
 13.         }
 14.         keep if inw
 15.         if "`v'" == "stay" keep if stayer
 16.         gen double X = grp_main_`x'
 17.         local terms ""
 18.         local pre_terms ""
 19.         local lc ""
 20.         local np 0
 21.         foreach y of local wl {
 22.             if `y' != `sf' {
 23.                 gen double t`y' = X * (year == `y')
 24.                 local terms "`terms' t`y'"
 25.                 if `y' < `sf' local pre_terms "`pre_terms' t`y'"
 26.                 else {
 27.                     local lc "`lc' + t`y'"
 28.                     local ++np
 29.                 }
 30.             }
 31.         }
 32.         gen double tpost = X * (year > `sf')
 33.         local ab "firm_id ind#year prov#year"
 34.         if "`v'" == "fy" local ab "firm_id year"
 35.         * --- year by year ---
.         quietly reghdfe ex `terms', absorb(`ab') vce(cluster firm_id)
 36.         capture drop es
 37.         gen byte es = e(sample)
 38.         local N  = e(N)
 39.         local G  = e(N_clust)
 40.         local df = e(df_r)
 41.         local S  = e(num_singletons)
 42.         if "`S'" == "" local S 0
 43.         * before-start check: the markers before the start file are 0 together
.         capture test `pre_terms'
 44.         local bp = cond(_rc, ., r(p))
 45.         * average of the markers after the start file
.         quietly lincom (`=substr("`lc'", 4, .)') / `np'
 46.         local ab_ = r(estimate)
 47.         local as_ = r(se)
 48.         * firms behind each marker: group (X = 1) and other firms (X = 0)
.         quietly count if es & year == `sf' & X == 1
 49.         local r1 = r(N)
 50.         quietly count if es & year == `sf' & X == 0
 51.         local r0 = r(N)
 52.         capture drop ft
 53.         egen byte ft = tag(firm_id) if es
 54.         quietly count if ft == 1 & X == 1
 55.         local fg1 = r(N)
 56.         quietly count if ft == 1 & X == 0
 57.         local fg0 = r(N)
 58.         foreach y of local wl {
 59.             if `y' == `sf' continue
 60.             local pp : list posof "`y'" in win_`s'
 61.             quietly count if es & year == `y' & X == 1
 62.             local n1 = r(N)
 63.             quietly count if es & year == `y' & X == 0
 64.             local n0 = r(N)
 65.             capture local sechk = _se[t`y']
 66.             if _rc local sechk = .
 67.             if `sechk' == 0 | missing(`sechk') {
 68.                 post `P' (`s') ("`x'") ("`v'") ("`y'") (`y') (`pp' - 3) (.) (.) (`df') (`N') (`G') (`S') ///
>                     (`n1') (`n0') (`r1') (`r0') (`fg1') (`fg0') (`bp')
 69.             }
 70.             else {
 71.                 post `P' (`s') ("`x'") ("`v'") ("`y'") (`y') (`pp' - 3) (_b[t`y']) (_se[t`y']) (`df') (`N') (`G') /
> //
>                     (`S') (`n1') (`n0') (`r1') (`r0') (`fg1') (`fg0') (`bp')
 72.                 if inlist("`v'", "covid", "normal") local bk_`x'_`y' = _b[t`y']
 73.             }
 74.         }
 75.         post `P' (`s') ("`x'") ("`v'") ("avgpost") (.) (.) (`ab_') (`as_') (`df') (`N') (`G') (`S') ///
>             (.) (.) (`r1') (`r0') (`fg1') (`fg0') (`bp')
 76.         if inlist("`v'", "covid", "normal") local ba_`x'_`s' = `ab_'
 77.         * --- pooled term (Bu Deasy's "x Post2020"), same rows ---
.         quietly reghdfe ex tpost if es, absorb(`ab') vce(cluster firm_id)
 78.         assert e(N) == `N'
 79.         * singletons: those the yearly model dropped (the pooled model runs on its rows, so it drops none)
.         post `P' (`s') ("`x'") ("`v'") ("pooled") (.) (.) (_b[tpost]) (_se[tpost]) (e(df_r)) (e(N)) ///
>             (e(N_clust)) (`S') (.) (.) (`r1') (`r0') (`fg1') (`fg0') (`bp')
 80.     }
 81.     * --- COVID minus normal years: both start files in one model ---
.     * The two windows share no file, so the industry x file and province x file averages are
.     * separate by start file; a firm in both start files gets one average per start file (fs)
.     * and one cluster (firm_id). Same markers as the two separate models (checked below).
.     use `panel', clear
 82.     keep if !missing(grp_main_`x', ex)
 83.     gen byte inw = 0
 84.     forvalues s = 1/2 {
 85.         foreach y of local mw_`s' {
 86.             quietly replace inw = 1 if section == `s' & year == `y'
 87.         }
 88.     }
 89.     keep if inw
 90.     egen long fs = group(section firm_id)
 91.     gen double X = grp_main_`x'
 92.     local terms ""
 93.     local lc1 ""
 94.     local lc2 ""
 95.     forvalues s = 1/2 {
 96.         foreach y of local mw_`s' {
 97.             if `y' != `start_`s'' {
 98.                 gen double t`y' = X * (year == `y' & section == `s')
 99.                 local terms "`terms' t`y'"
100.                 if `y' > `start_`s'' local lc`s' "`lc`s'' + t`y'"
101.             }
102.         }
103.     }
104.     quietly reghdfe ex `terms', absorb(fs ind#year prov#year) vce(cluster firm_id)
105.     forvalues s = 1/2 {
106.         foreach y of local mw_`s' {
107.             if `y' != `start_`s'' & "`bk_`x'_`y''" != "" assert abs(_b[t`y'] - `bk_`x'_`y'') < 1e-6
108.         }
109.     }
110.     local S3 = e(num_singletons)
111.     if "`S3'" == "" local S3 0
112.     local N3 = e(N)
113.     local G3 = e(N_clust)
114.     local df3 = e(df_r)
115.     quietly lincom (`=substr("`lc1'", 4, .)') / `npost' - (`=substr("`lc2'", 4, .)') / `npost'
116.     assert abs(r(estimate) - (`ba_`x'_1' - `ba_`x'_2')) < 1e-6
117.     post `P' (3) ("`x'") ("diff") ("covid_minus_normal") (.) (.) (r(estimate)) (r(se)) (`df3') (`N3') ///
>         (`G3') (`S3') (.) (.) (.) (.) (.) (.) (.)
118. }
