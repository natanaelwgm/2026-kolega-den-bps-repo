. *---------------------------------------------------------------------------
. display "Step 2/9: the two start files (read from the data)"
Step 2/9: the two start files (read from the data)

. *---------------------------------------------------------------------------
. * COVID start file = the last annual file before 2020, followed in the next files.
. * Normal-years start file (as R10-02): the latest file with two files before it whose
. * next three files are the next three calendar years, all before 2020 (no missing year,
. * no COVID year). Same code, same rules: it shows what the method gives without COVID.
. local nfiles : word count `allfiles'

. local covid_start ""

. local bench_start ""

. forvalues i = 1/`nfiles' {
  2.     local c : word `i' of `allfiles'
  3.     if `c' < `covid_first' local covid_start `c'
  4.     if `i' >= 3 & `i' + 3 <= `nfiles' {
  5.         local n1 : word `=`i' + 1' of `allfiles'
  6.         local n3 : word `=`i' + 3' of `allfiles'
  7.         if `n1' == `c' + 1 & `n3' == `c' + 3 & `n3' < `covid_first' local bench_start `c'
  8.     }
  9. }

. assert "`covid_start'" != "" & "`bench_start'" != ""

. display "   COVID start file `covid_start'; normal-years start file `bench_start'"
   COVID start file 2019; normal-years start file 2012

. 
. *---------------------------------------------------------------------------
. display "Step 3/9: for each start file, its firms and their groups (blocks copied unchanged)"
Step 3/9: for each start file, its firms and their groups (blocks copied unchanged)

. *---------------------------------------------------------------------------
. * The two blocks below are copied unchanged from R10-01 (the first from R4-01), with the
. * lines between them. After them, keep the firm-year rows of the firms of the start file
. * that were also in one of the two files before it (new_to_file == 0, R10's main sample).
. tempfile panel

. local first 1

. foreach cohort_year in `covid_start' `bench_start' {
  2. use `firmyear0', clear
  3. capture label drop grp          // the group block defines this label; the loop runs it twice
  4. *===========================================================================
. * COVID COHORT AND STATES (copy exactly into later R4 and R10 files)
. *   Version 2 - written and reviewed in R4-01 (28 Sep 2026). Do not edit a copy;
. *   change R4-01 and re-copy. Set -local cohort_year- before the block; R4-02
. *   runs it once per starting file (2012 ... 2019).
. *   In : firm-year rows in memory (one row per firm and year): firm_id year
. *        workers gross_output_nominal (gross_output_real is used instead when
. *        present and filled for 95%+ of the cohort-file and last-file rows).
. *        The block collapses to one row per firm: every other variable in memory
. *        is dropped. Build traits in a tempfile first and merge them back by
. *        firm_id after the block.
. *   Out: one row per firm in the cohort file or in one of the next three files.
. *        in_cohort = 1 for the firms of the cohort file (the cohort); the others
. *        are newcomers (new_in_file = the later file they first appear in).
. *        Locals: f1 f2 f3 = the next three files, p1 p2 = the two files before,
. *        outbasis = output variable used, band_pct = neutral band in percent
. *        (10 = within 10% either way), band_lo band_hi = its limits as ratios.
. *   The years come from the data, so the block runs unchanged on the real files.
. *===========================================================================
. isid firm_id year
  5. * -- the annual files in the data, and the files around the cohort file --
. quietly levelsof year, local(c_files)
  6. local c_pos : list posof "`cohort_year'" in c_files
  7. local c_nf : word count `c_files'
  8. if `c_pos' == 0 | `c_pos' + 3 > `c_nf' {
  9.     display as error "cohort file `cohort_year' must be a file year with three later files"
 10.     exit 198
 11. }
 12. local f1 : word `=`c_pos' + 1' of `c_files'
 13. local f2 : word `=`c_pos' + 2' of `c_files'
 14. local f3 : word `=`c_pos' + 3' of `c_files'
 15. local p1 ""
 16. local p2 ""
 17. if `c_pos' > 1 local p1 : word `=`c_pos' - 1' of `c_files'
 18. if `c_pos' > 2 local p2 : word `=`c_pos' - 2' of `c_files'
 19. * -- output: constant prices when the file has them, else current prices --
. local outbasis "gross_output_nominal"
 20. capture confirm numeric variable gross_output_real
 21. if !_rc {
 22.     quietly count if inlist(year, `cohort_year', `f3')
 23.     local c_nrows = r(N)
 24.     quietly count if inlist(year, `cohort_year', `f3') & !missing(gross_output_real)
 25.     if r(N) >= 0.95 * `c_nrows' & `c_nrows' > 0 local outbasis "gross_output_real"
 26. }
 27. * -- neutral band: a stayer is "about the same" if its last-file level is
. *    within band_pct percent of its cohort-file level, up or down (10: 0.90 to 1.10 times);
. *    the limits match the words on the chart ("down more than 10%") exactly --
. if "`band_pct'" == "" local band_pct 10
 28. local band_lo = 1 - `band_pct'/100
 29. local band_hi = 1 + `band_pct'/100
 30. * -- which files each firm is in (1 = in the file, 0 = not) --
. gen byte c_base    = (year == `cohort_year')
 31. gen byte c_f1      = (year == `f1')
 32. gen byte c_f2      = (year == `f2')
 33. gen byte c_f3      = (year == `f3')
 34. gen byte c_earlier = (year <  `cohort_year')                    // any file before the cohort file
 35. gen byte c_p1      = cond("`p1'" == "", ., (year == real("`p1'")))
 36. gen byte c_p2      = cond("`p2'" == "", ., (year == real("`p2'")))
 37. gen double c_wk0   = workers     if year == `cohort_year'
 38. gen double c_wk3   = workers     if year == `f3'
 39. gen double c_out0  = `outbasis'  if year == `cohort_year'
 40. gen double c_out3  = `outbasis'  if year == `f3'
 41. keep if year <= `f3'
 42. collapse (max) seen_base = c_base seen_f1 = c_f1 seen_f2 = c_f2 seen_f3 = c_f3 ///
>     seen_earlier = c_earlier seen_p1 = c_p1 seen_p2 = c_p2 ///
>     workers_base = c_wk0 workers_f3 = c_wk3 output_base = c_out0 output_f3 = c_out3, by(firm_id)
 43. keep if seen_base | seen_f1 | seen_f2 | seen_f3                  // firms of the cohort file or a later one
 44. gen int  cohort_year = `cohort_year'
 45. gen byte in_cohort   = (seen_base == 1)
 46. * -- new_to_file = 1: in the cohort file but in neither of the two files before
. *    (it may still be in an older file); 0 = "incumbent" (R10 uses 0 as incumbent) --
. gen byte new_to_file = .
 47. if "`p1'" != "" replace new_to_file = (seen_p1 == 0 & (seen_p2 == 0 | missing(seen_p2))) if in_cohort
 48. * -- presence in the next three files, e.g. "110" = in f1 and f2, not in f3 --
. gen str3 pattern = string(seen_f1) + string(seen_f2) + string(seen_f3) if in_cohort
 49. * -- state by the last file (f3) --
. *    1 stayed           = in all three later files
. *    2 absent then back = missed f1 and/or f2, in f3 again ("temporary disappearance")
. *    3 left the files   = not in f3 (the file has no closure record: not proof of closure)
. gen byte state_file = cond(pattern == "111", 1, cond(seen_f3 == 1, 2, 3)) if in_cohort
 50. *    left_when: 1 = gone from f1 on ("000"), 2 = in f1 or f2, gone by f3
. gen byte left_when = cond(pattern == "000", 1, 2) if state_file == 3
 51. * -- stayers: change from the cohort file to f3; 0 in f3 counts as shrank;
. *    no positive cohort-file level (or no f3 level) = not classified (missing) --
. gen double ratio_wk  = workers_f3 / workers_base if state_file == 1 & workers_base > 0 & !missing(workers_base, worker
> s_f3)
 52. gen double ratio_out = output_f3  / output_base  if state_file == 1 & output_base  > 0 & !missing(output_base,  out
> put_f3)
 53. foreach m in wk out {
 54.     gen byte size_`m' = cond(ratio_`m' < `band_lo', 1, cond(ratio_`m' > `band_hi', 3, 2)) if !missing(ratio_`m')
 55.     *   outcome5: 1 left the files, 2 absent then back, 3 shrank, 4 about the same, 5 grew
.     gen byte outcome5_`m' = cond(state_file == 3, 1, cond(state_file == 2, 2, 2 + size_`m')) if in_cohort
 56.     replace  outcome5_`m' = . if state_file == 1 & missing(size_`m')
 57. }
 58. * -- newcomers: the later file a firm not in the cohort file first appears in --
. gen int new_in_file = cond(seen_f1, `f1', cond(seen_f2, `f2', `f3')) if !in_cohort
 59. gen str80 outcome_basis = "`outbasis'"
 60. label define c_state 1 "stayed" 2 "absent then back" 3 "left the files", replace
 61. label define c_left  1 "gone from the first later file" 2 "gone later", replace
 62. label define c_size  1 "shrank" 2 "about the same" 3 "grew", replace
 63. label define c_out5  1 "left the files" 2 "absent then back" 3 "stayed, shrank" 4 "stayed, about the same" 5 "staye
> d, grew", replace
 64. label values state_file c_state
 65. label values left_when c_left
 66. label values size_wk size_out c_size
 67. label values outcome5_wk outcome5_out c_out5
 68. * -- structural checks (hold on any data) --
. isid firm_id
 69. assert !missing(state_file, pattern) if in_cohort
 70. assert missing(state_file) & !missing(new_in_file) if !in_cohort
 71. assert (state_file == 1) == (pattern == "111") if in_cohort
 72. assert !missing(outcome5_wk) if in_cohort & state_file != 1
 73. order firm_id cohort_year in_cohort new_to_file seen_* pattern state_file left_when ///
>     workers_base workers_f3 ratio_wk size_wk outcome5_wk output_base output_f3 ratio_out size_out ///
>     outcome5_out new_in_file outcome_basis
 74. display "   cohort file `cohort_year'; later files `f1' `f2' `f3'; earlier files `p2' `p1'; output: `outbasis'; ban
> d +/-`band_pct'%"
 75. *===========================================================================
. * END OF COVID COHORT AND STATES
. *===========================================================================
. 
. * back to firm-year rows: attach the cohort markers to every record of each firm
. keep firm_id in_cohort new_to_file pattern state_file left_when
 76. tempfile cohort
 77. save `cohort'
 78. use `firmyear0', clear
 79. merge m:1 firm_id using `cohort', keep(master match) nogenerate
 80. replace in_cohort = 0 if missing(in_cohort)       // firms seen only before the cohort file
 81. 
. *===========================================================================
. * R10 FROZEN PRE-COVID GROUPS (copy exactly into later R10 files)
. *===========================================================================
. * Needs: firm-year data with firm_id year export_flag import_flag fdi_10_flag,
. * in_cohort and new_to_file, and the locals cohort_year p1 p2 from the cohort block
. * (p1 = the file just before the cohort file, p2 = the one before that).
. * Each firm is put in each group ONCE, from its own records in the files
. * `p2', `p1' and `cohort_year' (the last file before COVID and the two before it).
. * Answers from later files NEVER change a group.
. *   main rule   : in the group (1) if it answered "yes" in at least half of its
. *                 known answers in those files; other firms (0) = "yes" in fewer
. *                 than half (most never said "yes"; e.g. yes in 1 of 3 = other);
. *                 no known answer = left out (missing), never counted as "no".
. *   stricter    : 1 only if "yes" in EVERY known answer; 0 only if never "yes";
. *                 firms with both answers ("mixed") are left out (missing).
. *   early files : main rule on the files `p2' and `p1' only (Bu Deasy's literal "pre-2019").
. *   base file   : the answer in the `cohort_year' file only.
. * Variable names: grp_<rule>_<x>, x = exp (export_flag), imp (import_flag),
. * fdi (fdi_10_flag); rule = main, strict, early, base. Also k_<x> (known
. * answers) and s_<x> (of which "yes") in the three files.
. * Main sample of R10 = cohort firms that are not new to the file (new_to_file == 0):
. * a firm first seen in `cohort_year' has only one year of answers and no earlier years.
. if "`p1'" == "" | "`p2'" == "" {
 82.     display as error "the groups need two files before the cohort file `cohort_year'"
 83.     exit 198
 84. }
 85. local grp_rule_min 0.5
 86. gen byte in_pre   = inlist(year, `p2', `p1', `cohort_year')
 87. gen byte in_early = inlist(year, `p2', `p1')
 88. foreach x in exp imp fdi {
 89.     if "`x'" == "exp" local v export_flag
 90.     if "`x'" == "imp" local v import_flag
 91.     if "`x'" == "fdi" local v fdi_10_flag
 92.     bysort firm_id: egen byte k_`x' = total(in_pre & !missing(`v'))
 93.     bysort firm_id: egen byte s_`x' = total(in_pre & `v' == 1)
 94.     gen byte grp_main_`x'   = s_`x' / k_`x' >= `grp_rule_min' if k_`x' > 0
 95.     gen byte grp_strict_`x' = cond(k_`x' == 0, ., cond(s_`x' == k_`x', 1, cond(s_`x' == 0, 0, .)))
 96.     bysort firm_id: egen byte ke = total(in_early & !missing(`v'))
 97.     bysort firm_id: egen byte se = total(in_early & `v' == 1)
 98.     gen byte grp_early_`x'  = se / ke >= `grp_rule_min' if ke > 0
 99.     bysort firm_id: egen byte grp_base_`x' = max(cond(year == `cohort_year', `v', .))
100.     drop ke se
101.     * groups exist only for firms in the cohort; they are constant within a firm
.     foreach r in main strict early base {
102.         replace grp_`r'_`x' = . if !in_cohort
103.         bysort firm_id: assert grp_`r'_`x' == grp_`r'_`x'[1]
104.     }
105.     replace k_`x' = . if !in_cohort
106.     replace s_`x' = . if !in_cohort
107. }
108. drop in_pre in_early
109. label define grp 1 "in the group" 0 "other firms"
110. label values grp_* grp
111. *===========================================================================
. * END R10 FROZEN PRE-COVID GROUPS
. *===========================================================================
. * ---- keep the start file's firms also in one of the two files before, their files p2 to f3 ----
. local s = cond(`cohort_year' == `covid_start', 1, 2)      // 1 = COVID years, 2 = normal years
112. keep if in_cohort & new_to_file == 0 & inrange(year, `p2', `f3')
113. gen byte section = `s'
114. gen byte stayer  = (state_file == 1)        // in every later file (a table-only check)
115. keep firm_id year section stayer ex dir_only industry2_reported province_code ///
>     grp_main_exp grp_main_imp grp_main_fdi
116. foreach q in p2 p1 f1 f2 f3 {
117.     local `q'_`s' ``q''
118. }
119. local start_`s' `cohort_year'
120. if !`first' append using `panel'
121. save `panel', replace
122. local first 0
123. }
