. display "Step 4/9: share exporting per group and file (the lines)"
Step 4/9: share exporting per group and file (the lines)

. *---------------------------------------------------------------------------
. * Share = firms that export / firms of the series in that file with a known answer, in %.
. * Firms that left the files are not in the later files; an unknown answer is left out.
. * 95% interval (table only): Wilson interval for a share.
. tempname pf

. tempfile shr

. postfile `pf' byte(section gi) str8 grouping byte grp int year byte pos byte(dir_only drawn) ///
>     double(n_infile n_known n_yes pct ci_lo ci_hi) using `shr', replace
(file /var/folders/0k/wcj_06q55_gd0c7z2x717jsc0000gn/T//S_19164.000005 not found)

. forvalues s = 1/2 {
  2.     local gi 0
  3.     foreach x in exp imp fdi {
  4.         local ++gi
  5.         foreach g in 1 0 {
  6.             local pp 0
  7.             foreach y of local win_`s' {
  8.                 local ++pp
  9.                 quietly count if section == `s' & grp_main_`x' == `g' & year == `y'
 10.                 local nin = r(N)
 11.                 quietly count if section == `s' & grp_main_`x' == `g' & year == `y' & !missing(ex)
 12.                 local N = r(N)
 13.                 quietly count if section == `s' & grp_main_`x' == `g' & year == `y' & ex == 100
 14.                 local n = r(N)
 15.                 local lo .
 16.                 local hi .
 17.                 if `N' > 0 {
 18.                     quietly cii proportions `N' `n', wilson
 19.                     local lo = 100 * r(lb)
 20.                     local hi = 100 * r(ub)
 21.                 }
 22.                 local isdir : list y in dir_yrs
 23.                 post `pf' (`s') (`gi') ("`x'") (`g') (`y') (`pp' - 3) (`isdir') (`N' >= `min_n') ///
>                     (`nin') (`N') (`n') (cond(`N' > 0, 100 * `n' / `N', .)) (`lo') (`hi')
 24.             }
 25.         }
 26.     }
 27. }

. postclose `pf'

