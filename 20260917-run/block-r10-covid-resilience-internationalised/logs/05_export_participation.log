. capture program drop r10_pts

. program define r10_pts, rclass
  1.     * whole percentage points with a sign and a true minus: +12, −3, 0
.     args v
  2.     local r = round(`v')
  3.     local sg = cond(`r' > 0, "+", cond(`r' < 0, "−", ""))
  4.     return local s "`sg'`=string(abs(`r'), "%9.0f")'"
  5. end

. local olab1 "exporters"

. local olab2 "importers"

. local olab3 "foreign-owned firms"

. local apart ""

. local n_apart 0

. forvalues g = 1/3 {
  2.     quietly count if gi == `g' & version == "covid" & yearly & pos < 0 & clear == 1
  3.     local flag_`g' = r(N) > 0
  4.     if r(N) > 0 {
  5.         local ++n_apart
  6.         local apart "`apart'; `olab`g''"
  7.     }
  8.     * v1 = COVID years vs the start file, v2 = pooled (x Post2020), v3 = normal years vs
.     * their start file, v4 = COVID minus normal years
.     local k 0
  9.     foreach vt in "covid avgpost" "covid pooled" "normal avgpost" "diff covid_minus_normal" {
 10.         local ++k
 11.         gettoken vv tt : vt
 12.         local tt = strtrim("`tt'")
 13.         foreach q in b lo hi {
 14.             quietly summarize `q' if gi == `g' & version == "`vv'" & term == "`tt'", meanonly
 15.             r10_pts `=r(mean)'
 16.             local `q'_ `r(s)'
 17.         }
 18.         local v`k'_`g' "`b_' (`lo_' to `hi_')"
 19.     }
 20.     local pt1_`g' "`post_rng' vs `start_1': `v1_`g''"
 21.     local pt2_`g' "`post_rng' vs `pool_rng': `v2_`g''"
 22.     local ptA_`g' "Normal years, `bpost_rng' vs `start_2': `v3_`g''"
 23.     local ptB_`g' "COVID minus normal years: `v4_`g''"
 24.     local pt3_`g' = cond(`flag_`g'', "Already apart before COVID", "")
 25.     * "mostly also seen in normal years": the COVID-years number (against the start file)
.     * is clearly away from 0, the normal-years number too, with the same sign and at least
.     * half its size, and COVID minus normal years is not: the change is mostly the
.     * fall-back also seen without COVID (for exporters: chosen for exporting before)
.     foreach vt in "covid avgpost 1" "normal avgpost 3" "diff covid_minus_normal 4" {
 26.         local vv : word 1 of `vt'
 27.         local tt : word 2 of `vt'
 28.         local kk : word 3 of `vt'
 29.         quietly summarize b if gi == `g' & version == "`vv'" & term == "`tt'", meanonly
 30.         local bb`kk' = r(mean)
 31.         quietly summarize clear if gi == `g' & version == "`vv'" & term == "`tt'", meanonly
 32.         local cl`kk' = r(mean)
 33.     }
 34.     local fb_`g' = (`cl1' == 1 & `cl3' == 1 & `cl4' == 0 & sign(`bb1') == sign(`bb3') & abs(`bb3') >= 0.5 * abs(`bb
> 1'))
 35.     local ptF_`g' = cond(`fb_`g'', "Mostly also seen in normal years: fall-back, not COVID", "")
 36.     display "   panel `g': `ptA_`g'' | `ptB_`g'' | `pt1_`g'' | `pt2_`g'' | `pt3_`g''"
 37. }
