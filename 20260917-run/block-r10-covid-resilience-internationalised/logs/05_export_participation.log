. local npost : word count `post_1'

. assert `npost' >= 1

. local post_2 ""

. forvalues k = 1/`npost' {
  2.     local post_2 "`post_2' `f`k'_2'"
  3. }

. local post_2 = strtrim("`post_2'")

. forvalues s = 1/2 {
  2.     local mw_`s' "`pre_`s'' `start_`s'' `post_`s''"      // the files of the main models
  3. }

. foreach y of local win_2 {
  2.     local isdir : list y in dir_yrs
  3.     assert !`isdir'                                        // the normal years keep one question
  4. }

. local lastmain : word `npost' of `post_1'

. assert `f3_2' < `p2_1'                                     // the two windows do not overlap

