. *---------------------------------------------------------------------------
. display "Step 4/8: regressions: group x each file (reference `cohort_year'), and the pooled term"
Step 4/8: regressions: group x each file (reference 2019), and the pooled term

. *---------------------------------------------------------------------------
. * Model (the same as R10-03, only the outcome differs): outcome = firm's own average + one
. * average per industry and file + one per province and file + the group's extra change in
. * each file against `cohort_year':  b_year = group minus other firms, percentage points.
. * Versions:  closed   = all sample firms, closed firms at -200 after leaving: drawn, hollow square (what-if)
. *            stay     = stayers only (firms in every later file): drawn, solid dot (other end)
. *            infile   = every firm in whatever files it is in, no 0 rows (table only; R10-03's circles)
. *            fyclosed = closed, firm + year averages only (table only)
. * Pooled (Bu Deasy's "x Post2020"): the same model with one term, group x every file after
. * `cohort_year', against the files `p2' to `cohort_year' together (a separate regression).
. local ab_closed   "firm_id ind#year prov#year"

. local ab_stay     "firm_id ind#year prov#year"

. local ab_infile   "firm_id ind#year prov#year"

. local ab_fyclosed "firm_id year"

. tempname P

. tempfile res

. postfile `P' str8 grouping str8 version byte outcome_id str8 term int year double(b se df_r) ///
>     long(rows firms singletons n_g1 n_g0 cl_g1 cl_g0 ref_g1 ref_g0 firms_g1 firms_g0 closed_rows) ///
>     double before_p using `res', replace
(file /var/folders/0k/wcj_06q55_gd0c7z2x717jsc0000gn/T//S_65406.000004 not found)

. foreach x in exp imp fdi {
  2.     display "   group `x'"
  3.     foreach v in closed stay infile fyclosed {
  4.         use `evdata', clear
  5.         keep if !missing(grp_main_`x')
  6.         if "`v'" == "stay"   keep if stayer
  7.         if "`v'" == "infile" keep if !closed
  8.         gen double X = grp_main_`x'
  9.         local terms ""
 10.         foreach y of local evyrs {
 11.             if `y' != `cohort_year' {
 12.                 gen double t`y' = X * (year == `y')
 13.                 local terms "`terms' t`y'"
 14.             }
 15.         }
 16.         local pre_terms ""
 17.         foreach y of local pre_list {
 18.             local pre_terms "`pre_terms' t`y'"
 19.         }
 20.         gen double tpost = X * post
 21.         foreach k in 1 2 {
 22.             * --- year by year ---
.             quietly reghdfe y`k' `terms', absorb(`ab_`v'') vce(cluster firm_id)
 23.             capture drop es
 24.             gen byte es = e(sample)
 25.             local N  = e(N)
 26.             local G  = e(N_clust)
 27.             local df = e(df_r)
 28.             local S  = e(num_singletons)
 29.             if "`S'" == "" local S 0
 30.             * before-COVID check: all markers before `cohort_year' are 0 together
.             capture test `pre_terms'
 31.             local bp = cond(_rc, ., r(p))
 32.             * average of the markers after `cohort_year'
.             local lc ""
 33.             foreach y of local post_list {
 34.                 local lc "`lc' + t`y'"
 35.             }
 36.             quietly lincom (`=substr("`lc'", 4, .)') / `npost'
 37.             local ab = r(estimate)
 38.             local as = r(se)
 39.             * firms behind each marker: group (X = 1) and other firms (X = 0) in that year
.             quietly count if es & year == `cohort_year' & X == 1
 40.             local r1 = r(N)
 41.             quietly count if es & year == `cohort_year' & X == 0
 42.             local r0 = r(N)
 43.             capture drop ft
 44.             egen byte ft = tag(firm_id) if es
 45.             quietly count if ft == 1 & X == 1
 46.             local fg1 = r(N)
 47.             quietly count if ft == 1 & X == 0
 48.             local fg0 = r(N)
 49.             quietly count if es & closed
 50.             local ncl = r(N)
 51.             foreach y of local evyrs {
 52.                 if `y' == `cohort_year' continue
 53.                 quietly count if es & year == `y' & X == 1
 54.                 local n1 = r(N)
 55.                 quietly count if es & year == `y' & X == 0
 56.                 local n0 = r(N)
 57.                 quietly count if es & year == `y' & X == 1 & closed
 58.                 local c1 = r(N)
 59.                 quietly count if es & year == `y' & X == 0 & closed
 60.                 local c0 = r(N)
 61.                 * a file with no rows for this outcome is dropped by reghdfe: left empty
.                 capture local sechk = _se[t`y']
 62.                 if _rc local sechk = .
 63.                 if `sechk' == 0 | missing(`sechk') {
 64.                     post `P' ("`x'") ("`v'") (`k') ("`y'") (`y') (.) (.) (`df') (`N') (`G') (`S') ///
>                         (`n1') (`n0') (`c1') (`c0') (`r1') (`r0') (`fg1') (`fg0') (`ncl') (`bp')
 65.                 }
 66.                 else {
 67.                     post `P' ("`x'") ("`v'") (`k') ("`y'") (`y') (_b[t`y']) (_se[t`y']) (`df') (`N') (`G') (`S') //
> /
>                         (`n1') (`n0') (`c1') (`c0') (`r1') (`r0') (`fg1') (`fg0') (`ncl') (`bp')
 68.                 }
 69.             }
 70.             post `P' ("`x'") ("`v'") (`k') ("avgpost") (.) (`ab') (`as') (`df') (`N') (`G') (`S') ///
>                 (.) (.) (.) (.) (`r1') (`r0') (`fg1') (`fg0') (`ncl') (`bp')
 71.             * --- pooled term (Bu Deasy's "x Post2020"), same rows ---
.             quietly reghdfe y`k' tpost if es, absorb(`ab_`v'') vce(cluster firm_id)
 72.             assert e(N) == `N'
 73.             local S2 = e(num_singletons)
 74.             if "`S2'" == "" local S2 0
 75.             post `P' ("`x'") ("`v'") (`k') ("pooled") (.) (_b[tpost]) (_se[tpost]) (e(df_r)) (e(N)) (e(N_clust)) //
> /
>                 (`S2') (.) (.) (.) (.) (`r1') (`r0') (`fg1') (`fg0') (`ncl') (`bp')
 76.         }
 77.     }
 78. }
