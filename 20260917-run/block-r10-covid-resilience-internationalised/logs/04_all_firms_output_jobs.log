. 
. * Totals (table only): each group's total output and workers in each file as % of the same
. * firms' `cohort_year' total. "closed": every sample firm with a known level that year, closed
. * firms counted as 0; "stay": stayers only. Same rows as the outcomes above (y not missing).
. use `evdata', clear
(G0 -> G0.25 OBSCURED -> G0.5 DUMMY PANEL -> G1 RE-ESTIMATED)

. tempfile tot

. local first 1

. foreach x in all exp imp fdi {
  2.     foreach v in closed stay {
  3.         forvalues k = 1/2 {
  4.             preserve
  5.             keep if !missing(y`k')
  6.             if "`v'" == "stay" keep if stayer
  7.             if "`x'" == "all" gen byte grp = 9
  8.             else {
  9.                 gen byte grp = grp_main_`x'
 10.                 drop if missing(grp)               // left out: no known answer
 11.             }
 12.             gen byte one = 1
 13.             collapse (sum) total_year = lev`k' total_base = base`k' firms = one firms_closed = closed, by(grp year)
 14.             gen str8 grouping = "`x'"
 15.             gen str8 version = "`v'"
 16.             gen byte outcome_id = `k'
 17.             if !`first' append using `tot'
 18.             save `tot', replace
 19.             local first 0
 20.             restore
 21.         }
 22.     }
 23. }
