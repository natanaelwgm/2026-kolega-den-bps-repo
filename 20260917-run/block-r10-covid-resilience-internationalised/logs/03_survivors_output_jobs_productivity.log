. display "Step 4/8: regressions: group x each file (reference `cohort_year'), and the pooled term"
Step 4/8: regressions: group x each file (reference 2019), and the pooled term

. *---------------------------------------------------------------------------
. * Model: outcome = firm's own average + one average per industry and file + one per
. * province and file + the group's extra change in each file, against `cohort_year':
. *   b_year = (group's change from `cohort_year' to that year) - (other firms' change), log points.
. * Versions:  stay   = stayers only (firms in every later file): drawn, solid dot
. *            all    = every firm of the sample in whatever files it is in: drawn, hollow circle
. *            fystay = stayers, firm + year averages only (table only)
. * Outcomes 4 (productivity residual) and 5 (output per worker): stayers, main averages, table only.
. * Pooled (Bu Deasy's "x Post2020"): the same model with one term, group x every file after
. * `cohort_year', against the files `p2' to `cohort_year' together (a separate regression).
. local ab_stay   "firm_id ind#year prov#year"

. local ab_all    "firm_id ind#year prov#year"

. local ab_fystay "firm_id year"

. tempname P

. tempfile res

. postfile `P' str8 grouping str8 version byte outcome_id str8 term int year double(b se df_r) ///
>     long(rows firms singletons n_g1 n_g0 ref_g1 ref_g0 firms_g1 firms_g0) double before_p using `res', replace
(file /var/folders/0k/wcj_06q55_gd0c7z2x717jsc0000gn/T//S_26392.000004 not found)

. foreach x in exp imp fdi {
  2.     display "   group `x'"
  3.     foreach v in stay all fystay {
  4.         use `evdata', clear
  5.         keep if !missing(grp_main_`x')
  6.         if "`v'" != "all" keep if stayer
  7.         gen double X = grp_main_`x'
  8.         local terms ""
  9.         foreach y of local evyrs {
 10.             if `y' != `cohort_year' {
 11.                 gen double t`y' = X * (year == `y')
 12.                 local terms "`terms' t`y'"
 13.             }
 14.         }
 15.         local pre_terms ""
 16.         foreach y of local pre_list {
 17.             local pre_terms "`pre_terms' t`y'"
 18.         }
 19.         gen double tpost = X * post
 20.         local ks "1 2 3"
 21.         if "`v'" == "stay" local ks "1 2 3 4 5"
 22.         foreach k of local ks {
 23.             * --- year by year ---
.             quietly reghdfe y`k' `terms', absorb(`ab_`v'') vce(cluster firm_id)
 24.             capture drop es
 25.             gen byte es = e(sample)
 26.             local N  = e(N)
 27.             local G  = e(N_clust)
 28.             local df = e(df_r)
 29.             local S  = e(num_singletons)
 30.             if "`S'" == "" local S 0
 31.             * before-COVID check: all markers before `cohort_year' are 0 together
.             capture test `pre_terms'
 32.             local bp = cond(_rc, ., r(p))
 33.             * average of the markers after `cohort_year'
.             local lc ""
 34.             foreach y of local post_list {
 35.                 local lc "`lc' + t`y'"
 36.             }
 37.             quietly lincom (`=substr("`lc'", 4, .)') / `npost'
 38.             local ab = r(estimate)
 39.             local as = r(se)
 40.             * firms behind each marker: group (X = 1) and other firms (X = 0) in that year
.             quietly count if es & year == `cohort_year' & X == 1
 41.             local r1 = r(N)
 42.             quietly count if es & year == `cohort_year' & X == 0
 43.             local r0 = r(N)
 44.             capture drop ft
 45.             egen byte ft = tag(firm_id) if es
 46.             quietly count if ft == 1 & X == 1
 47.             local fg1 = r(N)
 48.             quietly count if ft == 1 & X == 0
 49.             local fg0 = r(N)
 50.             foreach y of local evyrs {
 51.                 if `y' == `cohort_year' continue
 52.                 quietly count if es & year == `y' & X == 1
 53.                 local n1 = r(N)
 54.                 quietly count if es & year == `y' & X == 0
 55.                 local n0 = r(N)
 56.                 * a file with no rows for this outcome (e.g. no residual) is dropped by reghdfe: left empty
.                 capture local sechk = _se[t`y']
 57.                 if _rc local sechk = .
 58.                 if `sechk' == 0 | missing(`sechk') {
 59.                     post `P' ("`x'") ("`v'") (`k') ("`y'") (`y') (.) (.) (`df') (`N') (`G') (`S') ///
>                         (`n1') (`n0') (`r1') (`r0') (`fg1') (`fg0') (`bp')
 60.                 }
 61.                 else {
 62.                     post `P' ("`x'") ("`v'") (`k') ("`y'") (`y') (_b[t`y']) (_se[t`y']) (`df') (`N') (`G') (`S') //
> /
>                         (`n1') (`n0') (`r1') (`r0') (`fg1') (`fg0') (`bp')
 63.                 }
 64.             }
 65.             post `P' ("`x'") ("`v'") (`k') ("avgpost") (.) (`ab') (`as') (`df') (`N') (`G') (`S') ///
>                 (.) (.) (`r1') (`r0') (`fg1') (`fg0') (`bp')
 66.             * --- pooled term (Bu Deasy's "x Post2020"), same rows ---
.             quietly reghdfe y`k' tpost if es, absorb(`ab_`v'') vce(cluster firm_id)
 67.             assert e(N) == `N'
 68.             * singletons: those the yearly model dropped (the pooled model runs on its rows, so it drops none)
.             post `P' ("`x'") ("`v'") (`k') ("pooled") (.) (_b[tpost]) (_se[tpost]) (e(df_r)) (e(N)) (e(N_clust)) ///
>                 (`S') (.) (.) (`r1') (`r0') (`fg1') (`fg0') (`bp')
 69.         }
 70.     }
 71. }
