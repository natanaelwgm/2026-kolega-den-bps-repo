. * two numbers per panel (stayers), whole %, with their 95% intervals:
. *   line 1 = average of the markers after COVID, against `cohort_year' alone
. *   line 2 = the pooled term (Bu Deasy's x Post2020), against `p2'-`cohort_year' together
. *   line 3 = "Already apart before COVID" where a stayers' marker before `cohort_year' is clear
. forvalues g = 1/3 {
  2.     forvalues k = 1/3 {
  3.         foreach tm in avgpost pooled {
  4.             quietly summarize pct if gi == `g' & outcome_id == `k' & version == "stay" & term == "`tm'"
  5.             local pv = r(mean)
  6.             quietly summarize pct_lo if gi == `g' & outcome_id == `k' & version == "stay" & term == "`tm'"
  7.             local pl = r(mean)
  8.             quietly summarize pct_hi if gi == `g' & outcome_id == `k' & version == "stay" & term == "`tm'"
  9.             local ph = r(mean)
 10.             local s1 = cond(round(`pv') > 0, "+", "") + string(round(`pv'), "%9.0f")
 11.             local s2 = cond(round(`pl') > 0, "+", "") + string(round(`pl'), "%9.0f")
 12.             local s3 = cond(round(`ph') > 0, "+", "") + string(round(`ph'), "%9.0f")
 13.             local v_`tm' "`s1'% (`s2' to `s3')"
 14.         }
 15.         local ptxt1_`g'_`k' "`post_rng' vs `cohort_year': `v_avgpost'"
 16.         local ptxt2_`g'_`k' "`post_rng' vs `pool_rng': `v_pooled'"
 17.         local ptxt3_`g'_`k' = cond(`flag_`g'_`k'', "Already apart before COVID", "")
 18.     }
 19. }

