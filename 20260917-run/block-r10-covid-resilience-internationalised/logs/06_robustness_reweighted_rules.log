. display "Step 6/10: regressions: every outcome x group x version (as R10-02 to R10-05)"
Step 6/10: regressions: every outcome x group x version (as R10-02 to R10-05)

. *---------------------------------------------------------------------------
. * r106_es: the yearly model and the pooled term of R10-03, R10-04 and R10-05, on the rows in
. * memory (X = 1 group, 0 other firms). Outcome = firm's own average + one average per industry
. * and file + one per province and file (or the given averages) + the group's extra change in
. * each file against the reference (start) file:
. *   b_file = (group's change since the start file) - (other firms' change).
. * Posted: one row per file, the average of the markers after the start file ("vs 2019") and
. * the pooled term (Bu Deasy's "x Post2020": group x every later file, against the start file
. * and the files before it together; its own regression on the same rows, "vs 2017-19").
. capture program drop r106_es

. program define r106_es
  1.     args P oid x v y ref wl ab wt
  2.     local terms ""
  3.     local pre_terms ""
  4.     local lc ""
  5.     local np 0
  6.     foreach yy of local wl {
  7.         if `yy' != `ref' {
  8.             gen double t`yy' = X * (year == `yy')
  9.             local terms "`terms' t`yy'"
 10.             if `yy' < `ref' local pre_terms "`pre_terms' t`yy'"
 11.             else {
 12.                 local lc "`lc' + t`yy'"
 13.                 local ++np
 14.             }
 15.         }
 16.     }
 17.     gen double tpost = X * (year > `ref')
 18.     local wexp ""
 19.     if "`wt'" != "" local wexp "[pw = `wt']"
 20.     * --- year by year ---
.     quietly reghdfe `y' `terms' `wexp', absorb(`ab') vce(cluster firm_id)
 21.     gen byte es = e(sample)
 22.     local N  = e(N)
 23.     local G  = e(N_clust)
 24.     local df = e(df_r)
 25.     local S  = e(num_singletons)
 26.     if "`S'" == "" local S 0
 27.     * before-start check: all markers before the start file are 0 together
.     capture test `pre_terms'
 28.     local bp = cond(_rc, ., r(p))
 29.     * average of the markers after the start file
.     quietly lincom (`=substr("`lc'", 4, .)') / `np'
 30.     local ab_ = r(estimate)
 31.     local as_ = r(se)
 32.     * firms behind each marker: group (X = 1) and other firms (X = 0)
.     quietly count if es & year == `ref' & X == 1
 33.     local r1 = r(N)
 34.     quietly count if es & year == `ref' & X == 0
 35.     local r0 = r(N)
 36.     egen byte ft = tag(firm_id) if es
 37.     quietly count if ft == 1 & X == 1
 38.     local fg1 = r(N)
 39.     quietly count if ft == 1 & X == 0
 40.     local fg0 = r(N)
 41.     * what the weighted other firms of the start file are worth (as many firms counted equally)
.     local wo .
 42.     if "`wt'" != "" {
 43.         gen double w2_ = `wt'^2
 44.         quietly summarize `wt' if es & year == `ref' & X == 0
 45.         local sw = r(sum)
 46.         quietly summarize w2_ if es & year == `ref' & X == 0
 47.         local wo = `sw'^2 / r(sum)
 48.     }
 49.     foreach yy of local wl {
 50.         if `yy' == `ref' continue
 51.         quietly count if es & year == `yy' & X == 1
 52.         local n1 = r(N)
 53.         quietly count if es & year == `yy' & X == 0
 54.         local n0 = r(N)
 55.         * a file with no rows for this outcome is dropped by reghdfe: left empty
.         capture local sechk = _se[t`yy']
 56.         if _rc local sechk = .
 57.         if `sechk' == 0 | missing(`sechk') {
 58.             post `P' (`oid') ("`x'") ("`v'") ("`yy'") (`yy') (`ref') (.) (.) (`df') (`N') (`G') (`S') ///
>                 (`n1') (`n0') (`r1') (`r0') (`fg1') (`fg0') (`bp') (`wo')
 59.         }
 60.         else {
 61.             post `P' (`oid') ("`x'") ("`v'") ("`yy'") (`yy') (`ref') (_b[t`yy']) (_se[t`yy']) (`df') (`N') (`G') //
> /
>                 (`S') (`n1') (`n0') (`r1') (`r0') (`fg1') (`fg0') (`bp') (`wo')
 62.         }
 63.     }
 64.     post `P' (`oid') ("`x'") ("`v'") ("avgpost") (.) (`ref') (`ab_') (`as_') (`df') (`N') (`G') (`S') ///
>         (.) (.) (`r1') (`r0') (`fg1') (`fg0') (`bp') (`wo')
 65.     * --- pooled term (Bu Deasy's "x Post2020"), same rows ---
.     quietly reghdfe `y' tpost if es `wexp', absorb(`ab') vce(cluster firm_id)
 66.     assert e(N) == `N'
 67.     * singletons: those the yearly model dropped (the pooled model runs on its rows, so it drops none)
.     post `P' (`oid') ("`x'") ("`v'") ("pooled") (.) (`ref') (_b[tpost]) (_se[tpost]) (e(df_r)) (e(N)) ///
>         (e(N_clust)) (`S') (.) (.) (`r1') (`r0') (`fg1') (`fg0') (`bp') (`wo')
 68.     drop `terms' tpost es ft
 69.     capture drop w2_
 70. end

. 
. * r106_surv: R10-02's gap in "still in the files" (0 or 100) on the firms in memory, one row per
. * firm, expanded to one row per firm and later file; each file gets its own average for every
. * industry and province (or only its own average: version fy). Year by year and the average of
. * the three later files ("vs 2019": every firm is in the start file, so the gap there is 0).
. capture program drop r106_surv

. program define r106_surv
  1.     args P x v ref wl fe wt
  2.     quietly count if X == 1
  3.     local ng = r(N)
  4.     quietly count if X == 0
  5.     local no = r(N)
  6.     local wexp ""
  7.     local wo .
  8.     if "`wt'" != "" {
  9.         local wexp "[pw = `wt']"
 10.         gen double w2_ = `wt'^2
 11.         quietly summarize `wt' if X == 0
 12.         local sw = r(sum)
 13.         quietly summarize w2_ if X == 0
 14.         local wo = `sw'^2 / r(sum)
 15.         drop w2_
 16.     }
 17.     expand 3
 18.     bysort firm_id: gen byte step = _n
 19.     gen double still = 100 * cond(step == 1, still_1, cond(step == 2, still_2, still_3))
 20.     forvalues k = 1/3 {
 21.         gen byte g_`k' = X * (step == `k')
 22.     }
 23.     local ctrl "i.step#i.ind i.step#i.prov"
 24.     if "`fe'" == "fy" local ctrl "i.step"
 25.     * year by year
.     quietly regress still g_1 g_2 g_3 `ctrl' `wexp', vce(cluster firm_id)
 26.     local nobs = e(N)
 27.     local ncl  = e(N_clust)
 28.     local dfr  = e(df_r)
 29.     forvalues k = 1/3 {
 30.         local yy : word `k' of `wl'
 31.         quietly count if e(sample) & step == `k' & X == 1
 32.         local n1 = r(N)
 33.         quietly count if e(sample) & step == `k' & X == 0
 34.         local n0 = r(N)
 35.         post `P' (1) ("`x'") ("`v'") ("`yy'") (`yy') (`ref') (_b[g_`k']) (_se[g_`k']) (`dfr') (`nobs') (`ncl') ///
>             (0) (`n1') (`n0') (`ng') (`no') (`ng') (`no') (.) (`wo')
 36.     }
 37.     * average of the three later files (R10-02's printed gap)
.     quietly regress still X `ctrl' `wexp', vce(cluster firm_id)
 38.     post `P' (1) ("`x'") ("`v'") ("avgpost") (.) (`ref') (_b[X]) (_se[X]) (e(df_r)) (e(N)) (e(N_clust)) ///
>         (0) (.) (.) (`ng') (`no') (`ng') (`no') (.) (`wo')
 39. end

. 
. * Versions (each changes ONE thing against the main rows; the main rows are R10-02/03/05's):
. *   main   the exhibit's own numbers        fy     firm + year averages only (no industry or
. *   eb     other firms reweighted                  province averages; R10-02: file averages only)
. *   strict group = yes in every known answer, other firms = never yes (mixed left out)
. *   early  group from the two files before the start file only (Bu Deasy's literal "pre-2019")
. *   base   group from the start file's answer only
. *   newc   firms new in the start file added (their group comes from that file alone)
. *   allf   output, workers, value added per worker: every firm in whatever files it is in
. *   closed output, workers: R10-04's what-if, firms that left counted as closed (midpoint scale)
. *   stay   exporting: only firms in every later file
. *   bench  normal years: the same, for the firms of the normal-years start file
. *   look   the files before COVID extended by up to lb_n earlier files (table only)
. tempname P

. tempfile res

. postfile `P' byte oid str8 grouping str8 version str8 term int year int ref_year double(b se df_r) ///
>     long(rows firms singletons n_g1 n_g0 ref_g1 ref_g0 firms_g1 firms_g0) double(before_p worth_g0) ///
>     using `res', replace
(file /var/folders/0k/wcj_06q55_gd0c7z2x717jsc0000gn/T//S_01698.00000f not found)

. foreach x in exp imp fdi {
  2.     display "   group `x'"
  3.     * ---- output, workers, value added per worker (2-4) and exporting (5) ----
.     foreach v in main fy eb strict early base newc allf stay bench look {
  4.         foreach oid in 2 3 4 5 {
  5.             if "`v'" == "allf" & `oid' == 5 continue        // exporting: all firms is its main sample
  6.             if "`v'" == "stay" & `oid' <= 4 continue        // output etc.: stayers are the main sample
  7.             if "`v'" == "look" & "`lb_1'" == "" continue    // no earlier files in the data
  8.             local s = cond("`v'" == "bench", 2, 1)
  9.             local G "grp_main_`x'"
 10.             if inlist("`v'", "strict", "early", "base") local G "grp_`v'_`x'"
 11.             * the files of the model
.             if `oid' <= 4 local wl "`win_`s''"
 12.             else local wl "`mw_`s''"
 13.             if "`v'" == "look" local wl "`lb_1' `wl'"
 14.             use `panel', clear
 15.             keep if section == `s'
 16.             if "`v'" != "newc" keep if new_to_file == 0
 17.             keep if !missing(`G', y`oid')
 18.             gen byte inw = 0
 19.             foreach yy of local wl {
 20.                 quietly replace inw = 1 if year == `yy'
 21.             }
 22.             keep if inw
 23.             if (`oid' <= 4 & "`v'" != "allf") | (`oid' == 5 & "`v'" == "stay") keep if stayer
 24.             gen double X = `G'
 25.             local wt ""
 26.             if "`v'" == "eb" {
 27.                 local ws = cond(`oid' <= 4, "stay", "all")
 28.                 merge m:1 firm_id using `w_`x'_`ws'', keep(master match) nogenerate
 29.                 keep if !missing(w)
 30.                 local wt "w"
 31.             }
 32.             quietly count
 33.             if r(N) == 0 continue                          // balance not reached: left empty
 34.             local ab "firm_id ind#year prov#year"
 35.             if "`v'" == "fy" local ab "firm_id year"
 36.             r106_es `P' `oid' `x' `v' y`oid' `start_`s'' "`wl'" "`ab'" "`wt'"
 37.         }
 38.     }
 39.     * ---- R10-04's what-if: output (2) and workers (3), leavers counted as closed ----
.     foreach oid in 2 3 {
 40.         use `cldata', clear
 41.         keep if !missing(grp_main_`x')
 42.         gen double X = grp_main_`x'
 43.         r106_es `P' `oid' `x' closed y`oid' `start_1' "`win_1'" "firm_id ind#year prov#year" ""
 44.     }
 45.     * ---- still in the files (1) ----
.     foreach v in main fy eb strict early base newc bench {
 46.         local s = cond("`v'" == "bench", 2, 1)
 47.         local G "grp_main_`x'"
 48.         if inlist("`v'", "strict", "early", "base") local G "grp_`v'_`x'"
 49.         use `firms', clear
 50.         keep if section == `s'
 51.         if "`v'" != "newc" keep if new_to_file == 0
 52.         keep if !missing(`G')
 53.         gen double X = `G'
 54.         local wt ""
 55.         if "`v'" == "eb" {
 56.             merge m:1 firm_id using `w_`x'_all', keep(master match) nogenerate
 57.             keep if !missing(w)
 58.             local wt "w"
 59.         }
 60.         quietly count
 61.         if r(N) == 0 continue
 62.         r106_surv `P' `x' `v' `start_`s'' "`f1_`s'' `f2_`s'' `f3_`s''" "`v'" "`wt'"
 63.     }
 64. }
