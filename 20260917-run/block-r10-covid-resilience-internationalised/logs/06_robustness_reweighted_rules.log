. foreach x in exp imp fdi {
  2.     foreach ws in all stay {
  3.         use `firmdata', clear
  4.         keep if !missing(grp_main_`x')
  5.         if "`ws'" == "stay" keep if stayer
  6.         quietly count if missing(m1, m2, m3) | missing(ind, island)
  7.         local dnm = r(N)                            // no usable record before COVID (or no
  8.         drop if missing(m1, m2, m3) | missing(ind, island)  // industry or province code)
  9.         gen byte t  = grp_main_`x'
 10.         gen byte t0 = 1 - t
 11.         * an industry or island with firms of only one kind cannot be balanced: its firms are left out
.         bysort ind: egen long n1i = total(t)
 12.         bysort ind: egen long n0i = total(t0)
 13.         bysort island: egen long n1r = total(t)
 14.         bysort island: egen long n0r = total(t0)
 15.         gen byte off = n1i == 0 | n0i == 0 | n1r == 0 | n0r == 0
 16.         quietly count if off & t == 1
 17.         local d1 = r(N)
 18.         quietly count if off & t == 0
 19.         local d0 = r(N)
 20.         drop if off
 21.         quietly count if t == 1
 22.         local n1 = r(N)
 23.         quietly count if t == 0
 24.         local n0 = r(N)
 25.         * the other two groups: share of firms known to be in each (0/100: 100 = in that group;
.         * a firm whose answer is unknown is simply not known to be in it)
.         local stv ""
 26.         foreach z in exp imp fdi {
 27.             if "`z'" == "`x'" continue
 28.             gen double st_`z' = 100 * (grp_main_`z' == 1)
 29.             local stv "`stv' st_`z'"
 30.         }
 31.         * industry and island shares as 0/100 columns; one category of each is left out (shares add to 100)
.         quietly tab ind, gen(I_)
 32.         quietly tab island, gen(R_)
 33.         foreach v of varlist I_* R_* {
 34.             quietly replace `v' = 100 * `v'
 35.         }
 36.         drop I_1 R_1
 37.         local X "m1 m2 m3 `stv' I_* R_*"
 38.         unab X : `X'
 39.         * a measure that is the same for every other firm cannot be moved by weights: left out of the
.         * targets here; the balance check below still tests it
.         local XX ""
 40.         foreach v of local X {
 41.             quietly summarize `v' if t == 0
 42.             if r(sd) > 0 local XX "`XX' `v'"
 43.         }
 44.         mata: r110w = r110eb(st_data(., "`XX'", "t0"), mean(st_data(., "`XX'", "t")), `eb_tol', `eb_maxit')
 45.         gen double w = 1 if t == 1
 46.         mata: st_store(., "w", "t0", r110w * `n1')
 47.         local it  = scalar(r110_iter)
 48.         local gap = scalar(r110_gap)
 49.         * what the weighted other firms are worth: as many equally weighted firms as (sum w)^2 / sum w^2
.         gen double w2 = w^2
 50.         quietly summarize w if t == 0
 51.         local sw = r(sum)
 52.         local wmr = r(max) / r(mean)                // largest weight / average weight
 53.         quietly summarize w2 if t == 0
 54.         local worth = `sw'^2 / r(sum)
 55.         * balance check on every target: weighted gap in spreads
.         local bal = `gap' < `eb_tol'
 56.         foreach v of local X {
 57.             quietly summarize `v' if t == 1
 58.             local mg = r(mean)
 59.             local vg = r(Var)
 60.             quietly summarize `v' if t == 0
 61.             local vo = r(Var)
 62.             quietly summarize `v' [aw = w] if t == 0
 63.             if abs(`mg' - r(mean)) > 1e-5 * sqrt((`vg' + `vo') / 2) local bal 0
 64.         }
 65.         display "   `x' (`ws'): `n1' in group, `n0' others, worth " %6.1f `worth' ///
>             "; steps `it'; balanced: " cond(`bal', "yes", "NO")
 66.         if !`bal' {
 67.             display as error "   balance NOT reached for `x' (`ws'): its reweighted rows are left empty"
 68.             replace w = .
 69.         }
 70.         * the balance table: every measure, each industry and island, before and after weighting
.         quietly levelsof ind, local(inds)
 71.         foreach l of local inds {
 72.             gen double ind_`l' = 100 * (ind == `l')
 73.         }
 74.         quietly levelsof island, local(isls)
 75.         foreach l of local isls {
 76.             gen double isl_`l' = 100 * (island == `l')
 77.         }
 78.         foreach v of varlist m1 m2 m3 `stv' ind_* isl_* {
 79.             quietly summarize `v' if t == 1
 80.             local mg = r(mean)
 81.             local vg = r(Var)
 82.             quietly summarize `v' if t == 0
 83.             local mo = r(mean)
 84.             local vo = r(Var)
 85.             local sdp = sqrt((`vg' + `vo') / 2)
 86.             local mow = .
 87.             if `bal' {
 88.                 quietly summarize `v' [aw = w] if t == 0
 89.                 local mow = r(mean)
 90.             }
 91.             local sb = cond(`sdp' > 0, (`mg' - `mo') / `sdp', .)
 92.             local sa = cond(`sdp' > 0, (`mg' - `mow') / `sdp', .)
 93.             post `hb' ("`x'") ("`ws'") ("`v'") (`mg') (`mo') (`mow') (`sdp') (`sb') (`sa') ///
>                 (`n1') (`n0') (`d1') (`d0') (`dnm') (`it') (`worth') (`wmr') (`gap') (`bal')
 94.         }
 95.         keep firm_id w
 96.         tempfile w_`x'_`ws'
 97.         save `w_`x'_`ws''
 98.     }
