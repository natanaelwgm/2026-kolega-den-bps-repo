. * ---- the check: the rows R10-02 to R10-05 printed or tabled must come out the same here ----
. * (only when their CSVs are in tables/, e.g. after 00_run.do; the CSVs have 4 decimals)
. * source file | its rows (version) -> the version here
. local nchk 0

. foreach src in 02 03 04 05 {
  2.     if "`src'" == "02" local cf "tables/02_left_the_file_by_group_gaps.csv"
  3.     if "`src'" == "03" local cf "tables/03_survivors_output_jobs_productivity.csv"
  4.     if "`src'" == "04" local cf "tables/04_all_firms_output_jobs.csv"
  5.     if "`src'" == "05" local cf "tables/05_export_participation_models.csv"
  6.     capture confirm file "`cf'"
  7.     if _rc {
  8.         display "   check skipped: `cf' not found (run R10-0`=substr("`src'", 2, 1)' first to compare)"
  9.         continue
 10.     }
 11.     preserve
 12.     import delimited using "`cf'", clear varnames(1) stringcols(_all)
 13.     destring b, replace
 14.     if "`src'" == "02" {
 15.         destring section, replace
 16.         keep if section <= 2 & model != "diff"
 17.         gen byte oid = 1
 18.         gen str8 version = cond(section == 1, "main", "bench")
 19.         gen str8 t2 = cond(model == "average", "avgpost", year)
 20.     }
 21.     else if "`src'" == "03" {
 22.         destring outcome_id, replace
 23.         keep if outcome_id <= 3 & inlist(version, "stay", "all", "fystay")
 24.         gen byte oid = outcome_id + 1
 25.         replace version = cond(version == "stay", "main", cond(version == "all", "allf", "fy"))
 26.         gen str8 t2 = term
 27.     }
 28.     else if "`src'" == "04" {
 29.         destring outcome_id, replace
 30.         keep if version == "closed"
 31.         gen byte oid = outcome_id + 1
 32.         gen str8 t2 = term
 33.     }
 34.     else {
 35.         keep if inlist(version, "covid", "normal", "stay", "fy")
 36.         gen byte oid = 5
 37.         replace version = cond(version == "covid", "main", cond(version == "normal", "bench", version))
 38.         gen str8 t2 = term
 39.     }
 40.     keep if !missing(b)
 41.     capture confirm variable reference
 42.     if !_rc keep if reference != "1"                 // the start file's 0 (by definition)
 43.     keep oid grouping version t2 b
 44.     rename (t2 b) (term b_src)
 45.     tempfile chk
 46.     save `chk'
 47.     restore
 48.     merge 1:1 oid grouping version term using `chk', keep(master match using)
 49.     assert _merge != 2                                   // every row of the source is here too
 50.     quietly count if _merge == 3
 51.     local n_`src' = r(N)
 52.     local nchk = `nchk' + r(N)
 53.     assert abs(b - b_src) <= 0.00005 + 1e-9 if _merge == 3
 54.     display "   R10-`src': `n_`src'' estimates compared, all equal (4 decimals)"
 55.     drop _merge b_src
 56. }
