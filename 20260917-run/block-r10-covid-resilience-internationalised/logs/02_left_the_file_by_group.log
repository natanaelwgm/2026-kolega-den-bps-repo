 19.                 local nf = r(N)
 20.                 local lo .
 21.                 local hi .
 22.                 if `N' > 0 {
 23.                     quietly cii proportions `N' `n', wilson
 24.                     local lo = 100 * r(lb)
 25.                     local hi = 100 * r(ub)
 26.                 }
 27.                 post `pf' (`s') (`gi') ("`x'") (`sf') (`g') ("share") (`k') (`y`k'') ///
>                     ("Still in the files") (1) (`n') (`N') (cond(`N' > 0, 100 * `n' / `N', .)) (`lo') (`hi') (`nf')
 28.             }
