. * COVID-years gap minus normal-years gap: both starting files in one model, every
. * average and each gap separate by starting file (same point estimates as above);
. * a firm can be in both starting files, so errors are clustered by firm
. local gi 0

. foreach x in exp imp fdi {
  2.     local ++gi
  3.     preserve
  4.     keep if !missing(grp_main_`x')
  5.     expand 3
  6.     bysort section firm_id: gen byte step = _n
  7.     gen double still = 100 * cond(step == 1, still_1, cond(step == 2, still_2, still_3))
  8.     gen byte g_covid  = grp_main_`x' * (section == 1)
  9.     gen byte g_normal = grp_main_`x' * (section == 2)
 10.     quietly regress still g_covid g_normal i.section#i.step#i.ind i.section#i.step#i.prov, vce(cluster firm_id)
 11.     local nobs = e(N)
 12.     local ncl  = e(N_clust)
 13.     local dfr  = e(df_r)
 14.     quietly lincom g_covid - g_normal
 15.     post `pg' (3) (`gi') ("`x'") (.) ("diff") (0) (.) ///
>         (r(estimate)) (r(se)) (r(lb)) (r(ub)) (2 * ttail(`dfr', abs(r(estimate) / r(se)))) ///
>         (`nobs') (`ncl') (.) (.) (.)
 16.     restore
 17. }
