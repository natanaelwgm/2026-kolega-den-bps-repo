Step 8/8: companion tables - every plotted point, and the gap models (putpdf, no add-on)

. *---------------------------------------------------------------------------
. * ==== COMPANION TABLE (pattern for all exhibits) =============================
. * Owner rule, 28 Sep 2026: every chart gets a table of every plotted point, and
. * every chart of regression coefficients also gets a regression table, written
. * by the same do-file (spec: TABLE_BRIEF.md). This step runs AFTER the graph
. * export, so the chart and the CSV stay byte-identical.
. *
. * How to use it in another exhibit file:
. *   PART 1 (the writer, program ctable_pdf) is copied UNCHANGED.
. *   PART 2 is the only exhibit-specific part: put the numbers in memory (the
. *   tempfile saved right after the CSV export, or the CSV itself), build one
. *   STRING variable per table column, one row per plotted point in chart order
. *   (years not drawn included, with the reason in a status column), then call
. *   ctable_pdf. Format numbers with string(x, "%9.1f") etc. so the table shows
. *   exactly the rounding of the chart labels.
. *
. * ctable_pdf strvars using "tables/NN_name_table.pdf",
. *     title("Table R1-02. ...: every plotted point")    first line, bold
. *     header("Col 1" "Col 2" ...)       one text per column; "|" = line break
. *     [right(numlist)]                  columns right-aligned (numbers)
. *     [norepeat(numlist)]               columns whose repeated text is shown
. *                                       only on the first row of a run
. *     [rules(numlist)]                  thin gray line under these data rows
. *     [notes("line 1" "line 2" ...)]    footer paragraphs (Notes, Source, dev line)
. *     [subtitle(text)] [fontsize(#)] [perpage(#)] [landscape|portrait]
. * Landscape is chosen automatically when there are more than 6 columns. Long
. * tables continue on a new page with the header repeated ("(continued)"); a page
. * never breaks inside a block whose first column is empty (e.g. an SE row).
. * --- PART 1: the writer (identical in every file; do not edit) ---------------
. capture program drop ctable_pdf

. program define ctable_pdf
  1.     version 17
  2.     syntax varlist(string) using/, TItle(string) HEADer(string asis) ///
>         [RIGHT(numlist integer >0) NOREPeat(numlist integer >0) RULES(numlist integer >0) ///
>          NOTEs(string asis) SUBtitle(string) FONTsize(real 9.5) PERpage(integer 0) ///
>          LANDscape PORTrait]
  3.     local nc : word count `varlist'
  4.     local nh : word count `header'
  5.     if `nh' != `nc' {
  6.         display as error "ctable_pdf: `nc' columns but `nh' header texts"
  7.         exit 198
  8.     }
  9.     local orient = cond(`nc' > 6, "landscape", "")
 10.     if "`landscape'" != "" local orient "landscape"
 11.     if "`portrait'"  != "" local orient ""
 12.     * rows per page: a conservative guess for 9-10 pt text (wrapped cells take more)
.     if `perpage' == 0 local perpage = cond("`orient'" == "landscape", 24, 40)
 13.     preserve
 14.     quietly {
 15.         keep `varlist'
 16.         rename (`varlist') (__c#), addnumber      // __c1 __c2 ... in the order given
 17.         forvalues j = 1/`nc' {
 18.             replace __c`j' = strtrim(__c`j')
 19.         }
 20.         local N = _N
 21.         gen long row = _n
 22.         * page chunks: fill up to perpage rows; prefer to end a page at a rule,
.         * never start a page on a row whose first column is empty
.         gen int chunk = .
 23.         local start 1
 24.         local k 0
 25.         while `start' <= `N' {
 26.             local ++k
 27.             local end = min(`start' + `perpage' - 1, `N')
 28.             if `end' < `N' {
 29.                 local best 0
 30.                 foreach r of local rules {
 31.                     if `r' >= `start' + floor(`perpage' / 2) & `r' <= `end' & `r' > `best' local best `r'
 32.                 }
 33.                 if `best' > 0 local end `best'
 34.                 else {
 35.                     while `end' > `start' & __c1[`end' + 1] == "" {
 36.                         local --end
 37.                     }
 38.                 }
 39.             }
 40.             replace chunk = `k' in `start'/`end'
 41.             local start = `end' + 1
 42.         }
 43.         local nk `k'
 44.         * blank repeated labels inside each page; a column is blanked only while the
.         * norepeat columns to its left are unchanged too (a new panel shows its series)
.         gen byte same = _n > 1 & chunk == chunk[_n - 1]
 45.         foreach j of local norepeat {
 46.             gen strL o`j' = __c`j'
 47.             replace same = same & o`j' == o`j'[_n - 1]
 48.             replace __c`j' = "" if same
 49.             drop o`j'
 50.         }
 51.         drop same
 52.         * column widths (% of the page), from the longest text in each column;
.         * long text columns are capped so they wrap instead of squeezing numbers
.         matrix W = J(1, `nc', 0)
 53.         local tot 0
 54.         forvalues j = 1/`nc' {
 55.             gen long L`j' = udstrlen(__c`j')
 56.             summarize L`j', meanonly
 57.             local w = max(r(max), 3)
 58.             local h : word `j' of `header'
 59.             local h = subinstr(`"`h'"', "|", " ", .)
 60.             foreach hw of local h {
 61.                 local w = max(`w', udstrlen(`"`hw'"'))
 62.             }
 63.             local w = min(`w', 34) + 2          // + 2 = room for the cell margins
 64.             matrix W[1, `j'] = `w'
 65.             local tot = `tot' + `w'
 66.             drop L`j'
 67.         }
 68.         local used 0
 69.         forvalues j = 1/`nc' {
 70.             if `j' < `nc' {
 71.                 matrix W[1, `j'] = max(floor(100 * W[1, `j'] / `tot'), 3)
 72.                 local used = `used' + W[1, `j']
 73.             }
 74.             else matrix W[1, `j'] = 100 - `used'
 75.         }
 76.     }
 77.     putpdf clear
 78.     putpdf begin, pagesize(A4) `orient' font("Times New Roman", `fontsize') ///
>         margin(left, 0.8in) margin(right, 0.8in) margin(top, 0.5in) margin(bottom, 0.5in)
 79.     forvalues k = 1/`nk' {
 80.         if `k' > 1 putpdf pagebreak
 81.         putpdf paragraph, spacing(after, 4pt)
 82.         local tt = cond(`k' == 1, `"`title'"', `"`title' (continued)"')
 83.         putpdf text (`"`tt'"'), bold font("Times New Roman", `=`fontsize' + 1.5')
 84.         if `k' == 1 & `"`subtitle'"' != "" {
 85.             putpdf paragraph, spacing(after, 4pt)
 86.             putpdf text (`"`subtitle'"')
 87.         }
 88.         quietly count if chunk == `k'
 89.         local nr = r(N) + 1
 90.         quietly putpdf table T`k' = data(__c1-__c`nc') if chunk == `k', varnames border(all, nil) width(W)
 91.         forvalues j = 1/`nc' {
 92.             * header text; "|" starts a new line inside the cell
.             local rest : word `j' of `header'
 93.             local opt ""
 94.             while `"`rest'"' != "" {
 95.                 gettoken part rest : rest, parse("|")
 96.                 if `"`part'"' == "|" {
 97.                     putpdf table T`k'(1, `j') = (""), linebreak append
 98.                     continue
 99.                 }
100.                 putpdf table T`k'(1, `j') = (`"`part'"'), valign(bottom) `opt'
101.                 local opt "append"
102.             }
103.             local al = cond(`: list j in right', "right", "left")
104.             putpdf table T`k'(., `j'), halign(`al') margin(top, 0pt) margin(bottom, 0pt)
105.         }
106.         putpdf table T`k'(1, .), border(top, single, black) border(bottom, single, black)
107.         putpdf table T`k'(`nr', .), border(bottom, single, black)
108.         foreach r of local rules {
109.             quietly summarize row if chunk == `k', meanonly
110.             if `r' >= r(min) & `r' < r(max) {
111.                 putpdf table T`k'(`=`r' - r(min) + 2', .), border(bottom, single, "A6A6A6")
112.             }
113.         }
114.     }
115.     local first 1
116.     foreach n of local notes {
117.         putpdf paragraph, spacing(before, `=cond(`first', 6, 1)'pt)
118.         putpdf text (`"`n'"'), font("Times New Roman", `=`fontsize' - 0.5')
119.         local first 0
120.     }
121.     putpdf save `"`using'"', replace
122.     restore
123. end

. * --- end of PART 1 ------------------------------------------------------------
. 
. * --- PART 2: the rows of this exhibit (the only part that changes per file) ---
. * (1) Points table: every point of the chart, panel by panel, line by line (legend
