 16.         local mv`alt' = max(`mv`alt'', abs(r(mean) - `p0'))
 17.         if `c0' != `c1' | (`c0' == 1 & `s0' != `s1') local chg`alt' = strtrim("`chg`alt'' `o'")
 18.     }
 19.     local nch : word count `chg`alt''
 20.     if `nch' == 0 local ans`alt' "no answer changes"
