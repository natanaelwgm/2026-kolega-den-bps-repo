. display "Step 5/7: estimate each measure with firm and year fixed effects (clustered by firm), seven versions"
Step 5/7: estimate each measure with firm and year fixed effects (clustered by firm), seven versions

. *---------------------------------------------------------------------------
. * Log measure on the markers, removing each firm's own average level (firm fixed
. * effects) and each year's average (year fixed effects, set mostly by the
. * comparison firms). A firm with one usable year cannot be compared with itself;
. * reghdfe drops it and reports the number. Coefficient b = log difference from
. * the firm's year before the start, net of the comparison firms' change; drawn
. * as 100 x (exp(b) - 1) = % difference. Main = exactly R2-03's rows and model.
. * Versions (the chart shows "main" and "nodoubt"; all are in the table):
. *   age2     = adds the previous paper's control (age squared, see Step 4)
. *   no2017   = drops the 2017 starters (no 2016 file: they may have started in 2016)
. *   exact    = keeps only starters seen not exporting the year just before
. *   nodoubt  = without doubtful energy records (Step 4)
. *   common   = only firm-years where all six measures exist (same rows in every row)
. *   no2017yr = without every 2017 record (the year firms making their own
. *              electricity report far more fuel; most of those rows are doubtful)
. local nv 7

. local v1 "main"

. local v2 "age2"

. local v3 "no2017"

. local v4 "exact"

. local v5 "nodoubt"

. local v6 "common"

. local v7 "no2017yr"

. local e1 "1"

. local e2 "1"

. local e3 "gA != 2017"                                   // comparison firms (gA missing) stay

. local e4 "missing(gA) | exactA == 1"

. local e5 "!doubt"

. local e6 "all6"

. local e7 "year != 2017"

. local c2 "age2"

. local lc = subinstr("`post'", " ", " + ", .)            // years 0..+`whi', for the average

. local np : word count `post'

. * Second base (a check): the average of every single year before the start
. * (`wlo' to -1, the year just before counting as 0), instead of the year just
. * before only. A year just before that happens to be high or low moves the
. * main average; it moves this one much less.
. local lb = subinstr("`pre_in'", " ", " + ", .)          // years `wlo'..-2

. local nbase : word count `pre_in'

. local nbase = `nbase' + 1                                    // plus the year just before (0)

. tempname h

. postfile `h' byte outcome str8 version str8 term int event_time byte(grouped reference) ///
>     double(b se lo hi p) long(firms rows firms_early firms_late start_years) using `est'

. forvalues o = 1/`nall' {
  2.   forvalues s = 1/`nv' {
  3.     quietly reghdfe y`o' `terms' `c`s'' if `e`s'', absorb(firm_id year) vce(cluster firm_id)
  4.     matrix B`o'_`s' = e(b)
  5.     local df = e(df_r)
  6.     local N`o'_`s'  = e(N)
  7.     local G`o'_`s'  = e(N_clust)
  8.     local sg`o'_`s' = e(num_singletons)
  9.     capture drop es
 10.     gen byte es = e(sample)
 11.     * rows of this version where this measure has no value (a part is zero)
.     quietly count if missing(y`o') & (`e`s'')
 12.     local z`o'_`s' = r(N)
 13.     * Joint test: all years before the start (with and without the grouped end) are 0.
.     quietly test `pre'
 14.     local F`o'_`s'  = r(F)
 15.     local Fd`o'_`s' = r(df)
 16.     local Fp`o'_`s' = r(p)
 17.     quietly test `pre_in'
 18.     local Fq`o'_`s' = r(p)
 19.     * Average over the start year and the years after it inside the window.
.     quietly lincom (`lc') / `np'
 20.     local a`o'_`s'  = r(estimate)
 21.     local as`o'_`s' = r(se)
 22.     local al`o'_`s' = r(estimate) - invttail(`df', 0.025) * r(se)
 23.     local ah`o'_`s' = r(estimate) + invttail(`df', 0.025) * r(se)
 24.     local ap`o'_`s' = 2 * ttail(`df', abs(r(estimate) / r(se)))
 25.     * The same average, measured against the average of the years before the start.
.     if `nbase' > 1 quietly lincom (`lc') / `np' - (`lb') / `nbase'
 26.     else        quietly lincom (`lc') / `np'
 27.     local vb`o'_`s'  = r(estimate)
 28.     local vbs`o'_`s' = r(se)
 29.     local vbl`o'_`s' = r(estimate) - invttail(`df', 0.025) * r(se)
 30.     local vbh`o'_`s' = r(estimate) + invttail(`df', 0.025) * r(se)
 31.     local vbp`o'_`s' = 2 * ttail(`df', abs(r(estimate) / r(se)))
 32.     egen byte ftag = tag(firm_id) if es
 33.     quietly count if ftag == 1 & !missing(gA)
 34.     local st`o'_`s' = r(N)
 35.     quietly count if ftag == 1 & keyA == 9001
 36.     local cf`o'_`s' = r(N)
 37.     drop ftag
 38.     foreach t in `terms' ev_ref {
 39.         if "`t'" == "ev_lo"       local k = `wlo' - 1
 40.         else if "`t'" == "ev_hi"  local k = `whi' + 1
 41.         else if "`t'" == "ev_ref" local k = -1
 42.         else local k = cond(substr("`t'", 4, 1) == "m", -1, 1) * real(substr("`t'", 5, .))
 43.         * starters behind each point (a firm counts once in a grouped end)
.         egen byte ft = tag(firm_id) if es & `t'
 44.         quietly count if ft == 1
 45.         local nf = r(N)
 46.         quietly count if es & `t'
 47.         local nr = r(N)
 48.         quietly count if ft == 1 & gA < 2016
 49.         local ne = r(N)
 50.         quietly count if ft == 1 & gA > 2016
 51.         local nl = r(N)
 52.         quietly levelsof gA if es & `t'
 53.         local ny : word count `r(levels)'
 54.         drop ft
 55.         if "`t'" == "ev_ref" {
 56.             post `h' (`o') ("`v`s''") ("`t'") (`k') (0) (1) (0) (.) (0) (0) (.) (`nf') (`nr') (`ne') (`nl') (`ny')
 57.         }
 58.         else {
 59.             local b  = _b[`t']
 60.             local se = _se[`t']
 61.             post `h' (`o') ("`v`s''") ("`t'") (`k') (inlist("`t'", "ev_lo", "ev_hi")) (0) (`b') (`se') ///
>                 (`b' - invttail(`df', 0.025) * `se') (`b' + invttail(`df', 0.025) * `se') ///
>                 (2 * ttail(`df', abs(`b' / `se'))) (`nf') (`nr') (`ne') (`nl') (`ny')
 62.         }
 63.     }
 64.     if `s' == 1 | `s' == 5 {
 65.         local pshow = cond(`Fp`o'_`s'' < 0.001, "< 0.001", "= " + string(`Fp`o'_`s'', "%5.3f"))
 66.         display "   `o' `v`s'': " %6.0fc `N`o'_`s'' " rows, " %5.0fc `G`o'_`s'' " firms (" `st`o'_`s'' " starters);
>  average " ///
>             %5.1f 100 * (exp(`a`o'_`s'') - 1) "%; before-start test p `pshow'"
 67.         display "      same average against all years before the start: " %5.1f 100 * (exp(`vb`o'_`s'') - 1) "% (p 
> " %5.3f `vbp`o'_`s'' ")"
 68.     }
 69.   }
 70. }
