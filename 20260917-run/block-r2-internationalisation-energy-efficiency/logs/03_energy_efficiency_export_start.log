. *---------------------------------------------------------------------------
. display "Step 5/7: estimate with firm and year fixed effects (clustered by firm), four versions"
Step 5/7: estimate with firm and year fixed effects (clustered by firm), four versions

. *---------------------------------------------------------------------------
. * Log outcome on the markers, removing each firm's own average level (firm fixed
. * effects) and each year's average (year fixed effects, set mostly by the
. * comparison firms). A firm with one usable year cannot be compared with itself;
. * reghdfe drops it and reports the number. Coefficient b = log difference from
. * the firm's year before the start, net of the comparison firms' change; drawn
. * as 100 x (exp(b) - 1) = % difference.
. * Versions (the figure shows "main"; the others are in the table):
. *   age2   = adds the previous paper's control (age squared, see Step 4)
. *   no2017 = drops the 2017 starters (no 2016 file: they may have started in 2016)
. *   exact  = keeps only starters seen not exporting the year just before
. local v1 "main"

. local v2 "age2"

. local v3 "no2017"

. local v4 "exact"

. local c2 "age2"

. local if3 "if gA != 2017"                               // comparison firms (gA missing) stay

. local if4 "if missing(gA) | exactA == 1"

. local lc = subinstr("`post'", " ", " + ", .)            // years 0..+`whi', for the average

. local np : word count `post'

. tempname h

. postfile `h' str8 version str8 term int event_time byte(grouped reference) ///
>     double(b se lo hi p) long(firms rows firms_early firms_late start_years) using `est'

. forvalues s = 1/4 {
  2.     quietly reghdfe y `terms' `c`s'' `if`s'', absorb(firm_id year) vce(cluster firm_id)
  3.     local df = e(df_r)
  4.     local N`s'  = e(N)
  5.     local G`s'  = e(N_clust)
  6.     local sg`s' = e(num_singletons)
  7.     capture drop es
  8.     gen byte es = e(sample)
  9.     * Joint test: all years before the start (with and without the grouped end) are 0.
.     quietly test `pre'
 10.     local F`s'  = r(F)
 11.     local Fd`s' = r(df)
 12.     local Fp`s' = r(p)
 13.     quietly test `pre_in'
 14.     local Fq`s' = r(p)
 15.     * Average over the start year and the years after it inside the window.
.     quietly lincom (`lc') / `np'
 16.     local a`s'  = r(estimate)
 17.     local al`s' = r(estimate) - invttail(`df', 0.025) * r(se)
 18.     local ah`s' = r(estimate) + invttail(`df', 0.025) * r(se)
 19.     egen byte ftag = tag(firm_id) if es
 20.     quietly count if ftag == 1 & !missing(gA)
 21.     local st`s' = r(N)
 22.     quietly count if ftag == 1 & keyA == 9001
 23.     local cf`s' = r(N)
 24.     drop ftag
 25.     foreach t in `terms' ev_ref {
 26.         if "`t'" == "ev_lo"       local k = `wlo' - 1
 27.         else if "`t'" == "ev_hi"  local k = `whi' + 1
 28.         else if "`t'" == "ev_ref" local k = -1
 29.         else local k = cond(substr("`t'", 4, 1) == "m", -1, 1) * real(substr("`t'", 5, .))
 30.         * starters behind each point (a firm counts once in a grouped end)
.         egen byte ft = tag(firm_id) if es & `t'
 31.         quietly count if ft == 1
 32.         local nf = r(N)
 33.         quietly count if es & `t'
 34.         local nr = r(N)
 35.         quietly count if ft == 1 & gA < 2016
 36.         local ne = r(N)
 37.         quietly count if ft == 1 & gA > 2016
 38.         local nl = r(N)
 39.         quietly levelsof gA if es & `t'
 40.         local ny : word count `r(levels)'
 41.         drop ft
 42.         if "`t'" == "ev_ref" {
 43.             post `h' ("`v`s''") ("`t'") (`k') (0) (1) (0) (.) (0) (0) (.) (`nf') (`nr') (`ne') (`nl') (`ny')
 44.         }
 45.         else {
 46.             local b  = _b[`t']
 47.             local se = _se[`t']
 48.             post `h' ("`v`s''") ("`t'") (`k') (inlist("`t'", "ev_lo", "ev_hi")) (0) (`b') (`se') ///
>                 (`b' - invttail(`df', 0.025) * `se') (`b' + invttail(`df', 0.025) * `se') ///
>                 (2 * ttail(`df', abs(`b' / `se'))) (`nf') (`nr') (`ne') (`nl') (`ny')
 49.         }
 50.     }
 51.     display "   `v`s'': " %6.0fc `N`s'' " rows, " %5.0fc `G`s'' " firms (" `st`s'' " starters), " ///
>         %5.0fc `sg`s'' " one-year firms dropped; before-start test p = " %5.3f `Fp`s''
 52.     if `s' == 1 & `"`mexpr'"' != "" {
 53.         * The mirror outcome is minus the drawn one, so every coefficient flips sign exactly.
.         matrix bmain = e(b)
 54.         quietly reghdfe ym `terms', absorb(firm_id year) vce(cluster firm_id)
 55.         foreach t of local terms {
 56.             assert reldif(_b[`t'], -bmain[1, "`t'"]) < 1e-6
 57.         }
 58.     }
 59. }
