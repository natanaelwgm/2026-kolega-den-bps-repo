. *---------------------------------------------------------------------------
. display "Step 2/5: date each firm's entry under two rules (same code in every R2 file)"
Step 2/5: date each firm's entry under two rules (same code in every R2 file)

. *---------------------------------------------------------------------------
. * Missing status is unknown, never read as "not participating".
. * Rule A, simple first entry (main): the first year the firm is seen
. *   participating, if it was seen NOT participating in some earlier year.
. *   Firms participating when first seen cannot be dated and are left out.
. * Rule B, previous paper's sustained entry (variant): the first year t with
. *   participation in t, none in t-1 AND t-2, and participation again in t+1
. *   (exact calendar years; the missing 2016 file breaks the pattern).
. * Comparison group for BOTH rules: firms never seen participating.
. * Row keys: 9001 never seen participating · 9002 already participating when first
. * seen (rule A, excluded) · 9003 status never observed · 9004 seen participating
. * without the sustained pattern (rule B, excluded) · 8000 all entrants · 9999 all firms.
. local first 1

. foreach m in export import fdi10 {
  2.     use `base', clear
  3.     if "`m'" == "export" local x export_flag
  4.     if "`m'" == "import" local x import_flag
  5.     if "`m'" == "fdi10"  local x fdi_10_flag
  6. 
.     * --- Rule A ---
.     by firm_id: egen int first_yes = min(cond(`x' == 1, year, .))
  7.     by firm_id: egen int first_no  = min(cond(`x' == 0, year, .))
  8.     by firm_id: egen int n_known   = total(!missing(`x'))
  9.     gen int keyA = .
 10.     replace keyA = 9003 if n_known == 0                                     // status never observed
 11.     replace keyA = 9001 if n_known > 0 & missing(first_yes)                 // never seen participating
 12.     replace keyA = 9002 if n_known > 0 & !missing(first_yes) & (missing(first_no) | first_no > first_yes)
 13.     replace keyA = first_yes if n_known > 0 & !missing(first_yes) & !missing(first_no) & first_no < first_yes
 14.     assert !missing(keyA)
 15.     gen int gA = keyA if keyA < 9000                                        // entry year, rule A
 16.     by firm_id: egen int last_no_before = max(cond(`x' == 0 & year < gA, year, .))
 17.     gen byte exactA = !missing(gA) & last_no_before == gA - 1               // seen "no" the year just before
 18.     by firm_id: egen int first_stop = min(cond(!missing(gA) & `x' == 0 & year > gA, year, .))
 19.     gen byte stopA = !missing(first_stop)                                   // later seen not participating
 20.     by firm_id: egen byte reenterA = max(!missing(first_stop) & `x' == 1 & year > first_stop)
 21. 
.     * --- Rule B ---
.     gen byte cleanB = (`x' == 1 & L1.`x' == 0 & L2.`x' == 0 & F1.`x' == 1)
 22.     by firm_id: egen int gB = min(cond(cleanB == 1, year, .))               // entry year, rule B
 23.     by firm_id: egen byte earlier_yesB = max(`x' == 1 & year < gB & !missing(gB))
 24.     gen int keyB = cond(!missing(gB), gB, cond(n_known == 0, 9003, cond(missing(first_yes), 9001, 9004)))
 25. 
.     * --- one row per firm, then one row per group ---
.     gen byte one     = 1
 26.     gen byte beforeA = !missing(gA) & year <  gA
 27.     gen byte fromA   = !missing(gA) & year >= gA
 28.     gen byte beforeB = !missing(gB) & year <  gB
 29.     gen byte fromB   = !missing(gB) & year >= gB
 30.     collapse (first) keyA keyB exactA stopA reenterA earlier_yesB ///
>              (sum) fy = one bA = beforeA fA = fromA bB = beforeB fB = fromB, by(firm_id)
 31.     preserve
 32.     collapse (count) simple_firms = firm_id (sum) simple_firm_years = fy simple_rows_before_entry = bA ///
>         simple_rows_from_entry = fA simple_entry_year_exact = exactA simple_later_stop = stopA ///
>         simple_later_reenter = reenterA, by(keyA)
 33.     rename keyA row_key
 34.     tempfile tA
 35.     save `tA'
 36.     restore
 37.     collapse (count) sustained_firms = firm_id (sum) sustained_firm_years = fy ///
>         sustained_rows_before_entry = bB sustained_rows_from_entry = fB ///
>         sustained_had_earlier_yes = earlier_yesB, by(keyB)
 38.     rename keyB row_key
 39.     merge 1:1 row_key using `tA', nogenerate
 40. 
.     * --- full row skeleton: entry years 2010-2022, then the other groups ---
.     tempfile got
 41.     save `got'
 42.     clear
 43.     set obs 19
 44.     gen byte row_order = _n
 45.     gen int row_key = 2009 + _n if _n <= 13
 46.     replace row_key = 8000 if _n == 14                                      // all entrants
 47.     replace row_key = 9001 if _n == 15
 48.     replace row_key = 9002 if _n == 16
 49.     replace row_key = 9004 if _n == 17
 50.     replace row_key = 9003 if _n == 18
 51.     replace row_key = 9999 if _n == 19                                      // all firms
 52.     merge 1:1 row_key using `got', nogenerate
 53.     assert !missing(row_order)
 54. 
.     * Which rule applies to which row (the other rule's cells stay empty).
.     gen byte isA = (inrange(row_key, 2011, 2022) & row_key != 2016) | inlist(row_key, 9001, 9002, 9003)
 55.     gen byte isB = inlist(row_key, 2012, 2013, 2014, 2019, 2020, 2021) | inlist(row_key, 9001, 9004, 9003)
 56.     foreach v of varlist simple_* {
 57.         replace `v' = 0 if isA & missing(`v')          // a possible group with no firms is a genuine 0
 58.         replace `v' = . if !isA & row_key < 8000
 59.     }
 60.     foreach v of varlist sustained_* {
 61.         replace `v' = 0 if isB & missing(`v')
 62.         replace `v' = . if !isB & row_key < 8000
 63.     }
 64.     * Entry details only make sense for entrants.
.     foreach v in simple_rows_before_entry simple_rows_from_entry simple_entry_year_exact simple_later_stop simple_late
> r_reenter {
 65.         replace `v' = . if row_key > 9000
 66.     }
 67.     foreach v in sustained_rows_before_entry sustained_rows_from_entry sustained_had_earlier_yes {
 68.         replace `v' = . if row_key > 9000
 69.     }
 70.     replace simple_firms = . if row_key == 9004
 71.     replace simple_firm_years = . if row_key == 9004
 72.     replace sustained_firms = . if row_key == 9002
 73.     replace sustained_firm_years = . if row_key == 9002
 74.     * Totals: all entrants (row 14) and all firms (row 19).
.     foreach v of varlist simple_* sustained_* {
 75.         quietly summarize `v' if row_key < 8000
 76.         replace `v' = r(sum) if row_key == 8000
 77.     }
 78.     foreach v in simple_firms simple_firm_years sustained_firms sustained_firm_years {
 79.         quietly summarize `v' if row_key < 9999 & row_key != 8000
 80.         replace `v' = r(sum) if row_key == 9999
 81.     }
 82.     assert simple_firms == `N_firms' & sustained_firms == `N_firms' if row_key == 9999
 83.     assert simple_firm_years == `N_rows' & sustained_firm_years == `N_rows' if row_key == 9999
 84.     assert simple_entry_year_exact <= simple_firms & simple_later_reenter <= simple_later_stop if row_key < 8000 & 
> isA
 85.     assert simple_rows_before_entry >= simple_firms & simple_rows_from_entry >= simple_firms if row_key < 8000 & is
> A
 86.     if "`m'" == "export" assert simple_later_stop == 0 if inlist(row_key, 2022)     // nothing after the last file
 87. 
.     gen str6 margin = "`m'"
 88.     if !`first' append using `rows'
 89.     save `rows', replace
 90.     local first 0
 91. }
