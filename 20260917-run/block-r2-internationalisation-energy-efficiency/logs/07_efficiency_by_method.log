. program define r207_cell, rclass
  1.     args m cond
  2.     quietly count if method == "`m'" & `cond' & !missing(b)
  3.     if r(N) == 0 {
  4.         return local b "—"
  5.         return local s ""
  6.         return local p ""
  7.         exit
  8.     }
  9.     quietly summarize b if method == "`m'" & `cond', meanonly
 10.     return local b = string(r(mean), "%9.3f")
 11.     quietly summarize se if method == "`m'" & `cond', meanonly
 12.     return local s = cond(missing(r(mean)), "", "(" + string(r(mean), "%9.3f") + ")")
 13.     quietly summarize pct if method == "`m'" & `cond', meanonly
 14.     return local p = cond(missing(r(mean)), "", "[" + cond(r(mean) > 0, "+", "") + string(r(mean), "%9.1f") + "%]")
 15. end

