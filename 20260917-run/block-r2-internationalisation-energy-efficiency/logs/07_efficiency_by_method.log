. local gapnote ""

. if "`gapyr'" != "" & (`ok_cs' | `ok_sa' | `ok_dcdh') {
.     local g1 : word 1 of `gapyr'
.     local gapnote "No `gapyr' file: Callaway–Sant'Anna, Sun–Abraham and de Chaisemartin–D'Haultfœuille leave out firms
>  that started in `=`g1'+1'."
. }

. local txt "Notes: Every row compares firms that start exporting (first year seen exporting after a year seen not expor
> ting) with firms never seen"

. local txt "`txt' exporting: the change in value added per GJ since before the start."

. local txt "`txt' Rows 2 to 5 are the previous paper's four methods, named after their authors; they differ only in how
>  they combine"

. local txt "`txt' firms that start in different years: Callaway–Sant'Anna, Sun–Abraham and de Chaisemartin–D'Haultfœuil
> le compare each start"

. local txt "`txt' year only with never-exporters; Borusyak–Jaravel–Spiess also uses later starters' years before their 
> start."

. local txt "`txt' Figure R2-03's single regression can mix start years."

. local txt "`txt' The first `nw' averages run from `s_min' to `s_max'; `clr' (a bar crossing 0 = no clear difference)."

. local txt "`txt' Before the start = the method's own check that starters were not already changing differently (p belo
> w 0.05 = they were)."

. local txt "`txt' `gapnote' Value added = output value minus materials, energy and services bought (current prices); GJ
>  = gigajoules."

. local txt "`txt' Timing, not proof of cause; firm links are fictional."

. local maxw 53.5                                         // widest note line that fits the 9-inch PDF

. local nl 0

. local line ""

. local lw 0

. foreach w of local txt {
  2.     local n  = ustrlen(`"`w'"')
  3.     local na = `n' - ustrlen(ustrregexra(`"`w'"', "[ijltfr.,;:'()\-]", ""))
  4.     local wi = `n' - ustrlen(ustrregexra(`"`w'"', "[A-Zmw]", ""))
  5.     local pc = `n' - ustrlen(ustrregexra(`"`w'"', "%", ""))
  6.     local dg = `n' - ustrlen(ustrregexra(`"`w'"', "[0-9+=]", ""))
  7.     local ww = 0.29*`na' + 0.7*`wi' + 0.83*`pc' + 0.52*`dg' + 0.47*(`n' - `na' - `wi' - `pc' - `dg')
  8.     local try = `lw' + 0.25*(`"`line'"' != "") + `ww'
  9.     if `try' > `maxw' & `"`line'"' != "" {
 10.         local ++nl
 11.         local L`nl' `"`line'"'
 12.         local W`nl' = `lw'
 13.         local line `"`w'"'
 14.         local lw = `ww'
 15.     }
 16.     else {
 17.         local line = strtrim(`"`line' `w'"')
 18.         local lw = `try'
 19.     }
 20. }

. local ++nl

. local L`nl' `"`line'"'

. local W`nl' = `lw'

. local notes ""

. forvalues j = 1/`nl' {
  2.     display "   note line `j': " udstrlen(`"`L`j''"') " characters, width " %4.1f `W`j'' " of `maxw' em"
  3.     local notes `"`notes' "`L`j''""'
  4. }
