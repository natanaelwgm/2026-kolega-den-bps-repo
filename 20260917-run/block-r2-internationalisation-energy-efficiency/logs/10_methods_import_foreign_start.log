. display "Step 4/8: each start event and version under each method"
Step 4/8: each start event and version under each method

. *---------------------------------------------------------------------------
. * All five: log value added per GJ, firm and year effects, starters compared
. * with firms never seen participating, clustered by firm, no control variables.
. * What differs is how start years and years since the start are combined
. * (R2-07). Main number per method = average of years 0 to +`whi' with each year
. * counting equally; each method's own single overall number is kept too.
. * Counts behind each estimate: starters with a row from the start year on,
. * comparison firms and rows, all inside the estimation sample (variable es).
. capture program drop r210_used

. program define r210_used, rclass
  1.     quietly {
  2.         egen byte r210_fs = tag(firm_id) if es & !never & year >= gA
  3.         count if r210_fs == 1
  4.         return scalar starters = r(N)
  5.         egen byte r210_fc = tag(firm_id) if es & never
  6.         count if r210_fc == 1
  7.         return scalar comp = r(N)
  8.         count if es
  9.         return scalar rows = r(N)
 10.         drop r210_fs r210_fc
 11.     }
 12. end

. tempname h

. postfile `h' str3 event byte version byte morder str8 method str12 row_type int event_time double(b se df) ///
>     long(starters comp_firms rows) str80 status str120 note double pin using `est'

. timer clear 2

. timer on 2

. local enum 0

. foreach e in imp fdi any {
  2.     local ++enum
  3.     forvalues v = 1/2 {
  4.         * ---- the sample of this event and version ----
.         use `fy', clear
  5.         local gv "g_`e'"
  6.         local kv "key_`e'"
  7.         if `v' == 2 & "`e'" == "fdi" {
  8.             local gv "g_fdiraw"
  9.             local kv "key_fdiraw"
 10.         }
 11.         if `v' == 1 keep if main_`e'
 12.         else        keep if filed_`e'
 13.         gen int gA = `gv'
 14.         gen byte never = missing(gA)
 15.         assert `kv' == 9001 if never                        // comparison = never seen participating only
 16.         gen int kA = year - gA
 17.         gen double y = ln(value_added_nominal / total_gj_s1) // log value added per GJ (R2-03's outcome)
 18.         * R2-03's markers: one per year since the start inside the window, except -1
.         * (the year before the start = the reference), plus one for each grouped end.
.         gen byte ev_lo = !missing(kA) & kA < `wlo'
 19.         local terms "ev_lo"
 20.         local pre   "ev_lo"
 21.         local post  ""
 22.         forvalues k = `wlo'/`whi' {
 23.             if `k' == -1 continue
 24.             local nm = cond(`k' < 0, "ev_m" + string(-`k'), "ev_p" + string(`k'))
 25.             gen byte `nm' = (kA == `k')
 26.             local terms `terms' `nm'
 27.             if `k' < -1 local pre `pre' `nm'
 28.             if `k' >= 0 local post `post' `nm'
 29.         }
 30.         gen byte ev_hi = !missing(kA) & kA > `whi'
 31.         local terms `terms' ev_hi
 32.         foreach t of local terms {
 33.             quietly count if `t'
