.         * ---- (3) Sun-Abraham (eventstudyinteract): R2-03's markers, start years kept apart ----
.         if !`ok_sa' {
128.             post `h' ("`e'") (`v') (3) ("sa") ("avg") (.) (.) (.) (.) (.) (.) (.) ("unavailable: package not instal
> led (`=strtrim("`miss_sa'")')") ("ssc install eventstudyinteract; ssc install avar") (.)
129.         }
130.         else {
131.             use `smp', clear
132.             * A start year whose year before has no file (the year after the missing
.             * file) has no reference year: the package would silently measure those
.             * starters against their grouped last years instead (it drops one of their
.             * markers). Leave such start years out, as Callaway-Sant'Anna and
.             * de Chaisemartin-D'Haultfoeuille do by construction.
.             bysort gA: egen byte has_ref = max(kA == -1)
133.             egen byte ft0 = tag(firm_id) if !never & !has_ref
134.             quietly count if ft0 == 1
135.             local sa_out = r(N)
136.             drop if !never & !has_ref
137.             drop ft0 has_ref
138.             local sa_terms ""
139.             foreach t of local terms {
140.                 quietly count if `t'
141.                 if r(N) > 0 local sa_terms `sa_terms' `t'
142.             }
143.             assert "`sa_terms'" == "`terms'"                 // every marker still has starter rows
144.             capture quietly eventstudyinteract y `terms', cohort(gA) control_cohort(never) absorb(i.firm_id i.year)
>  vce(cluster firm_id)
145.             if _rc {
146.                 post `h' ("`e'") (`v') (3) ("sa") ("avg") (.) (.) (.) (.) (.) (.) (.) ("failed: eventstudyinteract 
> stopped with error r(`=_rc')") ("") (.)
147.             }
148.             else {
149.                 capture drop es
150.                 gen byte es = e(sample)
151.                 r210_used
152.                 local st = r(starters)
153.                 local cf = r(comp)
154.                 local rw = r(rows)
155.                 local df = e(df_r)
156.                 matrix bsa = e(b_iw)
157.                 matrix vsa = e(V_iw)
158.                 ereturn post bsa vsa, dof(`df')
159.                 foreach t of local terms {
160.                     if "`t'" == "ev_lo"      local k = `wlo' - 1
161.                     else if "`t'" == "ev_hi" local k = `whi' + 1
162.                     else local k = cond(substr("`t'", 4, 1) == "m", -1, 1) * real(substr("`t'", 5, .))
163.                     local nt = cond(inlist("`t'", "ev_lo", "ev_hi"), "grouped end", "")
164.                     post `h' ("`e'") (`v') (3) ("sa") ("event") (`k') (_b[`t']) (_se[`t']) (`df') (.) (.) (.) ("ok"
> ) ("`nt'") (.)
165.                 }
166.                 quietly lincom (`lc') / `np'
167.                 local sa_`e'`v' = r(estimate)
168.                 local sa_out_`e' = `sa_out'
169.                 post `h' ("`e'") (`v') (3) ("sa") ("avg") (.) (r(estimate)) (r(se)) (`df') (`st') (`cf') (`rw') ("o
> k") ("years 0 to +`whi', each counts equally; `sa_out' starters with no file the year before the start left out") (.)
170.                 quietly test `pre'
171.                 post `h' ("`e'") (`v') (3) ("sa") ("before_check") (.) (.) (.) (.) (.) (.) (.) ("ok") ("F test, yea
> rs before the start (grouped end included) = 0; p in column p") (r(p))
172.             }
173.         }
