.         * ---- (4) Borusyak-Jaravel-Spiess (did_imputation) ----
.         * Fits firm and year effects on rows not yet (or never) participating,
.         * predicts each starter's path without the start, and averages actual
.         * minus predicted. Its before-start check asks whether the years just
.         * before the start already differ from the firm's earlier years.
.         if !`ok_bjs' {
175.             post `h' ("`e'") (`v') (4) ("bjs") ("avg") (.) (.) (.) (.) (.) (.) (.) ("unavailable: package not insta
> lled (`=strtrim("`miss_bjs'")')") ("ssc install did_imputation") (.)
176.         }
177.         else {
178.             use `smp', clear
179.             gen int Ei = gA                                  // start year; missing = never started
180.             * minn(0): report every year; the window rule already needs 30+ starters per year.
.             capture quietly did_imputation y firm_id year Ei, horizons(0/`whi') pretrends(`=-`wlo'') autosample minn(0
> )
181.             if _rc {
182.                 post `h' ("`e'") (`v') (4) ("bjs") ("avg") (.) (.) (.) (.) (.) (.) (.) ("failed: did_imputation sto
> pped with error r(`=_rc')") ("") (.)
183.             }
184.             else {
185.                 capture drop es
186.                 gen byte es = e(sample)
187.                 r210_used
188.                 local st = r(starters)
189.                 local cf = r(comp)
190.                 local rw = r(rows)
191.                 local p_bjs = e(pre_p)
192.                 forvalues k = 0/`whi' {
193.                     post `h' ("`e'") (`v') (4) ("bjs") ("event") (`k') (_b[tau`k']) (_se[tau`k']) (.) (.) (.) (.) (
> "ok") ("vs predicted path without the start") (.)
194.                 }
195.                 forvalues k = 1/`=-`wlo'' {
196.                     post `h' ("`e'") (`v') (4) ("bjs") ("event") (-`k') (_b[pre`k']) (_se[pre`k']) (.) (.) (.) (.) 
> ("ok") ("before-start check: vs the firm's earlier years") (.)
197.                 }
198.                 local lcb "tau0"
199.                 forvalues k = 1/`whi' {
200.                     local lcb "`lcb' + tau`k'"
201.                 }
202.                 quietly lincom (`lcb') / `=`whi' + 1'
203.                 post `h' ("`e'") (`v') (4) ("bjs") ("avg") (.) (r(estimate)) (r(se)) (.) (`st') (`cf') (`rw') ("ok"
> ) ("years 0 to +`whi', each counts equally") (.)
204.                 post `h' ("`e'") (`v') (4) ("bjs") ("before_check") (.) (.) (.) (.) (.) (.) (.) ("ok") ("joint test
>  of the `=-`wlo'' years before the start; p in column p") (`p_bjs')
205.                 capture quietly did_imputation y firm_id year Ei, autosample minn(0)
206.                 if !_rc post `h' ("`e'") (`v') (4) ("bjs") ("own_overall") (.) (_b[tau]) (_se[tau]) (.) (.) (.) (e(
> N)) ("ok") ("one average over all starter rows from the start on") (.)
207.             }
208.         }
