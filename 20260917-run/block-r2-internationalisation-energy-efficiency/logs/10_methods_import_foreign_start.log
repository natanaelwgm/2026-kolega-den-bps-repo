 28.     }
 29.     forvalues k = `=`wlo' - 1'/`=`whi' + 1' {
 30.         local lab = cond(`k' > 0, "+", "") + string(`k')
 31.         if `k' < `wlo' local lab "≤ `lab' (grouped)"
 32.         if `k' > `whi' local lab "≥ `lab' (grouped)"
 33.         forvalues c = 1/6 {
 34.             r210_cell `e' `c' `"row_type == "event" & event_time == `k'"'
 35.             local b`c' "`r(b)'"
 36.             local s`c' "`r(s)'"
 37.             local p`c' "`r(p)'"
 38.             if `k' == -1 & inlist(`c', 1, 3, 6) local b`c' "reference"
 39.         }
 40.         post `P' ("Year `lab'") ("`b1'") ("`b2'") ("`b3'") ("`b4'") ("`b5'") ("`b6'")
 41.         post `P' ("")           ("`s1'") ("`s2'") ("`s3'") ("`s4'") ("`s5'") ("`s6'")
 42.         if `show_pct' post `P' ("") ("`p1'") ("`p2'") ("`p3'") ("`p4'") ("`p5'") ("`p6'")
 43.         local nr = `nr' + 2 + `show_pct'
 44.     }
 45.     forvalues c = 1/6 {
 46.         foreach v in starters comp_firms rows {
 47.             quietly summarize `v' if event == "`e'" & col == `c' & row_type == "avg", meanonly
 48.             local `v'`c' = cond(r(N) == 0, "—", string(r(mean), "%12.0fc"))
 49.         }
 50.         quietly levelsof ci_basis if event == "`e'" & col == `c' & row_type == "avg", local(cb) clean
 51.         local ci`c' = cond("`cb'" == "t", "t", cond("`cb'" == "normal", "Normal", "—"))
 52.     }
 53.     post `P' ("Starters")                  ("`starters1'") ("`starters2'") ("`starters3'") ("`starters4'") ("`start
> ers5'") ("`starters6'")
 54.     post `P' ("Never-starters")            ("`comp_firms1'") ("`comp_firms2'") ("`comp_firms3'") ("`comp_firms4'") 
> ("`comp_firms5'") ("`comp_firms6'")
 55.     post `P' ("Observations (firm-years)") ("`rows1'") ("`rows2'") ("`rows3'") ("`rows4'") ("`rows5'") ("`rows6'")
 56.     post `P' ("95% interval")              ("`ci1'") ("`ci2'") ("`ci3'") ("`ci4'") ("`ci5'") ("`ci6'")
 57.     local nr = `nr' + 4
 58.     local rl `rl' `nr'
 59. }

