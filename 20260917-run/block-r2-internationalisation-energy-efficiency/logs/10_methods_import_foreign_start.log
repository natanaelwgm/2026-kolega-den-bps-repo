. local K 99

. foreach m in imp fdi any {
  2.     use `fy', clear
  3.     keep if main_`m' & !missing(g_`m')
  4.     gen int k = year - g_`m'
  5.     gen byte early = g_`m' < `gap1'
  6.     gen byte late  = g_`m' > `gap1'
  7.     collapse (count) n = firm_id (max) early late, by(k)
  8.     gen byte passes = n >= `minfirms' & early & late
  9.     assert passes if inlist(k, -1, 0)
 10.     local K_`m' 0
 11.     local go 1
 12.     while `go' {
 13.         local kk = `K_`m'' + 1
 14.         quietly count if passes & inlist(k, -`kk', `kk')
 15.         if r(N) == 2 local K_`m' = `kk'
 16.         else local go 0
 17.     }
 18.     local K = min(`K', `K_`m'')
 19.     display "   `m': R2-02's rule allows -`K_`m'' to +`K_`m''"
 20. }
