 43. 
.         * ---- (1) one regression, all start years together (R2-03/R2-08's model) ----
.         quietly reghdfe y `terms', absorb(firm_id year) vce(cluster firm_id)
 44.         local df = e(df_r)
 45.         capture drop es
 46.         gen byte es = e(sample)
 47.         r210_used
 48.         local st = r(starters)
 49.         local cf = r(comp)
 50.         local rw = r(rows)
 51.         * (c) only: how many of these starters start by importing (the rest by exporting only).
.         if "`e'" == "any" & `v' == 1 {
 52.             egen byte fti = tag(firm_id) if es & !never & year >= gA & any_imp0
 53.             quietly count if fti == 1
 54.             local any_imp_n = r(N)
 55.             local any_imp_sh = r(N) / `st'
 56.             drop fti
 57.         }
 58.         foreach t of local terms {
 59.             if "`t'" == "ev_lo"      local k = `wlo' - 1
 60.             else if "`t'" == "ev_hi" local k = `whi' + 1
 61.             else local k = cond(substr("`t'", 4, 1) == "m", -1, 1) * real(substr("`t'", 5, .))
 62.             local nt = cond(inlist("`t'", "ev_lo", "ev_hi"), "grouped end", "")
 63.             post `h' ("`e'") (`v') (1) ("twfe") ("event") (`k') (_b[`t']) (_se[`t']) (`df') (.) (.) (.) ("ok") ("`n
> t'") (.)
 64.         }
 65.         quietly lincom (`lc') / `np'
 66.         local tw_`e'`v' = r(estimate)
 67.         post `h' ("`e'") (`v') (1) ("twfe") ("avg") (.) (r(estimate)) (r(se)) (`df') (`st') (`cf') (`rw') ("ok") ("
> reghdfe, R2-03's markers") (.)
 68.         quietly test `pre'
