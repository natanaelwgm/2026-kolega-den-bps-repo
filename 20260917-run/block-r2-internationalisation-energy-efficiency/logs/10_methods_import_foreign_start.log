. display "Step 2/8: date each firm's start (rule A, same code as every R2 file) for the three events"
Step 2/8: date each firm's start (rule A, same code as every R2 file) for the three events

. *---------------------------------------------------------------------------
. * Missing status is unknown, never read as "not participating".
. * Rule A, simple first entry: the first year the firm is seen participating,
. *   if it was seen NOT participating in some earlier year. Firms participating
. *   when first seen cannot be dated and are left out. A starter stays a
. *   starter if it stops later.
. * Comparison group: firms never seen participating.
. * Row keys: 9001 never seen participating · 9002 already participating when first
. * seen (excluded) · 9003 status never observed (excluded).
. * Events: imp = importing; fdi = foreign owner 10%+ with the `fdi_bad' answers
. * unknown (main); fdiraw = the same, answers as filed (as-filed version);
. * any = exporting or importing.
. foreach m in imp fdi fdiraw any {
  2.     if "`m'" == "imp"    local x import_flag
  3.     if "`m'" == "fdi"    local x fdi_fixed
  4.     if "`m'" == "fdiraw" local x fdi_10_flag
  5.     if "`m'" == "any"    local x any_trade
  6.     * --- Rule A ---
.     by firm_id: egen int first_yes = min(cond(`x' == 1, year, .))
  7.     by firm_id: egen int first_no  = min(cond(`x' == 0, year, .))
  8.     by firm_id: egen int n_known   = total(!missing(`x'))
  9.     gen int keyA = .
 10.     replace keyA = 9003 if n_known == 0                                     // status never observed
 11.     replace keyA = 9001 if n_known > 0 & missing(first_yes)                 // never seen participating
 12.     replace keyA = 9002 if n_known > 0 & !missing(first_yes) & (missing(first_no) | first_no > first_yes)
 13.     replace keyA = first_yes if n_known > 0 & !missing(first_yes) & !missing(first_no) & first_no < first_yes
 14.     assert !missing(keyA)
 15.     gen int gA = keyA if keyA < 9000                                        // start year, rule A
 16.     rename (keyA gA) (key_`m' g_`m')
 17.     drop first_yes first_no n_known
 18. }
