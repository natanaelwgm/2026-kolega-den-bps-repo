. * Notes as one text, wrapped by printed width (R2-05's rule; widths in em).
. local g1 : word 1 of `gapyr'

. local txt "Notes: Each row: starters' change in value added per GJ from the year before the start (average of years 0 
> to +`whi'),"

. local txt "`txt' minus the same change among firms never seen doing the same. Start = first year seen importing (a), w
> ith a foreign"

. local txt "`txt' owner holding 10%+ of the capital (b), or exporting or importing (c), after a year seen without (a st
> arter stays one"

. local txt "`txt' if it stops later). Rows 2 to 5 are the previous paper's four methods, named after their authors; the
> y differ only in"

. local txt "`txt' how they combine firms that start in different years (row 1 can mix start years)."

. local txt "`txt' Black dots also leave out energy records of importers with unknown"

. local txt "`txt' export status in `dtxt' (they jump or drop far from other years); the gray triangle keeps every start
>  and record."

. local txt "`txt' Five methods: (a) `rng_imp'; (b) `rng_fdi'; (c) `rng_any' (a bar crossing 0 = no clear difference)."

. local txt "`txt' Before the start = the method's check that starters were not already changing differently (p below 0.
> 05 = they were;"

. local txt "`txt' 'all years' = every year before the start, not only the last `: word `=-`wlo'' of one two three four 
> five six seven eight nine')."

. * Callaway-Sant'Anna's all-years check failing anywhere gets one plain sentence.
. local nall 0

. foreach e in imp fdi any {
  2.     if `bpall_`e'' < 0.05 local ++nall
  3. }

. if `nall' > 0 local txt "`txt' Where 'all years' differs, part of the change after the start may continue an earlier d
> ifference."

. if "`g1'" != "" local txt "`txt' No `gapyr' file: Callaway–Sant'Anna, Sun–Abraham and de Chaisemartin–D'Haultfœuille l
> eave out firms that started in `=`g1'+1'."

. local txt "`txt' Value added = output value minus materials, energy and services bought (current prices); GJ = gigajou
> les."

. local txt "`txt' Timing, not proof of cause; firm links are fictional."

. local maxw 53.5                                         // widest note line that fits the 9-inch PDF

. local nl 0

. local line ""

. local lw 0

. foreach w of local txt {
  2.     local n  = ustrlen(`"`w'"')
  3.     local na = `n' - ustrlen(ustrregexra(`"`w'"', "[ijltfr.,;:'()\-]", ""))
  4.     local wi = `n' - ustrlen(ustrregexra(`"`w'"', "[A-Zmw]", ""))
  5.     local pc = `n' - ustrlen(ustrregexra(`"`w'"', "%", ""))
  6.     local dg = `n' - ustrlen(ustrregexra(`"`w'"', "[0-9+=]", ""))
  7.     local ww = 0.29*`na' + 0.7*`wi' + 0.83*`pc' + 0.52*`dg' + 0.47*(`n' - `na' - `wi' - `pc' - `dg')
  8.     local try = `lw' + 0.25*(`"`line'"' != "") + `ww'
  9.     if `try' > `maxw' & `"`line'"' != "" {
 10.         local ++nl
 11.         local L`nl' `"`line'"'
 12.         local W`nl' = `lw'
 13.         local line `"`w'"'
 14.         local lw = `ww'
 15.     }
 16.     else {
 17.         local line = strtrim(`"`line' `w'"')
 18.         local lw = `try'
 19.     }
 20. }

. local ++nl

. local L`nl' `"`line'"'

. local W`nl' = `lw'

. local notes ""

. forvalues j = 1/`nl' {
  2.     display "   note line `j': " udstrlen(`"`L`j''"') " characters, width " %4.1f `W`j'' " of `maxw' em"
  3.     local notes `"`notes' "`L`j''""'
  4. }
