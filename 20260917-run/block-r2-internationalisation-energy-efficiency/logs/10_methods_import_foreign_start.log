.         * ---- (5) de Chaisemartin-D'Haultfoeuille (did_multiplegt_dyn) ----
.         * It numbers periods as they appear in the data, so every calendar year
.         * missing inside a firm's span (the year with no file included) gets an
.         * empty row with the start status filled in (R2-07's fix). Only
.         * never-starters are comparisons; starters whose year before the start
.         * has no row drop out. "Effect_1" = the start year (year 0), Effect_2 =
.         * year +1, ...; "Placebo_1" = year -2, Placebo_2 = -3, ...
.         if !`ok_dcdh' {
210.             post `h' ("`e'") (`v') (5) ("dcdh") ("avg") (.) (.) (.) (.) (.) (.) (.) ("unavailable: package not inst
> alled (`=strtrim("`miss_dcdh'")')") ("ssc install did_multiplegt_dyn; ssc install gtools") (.)
211.         }
212.         else {
213.             use `smp', clear
214.             * Starters with no usable row from their start year on would look like
.             * firms that never start: leave them out (as the other methods do).
.             bysort firm_id: egen byte has_after = max(!never & year >= gA)
215.             drop if !never & !has_after
216.             keep firm_id year y gA never
217.             tsset firm_id year
218.             tsfill                                          // empty rows for missing years inside each firm's span
219.             bysort firm_id (gA): replace gA = gA[1]
220.             bysort firm_id (never): replace never = never[1]
221.             gen byte D = !never & year >= gA                // start status: on from the start year, stays on
222.             keep firm_id year y D
223.             local ne  = `whi' + 1                           // Effect_1..Effect_`ne' = years 0..+`whi'
224.             local npl = -`wlo' - 1                          // Placebo_1..Placebo_`npl' = years -2..`wlo'
225.             * The package updates itself from the internet in 1 run in 100 unless
.             * told not to. This file never installs or updates anything.
.             capture quietly did_multiplegt_dyn y firm_id year D, effects(`ne') placebo(`npl') only_never_switchers gra
> ph_off _no_updates
226.             if _rc == 198 capture quietly did_multiplegt_dyn y firm_id year D, effects(`ne') placebo(`npl') only_ne
> ver_switchers graph_off no_updates
227.             if _rc == 198 {
228.                 post `h' ("`e'") (`v') (5) ("dcdh") ("avg") (.) (.) (.) (.) (.) (.) (.) ("failed: this did_multiple
> gt_dyn version cannot switch off its self-update") ("update it once: ssc install did_multiplegt_dyn, replace") (.)
229.             }
230.             else if _rc {
231.                 post `h' ("`e'") (`v') (5) ("dcdh") ("avg") (.) (.) (.) (.) (.) (.) (.) ("failed: did_multiplegt_dy
> n stopped with error r(`=_rc')") ("") (.)
232.             }
233.             else {
234.                 local st = e(N_switchers_effect_1)
235.                 local rw = e(N_effect_1)
236.                 local p_dcdh = e(p_jointplacebo)
237.                 forvalues l = 1/`ne' {
238.                     post `h' ("`e'") (`v') (5) ("dcdh") ("event") (`l' - 1) (e(Effect_`l')) (e(se_effect_`l')) (.) 
> (e(N_switchers_effect_`l')) (.) (e(N_effect_`l')) ("ok") ("Effect_`l' (package name) = year `=`l'-1' since the start")
>  (.)
239.                 }
240.                 forvalues l = 1/`npl' {
241.                     post `h' ("`e'") (`v') (5) ("dcdh") ("event") (-1 - `l') (e(Placebo_`l')) (e(se_placebo_`l')) (
> .) (e(N_switchers_placebo_`l')) (.) (e(N_placebo_`l')) ("ok") ("Placebo_`l' (package name) = year `=-1-`l'' vs the yea
> r before the start") (.)
242.                 }
243.                 post `h' ("`e'") (`v') (5) ("dcdh") ("own_overall") (.) (e(Av_tot_effect)) (e(se_avg_total_effect))
>  (.) (.) (.) (e(N_avg_total_effect)) ("ok") ("average total effect: all its effects, weighted by starters behind each"
> ) (.)
244.                 post `h' ("`e'") (`v') (5) ("dcdh") ("before_check") (.) (.) (.) (.) (.) (.) (.) ("ok") ("joint tes
> t of its placebos (years -2 to `wlo'); p in column p") (`p_dcdh')
245.                 local lcd "Effect_1"
246.                 forvalues l = 2/`ne' {
247.                     local lcd "`lcd' + Effect_`l'"
248.                 }
249.                 capture quietly lincom (`lcd') / `ne'
250.                 if !_rc post `h' ("`e'") (`v') (5) ("dcdh") ("avg") (.) (r(estimate)) (r(se)) (.) (`st') (.) (`rw')
>  ("ok") ("years 0 to +`whi', each counts equally; starters and rows = those behind year 0") (.)
251.                 else    post `h' ("`e'") (`v') (5) ("dcdh") ("avg") (.) (.) (.) (.) (`st') (.) (`rw') ("failed: no 
> covariances in this package version") ("update: ssc install did_multiplegt_dyn, replace") (.)
