. * Notes as one text, wrapped below by printed width, not by letter count: in Times
. * New Roman digits, capitals and % are wider than most letters, so a line full of
. * numbers would run past the PDF edge. Widths are in em (about one letter "m").
. local txt "Notes: Start = first year a firm is seen exporting after a year seen not exporting; never-exporters = firms
>  never seen exporting."

. local txt "`txt' Bars = 95% intervals; a bar crossing 0 = no clear difference. Average of years 0 to +`whi': `avgtxt'.
> "

. local txt "`txt' Value added per GJ (Figure R2-03) rises where the value added dot is above the energy use dot; if ene
> rgy use is not"

. local txt "`txt' below 0, that rise is more value added, not less energy (CO2: Figure R2-04). `btxt' Value added = out
> put value"

. local txt "`txt' minus materials, energy and services bought (current prices); GJ = gigajoules. Timing, not proof of c
> ause; firm links"

. local txt "`txt' are fictional: a test of the method only."

. local maxw 53.5                                         // widest note line that fits the 9-inch PDF

. local nl 0

. local line ""

. local lw 0

. foreach w of local txt {
  2.     * printed width of this word: narrow, wide, %, digits, other letters
.     local n  = ustrlen(`"`w'"')
  3.     local na = `n' - ustrlen(ustrregexra(`"`w'"', "[ijltfr.,;:'()\-]", ""))
  4.     local wi = `n' - ustrlen(ustrregexra(`"`w'"', "[A-Zmw]", ""))
  5.     local pc = `n' - ustrlen(ustrregexra(`"`w'"', "%", ""))
  6.     local dg = `n' - ustrlen(ustrregexra(`"`w'"', "[0-9+=]", ""))
  7.     local ww = 0.29*`na' + 0.7*`wi' + 0.83*`pc' + 0.52*`dg' + 0.47*(`n' - `na' - `wi' - `pc' - `dg')
  8.     local try = `lw' + 0.25*(`"`line'"' != "") + `ww'  // 0.25 = one space
  9.     if `try' > `maxw' & `"`line'"' != "" {
 10.         local ++nl
 11.         local L`nl' `"`line'"'
 12.         local W`nl' = `lw'
 13.         local line `"`w'"'
 14.         local lw = `ww'
 15.     }
 16.     else {
 17.         local line = strtrim(`"`line' `w'"')
 18.         local lw = `try'
 19.     }
 20. }

. local ++nl

. local L`nl' `"`line'"'

. local W`nl' = `lw'

. local notes ""

. forvalues j = 1/`nl' {
  2.     display "   note line `j': " udstrlen(`"`L`j''"') " characters, width " %4.1f `W`j'' " of `maxw' em"
  3.     local notes `"`notes' "`L`j''""'
  4. }
