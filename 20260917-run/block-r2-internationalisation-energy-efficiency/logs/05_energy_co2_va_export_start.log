. * Average of years 0..+5 per outcome, and the before-start check sorted into
. * outcomes with a clear difference (p below 0.05, a warning sign) and without.
. local avgtxt ""

. foreach L in fail pass xfail {
  2.     local n`L' 0
  3. }

. forvalues o = 1/3 {
  2.     quietly summarize avg_after_pct if outcome == `o'
  3.     local a = r(mean)
  4.     quietly summarize avg_after_pct_lo if outcome == `o'
  5.     local al = r(mean)
  6.     quietly summarize avg_after_pct_hi if outcome == `o'
  7.     local ah = r(mean)
  8.     local sep = cond(`o' == 3, " and ", cond(`o' == 1, "", ", "))
  9.     local iv  = cond(`o' == 1, "95% interval ", "")
 10.     local avgtxt = "`avgtxt'`sep'`w`o'' " + cond(`a' > 0, "+", "") + string(`a', "%9.0f") + "% (`iv'" ///
>         + cond(`al' > 0, "+", "") + string(`al', "%9.0f") + "% to " + cond(`ah' > 0, "+", "") + string(`ah', "%9.0f") 
> + "%)"
 11.     quietly summarize before_p if outcome == `o'
 12.     local pv = r(mean)
 13.     local pt = "`w`o'' (" + cond(`pv' < 0.001, "p < 0.001", "p = " + string(`pv', "%5.3f")) + ")"
 14.     if `pv' < 0.05 {
 15.         local ++nfail
 16.         local fail`nfail' "`pt'"
 17.     }
 18.     else {
 19.         local ++npass
 20.         local pass`npass' "`pt'"
 21.     }
 22.     * The stricter group (starters seen not exporting the year just before) is
.     * named only where it shows a clear difference and all starters do not.
.     if `pex`o'' < 0.05 & `pv' >= 0.05 {
 23.         local ++nxfail
 24.         local xfail`nxfail' = "`w`o'' (" + cond(`pex`o'' < 0.001, "p < 0.001", "p = " + string(`pex`o'', "%5.3f")) 
> + ")"
 25.     }
 26. }

. foreach L in fail pass xfail {                           // "a", "a and b", "a, b and c"
  2.     local `L'txt ""
  3.     forvalues j = 1/`n`L'' {
  4.         local sep = cond(`j' == 1, "", cond(`j' == `n`L'', " and ", ", "))
  5.         local `L'txt "``L'txt'`sep'``L'`j''"
  6.     }
  7. }

