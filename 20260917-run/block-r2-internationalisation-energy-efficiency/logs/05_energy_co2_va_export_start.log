. display "Step 5/8: estimate each outcome with firm and year fixed effects (clustered by firm), four versions"
Step 5/8: estimate each outcome with firm and year fixed effects (clustered by firm), four versions

. *---------------------------------------------------------------------------
. * Log outcome on the markers, removing each firm's own average level (firm fixed
. * effects) and each year's average (year fixed effects, set mostly by the
. * comparison firms). A firm with one usable year cannot be compared with itself;
. * reghdfe drops it and reports the number. Coefficient b = log difference from
. * the firm's year before the start, net of the comparison firms' change; drawn
. * as 100 x (exp(b) - 1) = % difference. Same rows and markers for all outcomes.
. * Versions (the figure shows "main"; the others are in the table):
. *   age2   = adds the previous paper's control (age squared, see Step 4)
. *   no2017 = drops the 2017 starters (no 2016 file: they may have started in 2016)
. *   exact  = keeps only starters seen not exporting the year just before
. local v1 "main"

. local v2 "age2"

. local v3 "no2017"

. local v4 "exact"

. local c2 "age2"

. local if3 "if gA != 2017"                               // comparison firms (gA missing) stay

. local if4 "if missing(gA) | exactA == 1"

. local lc = subinstr("`post'", " ", " + ", .)            // years 0..+`whi', for the average

. local np : word count `post'

. tempname h

. postfile `h' byte outcome str8 version str8 term int event_time byte(grouped reference) ///
>     double(b se lo hi p) long(firms rows firms_early firms_late start_years) using `est'

. forvalues o = 1/3 {
  2.   forvalues s = 1/4 {
  3.     quietly reghdfe y`o' `terms' `c`s'' `if`s'', absorb(firm_id year) vce(cluster firm_id)
  4.     matrix B`o'_`s' = e(b)
  5.     local df = e(df_r)
  6.     local N`o'_`s'  = e(N)
  7.     local G`o'_`s'  = e(N_clust)
  8.     local sg`o'_`s' = e(num_singletons)
  9.     local ab`o'_`s' "`e(absvars)'"                    // for the regression table (Step 8)
 10.     local cl`o'_`s' "`e(clustvar)'"
 11.     local wt`o'_`s' "`e(wtype)'"
 12.     assert e(N) == `N1_`s''                             // same rows for every outcome
 13.     capture drop es
 14.     gen byte es = e(sample)
 15.     * Joint test: all years before the start (with and without the grouped end) are 0.
.     quietly test `pre'
 16.     local F`o'_`s'  = r(F)
 17.     local Fd`o'_`s' = r(df)
 18.     local Fp`o'_`s' = r(p)
 19.     quietly test `pre_in'
 20.     local Fq`o'_`s' = r(p)
 21.     * Average over the start year and the years after it inside the window.
.     quietly lincom (`lc') / `np'
 22.     local a`o'_`s'  = r(estimate)
 23.     local al`o'_`s' = r(estimate) - invttail(`df', 0.025) * r(se)
 24.     local ah`o'_`s' = r(estimate) + invttail(`df', 0.025) * r(se)
 25.     local as`o'_`s' = r(se)                             // for the regression table (Step 8)
 26.     egen byte ftag = tag(firm_id) if es
 27.     quietly count if ftag == 1 & !missing(gA)
 28.     local st`o'_`s' = r(N)
 29.     quietly count if ftag == 1 & keyA == 9001
 30.     local cf`o'_`s' = r(N)
 31.     drop ftag
 32.     foreach t in `terms' ev_ref {
 33.         if "`t'" == "ev_lo"       local k = `wlo' - 1
 34.         else if "`t'" == "ev_hi"  local k = `whi' + 1
 35.         else if "`t'" == "ev_ref" local k = -1
 36.         else local k = cond(substr("`t'", 4, 1) == "m", -1, 1) * real(substr("`t'", 5, .))
 37.         * starters behind each point (a firm counts once in a grouped end)
.         egen byte ft = tag(firm_id) if es & `t'
 38.         quietly count if ft == 1
 39.         local nf = r(N)
 40.         quietly count if es & `t'
 41.         local nr = r(N)
 42.         quietly count if ft == 1 & gA < 2016
 43.         local ne = r(N)
 44.         quietly count if ft == 1 & gA > 2016
 45.         local nl = r(N)
 46.         quietly levelsof gA if es & `t'
 47.         local ny : word count `r(levels)'
 48.         drop ft
 49.         if "`t'" == "ev_ref" {
 50.             post `h' (`o') ("`v`s''") ("`t'") (`k') (0) (1) (0) (.) (0) (0) (.) (`nf') (`nr') (`ne') (`nl') (`ny')
 51.         }
 52.         else {
 53.             local b  = _b[`t']
 54.             local se = _se[`t']
 55.             post `h' (`o') ("`v`s''") ("`t'") (`k') (inlist("`t'", "ev_lo", "ev_hi")) (0) (`b') (`se') ///
>                 (`b' - invttail(`df', 0.025) * `se') (`b' + invttail(`df', 0.025) * `se') ///
>                 (2 * ttail(`df', abs(`b' / `se'))) (`nf') (`nr') (`ne') (`nl') (`ny')
 56.         }
 57.     }
 58.     local pshow = cond(`Fp`o'_`s'' < 0.001, "< 0.001", "= " + string(`Fp`o'_`s'', "%5.3f"))
 59.     display "   `w`o'', `v`s'': " %6.0fc `N`o'_`s'' " rows, " %5.0fc `G`o'_`s'' " firms (" `st`o'_`s'' " starters),
>  " ///
>         %5.0fc `sg`o'_`s'' " one-year firms dropped; before-start test p `pshow'"
 60.   }
 61. }
