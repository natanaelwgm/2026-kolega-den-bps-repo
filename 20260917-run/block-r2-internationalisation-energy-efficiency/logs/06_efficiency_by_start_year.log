. postclose `h'

. 
. *---------------------------------------------------------------------------
. display "Step 6/8: averages over start years (weighted by starters) and the CSV"
Step 6/8: averages over start years (weighted by starters) and the CSV

. *---------------------------------------------------------------------------
. * All start years in one stacked regression: each start year keeps its own
. * firm and year fixed effects and its own "after" marker, so each coefficient
. * equals Step 5's (checked); clustering by firm accounts for never-exporters
. * that serve in several start years. Averages = weights x coefficients
. * (lincom), weight = number of starters used.
. tempfile avg

. tempname a

. postfile `a' byte(vorder outcome) str16 row_type long starters double(b se df p) using `avg'

. forvalues v = 1/4 {
  2.     use `stack', clear
  3.     keep if vorder == `v'
  4.     egen long fc = group(firm_id cohort)
  5.     egen long yc = group(year cohort)
  6.     local dterms ""
  7.     foreach L in all early late notlast {
  8.         local t`L' 0
  9.         local l`L' ""
 10.     }
 11.     quietly levelsof cohort, local(used)
 12.     foreach g of local used {
 13.         gen byte d`g' = after * (cohort == `g')
 14.         local dterms `dterms' d`g'
 15.         local tall = `tall' + `w`v'_`g''
 16.         if `g' <= `paris_year' local tearly = `tearly' + `w`v'_`g''
 17.         else local tlate = `tlate' + `w`v'_`g''
 18.         if `g' != `lastg' local tnotlast = `tnotlast' + `w`v'_`g''
 19.     }
 20.     foreach g of local used {
 21.         local lall "`lall' + `w`v'_`g''/`tall' * d`g'"
 22.         if `g' <= `paris_year' local learly "`learly' + `w`v'_`g''/`tearly' * d`g'"
 23.         else local llate "`llate' + `w`v'_`g''/`tlate' * d`g'"
 24.         if `g' != `lastg' local lnotlast "`lnotlast' + `w`v'_`g''/`tnotlast' * d`g'"
 25.     }
 26.     * Before-start check, same comparisons: one marker per start year and year
.     * before the start, against the last year before the start that has a file
.     * (the year before; for 2017 starts 2015, as 2016 has no file). Markers for
.     * the same year before the start are averaged over start years (weight =
.     * starters seen that year) and all these averages are tested together.
.     gen int e = year - cohort if gA == cohort
 27.     local lterms ""
 28.     local ltest ""
 29.     forvalues k = `wlo'/-2 {
 30.         local K = -`k'
 31.         local lk`K' ""
 32.         local nk`K' 0
 33.         foreach g of local used {
 34.             quietly summarize e if cohort == `g' & e < 0, meanonly
 35.             if `k' >= r(max) continue                       // reference year or later
 36.             egen byte tq = tag(firm_id) if cohort == `g' & e == `k'
 37.             quietly count if tq == 1
 38.             local m = r(N)
 39.             drop tq
 40.             if `m' == 0 continue
 41.             gen byte q`g'_`K' = cohort == `g' & e == `k'
 42.             local lterms `lterms' q`g'_`K'
 43.             local lk`K' "`lk`K'' + `m' * q`g'_`K'"
 44.             local nk`K' = `nk`K'' + `m'
 45.         }
 46.         if `nk`K'' > 0 local ltest "`ltest' ((`lk`K'') / `nk`K'' = 0)"
 47.     }
 48.     forvalues o = 1/2 {
 49.         if "`ltest'" != "" {
 50.             quietly reghdfe y`o' `dterms' `lterms', absorb(fc yc) vce(cluster firm_id)
 51.             quietly test `ltest'
 52.             post `a' (`v') (`o') ("before_check") (.) (.) (.) (.) (r(p))
 53.         }
 54.         quietly reghdfe y`o' `dterms', absorb(fc yc) vce(cluster firm_id)
 55.         foreach g of local used {
 56.             assert reldif(_b[d`g'], `b`v'_`g'_`o'') < 1e-6
 57.         }
 58.         foreach L in all early late notlast {
 59.             if `t`L'' == 0 continue
 60.             quietly lincom `l`L''
 61.             post `a' (`v') (`o') ("`L'") (`t`L'') (r(estimate)) (r(se)) (r(df)) (r(p))
 62.         }
 63.         if `tearly' > 0 & `tlate' > 0 {
 64.             quietly lincom (`llate') - (`learly')
 65.             post `a' (`v') (`o') ("late_minus_early") (.) (r(estimate)) (r(se)) (r(df)) (r(p))
 66.         }
 67.     }
 68. }
