. display "Step 5/8: one before/after comparison per start year (firm and year fixed effects, clustered by firm)"
Step 5/8: one before/after comparison per start year (firm and year fixed effects, clustered by firm)

. *---------------------------------------------------------------------------
. * For start year g: the starters of year g and all never-exporters, only in
. * calendar years g`wlo' to g+`whi' (the same -`=-`wlo''..+`whi' window as R2-03; the missing
. * 2016 file is simply absent). "after" = 1 for a starter's rows from g on.
. * With firm and year fixed effects its coefficient compares each firm with
. * itself: the starters' change from before g to g on, minus the same change
. * among never-exporters in the same calendar years (firms are seen in
. * different years, so this is not a plain difference of group means).
. * Earlier starters are never used as comparisons, so start years are not mixed.
. * A starter counts only with a usable row both before g and from g on (a
. * firm seen on one side only cannot be compared with itself). A start year
. * gets an estimate only with `minfirms'+ such starters (R2-02's threshold).
. * Versions: 1 main; 2 without doubtful energy records (Step 4); 3 only
. * starters seen not exporting the year just before (start year exact);
. * 4 = 3 without doubtful energy records.
. quietly levelsof gA, local(cohorts)                    // start years in the data, never typed

. local ncoh : word count `cohorts'

. local lastg : word `ncoh' of `cohorts'

. tempfile est stack

. tempname h

. postfile `h' byte(vorder outcome) int start_year long(starters_dated starters st_rows_before st_rows_after ///
>     comp_firms comp_rows rows doubt_rows) int(first_year last_year files_before files_after) ///
>     double(b se df) using `est'

. local first 1

. forvalues v = 1/4 {
  2.     foreach g of local cohorts {
  3.         use `smp', clear
  4.         keep if (gA == `g' | missing(gA)) & inrange(year, `g' + `wlo', `g' + `whi')
  5.         if inlist(`v', 2, 4) drop if doubt
  6.         if inlist(`v', 3, 4) keep if missing(gA) | exactA == 1
  7.         egen byte ft = tag(firm_id) if gA == `g'
  8.         quietly count if ft == 1
  9.         local nd = r(N)                                  // starters dated to g with a usable row
 10.         by firm_id: egen byte has_b = max(year <  `g')
 11.         by firm_id: egen byte has_a = max(year >= `g')
 12.         keep if missing(gA) | (has_b & has_a)
 13.         quietly count if ft == 1
 14.         local ns = r(N)
 15.         local w`v'_`g' = `ns'                            // weight of this start year
 16.         if `ns' < `minfirms' {
 17.             forvalues o = 1/2 {
 18.                 post `h' (`v') (`o') (`g') (`nd') (`ns') (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.)
 19.             }
 20.             continue
 21.         }
 22.         gen byte after = (gA == `g') & year >= `g'
 23.         forvalues o = 1/2 {
 24.             quietly reghdfe y`o' after, absorb(firm_id year) vce(cluster firm_id)
 25.             local b  = _b[after]
 26.             local se = _se[after]
 27.             local df = e(df_r)
 28.             local ab_st "`e(absvars)'"                     // for the regression table (Step 8)
 29.             local cl_st "`e(clustvar)'"
 30.             local b`v'_`g'_`o' = `b'
 31.             capture drop es
 32.             gen byte es = e(sample)
 33.             quietly count if es & gA == `g' & year <  `g'
 34.             local rb = r(N)
 35.             quietly count if es & gA == `g' & year >= `g'
 36.             local ra = r(N)
 37.             egen byte ct = tag(firm_id) if es & missing(gA)
 38.             quietly count if ct == 1
 39.             local cf = r(N)
 40.             drop ct
 41.             quietly count if es & missing(gA)
 42.             local cr = r(N)
 43.             quietly count if es & doubt
 44.             local dr = r(N)
 45.             quietly summarize year if es
 46.             local fy0 = r(min)
 47.             local fy1 = r(max)
 48.             quietly levelsof year if es & year <  `g'
 49.             local nb : word count `r(levels)'
 50.             quietly levelsof year if es & year >= `g'
 51.             local na : word count `r(levels)'
 52.             post `h' (`v') (`o') (`g') (`nd') (`ns') (`rb') (`ra') (`cf') (`cr') (e(N)) (`dr') ///
>                 (`fy0') (`fy1') (`nb') (`na') (`b') (`se') (`df')
 53.         }
 54.         display "   version `v', start year `g': " %4.0f `ns' " starters, value added per GJ b = " %7.4f `b`v'_`g'_
> 1'
 55.         gen int cohort = `g'
 56.         gen byte vorder = `v'
 57.         keep firm_id year cohort vorder gA after y1 y2
 58.         if !`first' append using `stack'
 59.         save `stack', replace
 60.         local first 0
 61.     }
 62. }
