. display "Step 2/7: date each firm's start (rule A, same code as every R2 file) for importing and foreign ownership"
Step 2/7: date each firm's start (rule A, same code as every R2 file) for importing and foreign ownership

. *---------------------------------------------------------------------------
. * Missing status is unknown, never read as "not participating".
. * Rule A, simple first entry: the first year the firm is seen participating,
. *   if it was seen NOT participating in some earlier year. Firms participating
. *   when first seen cannot be dated and are left out.
. * Comparison group: firms never seen participating.
. * Row keys: 9001 never seen participating · 9002 already participating when first
. * seen (excluded) · 9003 status never observed (excluded).
. * Three start events: imp = importing; fdi = foreign owner 10%+ with the
. * `fdi_bad' answers unknown (main); fdiraw = the same, answers as filed.
. * (The previous paper's stricter rule B is counted in R2-01's table only.)
. foreach m in imp fdi fdiraw {
  2.     if "`m'" == "imp"    local x import_flag
  3.     if "`m'" == "fdi"    local x fdi_fixed
  4.     if "`m'" == "fdiraw" local x fdi_10_flag
  5.     * --- Rule A ---
.     by firm_id: egen int first_yes = min(cond(`x' == 1, year, .))
  6.     by firm_id: egen int first_no  = min(cond(`x' == 0, year, .))
  7.     by firm_id: egen int n_known   = total(!missing(`x'))
  8.     gen int keyA = .
  9.     replace keyA = 9003 if n_known == 0                                     // status never observed
 10.     replace keyA = 9001 if n_known > 0 & missing(first_yes)                 // never seen participating
 11.     replace keyA = 9002 if n_known > 0 & !missing(first_yes) & (missing(first_no) | first_no > first_yes)
 12.     replace keyA = first_yes if n_known > 0 & !missing(first_yes) & !missing(first_no) & first_no < first_yes
 13.     assert !missing(keyA)
 14.     gen int gA = keyA if keyA < 9000                                        // start year, rule A
 15.     by firm_id: egen int last_no_before = max(cond(`x' == 0 & year < gA, year, .))
 16.     gen byte exactA = !missing(gA) & last_no_before == gA - 1               // seen "no" the year just before
 17.     rename (keyA gA exactA) (key_`m' g_`m' exact_`m')
 18.     drop first_yes first_no n_known last_no_before
 19. }
