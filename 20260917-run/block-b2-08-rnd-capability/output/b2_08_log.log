######## B2-08: 02_availability ########

. /*==========================================================================
>   Line 2: "Untuk tahun Ketika tersedia:"
>   Data  : SI 2010-2022 (data/b208_si.dta), clean == 1
>   Which capability question is asked in which year, and how many firms answer
> .
>   Output sheets:
>     t02_availability  every capability variable x year: records, answered,
>                       blank, % answered, % yes among answered (pool = asked y
> ears)
>     t02_matrix        % answered, 1 row per variable, 1 column per year
>                       (0 = question not in that year's form)
> 
>   NOTE: a blank is "not asked or not answered", never "no". Even in the years
>   a question is asked, 25-55% of firms leave it blank (R&D: about 45%).
>   rnd_cost and rnd_workers are amounts: block 0 writes 0 when nothing is
>   reported, so for them "answered" = present and "yes" = a positive amount.
> ==========================================================================*/
. if "$B208" == "" {
.     display as error "Run 00_run.do first (it sets the paths)."
.     exit 198
. }

. use "$B208_DATA/b208_si.dta", clear
(G0 -> G0.25 OBSCURED -> G0.5 DUMMY PANEL -> G1 RE-ESTIMATED)

. keep if clean == 1
(30 observations deleted)

. 
. local ALL "rnd rnd_ext rnd_cost rnd_workers innov innov_product innov_process
>  innov_marketing innov_org amdal ukl_upl sppl env_doc waste_treat waste_solid
>  waste_liquid waste_haz waste_any"

. do "$B208/_incidence.do" "`ALL'" "t02_availability"

. /*==========================================================================
>   _incidence.do -- helper: yes / no / blank table, BY YEAR + POOLED
> 
>   Usage (data already loaded, must contain variable year):
>       do "$B208/_incidence.do" "rnd rnd_ext" "t03_rnd_by_year"
> 
>       argument 1 = list of variables (0/1 flags, or amounts: "yes" = > 0)
>       argument 2 = sheet name in output/b2_08_tables.xlsx (max 31 characters)
> 
>   Result: 1 row = variable x period (pool, 2010, 2011, ...)
>     n_records     firm-years in that period
>     n_answered    firm-years with an answer (yes or no)
>     n_blank       not asked or left blank  -- NOT counted as "no"
>     pct_answered  n_answered / n_records
>     n_yes         answered yes (amounts: > 0)
>     pct_yes       n_yes / n_answered       <- the incidence to read
>     pct_yes_all   n_yes / n_records        (lower bound: treats blanks as no)
>   The pooled row only adds up the years in which the question was asked.
>   The data in memory are unchanged after this file runs.
> ==========================================================================*/
. args vars sheet

. 
. tempfile result original

. save `original'
file /var/folders/7l/7f30l8dj7219j21dhg9glmwc0000gn/T//St65806.000002 saved
    as .dta format

. local first 1

. foreach v of local vars {
  2.     local lab : variable label `v'
  3.     preserve
  4.     keep year `v'
  5.     generate n_records  = 1
  6.     generate n_answered = !missing(`v')
  7.     generate n_yes      = (`v' > 0 & !missing(`v'))
  8.     collapse (sum) n_records n_answered n_yes, by(year)
  9.     * pooled row (year = 0): only the years in which the question was aske
> d
.     expand 2 if n_answered > 0, generate(copy)
 10.     replace year = 0 if copy == 1
 11.     collapse (sum) n_records n_answered n_yes, by(year)
 12.     generate str20 variable = "`v'"
 13.     generate str80 question = "`lab'"
 14.     if `first' == 0 append using `result'
 15.     save `result', replace
 16.     local first 0
 17.     restore
 18. }
