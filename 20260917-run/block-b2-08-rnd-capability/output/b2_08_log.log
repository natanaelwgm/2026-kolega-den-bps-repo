. * ---- B. carbon / energy productivity by capability ----
. tempfile stack

. local first 1

. foreach c in rnd rnd_cost_pos innov amdal env_doc waste_treat waste_any {
  2.     use "$B208_DATA/b208_si.dta", clear
  3.     keep if clean == 1 & !missing(`c')
  4.     generate n_firms = 1
  5.     expand 2, generate(copy)
  6.     replace year = 0 if copy == 1
  7.     collapse (sum) n_firms (p50) med_va_per_co2 = va_per_co2 med_va_per_gj
>  = va_per_gj ///
>              med_co2_per_va = co2_per_va (mean) mean_ln_va_per_co2 = ln_va_pe
> r_co2 ///
>              mean_ln_va_per_gj = ln_va_per_gj, by(`c' year)
  8.     generate str14 capability = "`c'"
  9.     rename `c' has_capability
 10.     if `first' == 0 append using `stack'
 11.     save `stack', replace
 12.     local first 0
 13. }
