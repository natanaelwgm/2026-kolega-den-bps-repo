  3.     xtile tmp_e = va_per_gj  if year == `y' & clean == 1, nquantiles(5)
  4.     replace q_cprod = tmp_c if year == `y'
  5.     replace q_eprod = tmp_e if year == `y'
  6.     drop tmp_c tmp_e
  7. }
