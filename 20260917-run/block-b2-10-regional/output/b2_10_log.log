. foreach lev of local levels {
  2.     use "$B210_DATA/b210_si.dta", clear
  3.     keep if clean == 1 & !missing(`lev')
  4.     generate n_firms = 1
  5.     expand 2, generate(copy)              // copy of every row with year =
>  0 for "pool"
  6.     replace year = 0 if copy == 1
  7.     collapse (sum) n_firms gj_s1 gj_s2 gj_total va workers ///
>              (p50) med_gj = gj_total (mean) mean_ln_gj = ln_gj_total, by(`lev
> ' year)
  8.     bysort year: egen double all = total(gj_total)
  9.     generate gj_share_pct = 100 * gj_total / all
 10.     generate gj_per_va    = gj_total / va      if va > 0
 11.     generate gj_pw        = gj_total / workers if workers > 0
 12.     generate period = cond(year == 0, "pool", string(year))
 13.     sort `lev' year
 14.     order `lev' period n_firms gj_s1 gj_s2 gj_total gj_share_pct gj_per_va
>  gj_pw med_gj mean_ln_gj
 15.     drop year all va workers
 16.     if "`lev'" == "java" list if period == "pool", clean noobs
 17.     export excel using "$B210_XLSX", sheet("t04_energy_`lev'", replace) fi
> rstrow(variables)
 18. }
