######## B2-10: 10_ranking ########

. /*==========================================================================
>   Line 10: "Indentifikasi daerah yg lebih clean mana yg carbon intensive"
>   Data  : SI 2010-2022 (data/b210_si.dta), clean == 1
>   Output sheets:
>     t10_rank_prov       provinces ranked by CO2 per VA, pooled 2010-2022
>                         (rank 1 = cleanest), with the quadrant of each
>     t10_quadrant_prov   the quadrant table: how many provinces, and which,
>                         are large/small and cleaner/carbon intensive
>     t10_rank_year_prov  CO2 per VA and rank per province in every year
>                         (shows whether the ranking is stable)
>     t10_rank_kabkot, t10_quadrant_kabkot, t10_rank_year_kabkot
>                         same per district (only when district codes exist)
> 
>   Definitions:
>     co2_per_va   total CO2 / total VA of the region (aggregate)
>     ranked       1 = at least 50 clean firm-years pooled (10 per year in
>                  t10_rank_year_*). Smaller regions stay in the table with
>                  ranked = 0 and no rank, because a region with a handful of
>                  firms can top any ranking by accident.
>     intensity    "Cleaner" if co2_per_va is below the national CO2 per VA,
>                  else "Carbon intensive"
>     size         "Large" if the region's VA share is at or above the median
>                  VA share of the ranked regions, else "Small"
>     quadrant     size x intensity, e.g. "Large, carbon intensive"
>   Also shown, to explain the ranking: co2_per_gj (how dirty each GJ is),
>   co2_s1_per_gj_s1 (own fuel combustion only, without purchased electricity,
>   whose grid factor is one national number), coal share of the energy mix,
>   share of national VA and CO2.
> 
>   NOTE: VA is nominal and masked; the pooled ranking compares regions over th
> e
>         same years, so price levels largely cancel, but read ranks, not level
> s.
> ==========================================================================*/
. if "$B210" == "" {
.     display as error "Run 00_run.do first (it sets the paths)."
.     exit 198
. }

. 
. use "$B210_DATA/b210_si.dta", clear
(G0 -> G0.25 OBSCURED -> G0.5 DUMMY PANEL -> G1 RE-ESTIMATED)

. local levels "prov"

. count if kabkot != ""
  0

. if r(N) > 0 local levels "prov kabkot"

. else display as error "No district (kabkot) codes in this data: kabkot rankin
> g skipped."
No district (kabkot) codes in this data: kabkot ranking skipped.

. 
. foreach lev of local levels {
  2.     * ---- A. pooled ranking ----
.     use "$B210_DATA/b210_si.dta", clear
  3.     keep if clean == 1 & !missing(`lev')
  4.     generate n_firms = 1
  5.     collapse (sum) n_firms va co2_total gj_total co2_s1 gj_s1 mix_coal mix
> _total, by(`lev')
  6.     * region name as text (province label, or the district code itself)
.     capture decode `lev', generate(region)
  7.     if _rc generate region = `lev'
  8.     egen double va_all  = total(va)
  9.     egen double co2_all = total(co2_total)
 10.     generate national_co2_per_va = co2_all / va_all
 11.     generate va_share_pct  = 100 * va / va_all
 12.     generate co2_share_pct = 100 * co2_total / co2_all
 13.     generate co2_per_va       = co2_total / va       if va > 0
 14.     generate co2_per_gj       = co2_total / gj_total if gj_total > 0
 15.     generate co2_s1_per_gj_s1 = co2_s1 / gj_s1       if gj_s1 > 0
 16.     generate coal_mix_pct     = 100 * mix_coal / mix_total if mix_total > 
> 0
 17. 
.     generate ranked = (n_firms >= 50 & !missing(co2_per_va))
 18.     egen rank_co2_per_va = rank(co2_per_va) if ranked == 1, unique   // 1 
> = cleanest
 19.     egen rank_co2_per_gj = rank(co2_per_gj) if ranked == 1, unique
 20. 
.     generate str16 intensity = cond(co2_per_va < national_co2_per_va, "Cleane
> r", "Carbon intensive") if ranked == 1
 21.     summarize va_share_pct if ranked == 1, detail
 22.     generate str5 size = cond(va_share_pct >= r(p50), "Large", "Small") if
>  ranked == 1
 23.     generate str30 quadrant = size + ", " + lower(intensity) if ranked == 
> 1
 24.     replace quadrant = "Not ranked (<50 firm-years)" if ranked == 0
 25. 
.     gsort -ranked rank_co2_per_va
 26.     order region `lev' n_firms ranked rank_co2_per_va co2_per_va national_
> co2_per_va quadrant ///
>           va_share_pct co2_share_pct co2_per_gj rank_co2_per_gj co2_s1_per_gj
> _s1 coal_mix_pct
 27.     keep  region n_firms ranked rank_co2_per_va co2_per_va national_co2_pe
> r_va quadrant ///
>           va_share_pct co2_share_pct co2_per_gj rank_co2_per_gj co2_s1_per_gj
> _s1 coal_mix_pct
 28.     list region n_firms rank_co2_per_va co2_per_va quadrant if ranked == 1
> , clean noobs
 29.     export excel using "$B210_XLSX", sheet("t10_rank_`lev'", replace) firs
> trow(variables)
 30. 
.     * ---- B. quadrant table ----
.     * the regions in each quadrant, listed from cleanest to most intensive
.     sort quadrant rank_co2_per_va region
 31.     by quadrant: generate strL regions = region if _n == 1
 32.     by quadrant: replace regions = regions[_n-1] + "; " + region if _n > 1
 33.     by quadrant: egen n_regions     = count(n_firms)
 34.     by quadrant: egen va_share_sum  = total(va_share_pct)
 35.     by quadrant: egen co2_share_sum = total(co2_share_pct)
 36.     by quadrant: keep if _n == _N
 37.     keep  quadrant n_regions va_share_sum co2_share_sum regions
 38.     rename (va_share_sum co2_share_sum) (va_share_pct co2_share_pct)
 39.     list quadrant n_regions va_share_pct co2_share_pct, clean noobs
 40.     export excel using "$B210_XLSX", sheet("t10_quadrant_`lev'", replace) 
> firstrow(variables)
 41. 
.     * ---- C. ranking in every year ----
.     use "$B210_DATA/b210_si.dta", clear
 42.     keep if clean == 1 & !missing(`lev')
 43.     generate n_firms = 1
 44.     collapse (sum) n_firms va co2_total, by(`lev' year)
 45.     capture decode `lev', generate(region)
 46.     if _rc generate region = `lev'
 47.     generate co2_per_va = co2_total / va if va > 0
 48.     generate ranked = (n_firms >= 10 & !missing(co2_per_va))
 49.     bysort year: egen rank_co2_per_va = rank(co2_per_va) if ranked == 1, u
