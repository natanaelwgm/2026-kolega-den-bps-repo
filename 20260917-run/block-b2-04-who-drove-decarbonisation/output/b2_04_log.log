. 
. * ---- FHK: one term per firm, then summed --------------------------------
. generate double fhk_within  = s0 * (phi1 - phi0)          if status == 1   //
>  within
(542 missing values generated)

. generate double fhk_between = (phi0 - `I0') * (s1 - s0)   if status == 1   //
