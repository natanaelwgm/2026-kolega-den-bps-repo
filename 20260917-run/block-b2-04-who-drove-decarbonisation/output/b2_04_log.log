. * ---- the firms in the two years ---------------------------------------
. use "$B204_DATA/b204_si.dta", clear
(G0 -> G0.25 OBSCURED -> G0.5 DUMMY PANEL -> G1 RE-ESTIMATED)

. keep if clean == 1 & inlist(year, `y0', `y1') & (`cond')
(29,082 observations deleted)

. keep if `den' > 0 & !missing(`den') & !missing(`num')
(0 observations deleted)

. quietly count if year == `y0'

. local n_t0 = r(N)

. quietly count if year == `y1'

. local n_t1 = r(N)

. if `n_t0' == 0 | `n_t1' == 0 {
.     display as error "  `label', `ind' `y0'-`y1': no firms in one of the two 
> years, nothing written"
