. generate double cov0 = (s0 / `S_C0' - 1 / `n_cont') * (phi0 - `mean0') if sta
> tus == 1
(247 missing values generated)

. generate double cov1 = (s1 / `S_C1' - 1 / `n_cont') * (phi1 - `mean1') if sta
> tus == 1
(247 missing values generated)

. quietly summarize cov0, meanonly

. local cov0 = r(sum)

. quietly summarize cov1, meanonly

. local cov1 = r(sum)

. local mp_mean  = `mean1' - `mean0'                          // within (surviv
> ors' mean)

. local mp_cov   = `cov1' - `cov0'                            // reallocation (
> survivors' covariance)

. local mp_entry = cond(`S_N1' > 0, `S_N1' * (`I_N1' - `I_C1'), 0)   // entry

. local mp_exit  = cond(`S_X0' > 0, `S_X0' * (`I_C0' - `I_X0'), 0)   // exit

. local mp_sum   = `mp_mean' + `mp_cov' + `mp_entry' + `mp_exit'

. if `n_cont' == 0 {
.     display as error "  no continuers: the Melitz-Polanec survivor terms cann
> ot be computed"
