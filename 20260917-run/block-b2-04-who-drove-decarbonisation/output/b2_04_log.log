######## B2-04: 01a_prep_si ########

. /*==========================================================================
>   Line 1: "Who drove aggregate manufacturing decarbonisation? Pakai FHK
>            decomposition (2001) dan Melitz-Polanec (2015)"
>   Prepare Statistik Industri (SI) 2010-2022 for B2-04
>   (copied from block-b1-18-bahan-baku/01a_prep_si.do, only the variables
>   this row needs are kept)
> 
>   Input : $SI_DATA  (analysis_ready_data.dta from block 0)
>   Output: data/b204_si.dta  -- 1 row = 1 firm x year
>           (open with: use "$B204_DATA/b204_si.dta", clear  then browse)
> 
>   Main variables created:
>     firm_id        firm link across years (FICTIONAL in the development data)
>     exporter, fdi, importer, kbli2, kbli5
>     va, workers
>     co2_s1 co2_s2 co2_total gj_s1 gj_s2 gj_total
>     co2_per_va     carbon intensity  (CO2 tonnes / nominal VA)
>     gj_per_va      energy intensity  (GJ / nominal VA)
>     clean          1 = not an extreme energy outlier
>   The energy and emission variables are stored as double, because the
>   decompositions add up many small firm terms.
> ==========================================================================*/
. if "$B204" == "" {
.     display as error "Run 00_run.do first (it sets the paths)."
.     exit 198
. }

. use "$SI_DATA", clear
(G0 -> G0.25 OBSCURED -> G0.5 DUMMY PANEL -> G1 RE-ESTIMATED)

. 
. * ---- identifiers ------------------------------------------------------
. * year = survey year (there is no 2016 file)
. * firm_id x year is unique. The firm links are FICTIONAL in the development
. * data, so anything about the same firm over time only means something on
. * the real BPS data.
. generate kbli2 = real(substr(industry_code, 1, 2))

. generate kbli5 = industry_code

. 
. * ---- imports ----------------------------------------------------------
. * importer is only defined where the import question can be evaluated
. generate importer = import_flag if import_observed == 1

. label define importer 0 "Non-importer" 1 "Importer"

. label values importer importer

. 
. * ---- exports & FDI ----------------------------------------------------
. generate exporter = export_flag
(15,321 missing values generated)

. generate fdi      = fdi_10_flag                     // foreign ownership >= 1
> 0%
(311 missing values generated)

. * 2022: the form only asks about DIRECT exports, a "no" is never recorded -> 
> missing
. replace exporter = . if year == 2022
(344 real changes made, 344 to missing)

. * 2020: foreign ownership is inconsistent (47% FDI vs 8-11% other years) -> m
> issing
. replace fdi = . if year == 2020
(2,936 real changes made, 2,936 to missing)

. label define exporter 0 "Non-exporter" 1 "Exporter"

. label values exporter exporter

. label define fdi 0 "Domestic" 1 "FDI"

. label values fdi fdi

. 
. * ---- size (nominal) ---------------------------------------------------
. generate double va = value_added_nominal         // double: VA is large, floa
> t loses digits

. 
. * ---- energy & emissions -----------------------------------------------
. * COAL 2017 CORRECTION: block 0 multiplies by 1000 (treats it as tonnes),
. * but the price per unit shows the data are already in kg. Divide back.
. generate double co2_coal = co2_coal_s1

. generate double gj_coal2 = gj_coal

. replace  co2_coal = co2_coal_s1 / 1000 if year == 2017
(1,181 real changes made)

. replace  gj_coal2 = gj_coal / 1000     if year == 2017
(1,181 real changes made)

. 
. * scope 1 = the 4 fuels asked in every year: diesel, petrol, coal, LPG
. egen double co2_s1 = rowtotal(co2_diesel_s1 co2_petrol_s1 co2_coal co2_lpg_s1
> ), missing

. egen double gj_s1  = rowtotal(gj_diesel gj_petrol gj_coal2 gj_lpg), missing

. * scope 2 = purchased electricity
. generate double co2_s2 = co2_scope2_s1

. generate double gj_s2  = gj_electricity

. egen double co2_total = rowtotal(co2_s1 co2_s2), missing

. egen double gj_total  = rowtotal(gj_s1 gj_s2), missing

. 
. * the two intensities this row decomposes (firm level)
. generate double co2_per_va = co2_total / va  if va > 0

. generate double gj_per_va  = gj_total / va   if va > 0

. 
. * ---- energy outlier flag (clean) --------------------------------------
. * a record is left out of the analysis (clean = 0) if any of its energy
. * quantities is above 100x that year's 99th percentile. Nothing is deleted.
. generate coal_kg_fix = fuel_coal_kg

. replace  coal_kg_fix = fuel_coal_kg / 1000 if year == 2017
(1,181 real changes made)

. generate clean = 1

. levelsof year, local(years)
2010 2011 2012 2013 2014 2015 2017 2018 2019 2020 2021 2022

. foreach q in fuel_diesel_ltr fuel_petrol_ltr fuel_kerosene_ltr coal_kg_fix fu
> el_lpg_kg ///
>              fuel_citygas_m3 fuel_othergas_m3 fuel_coalbriq_kg fuel_coke_kg /
> //
>              elec_pln_kwh elec_nonpln_kwh elec_owngen_kwh fuel_dieseloil_ltr 
> ///
>              fuel_fueloil_ltr fuel_natgas_mmbtu fuel_biodiesel_ltr fuel_bioma
> ss_kg {
  2.     foreach y of local years {
  3.         quietly count if year == `y' & `q' > 0 & !missing(`q')
  4.         if r(N) > 2 {
  5.             quietly summarize `q' if year == `y' & `q' > 0, detail
  6.             quietly replace clean = 0 if year == `y' & `q' > 100 * r(p99) 
> & !missing(`q')
  7.         }
  8.     }
  9. }

. replace clean = 0 if workers == 0 & co2_s1 > 0 & !missing(co2_s1)
(20 real changes made)

. count if clean == 0
  30

. display as result "Outlier records (clean = 0): " r(N)
Outlier records (clean = 0): 30

. 
. * ---- ln versions ------------------------------------------------------
. foreach v in va co2_total gj_total co2_per_va gj_per_va {
  2.     generate ln_`v' = ln(`v') if `v' > 0
  3. }
(547 missing values generated)
(547 missing values generated)
(547 missing values generated)
(547 missing values generated)

. 
. * ---- save -------------------------------------------------------------
. keep  firm_id year source_row kbli2 kbli5 importer exporter fdi va workers //
> /
>       co2_s1 co2_s2 co2_total gj_s1 gj_s2 gj_total co2_per_va gj_per_va clean
>  ln_*

. order firm_id year source_row kbli2 kbli5 importer exporter fdi

. label variable firm_id    "Firm id (links across years are FICTIONAL in the d
> ev data)"

. label variable co2_total  "CO2 scope 1 (4 fuels) + scope 2, tonnes"

. label variable gj_total   "Energy scope 1 (4 fuels) + purchased electricity, 
> GJ"

. label variable co2_per_va "Carbon intensity: CO2 / nominal VA"

. label variable gj_per_va  "Energy intensity: GJ / nominal VA"

. label variable clean      "1 = not an energy outlier"

. compress
  variable kbli2 was double now byte
  variable importer was double now byte
  variable exporter was double now byte
  variable fdi was double now byte
  variable clean was double now byte
  (1,156,715 bytes saved)

. save "$B204_DATA/b204_si.dta", replace
(file
    /private/tmp/claude-501/sp/pr-worktree/20260917-run/block-b2-04-who-drove
    > -decarbonisation/data/b204_si.dta not found)
file
    /private/tmp/claude-501/sp/pr-worktree/20260917-run/block-b2-04-who-drove
    > -decarbonisation/data/b204_si.dta saved

. display as result "01a done: $B204_DATA/b204_si.dta (" _N " rows)"
01a done: /private/tmp/claude-501/sp/pr-worktree/20260917-run/block-b2-04-who-d
> rove-decarbonisation/data/b204_si.dta (33049 rows)

. 
end of do-file

######## B2-04: 02-05_decomposition ########

. /*==========================================================================
>   Lines 2-5 (one calculation, its components are lines 3-5):
>     2 "Accounting decomposition perubahan carbon intensity dan energy
>        intensity menjadi:"
>     3 "Within firm improvement"
>     4 "Reallocation toward cleaner firms"
>     5 "Entry/exit"
>   Methods named in line 1: FHK (2001) and Melitz-Polanec (2015), both done by
>   the helper _decompose.do (formulas in its header).
> 
>   Data  : SI 2010-2022 (data/b204_si.dta), clean == 1, VA > 0
>   Indicators: carbon intensity = total CO2 / total VA
>               energy intensity = total GJ / total VA
>               (firms weighted by their share of VA, so the aggregate is the
>               ratio of totals)
>   Periods: 2010-2015 and 2017-2022 (each side of the 2016 questionnaire
>            change) and 2010-2022 (whole window)
> 
>   Output sheets:
>     t02_05_fhk        FHK: within, between, cross, entry, exit, their sum, th
> e
>                       total change and the difference (must be ~0)
>     t02_05_mp         Melitz-Polanec: survivors' mean, survivors' covariance,
>                       entry, exit, sum, total change, difference
>     t02_05_summary    both methods mapped to the to-do's three parts, in
>                       levels, as % of the total change and as % of the
>                       start-year intensity
>     t02_05_firm_int   firm-level CO2/VA and GJ/VA, descriptive stats, pool + 
> yearly
>   Dataset: data/b204_decomp_total.dta
> 
>   NOTE: FIRM LINKS (firm_id across years) ARE FICTIONAL in the development
>         data. Who is a continuer, entrant or exiter, and therefore every
>         component, only means something on the real BPS data. Only the total
>         change does not depend on the links.
>   NOTE: VA is nominal (and masked in the dev data), so the intensities mix
>         price change with real change. Read signs and shares, not levels.
> ==========================================================================*/
. if "$B204" == "" {
.     display as error "Run 00_run.do first (it sets the paths)."
.     exit 198
. }

. 
. * ---- run the decomposition: 2 indicators x 3 periods -------------------
. capture erase "$B204_DATA/b204_decomp_rows.dta"

. foreach ind in co2_va gj_va {
  2.     do "$B204/_decompose.do" `ind' 2010 2015
  3.     do "$B204/_decompose.do" `ind' 2017 2022
  4.     do "$B204/_decompose.do" `ind' 2010 2022
  5. }

. /*==========================================================================
>   _decompose.do -- helper: FHK (2001) and Melitz-Polanec (2015) decomposition
>                    of the change in an aggregate intensity between two years
> 
>   Usage:
>       do "$B204/_decompose.do" co2_va 2010 2022
>       do "$B204/_decompose.do" co2_va 2010 2021 "exporter == 1" "Exporter"
> 
>       argument 1 = indicator: co2_va (CO2 / VA, carbon intensity)
>                               gj_va  (GJ / VA,  energy intensity)
>       argument 2 = start year (t0)
>       argument 3 = end year   (t1)
>       argument 4 = optional condition that defines the group, e.g. "fdi == 1"
>                    (applied to each firm-year, so a firm that changes group
>                    leaves one group and enters the other)
>       argument 5 = optional group label for the table ("All firms" if empty)
> 
>   Result: ONE row is appended to data/b204_decomp_rows.dta. The calling file
>   erases that file first and exports it at the end. The helper loads the data
>   itself, so nothing needs to be in memory.
> 
>   The aggregate intensity in year t is
>       I_t = sum_i s_it * phi_it  = total CO2 / total VA
>       phi_it = firm intensity (CO2_it / VA_it)
>       s_it   = firm share of the group's VA in year t
>   Firms are matched by firm_id:
>       continuers (C) = in t0 and t1, entrants (N) = t1 only, exiters (X) = t0
>  only
>   FIRM LINKS ARE FICTIONAL IN THE DEVELOPMENT DATA: the split into continuers
> ,
>   entrants and exiters, and so every term below, only means something on the
>   real BPS data. The total change (I_t1 - I_t0) does not depend on the links.
> 
>   FHK (Foster, Haltiwanger and Krizan 2001), with I_t0 as the reference:
>       within  = sum_C s_i0 * (phi_i1 - phi_i0)
>       between = sum_C (phi_i0 - I_t0) * (s_i1 - s_i0)
>       cross   = sum_C (s_i1 - s_i0) * (phi_i1 - phi_i0)
>       entry   = sum_N s_i1 * (phi_i1 - I_t0)
>       exit    = - sum_X s_i0 * (phi_i0 - I_t0)
>   Melitz-Polanec (2015):
>       survivors' mean      = change in the unweighted mean of phi among C
>       survivors' covariance = change in sum_C (s_i/S_C - 1/n_C) * (phi_i - me
> an phi)
>       entry = S_N1 * (I_N1 - I_C1)      S = group share, I = group intensity
>       exit  = S_X0 * (I_C0 - I_X0)
>   Both sets of components must add up to I_t1 - I_t0; the difference is
>   displayed and written to the table (column fhk_diff, mp_diff).
> ==========================================================================*/
. args ind y0 y1 cond label

. if "`cond'" == ""  local cond "1 == 1"

. if "`label'" == "" local label "All firms"

. 
. * ---- which numerator / denominator ------------------------------------
. if "`ind'" == "co2_va" {
.     local num co2_total
.     local den va
.     local ind_label "CO2 / VA (carbon intensity)"
. }

. else if "`ind'" == "gj_va" {
.     local num gj_total
.     local den va
.     local ind_label "GJ / VA (energy intensity)"
. }

. else {
.     display as error "_decompose.do: unknown indicator `ind' (use co2_va or g
> j_va)"
.     exit 198
. }

. 
. * ---- the firms in the two years ---------------------------------------
. use "$B204_DATA/b204_si.dta", clear
(G0 -> G0.25 OBSCURED -> G0.5 DUMMY PANEL -> G1 RE-ESTIMATED)

. keep if clean == 1 & inlist(year, `y0', `y1') & (`cond')
(28,085 observations deleted)

. keep if `den' > 0 & !missing(`den') & !missing(`num')
(0 observations deleted)

. quietly count if year == `y0'

. local n_t0 = r(N)

. quietly count if year == `y1'

. local n_t1 = r(N)

. if `n_t0' == 0 | `n_t1' == 0 {
.     display as error "  `label', `ind' `y0'-`y1': no firms in one of the two 
> years, nothing written"
.     exit
. }

. keep firm_id year `num' `den'

. 
. * ---- firm intensity (phi), firm share (s), aggregate intensity (I) -----
. generate double phi = `num' / `den'

. bysort year: egen double den_total = total(`den')

. generate double s = `den' / den_total

. generate double s_phi = s * phi

. quietly summarize s_phi if year == `y0', meanonly

. local I0 = r(sum)                                  // I_t0 = sum s_i0 * phi_i
> 0

. quietly summarize s_phi if year == `y1', meanonly

. local I1 = r(sum)                                  // I_t1 = sum s_i1 * phi_i
> 1

. local dI = `I1' - `I0'                             // total change to decompo
> se

. 
. * ---- one row per firm: s0 phi0 (start year), s1 phi1 (end year) -------
. generate t = cond(year == `y0', 0, 1)

. keep firm_id t s phi

. reshape wide s phi, i(firm_id) j(t)
(j = 0 1)

Data                               Long   ->   Wide
-----------------------------------------------------------------------------
Number of observations            4,964   ->   3,878       
Number of variables                   4   ->   5           
j variable (2 values)                 t   ->   (dropped)
xij variables:
                                      s   ->   s0 s1
                                    phi   ->   phi0 phi1
-----------------------------------------------------------------------------

. generate status = 1 if !missing(s0) & !missing(s1)       // continuer
(2,792 missing values generated)

. replace  status = 2 if  missing(s0) & !missing(s1)       // entrant
(1,544 real changes made)

. replace  status = 3 if !missing(s0) &  missing(s1)       // exiter
(1,248 real changes made)

. quietly count if status == 1

. local n_cont = r(N)

. quietly count if status == 2

. local n_entry = r(N)

. quietly count if status == 3

. local n_exit = r(N)

. 
. * ---- FHK: one term per firm, then summed --------------------------------
. generate double fhk_within  = s0 * (phi1 - phi0)          if status == 1   //
>  within
(2,792 missing values generated)

. generate double fhk_between = (phi0 - `I0') * (s1 - s0)   if status == 1   //
>  between
(2,792 missing values generated)

. generate double fhk_cross   = (s1 - s0) * (phi1 - phi0)   if status == 1   //
>  cross
(2,792 missing values generated)

. generate double fhk_entry   = s1 * (phi1 - `I0')          if status == 2   //
>  entry
(2,334 missing values generated)

. generate double fhk_exit    = -s0 * (phi0 - `I0')         if status == 3   //
>  exit
(2,630 missing values generated)

. foreach c in within between cross entry exit {
  2.     quietly summarize fhk_`c', meanonly
  3.     local fhk_`c' = r(sum)
  4. }

. local fhk_sum = `fhk_within' + `fhk_between' + `fhk_cross' + `fhk_entry' + `f
> hk_exit'

. 
. * ---- Melitz-Polanec ------------------------------------------------------
. * group shares: S_C0, S_X0 (start year), S_C1, S_N1 (end year)
. quietly summarize s0 if status == 1, meanonly

. local S_C0 = r(sum)

. quietly summarize s0 if status == 3, meanonly

. local S_X0 = r(sum)

. quietly summarize s1 if status == 1, meanonly

. local S_C1 = r(sum)

. quietly summarize s1 if status == 2, meanonly

. local S_N1 = r(sum)

. * group intensities: I_g = sum_g s_i * phi_i / S_g
. generate double sphi0 = s0 * phi0
(1,544 missing values generated)

. generate double sphi1 = s1 * phi1
(1,248 missing values generated)

. quietly summarize sphi0 if status == 1, meanonly

. local I_C0 = r(sum) / `S_C0'

. quietly summarize sphi1 if status == 1, meanonly

. local I_C1 = r(sum) / `S_C1'

. quietly summarize sphi0 if status == 3, meanonly

. local I_X0 = cond(`S_X0' > 0, r(sum) / `S_X0', 0)

. quietly summarize sphi1 if status == 2, meanonly

. local I_N1 = cond(`S_N1' > 0, r(sum) / `S_N1', 0)

. * survivors: I_C = unweighted mean of phi + covariance term (Olley-Pakes)
. quietly summarize phi0 if status == 1, meanonly

. local mean0 = r(mean)

. quietly summarize phi1 if status == 1, meanonly

. local mean1 = r(mean)

. generate double cov0 = (s0 / `S_C0' - 1 / `n_cont') * (phi0 - `mean0') if sta
> tus == 1
(2,792 missing values generated)

. generate double cov1 = (s1 / `S_C1' - 1 / `n_cont') * (phi1 - `mean1') if sta
> tus == 1
(2,792 missing values generated)

. quietly summarize cov0, meanonly

. local cov0 = r(sum)

. quietly summarize cov1, meanonly

. local cov1 = r(sum)

. local mp_mean  = `mean1' - `mean0'                          // within (surviv
> ors' mean)

. local mp_cov   = `cov1' - `cov0'                            // reallocation (
> survivors' covariance)

. local mp_entry = cond(`S_N1' > 0, `S_N1' * (`I_N1' - `I_C1'), 0)   // entry

. local mp_exit  = cond(`S_X0' > 0, `S_X0' * (`I_C0' - `I_X0'), 0)   // exit

. local mp_sum   = `mp_mean' + `mp_cov' + `mp_entry' + `mp_exit'

. if `n_cont' == 0 {
.     display as error "  no continuers: the Melitz-Polanec survivor terms cann
> ot be computed"
. }

. 
. * ---- the check: components must add up to the total change -------------
. local fhk_diff = `dI' - `fhk_sum'

. local mp_diff  = `dI' - `mp_sum'

. display as result "  `label' | `ind' `y0'-`y1' | continuers `n_cont', entrant
> s `n_entry', exiters `n_exit'"
  All firms | co2_va 2010-2015 | continuers 1086, entrants 1544, exiters 1248

. display as result "    total change " %10.3g `dI' "   FHK sum " %10.3g `fhk_s
> um' "   difference " %9.2g `fhk_diff'
    total change   .0000101   FHK sum   .0000101   difference   1.0e-16

. display as result "    total change " %10.3g `dI' "   MP sum  " %10.3g `mp_su
> m'  "   difference " %9.2g `mp_diff'
    total change   .0000101   MP sum    .0000101   difference   1.0e-16

. if abs(`fhk_diff') > 1e-9 * max(abs(`dI'), abs(`I0')) | abs(`mp_diff') > 1e-9
>  * max(abs(`dI'), abs(`I0')) {
.     display as error "  WARNING: the components do not add up to the total ch
> ange (see diff)"
. }

. 
. * ---- write one result row --------------------------------------------
. clear

. set obs 1
Number of observations (_N) was 0, now 1.

. generate str40 group     = "`label'"

. generate str40 condition = "`cond'"

. generate str32 indicator = "`ind_label'"

. generate str9  period    = "`y0'-`y1'"

. generate year_from = `y0'

. generate year_to   = `y1'

. generate n_firms_t0   = `n_t0'

. generate n_firms_t1   = `n_t1'

. generate n_continuers = `n_cont'

. generate n_entrants   = `n_entry'

. generate n_exiters    = `n_exit'

. generate double I_t0   = `I0'

. generate double I_t1   = `I1'

. generate double change = `dI'

. foreach c in within between cross entry exit sum diff {
  2.     generate double fhk_`c' = `fhk_`c''
  3. }

. foreach c in mean cov entry exit sum diff {
  2.     generate double mp_`c' = `mp_`c''
  3. }

. * the shares of VA behind the entry and exit terms
. generate double share_va_entrants_t1 = `S_N1'

. generate double share_va_exiters_t0  = `S_X0'

. * add the row at the bottom of the results file (create it on the first call)
. tempfile row

. save `row'
file /var/folders/7l/7f30l8dj7219j21dhg9glmwc0000gn/T//St65806.000001 saved
    as .dta format

. capture confirm file "$B204_DATA/b204_decomp_rows.dta"

. if _rc == 0 {
.     use "$B204_DATA/b204_decomp_rows.dta", clear
.     append using `row'
. }

. save "$B204_DATA/b204_decomp_rows.dta", replace
(file
    /private/tmp/claude-501/sp/pr-worktree/20260917-run/block-b2-04-who-drove
    > -decarbonisation/data/b204_decomp_rows.dta not found)
file
    /private/tmp/claude-501/sp/pr-worktree/20260917-run/block-b2-04-who-drove
    > -decarbonisation/data/b204_decomp_rows.dta saved

. 
end of do-file

. /*==========================================================================
>   _decompose.do -- helper: FHK (2001) and Melitz-Polanec (2015) decomposition
>                    of the change in an aggregate intensity between two years
> 
>   Usage:
>       do "$B204/_decompose.do" co2_va 2010 2022
>       do "$B204/_decompose.do" co2_va 2010 2021 "exporter == 1" "Exporter"
> 
>       argument 1 = indicator: co2_va (CO2 / VA, carbon intensity)
>                               gj_va  (GJ / VA,  energy intensity)
>       argument 2 = start year (t0)
>       argument 3 = end year   (t1)
>       argument 4 = optional condition that defines the group, e.g. "fdi == 1"
>                    (applied to each firm-year, so a firm that changes group
>                    leaves one group and enters the other)
>       argument 5 = optional group label for the table ("All firms" if empty)
> 
>   Result: ONE row is appended to data/b204_decomp_rows.dta. The calling file
>   erases that file first and exports it at the end. The helper loads the data
>   itself, so nothing needs to be in memory.
> 
>   The aggregate intensity in year t is
>       I_t = sum_i s_it * phi_it  = total CO2 / total VA
>       phi_it = firm intensity (CO2_it / VA_it)
>       s_it   = firm share of the group's VA in year t
>   Firms are matched by firm_id:
>       continuers (C) = in t0 and t1, entrants (N) = t1 only, exiters (X) = t0
>  only
>   FIRM LINKS ARE FICTIONAL IN THE DEVELOPMENT DATA: the split into continuers
> ,
