>  within
(62 missing values generated)

. generate double fhk_between = (phi0 - `I0') * (s1 - s0)   if status == 1   //
>  between
(62 missing values generated)

. generate double fhk_cross   = (s1 - s0) * (phi1 - phi0)   if status == 1   //
>  cross
(62 missing values generated)

