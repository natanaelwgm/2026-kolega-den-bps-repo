. if "`cond'" == ""  local cond "1 == 1"

. if "`label'" == "" local label "All firms"

. 
. * ---- which numerator / denominator ------------------------------------
. if "`ind'" == "co2_va" {
.     local num co2_total
.     local den va
.     local ind_label "CO2 / VA (carbon intensity)"
. }

. else if "`ind'" == "gj_va" {
.     local num gj_total
.     local den va
.     local ind_label "GJ / VA (energy intensity)"
. }

. else {
.     display as error "_decompose.do: unknown indicator `ind' (use co2_va or g
> j_va)"
.     exit 198
