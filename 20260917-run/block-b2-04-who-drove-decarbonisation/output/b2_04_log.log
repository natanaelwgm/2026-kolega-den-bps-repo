    total change  -.0000223   MP sum   -.0000223   difference   2.0e-16

. if abs(`fhk_diff') > 1e-9 * max(abs(`dI'), abs(`I0')) | abs(`mp_diff') > 1e-9
>  * max(abs(`dI'), abs(`I0')) {
