. quietly summarize s0 if status == 3, meanonly

. local S_X0 = r(sum)

. quietly summarize s1 if status == 1, meanonly

. local S_C1 = r(sum)

. quietly summarize s1 if status == 2, meanonly

. local S_N1 = r(sum)

