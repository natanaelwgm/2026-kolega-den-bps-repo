. * ---- write one result row --------------------------------------------
. clear

. set obs 1
Number of observations (_N) was 0, now 1.

. generate str40 group     = "`label'"

. generate str40 condition = "`cond'"

. generate str32 indicator = "`ind_label'"

. generate str9  period    = "`y0'-`y1'"

