. display as result "    total change " %10.3g `dI' "   FHK sum " %10.3g `fhk_s
> um' "   difference " %9.2g `fhk_diff'
    total change  -.0000652   FHK sum  -.0000652   difference         0

. display as result "    total change " %10.3g `dI' "   MP sum  " %10.3g `mp_su
> m'  "   difference " %9.2g `mp_diff'
    total change  -.0000652   MP sum   -.0000652   difference   1.0e-16

