    as .dta format

. capture confirm file "$B204_DATA/b204_decomp_rows.dta"

. if _rc == 0 {
.     use "$B204_DATA/b204_decomp_rows.dta", clear
.     append using `row'
. }

. save "$B204_DATA/b204_decomp_rows.dta", replace
file
