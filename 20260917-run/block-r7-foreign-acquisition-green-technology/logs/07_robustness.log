. * Notes as one text, wrapped by printed width (R2-08's rule; widths in em).
. local txt "Notes: `rd1'`rd2'`vatxt' Bars = 95% intervals (crossing 0 = not clear); 'Years before': p below 0.05 = alre
> ady changing"

. local txt "`txt' differently before (each method's own test). Acquisition = first year with 10%+ foreign-owned capital
>  after a year below 10% (a"

. local txt "`txt' reported share, not a verified purchase; `n_back_c' of `n_later_c' fall back below 10% at the next an
> swer). The share rules pick nearly the"

. local txt "`txt' same firms: `sh0100_t'% of answers are exactly 0% or 100%. Energy records in doubt (importers of unkn
> own export status in `dtxt')"

. local txt "`txt' are `dspre_t'% of acquirers' usable years before and `dspost_t'% after the acquisition`dbtxt'. Value 
> added = output value minus materials, energy"

. local txt "`txt' and services bought (current prices); CO2 = energy used x standard factors. This cannot show which eq
> uipment or process changed."

. local txt "`txt' Firm links are fictional: a test of the method only."

. local maxw 53.5                                         // widest note line that fits the 9-inch PDF

. local notes ""

. local nl 0

. local line ""

. local lw 0

. foreach w of local txt {
  2.     local n  = ustrlen(`"`w'"')
  3.     local na = `n' - ustrlen(ustrregexra(`"`w'"', "[ijltfr.,;:'()\-]", ""))
  4.     local wi = `n' - ustrlen(ustrregexra(`"`w'"', "[A-Zmw]", ""))
  5.     local pc = `n' - ustrlen(ustrregexra(`"`w'"', "%", ""))
  6.     local dg = `n' - ustrlen(ustrregexra(`"`w'"', "[0-9+=]", ""))
  7.     local ww = 0.29*`na' + 0.7*`wi' + 0.83*`pc' + 0.52*`dg' + 0.47*(`n' - `na' - `wi' - `pc' - `dg')
  8.     local try = `lw' + 0.25*(`"`line'"' != "") + `ww'
  9.     if `try' > `maxw' & `"`line'"' != "" {
 10.         local ++nl
 11.         local L`nl' `"`line'"'
 12.         local W`nl' = `lw'
 13.         local line `"`w'"'
 14.         local lw = `ww'
 15.     }
 16.     else {
 17.         local line = strtrim(`"`line' `w'"')
 18.         local lw = `try'
 19.     }
 20. }

. local ++nl

. local L`nl' `"`line'"'

. local W`nl' = `lw'

. forvalues j = 1/`nl' {
  2.     display "   note line `j': " udstrlen(`"`L`j''"') " characters, width " %4.1f `W`j'' " of `maxw' em"
  3.     local notes `"`notes' "`L`j''""'
  4. }
