282.         local nr = .
283.         if "`t`s''" == "dcdh" & "`nm'" != "" {
284.             local nf = `dsw`=`k'+10''                      // switchers behind the year (package count)
285.             local nr = `drw`=`k'+10''
286.         }
287.         else if "`t`s''" != "dcdh" {
288.             local kc = cond(`k' < `wlo', "kA < `wlo'", cond(`k' > `whi', "kA > `whi' & !missing(kA)", "kA == `k'"))
289.             egen byte ft = tag(firm_id) if es & !never & `kc'
290.             quietly count if ft == 1
291.             local nf = r(N)
292.             quietly count if es & !never & `kc'
293.             local nr = r(N)
294.             drop ft
295.         }
296.         if `k' == -1 & "`nm'" == "" & strpos("`stat'", "ok") == 1 {
297.             post `h' (`s') (`k') (0) (1) (0) (.) (0) (0) (.) (`nf') (`nr') ("reference year: 0 by definition")
298.         }
299.         else if "`nm'" == "" {
300.             local why = cond(strpos("`stat'", "ok") == 1, "not estimated by this method", "row not estimated")
301.             post `h' (`s') (`k') (`grp') (0) (.) (.) (.) (.) (.) (`nf') (`nr') ("`why'")
302.         }
303.         else {
304.             local b  = _b[`nm']
305.             local se = _se[`nm']
306.             post `h' (`s') (`k') (`grp') (0) (`b') (`se') (`b' - `crit' * `se') (`b' + `crit' * `se') ///
>                 (cond("`ci'" == "t", 2 * ttail(`df', abs(`b' / `se')), 2 * normal(-abs(`b' / `se')))) ///
>                 (`nf') (`nr') ("`tn'")
307.         }
308.     }
309.     if "`t`s''" == "sa" & !missing(`sa_out') {
