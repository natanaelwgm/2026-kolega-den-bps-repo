274.             if `kk' == `k' local nm = substr("`nn'", 2, .)
275.         }
276.         local tn ""
277.         if "`t`s''" == "bjs" & `k' < 0 local tn "vs the firm's years before `wlo' (the method's own check)"
278.         if "`t`s''" == "cs" & `k' < -1 local tn "long2 run: against the year before the acquisition"
279.         if "`t`s''" == "dcdh" & `k' >= 0 local tn "Effect_`=`k'+1' (package name)"
280.         if "`t`s''" == "dcdh" & `k' < -1 local tn "Placebo_`=-1-`k'' (package name)"
281.         * rows behind the year (a firm counts once in a grouped end)
