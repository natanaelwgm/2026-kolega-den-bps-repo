189.         local ci "normal"
190.         if !`ok_dcdh' local stat "unavailable: package not installed (`=strtrim("`miss_dcdh'")')"
191.         else {
192.             preserve
193.             * Acquirers with no usable row from their acquisition year on would look
.             * like firms never acquired: leave them out (as the other methods do).
.             bysort firm_id: egen byte has_after = max(!never & year >= gA)
194.             drop if !never & !has_after
195.             keep firm_id year y gA never
196.             tsset firm_id year
197.             tsfill                                          // empty rows for missing years inside each firm's span
198.             bysort firm_id (gA): replace gA = gA[1]
199.             bysort firm_id (never): replace never = never[1]
200.             gen byte D = !never & year >= gA                // acquisition status: on from the acquisition year
201.             keep firm_id year y D
202.             local ne  = `whi' + 1                           // Effect_1..Effect_`ne' = years 0..+`whi'
203.             local npl = -`wlo' - 1                          // Placebo_1..Placebo_`npl' = years -2..`wlo'
204.             * The package updates itself from the internet in 1 run in 100 unless
.             * told not to. This file never installs or updates anything.
.             capture quietly did_multiplegt_dyn y firm_id year D, effects(`ne') placebo(`npl') only_never_switchers gra
> ph_off _no_updates
205.             if _rc == 198 capture quietly did_multiplegt_dyn y firm_id year D, effects(`ne') placebo(`npl') only_ne
> ver_switchers graph_off no_updates
206.             local rc = _rc
207.             restore
208.             if `rc' == 198 local stat "failed: this did_multiplegt_dyn version cannot switch off its self-update"
209.             else if `rc' local stat "failed: did_multiplegt_dyn stopped with error r(`rc')"
210.             else {
211.                 local st = e(N_switchers_effect_1)
212.                 local N  = e(N_effect_1)
213.                 local bp = e(p_jointplacebo)
214.                 local btest "joint test of its placebos (years -2 to `wlo', each vs the year before)"
215.                 forvalues l = 1/`ne' {
216.                     local dsw`=`l'-1+10' = e(N_switchers_effect_`l')
217.                     local drw`=`l'-1+10' = e(N_effect_`l')
218.                     local map `map' `=`l'-1':Effect_`l'
219.                 }
220.                 forvalues l = 1/`npl' {
221.                     local dsw`=-1-`l'+10' = e(N_switchers_placebo_`l')
222.                     local drw`=-1-`l'+10' = e(N_placebo_`l')
223.                     local map `map' `=-1-`l'':Placebo_`l'
224.                 }
225.                 local lcd "Effect_1"
226.                 forvalues l = 2/`ne' {
227.                     local lcd "`lcd' + Effect_`l'"
228.                 }
229.                 local lcq "Placebo_1"
230.                 forvalues l = 2/`npl' {
231.                     local lcq "`lcq' + Placebo_`l'"
232.                 }
233.                 capture quietly lincom (`lcd') / `ne'
234.                 if !_rc {
235.                     local ab = r(estimate)
236.                     local ase = r(se)
237.                     quietly lincom (`lcd') / `ne' - (`lcq') / `npl'
238.                     local qb = r(estimate)
239.                     local qse = r(se)
240.                     local stat "ok; acquirers and firm-years = those behind year 0"
241.                 }
242.                 else local stat "failed: no covariances in this package version"
243.             }
244.         }
245.     }
246. 
.     * ---- intervals, counts, and the post lines ----
.     local crit = cond("`ci'" == "t", invttail(`df', 0.025), invnormal(0.975))
247.     if !missing(`ab') {
248.         local alo = `ab' - `crit' * `ase'
249.         local ahi = `ab' + `crit' * `ase'
250.         local ap = cond("`ci'" == "t", 2 * ttail(`df', abs(`ab' / `ase')), 2 * normal(-abs(`ab' / `ase')))
251.     }
252.     if !missing(`qb') {
253.         local qlo = `qb' - `crit' * `qse'
254.         local qhi = `qb' + `crit' * `qse'
255.         local qp = cond("`ci'" == "t", 2 * ttail(`df', abs(`qb' / `qse')), 2 * normal(-abs(`qb' / `qse')))
256.     }
257.     quietly count if es
258.     if r(N) > 0 {
259.         r707_n `whi' `wlo'
260.         local st = r(acq)
261.         local cf = r(comp)
262.         local G = r(firms)
263.         local npost = r(post)
264.         local nref = r(ref)
265.         local nearly = r(early)
266.         if missing(`N') local N = r(rows)
267.     }
268.     post `hs' (`s') (`N') (`G') (`st') (`cf') (`sg') (`npost') (`nref') (`nearly') (`sa_out') ///
>         (`bp') (`ab') (`ase') (`alo') (`ahi') (`ap') (`qb') (`qse') (`qlo') (`qhi') (`qp') ///
>         ("`ci'") ("`btest'") ("`stat'")
269.     * One line per year since the acquisition (-K-1 = grouped start, +K+1 = grouped end).
