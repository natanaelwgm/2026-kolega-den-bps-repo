file /var/folders/0k/wcj_06q55_gd0c7z2x717jsc0000gn/T//S_66694.000002 saved as .dta format

. 
. *---------------------------------------------------------------------------
. display "Step 4/8: estimate each row (firm and year effects, clustered by firm; rows 2-5 = R2-10's methods)"
Step 4/8: estimate each row (firm and year effects, clustered by firm; rows 2-5 = R2-10's methods)

. *---------------------------------------------------------------------------
. * Row 1 (and 6-16 with one change): log outcome on one marker per year since
. * the acquisition (-1 = the year before = reference, 0 by definition; years
. * beyond the window grouped at the two ends), with firm and year effects;
. * firms never seen foreign-owned (at the row's rule) are 0 on every marker; a
. * firm with one usable year is dropped by reghdfe. Rows 2-5 run R2-10's code
. * for its four methods on row 1's sample (outcome flipped to energy per value
. * added). Two averages per row, as R7-04 and R7-05:
. *   black = years 0..+K minus the year before (-1);
. *   gray  = years 0..+K minus the average of years -K..-2 (the earlier years
. *           before): if the outcome was already moving before the acquisition,
. *           the two differ, and that move cannot come from the new owner.
. * Borusyak-Jaravel-Spiess compares each acquirer with its own predicted path
. * from ALL its years before the acquisition, so it has one average (black).
. capture program drop r707_n

. program define r707_n, rclass
  1.     * firms and rows in the estimation sample (variable es): acquirers, comparison
.     * firms, and acquirers with a row after (0..+K), in the year before, and in -K..-2
.     args whi wlo
  2.     quietly {
  3.         egen byte r7_f = tag(firm_id) if es
  4.         count if r7_f == 1 & !never
  5.         return scalar acq = r(N)
  6.         count if r7_f == 1 & never
  7.         return scalar comp = r(N)
  8.         count if r7_f == 1
  9.         return scalar firms = r(N)
 10.         count if es
 11.         return scalar rows = r(N)
 12.         drop r7_f
 13.         foreach w in post ref early {
 14.             if "`w'" == "post"  local kc "inrange(kA, 0, `whi')"
 15.             if "`w'" == "ref"   local kc "kA == -1"
 16.             if "`w'" == "early" local kc "inrange(kA, `wlo', -2)"
 17.             egen byte r7_f = tag(firm_id) if es & !never & `kc'
 18.             count if r7_f == 1
 19.             return scalar `w' = r(N)
 20.             drop r7_f
 21.         }
 22.     }
 23. end

. tempname h hs

. postfile `h' byte spec int event_time byte(grouped reference) double(b se lo hi p) long(firms rows) ///
>     str70 tnote using `est'

. postfile `hs' byte spec long(n_rows n_firms n_acquirers n_comparison n_one_year_dropped n_acq_post n_acq_ref ///
>     n_acq_early sa_left_out) double(before_p avg_b avg_se avg_lo avg_hi avg_p pp_b pp_se pp_lo pp_hi pp_p) ///
>     str6 ci_basis str90 before_test str90 status using `sums'

. timer clear 2

. timer on 2

. forvalues s = 1/`nspec' {
  2.     use `fy', clear
  3.     keep if `keep`s''
  4.     gen int gA = `g`s''
  5.     gen byte never = `key`s'' == 9001
  6.     assert never == missing(gA)                      // comparison = never foreign-owned at this rule only
  7.     gen int kA = year - gA
  8.     gen double y = `y`s''
  9.     assert !missing(y)                               // every kept row has a log (usable rows only)
 10.     sort firm_id year
 11.     * Sun-Abraham: an acquisition year whose year before has no row (the year
.     * after a missing file) has no reference year; the package would silently
.     * measure those acquirers against another year. Left out (lesson 20).
.     local sa_out = .
 12.     local sa_yrs ""
 13.     if "`t`s''" == "sa" & `ok_sa' {
 14.         bysort gA: egen byte has_ref = max(kA == -1)
 15.         egen byte ft0 = tag(firm_id) if !never & !has_ref
 16.         quietly count if ft0 == 1
 17.         local sa_out = r(N)
 18.         quietly levelsof gA if ft0 == 1, local(sa_yrs)
 19.         drop if !never & !has_ref
 20.         drop ft0 has_ref
 21.         sort firm_id year
 22.     }
 23.     * R7-04's markers; a marker with no acquirer row in this sample is left out.
.     gen byte ev_lo = !missing(kA) & kA < `wlo'
 24.     local cand "ev_lo"
 25.     forvalues k = `wlo'/`whi' {
 26.         if `k' == -1 continue
 27.         local nm = cond(`k' < 0, "ev_m" + string(-`k'), "ev_p" + string(`k'))
 28.         gen byte `nm' = (kA == `k')
 29.         local cand `cand' `nm'
 30.     }
 31.     gen byte ev_hi = !missing(kA) & kA > `whi'
 32.     local cand `cand' ev_hi
 33.     local terms ""
 34.     local pre ""
 35.     local pre_in ""
 36.     local post ""
 37.     foreach t of local cand {
 38.         quietly count if `t'
 39.         if r(N) == 0 continue
 40.         local terms `terms' `t'
 41.         if "`t'" == "ev_lo" | substr("`t'", 4, 1) == "m" local pre `pre' `t'
 42.         if substr("`t'", 4, 1) == "m" local pre_in `pre_in' `t'      // before, grouped end left out
 43.         if "`t'" != "ev_hi" & "`t'" != "ev_lo" & substr("`t'", 4, 1) == "p" local post `post' `t'
 44.     }
 45.     local lc = subinstr("`post'", " ", " + ", .)        // years 0..+K, for the black average
 46.     local np : word count `post'
 47.     local lcp = subinstr("`pre_in'", " ", " + ", .)     // years -K..-2, for the gray average
 48.     local npi : word count `pre_in'
 49.     * What every row posts (missing unless set below).
.     foreach x in N G st cf sg npost nref nearly bp ab ase alo ahi ap qb qse qlo qhi qp {
 50.         local `x' = .
 51.     }
 52.     local ci "t"
 53.     local btest ""
 54.     local stat "ok"
 55.     local map ""                                         // "k:coefficient name" pairs for the table
 56.     local df = .
 57.     capture drop es
 58.     gen byte es = 0
 59. 
.     * ---- one regression (reghdfe) and Sun-Abraham: R7-04's code ----
.     if inlist("`t`s''", "twfe", "sa") {
 60.         local run 1
 61.         if "`t`s''" == "sa" & !`ok_sa' {
 62.             local stat "unavailable: package not installed (`=strtrim("`miss_sa'")')"
 63.             local run 0
 64.         }
 65.         if `run' & "`t`s''" == "sa" {
 66.             capture quietly eventstudyinteract y `terms', cohort(gA) control_cohort(never) ///
>                 absorb(i.firm_id i.year) vce(cluster firm_id)
 67.             if _rc {
 68.                 local stat "failed: eventstudyinteract stopped with error r(`=_rc')"
 69.                 local run 0
 70.             }
 71.             else {
 72.                 local df = e(df_r)
 73.                 local N  = e(N)
 74.                 replace es = e(sample)
 75.                 matrix bsa = e(b_iw)
 76.                 matrix vsa = e(V_iw)
 77.                 ereturn post bsa vsa, dof(`df')
 78.             }
 79.         }
 80.         if `run' & "`t`s''" == "twfe" {
 81.             quietly reghdfe y `terms', absorb(`fe`s'') vce(cluster firm_id)
 82.             local df = e(df_r)
 83.             local N  = e(N)
 84.             local sg = e(num_singletons)
 85.             replace es = e(sample)
 86.         }
 87.         if `run' {
 88.             quietly test `pre'
 89.             local bp = r(p)
 90.             local btest "F test: every year before the acquisition (grouped end included) = 0"
 91.             quietly lincom (`lc') / `np'
 92.             local ab = r(estimate)
 93.             local ase = r(se)
 94.             quietly lincom (`lc') / `np' - (`lcp') / `npi'
 95.             local qb = r(estimate)
 96.             local qse = r(se)
 97.             foreach t of local terms {
 98.                 if "`t'" == "ev_lo"      local k = `wlo' - 1
 99.                 else if "`t'" == "ev_hi" local k = `whi' + 1
100.                 else local k = cond(substr("`t'", 4, 1) == "m", -1, 1) * real(substr("`t'", 5, .))
101.                 local map `map' `k':`t'
102.             }
103.         }
104.     }
105. 
.     * ---- (2) Callaway-Sant'Anna (csdid): R2-10's code ----
.     * csdid lays out calendar years one by one, so the year with no file is a
.     * real gap. Black = its average of years 0..+K (estat event Post_avg); its
.     * before check = estat pretrend (R2-10). Its default years before are
.     * year-to-year changes, so a second run with long2 (every year against the
.     * year before the acquisition, as row 1) gives the gray average; the years
.     * after are the same in both runs (checked).
.     if "`t`s''" == "cs" {
106.         local ci "normal"
107.         if !`ok_cs' local stat "unavailable: package not installed (`=strtrim("`miss_cs'")')"
108.         else {
109.             gen int gcs = cond(never, 0, gA)                 // csdid wants 0 = never acquired
110.             capture quietly csdid y, ivar(firm_id) time(year) gvar(gcs)
111.             if _rc local stat "failed: csdid stopped with error r(`=_rc')"
112.             else {
113.                 replace es = e(sample)
114.                 quietly estat event, window(`wlo' `whi')
115.                 matrix bb = r(b)
116.                 matrix vv = r(V)
117.                 local j = colnumb(bb, "Post_avg")
118.                 local ab = bb[1, `j']
119.                 local ase = sqrt(vv[`j', `j'])
120.                 capture quietly estat pretrend, window(`wlo' -1)
121.                 local btest "estat pretrend inside the window (year-to-year changes before the acquisition)"
122.                 if _rc {
123.                     quietly estat pretrend                    // older csdid: no window option
124.                     local btest "estat pretrend, all years before the acquisition"
125.                 }
126.                 local bp = r(pchi2)
127.                 capture quietly csdid y, ivar(firm_id) time(year) gvar(gcs) long2
128.                 if _rc local stat "ok; gray not run: csdid long2 stopped with error r(`=_rc')"
129.                 else {
130.                     quietly estat event, window(`wlo' `whi')
131.                     matrix bb = r(b)
132.                     matrix vv = r(V)
133.                     ereturn post bb vv
134.                     local lcc ""
135.                     local lcq ""
136.                     local nq 0
137.                     forvalues k = 0/`whi' {
138.                         local lcc = cond("`lcc'" == "", "Tp`k'", "`lcc' + Tp`k'")
139.                         local map `map' `k':Tp`k'
140.                     }
141.                     forvalues k = 2/`=-`wlo'' {
142.                         if colnumb(e(b), "Tm`k'") < . {
143.                             local lcq = cond("`lcq'" == "", "Tm`k'", "`lcq' + Tm`k'")
144.                             local ++nq
145.                             local map `map' -`k':Tm`k'
146.                         }
147.                     }
148.                     quietly lincom (`lcc') / `=`whi' + 1'
149.                     if abs(r(estimate) - `ab') > 1e-7 display "   WARNING: csdid long2 years after differ from the 
> default run - re-check"
150.                     if `nq' == -`wlo' - 1 {
151.                         quietly lincom (`lcc') / `=`whi' + 1' - (`lcq') / `nq'
152.                         local qb = r(estimate)
153.                         local qse = r(se)
154.                     }
155.                     else local stat "ok; gray not computed: long2 lacks some years -K..-2"
156.                 }
157.             }
158.         }
159.     }
160. 
.     * ---- (4) Borusyak-Jaravel-Spiess (did_imputation): R2-10's code ----
.     * Fits firm and year effects on rows not yet (or never) acquired, predicts
.     * each acquirer's path without the acquisition, and averages actual minus
.     * predicted. Its before check asks whether the years just before the
.     * acquisition differ from the firm's earlier years.
.     if "`t`s''" == "bjs" {
161.         local ci "normal"
162.         if !`ok_bjs' local stat "unavailable: package not installed (`=strtrim("`miss_bjs'")')"
163.         else {
164.             gen int Ei = gA                                  // acquisition year; missing = never
165.             * minn(0): report every year; the window rule already needs 30+ acquirers per year.
.             capture quietly did_imputation y firm_id year Ei, horizons(0/`whi') pretrends(`=-`wlo'') autosample minn(0
> )
166.             if _rc local stat "failed: did_imputation stopped with error r(`=_rc')"
167.             else {
168.                 replace es = e(sample)
169.                 local bp = e(pre_p)
170.                 local btest "joint test of the `=-`wlo'' years before the acquisition (vs the firm's earlier years)
> "
171.                 local lcb "tau0"
172.                 forvalues k = 1/`whi' {
173.                     local lcb "`lcb' + tau`k'"
174.                 }
175.                 quietly lincom (`lcb') / `=`whi' + 1'
176.                 local ab = r(estimate)
177.                 local ase = r(se)
178.                 forvalues k = 0/`whi' {
179.                     local map `map' `k':tau`k'
180.                 }
181.                 forvalues k = 1/`=-`wlo'' {
182.                     local map `map' -`k':pre`k'
183.                 }
184.                 local stat "ok; one average: vs all years before the acquisition"
185.             }
186.         }
187.     }
188. 
.     * ---- (5) de Chaisemartin-D'Haultfoeuille (did_multiplegt_dyn): R2-10's code ----
.     * It numbers periods as they appear in the data, so every calendar year
.     * missing inside a firm's span (the year with no file included) gets an
.     * empty row with the acquisition status filled in (R2-07's fix). Only
.     * never-acquired firms are comparisons. Effect_1 = year 0, Effect_2 = +1, ...;
.     * Placebo_1 = year -2, Placebo_2 = -3, ... (each against the year before).
