. quietly summarize acq_sh if year != `acq_bad', detail

. local acq_sh_other = r(p50)

. quietly summarize acq_sh if year == `acq_bad'

. local acq_sh_bad = r(mean)

. restore

. if `acq_sh_bad' < 2 * `acq_sh_other' display "   WARNING: 10%+ foreign share in `acq_bad' looks normal (" %4.2f `acq_s
> h_bad' " vs " %4.2f `acq_sh_other' ") - re-check acq_bad"

. else display "   10%+ foreign share: `acq_bad' " %4.2f `acq_sh_bad' " vs middle of other years " %4.2f `acq_sh_other' 
> " (`acq_bad' answers treated as unknown)"
