. *---------------------------------------------------------------------------
. display "Step 4/8: one event study per measure (firm and year fixed effects, clustered by firm)"
Step 4/8: one event study per measure (firm and year fixed effects, clustered by firm)

. *---------------------------------------------------------------------------
. * Each measure on one marker per year since the acquisition (-1 = the year before
. * = reference, 0 by definition; years beyond the window grouped at the two ends),
. * removing each firm's own average (firm fixed effects) and each calendar year's
. * average (year fixed effects). Firms never seen 10%+ foreign-owned are 0 on every
. * marker. A firm with one usable year cannot be compared with itself; reghdfe
. * drops it. b = log difference (points for row 12) from the acquirers' year
. * before the acquisition, net of the comparison firms' change.
. * Two averages are drawn for every measure:
. *   black = years 0..+K minus the year before (-1), as in R7-04;
. *   gray  = years 0..+K minus the average of years -K..-2 (the earlier years
. *           before): if the measure was already moving before the acquisition,
. *           the two differ, and the move cannot come from the new owner.
. tempfile est sums

. tempname h s

. postfile `h' byte outcome str8 term int event_time byte(grouped reference) ///
>     double(b se lo hi p) long(firms rows) using `est'

. postfile `s' byte outcome long(n_rows n_firms n_acquirers n_comparison n_one_year_dropped n_main_left_out ///
>     n_acq_post n_acq_ref n_acq_early) double(before_F before_df before_p before_p_no_grouped ///
>     avg_b avg_se avg_lo avg_hi avg_p pp_b pp_se pp_lo pp_hi pp_p) using `sums'

. forvalues o = 1/`nmeas' {
  2.     * markers with at least one acquirer row for this measure
.     local terms ""
  3.     local pre ""
  4.     local pre_in ""
  5.     local post ""
  6.     foreach t of local cand {
  7.         quietly count if `t' & !missing(y`o')
  8.         if r(N) == 0 continue
  9.         local terms `terms' `t'
 10.         if "`t'" == "ev_lo" | substr("`t'", 4, 1) == "m" local pre `pre' `t'
 11.         if substr("`t'", 4, 1) == "m" local pre_in `pre_in' `t'      // before, grouped end left out
 12.         if "`t'" != "ev_hi" & "`t'" != "ev_lo" & substr("`t'", 4, 1) == "p" local post `post' `t'
 13.     }
 14.     local lc = subinstr("`post'", " ", " + ", .)        // years 0..+K, for the average
 15.     local np : word count `post'
 16.     local lcp = subinstr("`pre_in'", " ", " + ", .)     // years -K..-2, for the gray average
 17.     local npi : word count `pre_in'
 18.     quietly reghdfe y`o' `terms', absorb(firm_id year) vce(cluster firm_id)
 19.     local df = e(df_r)
 20.     local N  = e(N)
 21.     local sg = e(num_singletons)
 22.     capture drop es
 23.     gen byte es = e(sample)
 24.     * Joint test: all years before the acquisition are 0 (with / without the grouped end).
.     quietly test `pre'
 25.     local bF = r(F)
 26.     local bd = r(df)
 27.     local bp = r(p)
 28.     quietly test `pre_in'
 29.     local bq = r(p)
 30.     * Black: average of years 0..+K (against the year before, the reference).
.     quietly lincom (`lc') / `np'
 31.     local ab = r(estimate)
 32.     local ase = r(se)
 33.     local alo = r(estimate) - invttail(`df', 0.025) * r(se)
 34.     local ahi = r(estimate) + invttail(`df', 0.025) * r(se)
 35.     local ap = 2 * ttail(`df', abs(r(estimate) / r(se)))
 36.     * Gray: the same average minus the average of the earlier years before (-K..-2).
.     quietly lincom (`lc') / `np' - (`lcp') / `npi'
 37.     local qb = r(estimate)
 38.     local qse = r(se)
 39.     local qlo = r(estimate) - invttail(`df', 0.025) * r(se)
 40.     local qhi = r(estimate) + invttail(`df', 0.025) * r(se)
 41.     local qp = 2 * ttail(`df', abs(r(estimate) / r(se)))
 42.     * Firms in the estimate, and acquirers behind each average.
.     egen byte ftag = tag(firm_id) if es
 43.     quietly count if ftag & !never
 44.     local st = r(N)
 45.     quietly count if ftag & never
 46.     local cf = r(N)
 47.     quietly count if ftag
 48.     local G = r(N)
 49.     drop ftag
 50.     foreach w in post ref early {
 51.         if "`w'" == "post"  local kc "inrange(kA, 0, `whi')"
 52.         if "`w'" == "ref"   local kc "kA == -1"
 53.         if "`w'" == "early" local kc "inrange(kA, `wlo', -2)"
 54.         egen byte ftag = tag(firm_id) if es & !never & `kc'
 55.         quietly count if ftag == 1
 56.         local na_`w' = r(N)
 57.         drop ftag
 58.     }
 59.     post `s' (`o') (`N') (`G') (`st') (`cf') (`sg') (`left`o'') (`na_post') (`na_ref') (`na_early') ///
>         (`bF') (`bd') (`bp') (`bq') (`ab') (`ase') (`alo') (`ahi') (`ap') (`qb') (`qse') (`qlo') (`qhi') (`qp')
 60.     foreach t in `cand' ev_ref {
 61.         if "`t'" == "ev_lo"       local k = `wlo' - 1
 62.         else if "`t'" == "ev_hi"  local k = `whi' + 1
 63.         else if "`t'" == "ev_ref" local k = -1
 64.         else local k = cond(substr("`t'", 4, 1) == "m", -1, 1) * real(substr("`t'", 5, .))
 65.         * acquirers behind each marker (a firm counts once in a grouped end)
.         egen byte ft = tag(firm_id) if es & `t'
 66.         quietly count if ft == 1
 67.         local nf = r(N)
 68.         quietly count if es & `t'
 69.         local nr = r(N)
 70.         drop ft
 71.         local grp = inlist("`t'", "ev_lo", "ev_hi")
 72.         if "`t'" == "ev_ref" {
 73.             post `h' (`o') ("`t'") (`k') (0) (1) (0) (.) (0) (0) (.) (`nf') (`nr')
 74.         }
 75.         else if !`: list t in terms' | `nr' == 0 {
 76.             post `h' (`o') ("`t'") (`k') (`grp') (0) (.) (.) (.) (.) (.) (0) (0)
 77.         }
 78.         else {
 79.             local b  = _b[`t']
 80.             local se = _se[`t']
 81.             post `h' (`o') ("`t'") (`k') (`grp') (0) (`b') (`se') ///
>                 (`b' - invttail(`df', 0.025) * `se') (`b' + invttail(`df', 0.025) * `se') ///
>                 (2 * ttail(`df', abs(`b' / `se'))) (`nf') (`nr')
 82.         }
 83.     }
 84.     display "   row `o' (`n`o''): " %6.0fc `N' " rows, `st' acquirers, `cf' comparison firms"
 85. }
   row 1 (Energy used): 19,756 rows, 760 acquirers, 3397 comparison firms
   row 2 (CO2): 19,756 rows, 760 acquirers, 3397 comparison firms
   row 3 (Value added): 19,756 rows, 760 acquirers, 3397 comparison firms
   row 4 (Output): 19,756 rows, 760 acquirers, 3397 comparison firms
   row 5 (Workers): 19,749 rows, 760 acquirers, 3395 comparison firms
   row 6 (Energy per unit of value added): 19,756 rows, 760 acquirers, 3397 comparison firms
   row 7 (Energy per unit of output): 19,756 rows, 760 acquirers, 3397 comparison firms
   row 8 (CO2 per unit of value added): 19,756 rows, 760 acquirers, 3397 comparison firms
   row 9 (CO2 per GJ of energy used): 19,756 rows, 760 acquirers, 3397 comparison firms
   row 10 (Fuels burned): 17,473 rows, 727 acquirers, 3128 comparison firms
   row 11 (Bought electricity): 18,723 rows, 724 acquirers, 3246 comparison firms
   row 12 (Bought electricity, share of energy used): 19,756 rows, 760 acquirers, 3397 comparison firms

. postclose `h'

. postclose `s'

. 
