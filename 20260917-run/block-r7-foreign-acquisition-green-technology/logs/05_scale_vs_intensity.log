  3.     local nm = cond(`k' < 0, "ev_m" + string(-`k'), "ev_p" + string(`k'))
  4.     gen byte `nm' = (kA == `k')
  5.     local cand `cand' `nm'
  6. }

. gen byte ev_hi = !missing(kA) & kA > `whi'

. local cand `cand' ev_hi

. gen byte ev_ref = (kA == -1)

