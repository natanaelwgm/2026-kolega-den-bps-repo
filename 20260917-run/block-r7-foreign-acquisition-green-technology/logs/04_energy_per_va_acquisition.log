. * Notes as one text, wrapped by printed width (R2-08's rule; widths in em).
. local txt "Notes: Acquisition = the first year a firm reports foreign owners holding 10% or more of its capital, after
>  an earlier year below"

. local txt "`txt' 10% (a change in the reported share, not a verified purchase); it stays an acquirer if the share fall
> s back later (`n_back_c' of"

. local txt "`txt' the `n_later_c' with a later answer). Each black dot = acquirers' change since their year before the 
> acquisition, minus the"

. local txt "`txt' same years' change among firms never seen 10%+ foreign-owned. Bars = 95% intervals; crossing 0 = no c
> lear difference."

. local txt "`txt' 'Years before': p below 0.05 = acquirers were already changing differently before (a warning sign). '
> Years 0 to +`whi' vs"

. local txt "`txt' years `wlo' to -2' measures the years after against the earlier years before, not the year just befor
> e: a change that"

. local txt "`txt' starts before the acquisition cannot come from the new owner. Black dots: none dated in `gaptxt' (no 
> file) or `acq_bad'"

. local txt "`txt' (ownership answers unusable); energy records in doubt left out (importers of unknown export status in
>  `dtxt'), which"

. local txt "`txt' removes more years after the acquisition than before it (acquired up to `acq_paris': `d0post'% vs `d0
> pre'%; later: `d1post'% vs"

. local txt "`txt' `d1pre'%). Gray triangles keep everything as filed. Value added = output value minus materials, energ
> y and services bought"

. local txt "`txt' (current prices); GJ = gigajoules; CO2 = energy used x standard factors, not measured, so (b) differs
>  from (a) only through"

. local txt "`txt' the fuel mix. Timing, not proof of cause; cannot show which equipment or process changed. Firm links 
> are fictional: a test"

. local txt "`txt' of the method only."

. local maxw 53.5                                         // widest note line that fits the 9-inch PDF

. local nl 0

. local line ""

. local lw 0

. foreach w of local txt {
  2.     local n  = ustrlen(`"`w'"')
  3.     local na = `n' - ustrlen(ustrregexra(`"`w'"', "[ijltfr.,;:'()\-]", ""))
  4.     local wi = `n' - ustrlen(ustrregexra(`"`w'"', "[A-Zmw]", ""))
  5.     local pc = `n' - ustrlen(ustrregexra(`"`w'"', "%", ""))
  6.     local dg = `n' - ustrlen(ustrregexra(`"`w'"', "[0-9+=]", ""))
  7.     local ww = 0.29*`na' + 0.7*`wi' + 0.83*`pc' + 0.52*`dg' + 0.47*(`n' - `na' - `wi' - `pc' - `dg')
  8.     local try = `lw' + 0.25*(`"`line'"' != "") + `ww'
  9.     if `try' > `maxw' & `"`line'"' != "" {
 10.         local ++nl
 11.         local L`nl' `"`line'"'
 12.         local W`nl' = `lw'
 13.         local line `"`w'"'
 14.         local lw = `ww'
 15.     }
 16.     else {
 17.         local line = strtrim(`"`line' `w'"')
 18.         local lw = `try'
 19.     }
 20. }

. local ++nl

. local L`nl' `"`line'"'

. local W`nl' = `lw'

. local notes ""

. forvalues j = 1/`nl' {
  2.     display "   note line `j': " udstrlen(`"`L`j''"') " characters, width " %4.1f `W`j'' " of `maxw' em"
  3.     local notes `"`notes' "`L`j''""'
  4. }
