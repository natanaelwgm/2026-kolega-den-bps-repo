 31.     gen double y2 = ln(co2_total_s1 / value_added_nominal)
 32.     * markers; a marker with no acquirer row in this sample is left out
.     gen byte ev_lo = !missing(kA) & kA < `wlo'
 33.     local cand "ev_lo"
 34.     forvalues k = `wlo'/`whi' {
 35.         if `k' == -1 continue
 36.         local nm = cond(`k' < 0, "ev_m" + string(-`k'), "ev_p" + string(`k'))
 37.         gen byte `nm' = (kA == `k')
 38.         local cand `cand' `nm'
 39.     }
 40.     gen byte ev_hi = !missing(kA) & kA > `whi'
 41.     local cand `cand' ev_hi
 42.     gen byte ev_ref = (kA == -1)
 43.     local terms ""
 44.     local pre ""
 45.     local pre_in ""
 46.     local post ""
 47.     foreach t of local cand {
 48.         quietly count if `t'
 49.         if r(N) == 0 continue
 50.         local terms `terms' `t'
 51.         if "`t'" == "ev_lo" | substr("`t'", 4, 1) == "m" local pre `pre' `t'
 52.         if substr("`t'", 4, 1) == "m" local pre_in `pre_in' `t'      // before, grouped end left out
 53.         if "`t'" != "ev_hi" & "`t'" != "ev_lo" & substr("`t'", 4, 1) == "p" local post `post' `t'
 54.     }
 55.     local lc = subinstr("`post'", " ", " + ", .)        // years 0..+`whi', for the average
 56.     local np : word count `post'
 57.     local lcp = subinstr("`pre_in'", " ", " + ", .)     // years -K..-2, for the before/after contrast
 58.     local npi : word count `pre_in'
 59.     forvalues o = 1/2 {
 60.         if `v' == 4 & !`ok_sa' {
 61.             post `s' (`o') (`v') (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) ("") (
> "unavailable: eventstudyinteract/avar not installed")
 62.             continue
 63.         }
 64.         if `v' == 4 {
 65.             capture quietly eventstudyinteract y`o' `terms', cohort(gA) control_cohort(never) ///
>                 absorb(i.firm_id i.year) vce(cluster firm_id)
 66.             if _rc {
 67.                 post `s' (`o') (`v') (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (`sa_o
> ut') ("`sa_yrs'") ("failed: eventstudyinteract error r(`=_rc')")
 68.                 continue
 69.             }
 70.             local df = e(df_r)
 71.             local N  = e(N)
 72.             capture drop es
 73.             gen byte es = e(sample)
 74.             matrix bsa = e(b_iw)
 75.             matrix vsa = e(V_iw)
 76.             ereturn post bsa vsa, dof(`df')
 77.             local sg = .
 78.         }
 79.         else {
 80.             quietly reghdfe y`o' `terms', absorb(firm_id year) vce(cluster firm_id)
 81.             local df = e(df_r)
 82.             local N  = e(N)
 83.             local sg = e(num_singletons)
 84.             capture drop es
 85.             gen byte es = e(sample)
 86.         }
 87.         * Joint test: all years before the acquisition are 0 (with / without the grouped end).
.         quietly test `pre'
 88.         local bF = r(F)
 89.         local bd = r(df)
 90.         local bp = r(p)
 91.         quietly test `pre_in'
 92.         local bq = r(p)
 93.         * Average over the acquisition year and the years after it inside the window.
.         quietly lincom (`lc') / `np'
 94.         local ab = r(estimate)
 95.         local ase = r(se)
 96.         local alo = r(estimate) - invttail(`df', 0.025) * r(se)
 97.         local ahi = r(estimate) + invttail(`df', 0.025) * r(se)
 98.         * Before/after contrast: the average of years 0..+K minus the average of the
.         * earlier years before (-K..-2). The chart's dots compare every year with the
.         * year just before (-1); if the years before drift, this says how much of
.         * the difference between the two sides of the line was already there.
.         quietly lincom (`lc') / `np' - (`lcp') / `npi'
 99.         local qb = r(estimate)
100.         local qse = r(se)
101.         local qlo = r(estimate) - invttail(`df', 0.025) * r(se)
102.         local qhi = r(estimate) + invttail(`df', 0.025) * r(se)
103.         local qp = 2 * ttail(`df', abs(r(estimate) / r(se)))
104.         egen byte ftag = tag(firm_id) if es
105.         quietly count if ftag & !never
106.         local st = r(N)
107.         quietly count if ftag & never
108.         local cf = r(N)
109.         quietly count if ftag
110.         local G = r(N)
111.         drop ftag
112.         post `s' (`o') (`v') (`N') (`G') (`st') (`cf') (`sg') (`bF') (`bd') (`bp') (`bq') (`ab') (`ase') (`alo') (`
> ahi') ///
>             (`qb') (`qse') (`qlo') (`qhi') (`qp') (`sa_out') ("`sa_yrs'") ("ok")
113.         foreach t in `cand' ev_ref {
114.             if "`t'" == "ev_lo"       local k = `wlo' - 1
115.             else if "`t'" == "ev_hi"  local k = `whi' + 1
116.             else if "`t'" == "ev_ref" local k = -1
117.             else local k = cond(substr("`t'", 4, 1) == "m", -1, 1) * real(substr("`t'", 5, .))
118.             * acquirers behind each point (a firm counts once in a grouped end)
