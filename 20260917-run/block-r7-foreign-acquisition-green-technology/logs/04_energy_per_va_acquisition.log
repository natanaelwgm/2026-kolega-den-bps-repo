121.             quietly count if es & `t'
122.             local nr = r(N)
123.             quietly count if ft == 1 & aft == 0
124.             local ne = r(N)
125.             quietly count if ft == 1 & aft == 1
126.             local nl = r(N)
127.             drop ft
128.             local grp = inlist("`t'", "ev_lo", "ev_hi")
129.             if "`t'" == "ev_ref" {
130.                 post `h' (`o') (`v') ("`t'") (`k') (0) (1) (0) (.) (0) (0) (.) (`nf') (`nr') (`ne') (`nl')
131.             }
