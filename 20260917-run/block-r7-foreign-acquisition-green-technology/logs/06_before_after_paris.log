. *---------------------------------------------------------------------------
. display "Step 4/8: one before/after comparison per acquisition year (firm and year fixed effects, clustered by firm)"
Step 4/8: one before/after comparison per acquisition year (firm and year fixed effects, clustered by firm)

. *---------------------------------------------------------------------------
. * R2-06's design with the R7 acquisition. For acquisition year g: the firms
. * acquired in g and all firms never seen 10%+ foreign-owned, only in calendar
. * years g`wlo' to g+`whi' (the R7 window; a year with no file is simply absent).
. * "after" = 1 for an acquirer's rows from g on. With firm and year fixed
. * effects its coefficient compares each firm with itself: the acquirers' change
. * from their years before g to their years from g on, minus the same change
. * among never-foreign firms over the same calendar years. Earlier or later
. * acquirers are never the comparison, so acquisition years are not mixed.
. * An acquirer counts only with a usable row both before g and from g on; an
. * acquisition year gets an estimate only with `minfirms'+ such acquirers.
. * Two comparisons (spec):
. *   1 from g on vs ALL years before (g`wlo'..g-1)                   (the dots)
. *   2 from g on vs the EARLIER years before only (g`wlo'..g-2): the year just
. *     before gets its own marker (m1), because in Figure R7-04 part of the fall
. *     happens before the acquisition. Needs `minfirms'+ acquirers with a row in
. *     g`wlo'..g-2. Where the year just before has no row (after a year with no
. *     file), spec 2 = spec 1. The same regression also gives "from g on vs the
. *     year just before" (after - m1; CSV only).
. * Versions:
. *   1 main      = R7 main sample (usable rows, energy records in doubt left out)
. *   2 doubt     = energy records in doubt kept
. *   3 paris_cut = main, but acquisitions up to `acq_paris' seen only up to
. *                 `acq_paris' (every row of their comparison), so "before Paris"
. *                 acquirers are measured before Paris only; later years = main
. *   4 exact     = main, only acquirers seen below 10% in the year just before
. tempname h

. postfile `h' byte(version outcome spec) int start_year long(acq_dated acquirers acq_rows_before acq_rows_after ///
>     comp_firms comp_rows rows) int(first_year last_year) double(b se df yb_b yb_se) using `est'

. local first 1

. forvalues v = 1/4 {
  2.     foreach g of local cohorts {
  3.         use `fy', clear
  4.         if `v' == 2 keep if acq_usable & (!missing(acq_year) | acq_key == 9001)
  5.         else        keep if acq_main
  6.         if `v' == 4 keep if missing(acq_year) | acq_exact == 1
  7.         keep if (acq_year == `g' | acq_key == 9001) & inrange(year, `g' + `wlo', `g' + `whi')
  8.         if `v' == 3 & `g' <= `acq_paris' drop if year > `acq_paris'
  9.         sort firm_id year
 10.         gen byte acq = acq_year == `g'                       // acquirer of year g (0 = never foreign)
 11.         egen byte ft = tag(firm_id) if acq
 12.         quietly count if ft == 1
 13.         local nd = r(N)                                  // acquirers of g with a usable row in the window
 14.         by firm_id: egen byte has_b = max(year <  `g')
 15.         by firm_id: egen byte has_a = max(year >= `g')
 16.         by firm_id: egen byte has_e = max(year <= `g' - 2)   // a row in the earlier years before
 17.         keep if !acq | (has_b & has_a)
 18.         quietly count if ft == 1
 19.         local ns = r(N)                                  // acquirers used (weight, spec 1)
 20.         quietly count if ft == 1 & has_e
 21.         local ne = r(N)                                  // of which with a row in g`wlo'..g-2 (weight, spec 2)
 22.         local wA`v'_`g' = `ns'
 23.         local wB`v'_`g' = cond(`ns' >= `minfirms', `ne', 0)
 24.         gen byte after = acq & year >= `g'
 25.         gen byte m1 = acq & year == `g' - 1              // the year just before (none after a year with no file)
 26.         quietly count if m1
 27.         local nm1 = r(N)
 28.         forvalues s = 1/2 {
 29.             local nn = cond(`s' == 1, `ns', `ne')
 30.             if `ns' < `minfirms' | `nn' < `minfirms' {
 31.                 forvalues o = 1/4 {
 32.                     post `h' (`v') (`o') (`s') (`g') (`nd') (`nn') (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.) (.)
 33.                 }
 34.                 continue
 35.             }
 36.             local rhs = cond(`s' == 2 & `nm1' > 0, "after m1", "after")
 37.             forvalues o = 1/4 {
 38.                 quietly reghdfe y`o' `rhs', absorb(firm_id year) vce(cluster firm_id)
 39.                 local b  = _b[after]
 40.                 local se = _se[after]
 41.                 local df = e(df_r)
 42.                 local ab_st "`e(absvars)'"                 // for the regression table (Step 8)
 43.                 local cl_st "`e(clustvar)'"
 44.                 local b`s'_`v'_`g'_`o' = `b'
 45.                 local ybb = .
 46.                 local ybs = .
 47.                 if "`rhs'" == "after m1" {
 48.                     quietly lincom after - m1
 49.                     local ybb = r(estimate)
 50.                     local ybs = r(se)
 51.                 }
 52.                 capture drop es
 53.                 gen byte es = e(sample)
 54.                 quietly count if es & acq & year <  `g'
 55.                 local rb = r(N)
 56.                 quietly count if es & acq & year >= `g'
 57.                 local ra = r(N)
 58.                 egen byte ct = tag(firm_id) if es & !acq
 59.                 quietly count if ct == 1
 60.                 local cf = r(N)
 61.                 drop ct
 62.                 quietly count if es & !acq
 63.                 local cr = r(N)
 64.                 quietly summarize year if es
 65.                 local fy0 = r(min)
 66.                 local fy1 = r(max)
 67.                 post `h' (`v') (`o') (`s') (`g') (`nd') (`nn') (`rb') (`ra') (`cf') (`cr') (e(N)) ///
>                     (`fy0') (`fy1') (`b') (`se') (`df') (`ybb') (`ybs')
 68.             }
 69.             * Check: energy per value added = energy used minus value added, so the
.             * coefficients must add up exactly (same rows, same model).
.             assert abs(`b`s'_`v'_`g'_1' - (`b`s'_`v'_`g'_3' - `b`s'_`v'_`g'_4')) < 1e-7
 70.         }
 71.         if `ns' >= `minfirms' display "   version `v', acquired in `g': " %4.0f `ns' " acquirers (" %4.0f `ne' ///
>             " with an earlier year before); energy per value added b = " %7.4f `b1_`v'_`g'_1'
 72.         else display "   version `v', acquired in `g': " %4.0f `ns' " acquirers - fewer than `minfirms', no estimat
> e"
 73.         if `ns' >= `minfirms' {
 74.             gen int cohort = `g'
 75.             gen byte version = `v'
 76.             gen int e = year - `g' if acq
 77.             keep firm_id year cohort version acq after m1 e y1 y2 y3 y4
 78.             if !`first' append using `stack'
 79.             save `stack', replace
 80.             local first 0
 81.         }
 82.     }
 83. }
