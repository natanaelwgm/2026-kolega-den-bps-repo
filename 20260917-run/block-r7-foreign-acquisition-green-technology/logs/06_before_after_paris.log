. * Notes as one text, wrapped by printed width (R2-08's rule; widths in em).
. local txt "Notes: Acquisition = the first year a firm reports foreign owners holding 10% or more of its capital, after
>  an earlier year below"

. local txt "`txt' 10% (a change in the reported share, not a verified purchase); it stays one if the share falls back (
> `n_back_c' of"

. local txt "`txt' `n_later_c' with a later answer). Each dot = one acquisition year: its acquirers' change from the yea
> rs before (`wlo' to -1)"

. local txt "`txt' to the acquisition year and after (0 to +`whi'), minus the same change among firms never seen 10%+ fo
> reign-owned over the"

. local txt "`txt' same years; bars = 95% intervals, crossing 0 = no clear difference. Gray squares: base = only the"

. local txt "`txt' earlier years before (`wlo' to -2). `r4txt' `rdtxt'"

. if "`shorttxt'" != "" local txt "`txt' Fewer years after: `shorttxt'."

. local txt "`txt' Energy records in doubt left out: `d1'% of after-Paris acquirers' years, `d0'% up to `acq_paris'; kep
> t, after Paris"

. local txt "`txt' = `dktxt', but those records show far less energy than others (a recording problem)."

. local txt "`txt' A gap would not prove that Paris caused it. Value added = output value minus materials, energy"

. local txt "`txt' and services bought (current prices); GJ = gigajoules. No equipment or process data. Firm links are f
> ictional: a test of the method only."

. local maxw 53.5                                         // widest note line that fits the 9-inch PDF

. local nl 0

. local line ""

. local lw 0

. foreach w of local txt {
  2.     local n  = ustrlen(`"`w'"')
  3.     local na = `n' - ustrlen(ustrregexra(`"`w'"', "[ijltfr.,;:'()\-]", ""))
  4.     local wi = `n' - ustrlen(ustrregexra(`"`w'"', "[A-Zmw]", ""))
  5.     local pc = `n' - ustrlen(ustrregexra(`"`w'"', "%", ""))
  6.     local dg = `n' - ustrlen(ustrregexra(`"`w'"', "[0-9+=]", ""))
  7.     local ww = 0.29*`na' + 0.7*`wi' + 0.83*`pc' + 0.52*`dg' + 0.47*(`n' - `na' - `wi' - `pc' - `dg')
  8.     local try = `lw' + 0.25*(`"`line'"' != "") + `ww'
  9.     if `try' > `maxw' & `"`line'"' != "" {
 10.         local ++nl
 11.         local L`nl' `"`line'"'
 12.         local W`nl' = `lw'
 13.         local line `"`w'"'
 14.         local lw = `ww'
 15.     }
 16.     else {
 17.         local line = strtrim(`"`line' `w'"')
 18.         local lw = `try'
 19.     }
 20. }

. local ++nl

. local L`nl' `"`line'"'

. local W`nl' = `lw'

. local notes ""

. forvalues j = 1/`nl' {
  2.     display "   note line `j': " udstrlen(`"`L`j''"') " characters, width " %4.1f `W`j'' " of `maxw' em"
  3.     local notes `"`notes' "`L`j''""'
  4. }
