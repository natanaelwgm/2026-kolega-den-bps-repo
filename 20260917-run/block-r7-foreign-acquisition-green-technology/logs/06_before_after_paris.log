. *---------------------------------------------------------------------------
. display "Step 5/8: averages over acquisition years (weighted by acquirers used), up to vs after Paris"
Step 5/8: averages over acquisition years (weighted by acquirers used), up to vs after Paris

. *---------------------------------------------------------------------------
. * All acquisition years in one stacked regression: each keeps its own firm and
. * year fixed effects and its own markers, so each coefficient equals Step 4's
. * (checked); clustering by firm accounts for never-foreign firms that serve in
. * several acquisition years. Average = weights x coefficients (lincom), weight =
. * acquirers used. "Up to Paris" = acquired up to `acq_paris'; "after" = later.
. tempname a

. postfile `a' byte(version outcome spec) str16 row_type long(acquirers comp_firms rows) double(b se df p) using `avg'

. forvalues v = 1/4 {
  2.     use `stack', clear
  3.     keep if version == `v'
  4.     egen long fc = group(firm_id cohort)
  5.     egen long yc = group(year cohort)
  6.     quietly levelsof cohort, local(used1)
  7.     forvalues s = 1/2 {
  8.         local dterms ""
  9.         local used ""
 10.         foreach L in all early late notlast {
 11.             local t`L' 0
 12.             local l`L' ""
 13.         }
 14.         local tpre 0                                     // spec 2: the year just before vs the earlier years
 15.         local mused ""
 16.         local lpre ""
 17.         foreach g of local used1 {
 18.             local w = cond(`s' == 1, `wA`v'_`g'', `wB`v'_`g'')
 19.             if `w' < `minfirms' continue
 20.             local used `used' `g'
 21.             capture drop d`g'
 22.             gen byte d`g' = after * (cohort == `g')
 23.             local dterms `dterms' d`g'
 24.             if `s' == 2 {
 25.                 quietly count if m1 & cohort == `g'
 26.                 if r(N) > 0 {
 27.                     capture drop m1_`g'
 28.                     gen byte m1_`g' = m1 * (cohort == `g')
 29.                     local dterms `dterms' m1_`g'
 30.                     local mused `mused' `g'
 31.                     local tpre = `tpre' + `w'
 32.                 }
 33.             }
 34.             local tall = `tall' + `w'
 35.             if `g' <= `acq_paris' local tearly = `tearly' + `w'
 36.             else local tlate = `tlate' + `w'
 37.             if `g' != `lastg' local tnotlast = `tnotlast' + `w'
 38.         }
 39.         foreach g of local used {
 40.             local w = cond(`s' == 1, `wA`v'_`g'', `wB`v'_`g'')
 41.             local lall "`lall' + `w'/`tall' * d`g'"
 42.             if `g' <= `acq_paris' local learly "`learly' + `w'/`tearly' * d`g'"
 43.             else local llate "`llate' + `w'/`tlate' * d`g'"
 44.             if `g' != `lastg' local lnotlast "`lnotlast' + `w'/`tnotlast' * d`g'"
 45.         }
 46.         * The year just before vs the earlier years before (-K..-2), averaged the same
.         * way: shows whether a change was already under way before the acquisition.
.         foreach g of local mused {
 47.             local lpre "`lpre' + `wB`v'_`g''/`tpre' * m1_`g'"
 48.         }
 49.         capture drop inS
 50.         gen byte inS = 0
 51.         foreach g of local used {
 52.             quietly replace inS = 1 if cohort == `g'
 53.         }
 54.         * Before-acquisition check (R2-06's), spec 1 only: one marker per acquisition
.         * year and year before it, against the last year before it that has a row
.         * (the year just before; for 2017 acquirers 2015, as 2016 has no file).
.         * Markers for the same year before are averaged over acquisition years
.         * (weight = acquirers seen that year) and all these averages tested together.
.         local lterms ""
 55.         local ltest ""
 56.         if `s' == 1 {
 57.             forvalues k = `wlo'/-2 {
 58.                 local K = -`k'
 59.                 local lk`K' ""
 60.                 local nk`K' 0
 61.                 foreach g of local used {
 62.                     quietly summarize e if cohort == `g' & e < 0, meanonly
 63.                     if `k' >= r(max) continue                       // reference year or later
 64.                     egen byte tq = tag(firm_id) if cohort == `g' & e == `k'
 65.                     quietly count if tq == 1
 66.                     local m = r(N)
 67.                     drop tq
 68.                     if `m' == 0 continue
 69.                     gen byte q`g'_`K' = cohort == `g' & e == `k'
 70.                     local lterms `lterms' q`g'_`K'
 71.                     local lk`K' "`lk`K'' + `m' * q`g'_`K'"
 72.                     local nk`K' = `nk`K'' + `m'
 73.                 }
 74.                 if `nk`K'' > 0 local ltest "`ltest' ((`lk`K'') / `nk`K'' = 0)"
 75.             }
 76.         }
 77.         forvalues o = 1/4 {
 78.             if "`ltest'" != "" {
 79.                 quietly reghdfe y`o' `dterms' `lterms' if inS, absorb(fc yc) vce(cluster firm_id)
 80.                 quietly test `ltest'
 81.                 post `a' (`v') (`o') (`s') ("before_check") (.) (.) (.) (.) (.) (.) (r(p))
 82.             }
 83.             quietly reghdfe y`o' `dterms' if inS, absorb(fc yc) vce(cluster firm_id)
 84.             foreach g of local used {
 85.                 assert reldif(_b[d`g'], `b`s'_`v'_`g'_`o'') < 1e-6
 86.             }
 87.             local nobs = e(N)
 88.             capture drop es
 89.             gen byte es = e(sample)
 90.             egen byte ct = tag(firm_id) if es & !acq
 91.             quietly count if ct == 1
 92.             local cf = r(N)
 93.             drop ct
 94.             foreach L in all early late notlast {
 95.                 if `t`L'' == 0 continue
 96.                 quietly lincom `l`L''
 97.                 post `a' (`v') (`o') (`s') ("`L'") (`t`L'') (`cf') (`nobs') (r(estimate)) (r(se)) (r(df)) (r(p))
 98.             }
 99.             if `tearly' > 0 & `tlate' > 0 {
100.                 quietly lincom (`llate') - (`learly')
101.                 post `a' (`v') (`o') (`s') ("late_minus_early") (.) (`cf') (`nobs') (r(estimate)) (r(se)) (r(df)) (
> r(p))
102.             }
103.             if `tpre' > 0 {
104.                 quietly lincom `lpre'
105.                 post `a' (`v') (`o') (`s') ("pre_step") (`tpre') (`cf') (`nobs') (r(estimate)) (r(se)) (r(df)) (r(p
> ))
106.             }
107.         }
108.         if "`lterms'" != "" drop `lterms'
109.     }
110.     display "   version `v': stacked coefficients equal each acquisition year's own regression"
111. }
