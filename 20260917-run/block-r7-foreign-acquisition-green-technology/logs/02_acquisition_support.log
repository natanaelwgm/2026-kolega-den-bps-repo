. gen int acq_k = year - acq_year
(27,432 missing values generated)

. * Acquirers with a main row in each year since acquisition, by Paris period.
. bysort acq_k: egen int acq_nb = total(acq_main & acq_after == 0)

. by acq_k: egen int acq_na = total(acq_main & acq_after == 1)

. capture assert acq_nb >= `acq_minfirms' & acq_na >= `acq_minfirms' if inlist(acq_k, -1, 0)

. if _rc {
.     display as error "R7 window: fewer than `acq_minfirms' acquirers before or after Paris in the year before or the a
> cquisition year - no window"
.     exit 9
. }

. local acq_K 0

. local acq_go 1

. while `acq_go' {
  2.     local acq_kk = `acq_K' + 1
  3.     quietly count if acq_k == -`acq_kk' & acq_nb >= `acq_minfirms' & acq_na >= `acq_minfirms'
  4.     local acq_c1 = r(N)
  5.     quietly count if acq_k == `acq_kk' & acq_nb >= `acq_minfirms' & acq_na >= `acq_minfirms'
  6.     if `acq_c1' > 0 & r(N) > 0 local acq_K = `acq_kk'
  7.     else local acq_go 0
  8. }

. drop acq_nb acq_na

. sort firm_id year

. local acq_wlo = -`acq_K'

. local acq_whi = `acq_K'

. display "   R7 window: each year from `acq_wlo' to +`acq_whi' on its own; years further out grouped at the two ends"
   R7 window: each year from -4 to +4 on its own; years further out grouped at the two ends

