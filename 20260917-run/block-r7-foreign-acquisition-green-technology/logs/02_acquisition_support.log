. * Notes as one text, wrapped by printed width (R2-08's rule; widths in em).
. local gaptxt = strtrim("`gapyr'")

. local txt "Notes: Acquisition here = the first year a firm reports foreign owners holding 10% or more of its capital, 
> after an earlier year"

. local txt "`txt' below 10% (a change in the reported share, not a verified purchase); none can be dated in `gaptxt' (n
> o file) or `acq_bad'"

. local txt "`txt' (ownership answers unusable). A firm counts in a year when its energy use (GJ), CO2 and value added a
> re all above zero."

. local txt "`txt' Energy records in doubt (importers with unknown export status in some later files) are left out: `dsh
> 1'% of B's usable"

. local txt "`txt' years in the window, `dsh0'% of A's. A year since acquisition is shown on its own in later charts onl
> y when A and B both"

. local txt "`txt' have `minfirms'+ firms in it, so firms acquired before and after Paris (adopted December `acq_paris')
>  are compared over the same years."

. local txt "`txt' `n4b' (A) and `n4a' (B) acquirers have usable years both before and from the acquisition inside the w
> indow; the `n6' firms never"

. local txt "`txt' seen 10%+ foreign-owned (`n7' with 2+ usable years) are the comparison firms. This shows how many fir
> ms can be compared,"

. local txt "`txt' not how they changed. Firm links are fictional: a test of the method only."

. local maxw 43                                           // widest note line that fits the 9-inch PDF

. local nl 0

. local line ""

. local lw 0

. foreach w of local txt {
  2.     local n  = ustrlen(`"`w'"')
  3.     local na = `n' - ustrlen(ustrregexra(`"`w'"', "[ijltfr.,;:'()\-]", ""))
  4.     local wi = `n' - ustrlen(ustrregexra(`"`w'"', "[A-Zmw]", ""))
  5.     local pc = `n' - ustrlen(ustrregexra(`"`w'"', "%", ""))
  6.     local dg = `n' - ustrlen(ustrregexra(`"`w'"', "[0-9+=]", ""))
  7.     local ww = 0.29*`na' + 0.7*`wi' + 0.83*`pc' + 0.52*`dg' + 0.47*(`n' - `na' - `wi' - `pc' - `dg')
  8.     local try = `lw' + 0.25*(`"`line'"' != "") + `ww'
  9.     if `try' > `maxw' & `"`line'"' != "" {
 10.         local ++nl
 11.         local L`nl' `"`line'"'
 12.         local W`nl' = `lw'
 13.         local line `"`w'"'
 14.         local lw = `ww'
 15.     }
 16.     else {
 17.         local line = strtrim(`"`line' `w'"')
 18.         local lw = `try'
 19.     }
 20. }

. local ++nl

. local L`nl' `"`line'"'

. local W`nl' = `lw'

. local notes ""

. forvalues j = 1/`nl' {
  2.     display "   note line `j': " udstrlen(`"`L`j''"') " characters, width " %4.1f `W`j'' " of `maxw' em"
  3.     local notes `"`notes' "`L`j''""'
  4. }
