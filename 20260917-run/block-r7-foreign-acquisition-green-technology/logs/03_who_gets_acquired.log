. local ruleB = `r'

. * footer rows: fixed effects, acquirers in each version, weights, standard errors
. preserve

. use `rr', clear

. forvalues v = 1/`nv' {
  2.     quietly summarize n_acq_all if version == `v' & row == 1
  3.     local na`v' = string(r(mean), "%9.0fc")
  4. }

. restore

. local f1 "Year x 2-digit industry cells"

. local f2 "Year x province cells"

. local f3 "Acquirers in the version"

. local f4 "Weights"

. local f5 "Standard errors"

. forvalues k = 1/5 {
  2.     local ++r
  3.     replace c1 = "`f`k''" in `r'
  4.     forvalues v = 1/`nv' {
  5.         local cell ""
  6.         if `k' == 1 local cell "Yes"
  7.         if `k' == 2 local cell = cond(`v' == 4, "Yes", "No")
  8.         if `k' == 3 local cell "`na`v''"
  9.         if `k' == 4 local cell "None"
 10.         if `k' == 5 local cell "By firm"
 11.         replace c`=3 + `v'' = "`cell'" in `r'
 12.     }
 13. }
