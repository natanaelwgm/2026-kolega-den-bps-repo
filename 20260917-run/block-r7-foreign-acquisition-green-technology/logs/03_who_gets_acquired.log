. local notes ""

. foreach pn in a b {
  2.     quietly summarize lo if panel == "`pn'" & version == 1
  3.     local xmin = min(r(min), 0)
  4.     quietly summarize hi if panel == "`pn'" & version == 1
  5.     local xmax = max(r(max), 0)
  6.     quietly summarize b if panel == "`pn'" & version == 2
  7.     local xmin = min(`xmin', r(min))
  8.     local xmax = max(`xmax', r(max))
  9.     if "`pn'" == "a" {
 10.         * log scale: one gridline per doubling (or halving), labelled in % difference
.         local l2 = ln(2)
 11.         local kb = floor(`xmin' / `l2')
 12.         local kt = ceil(`xmax' / `l2')
 13.         local xbot = `kb' * `l2'
 14.         local xtop = `kt' * `l2'
 15.         local xlab ""
 16.         forvalues k = `kb'/`kt' {
 17.             local pc = 100 * (2^`k' - 1)
 18.             local s = cond(`pc' > 0, "+", "") + strtrim(string(`pc', "%9.0fc")) + "%"
 19.             if `k' == 0 local s "0"
 20.             local xlab `"`xlab' `=`k'*`l2'' "`s'""'
 21.         }
 22.         local xtt "% difference, log scale (each gridline = twice as large)"
 23.     }
 24.     else {
 25.         local rng = `xmax' - `xmin'
 26.         local step = 10^floor(log10(`rng'))
 27.         if `rng'/`step' < 2       local step = `step'/5
 28.         else if `rng'/`step' < 5  local step = `step'/2
 29.         if `rng'/`step' > 6       local step = `step'*2
 30.         local xbot = `step' * floor(`xmin'/`step')
 31.         local xtop = `step' * ceil(`xmax'/`step')
 32.         local xlab "`xbot'(`step')`xtop'"
 33.         local xtt "Difference in percentage points"
 34.     }
 35.     local span = `xtop' - `xbot'
