. forvalues v = 1/7 {
  2.     local keep ""
  3.     if `v' == 2 local keep "& acq_exact == 1"
  4.     if `v' == 5 local keep "& acq_after == 0"
  5.     if `v' == 6 local keep "& acq_after == 1"
  6.     if `v' == 7 local keep "& acq_major == 1"
  7.     local abs = cond(`v' == 4, "cell pcell", "cell")
  8.     forvalues j = 1/13 {
  9.         local y "t`j'"
 10.         local m = cond(`j' >= 12, "S", "A")
 11.         quietly count if `m' `keep'
 12.         local nall = r(N)                                   // acquirers in this version
 13.         if `v' == 3 & !`: list j in erows' {
 14.             post `h' (`v') (`j') (.) (.) (.) (.) (.) (.) (.) (.) (.) (`nall') (.) (.) (.) ///
>                 ("same as version 1: this row uses no energy record")
 15.             continue
 16.         }
 17.         if `v' == 3 local y "t`j'k"
 18.         capture quietly reghdfe `y' `m' if (`m' `keep') | C, absorb(`abs') vce(cluster firm_id)
 19.         if _rc {
 20.             post `h' (`v') (`j') (.) (.) (.) (.) (.) (.) (.) (.) (.) (`nall') (.) (.) (.) ("failed: reghdfe error r
> (`=_rc')")
 21.             continue
 22.         }
 23.         capture drop es
 24.         gen byte es = e(sample)
 25.         quietly count if es & `m'
 26.         local na = r(N)
 27.         if `na' == 0 | _se[`m'] == 0 {
 28.             post `h' (`v') (`j') (.) (.) (.) (.) (.) (.) (.) (0) (.) (`nall') (.) (.) (.) ("not estimated: no acqui
> rer row")
 29.             continue
 30.         }
 31.         local df = e(df_r)
 32.         local b  = _b[`m']
 33.         local se = _se[`m']
 34.         egen byte ft = tag(firm_id) if es
 35.         quietly count if ft == 1 & C
 36.         local nc = r(N)
 37.         quietly count if ft == 1
 38.         local nf = r(N)
 39.         drop ft
 40.         quietly summarize `y' if es & `m'
 41.         local ma = r(mean)
 42.         quietly summarize `y' if es & C
 43.         local mc = r(mean)
 44.         post `h' (`v') (`j') (`b') (`se') (`b' - invttail(`df', 0.025) * `se') (`b' + invttail(`df', 0.025) * `se')
>  ///
>             (2 * ttail(`df', abs(`b' / `se'))) (e(N)) (`nf') (`na') (`nc') (`nall') (e(num_singletons)) (`ma') (`mc') 
> ("ok")
 45.     }
 46.     display "   version `v': done"
 47. }
