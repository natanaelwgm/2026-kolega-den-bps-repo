. * Notes as one text, wrapped by printed width (R2-08's rule; widths in em).
. local txt "Notes: Reading: in their last year below 10% foreign, acquirers differ from similar firms by `p1' in worker
> s and `p4' in"

. local txt "`txt' energy used, but by `p5' in energy per unit of value added (`c5') and `p6' in CO2 per unit of value a
> dded (`c6')."

. local txt "`txt' Acquirers = `n_acq_c' firms first seen with foreign owners holding 10%+ of their capital after an ear
> lier year below 10%"

. local txt "`txt' (Figure R7-01): a change in the reported share, not a verified purchase. Comparison = `n_never_c' fir
> ms never seen 10%+"

. local txt "`txt' foreign-owned, all their years. Each dot = acquirers minus comparison firms of the same year and 2-di
> git industry, in"

. local txt "`txt' the acquirer's last year below 10% (the year just before for `n_exact_c'; earlier for the rest); bars
>  = 95% intervals, crossing"

. local txt "`txt' 0 = no clear difference. Change rows: a clear difference would mean acquirers were already changing d
> ifferently before"

. local txt "`txt' it. Energy rows leave out records in doubt (importers of unknown export status in `dtxt')."

. local txt "`txt' Value added = output value minus materials, energy and services bought (current prices); GJ = gigajou
> les;"

. local txt "`txt' CO2 = energy used x standard factors, not measured. Shows which firms get a foreign owner, not what t
> he owner"

. local txt "`txt' changes. Firm links are fictional: a test of the method only."

. local maxw 53.5                                         // widest note line that fits the 9-inch PDF

. local nl 0

. local line ""

. local lw 0

. foreach w of local txt {
  2.     local n  = ustrlen(`"`w'"')
  3.     local na = `n' - ustrlen(ustrregexra(`"`w'"', "[ijltfr.,;:'()\-]", ""))
  4.     local wi = `n' - ustrlen(ustrregexra(`"`w'"', "[A-Zmw]", ""))
  5.     local pc = `n' - ustrlen(ustrregexra(`"`w'"', "%", ""))
  6.     local dg = `n' - ustrlen(ustrregexra(`"`w'"', "[0-9+=]", ""))
  7.     local ww = 0.29*`na' + 0.7*`wi' + 0.83*`pc' + 0.52*`dg' + 0.47*(`n' - `na' - `wi' - `pc' - `dg')
  8.     local try = `lw' + 0.25*(`"`line'"' != "") + `ww'
  9.     if `try' > `maxw' & `"`line'"' != "" {
 10.         local ++nl
 11.         local L`nl' `"`line'"'
 12.         local W`nl' = `lw'
 13.         local line `"`w'"'
 14.         local lw = `ww'
 15.     }
 16.     else {
 17.         local line = strtrim(`"`line' `w'"')
 18.         local lw = `try'
 19.     }
 20. }

. local ++nl

. local L`nl' `"`line'"'

. local W`nl' = `lw'

. forvalues j = 1/`nl' {
  2.     display "   note line `j': " udstrlen(`"`L`j''"') " characters, width " %4.1f `W`j'' " of `maxw' em"
  3.     local notes `"`notes' "`L`j''""'
  4. }
