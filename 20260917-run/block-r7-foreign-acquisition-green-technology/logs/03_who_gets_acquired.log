. sort firm_id year

. foreach r in main raw maj any {
  2.     local s   = cond("`r'" == "main", "", "_`r'")
  3.     local own = cond("`r'" == "raw", "foreign_ownership_pct", "acq_own")
  4.     local yes "`own' >= 10"                       // foreign-owned
  5.     local no  "`own' < 10"                        // domestic
  6.     if "`r'" == "maj" local yes "`own' >= 50"
  7.     if "`r'" == "any" local yes "`own' > 0"
  8.     if "`r'" == "any" local no  "`own' == 0"
  9.     by firm_id: egen int acq_fy = min(cond(`yes' & !missing(`own'), year, .))   // first "yes"
 10.     by firm_id: egen int acq_fn = min(cond(`no'  & !missing(`own'), year, .))   // first "no"
 11.     by firm_id: egen int acq_nk = total(!missing(`own'))                       // usable answers
 12.     gen int acq_key`s' = .
 13.     replace acq_key`s' = 9003 if acq_nk == 0
 14.     replace acq_key`s' = 9001 if acq_nk > 0 & missing(acq_fy)
 15.     replace acq_key`s' = 9002 if acq_nk > 0 & !missing(acq_fy) & (missing(acq_fn) | acq_fn > acq_fy)
 16.     replace acq_key`s' = acq_fy if acq_nk > 0 & !missing(acq_fy, acq_fn) & acq_fn < acq_fy
 17.     assert !missing(acq_key`s')
 18.     gen int acq_year`s' = acq_key`s' if acq_key`s' < 9000
 19.     by firm_id: egen int acq_ln = max(cond(`no' & !missing(`own', acq_year`s') & year < acq_year`s', year, .))
 20.     gen byte acq_exact`s' = acq_ln == acq_year`s' - 1 if !missing(acq_year`s')
 21.     drop acq_fy acq_fn acq_nk acq_ln
 22. }
