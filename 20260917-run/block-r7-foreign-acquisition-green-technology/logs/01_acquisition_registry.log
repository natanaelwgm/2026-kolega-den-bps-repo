>  the last file)."

. if "`apxtxt'" != "" local txt "`txt' Starts in `apxtxt' are dated approximately: the year before has no file or no usa
> ble answer."

. local txt "`txt' All `acq_bad' ownership answers are treated as unknown (`s_bad'% of firms marked 10%+ foreign-owned, 
> about `s_oth'% in other years);"

. local txt "`txt' as filed, `n_bad_c' firms would start in `acq_bad' (here `n_bad_later_c' get a later year, `n_bad_nev
> er_c' count as never foreign-owned)."

. local txt "`txt' Not shown: `g9001' firms never seen 10%+ foreign-owned (the comparison firms in later R7 figures), `g
> 9002' foreign-owned when"

. local txt "`txt' first seen (start unknown), `g9003' with no usable answer. Firm links are fictional, so most starts a
> nd reversals here come from the"

. local txt "`txt' fake panel: a test of the method only."

. local maxw 54                                           // widest note line that fits the 8-inch PDF

. local nl 0

. local line ""

. local lw 0

. foreach w of local txt {
  2.     local n  = ustrlen(`"`w'"')
  3.     local na = `n' - ustrlen(ustrregexra(`"`w'"', "[ijltfr.,;:'()\-]", ""))
  4.     local wi = `n' - ustrlen(ustrregexra(`"`w'"', "[A-Zmw]", ""))
  5.     local pc = `n' - ustrlen(ustrregexra(`"`w'"', "%", ""))
  6.     local dg = `n' - ustrlen(ustrregexra(`"`w'"', "[0-9+=]", ""))
  7.     local ww = 0.29*`na' + 0.7*`wi' + 0.83*`pc' + 0.52*`dg' + 0.47*(`n' - `na' - `wi' - `pc' - `dg')
  8.     local try = `lw' + 0.25*(`"`line'"' != "") + `ww'
  9.     if `try' > `maxw' & `"`line'"' != "" {
 10.         local ++nl
 11.         local L`nl' `"`line'"'
 12.         local W`nl' = `lw'
 13.         local line `"`w'"'
 14.         local lw = `ww'
 15.     }
 16.     else {
 17.         local line = strtrim(`"`line' `w'"')
 18.         local lw = `try'
 19.     }
 20. }

. local ++nl

. local L`nl' `"`line'"'

. local W`nl' = `lw'

. local notes ""

. forvalues j = 1/`nl' {
  2.     display "   note line `j': " udstrlen(`"`L`j''"') " characters, width " %4.1f `W`j'' " of `maxw' em"
  3.     local notes `"`notes' "`L`j''""'
  4. }
