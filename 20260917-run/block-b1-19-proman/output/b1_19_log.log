. 
. * ---- save -------------------------------------------------------------
. keep  firm_id year source_row kbli2 kbli5 prov java large importer imports ma
> terials inputs ///
>       imp_share_mat imp_share_int exporter exp_share exp_group fdi va output 
> capital ///
>       workers va_pw out_pw cap_pw tfp_* co2_s1 co2_s2 co2_total gj_s1 gj_s2 /
> //
>       gj_total co2_per_va gj_per_va co2_per_out co2_pw gj_pw clean ln_*

. order firm_id year source_row kbli2 kbli5 prov java large exporter exp_share 
> exp_group importer fdi

. label variable imp_share_mat "Imports / raw materials (RTLVCU), importers onl
> y"

. label variable imp_share_int "Imports / total intermediate inputs, importers 
> only"

. label variable exp_share "Export share of output (%), exporters with a report
> ed share"

. label variable clean "1 = not an energy outlier"

. compress
  variable kbli2 was float now byte
  variable prov was float now byte
  variable java was float now byte
  variable large was float now byte
  variable exporter was float now byte
  variable exp_group was float now byte
  variable importer was float now byte
