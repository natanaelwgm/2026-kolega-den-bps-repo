. * ---- C. roster: export share of production by location ----
. foreach loc in java prov {
  2.     use "$B19_DATA/b19_pm_firm.dta", clear
  3.     keep if !missing(`loc')
  4.     generate n_firms = 1
  5.     generate val_prod_known = val_prod if !missing(val_export)
  6.     expand 2, generate(copy)
  7.     replace year = 0 if copy == 1
  8.     collapse (sum) n_firms any_export val_export val_prod_known, by(`loc' 
> year)
  9.     generate pct_firms_export = 100 * any_export / n_firms
 10.     generate agg_export_share = 100 * val_export / val_prod_known
 11.     generate period = cond(year == 0, "pool", string(year))
 12.     sort `loc' year
 13.     order `loc' period n_firms any_export pct_firms_export agg_export_shar
> e
 14.     drop year
 15.     export excel using "$B19_XLSX", sheet("t09_pm_by_`loc'", replace) firs
> trow(variables)
 16. }
