######## B2-02: 05_synthesis ########

. /*==========================================================================
>   Line 5: "Untuk melihat apakah manufacturing mengalami efficiency improvemen
> t
>            without full decarbonisation"
>   Data  : SI 2010-2022 (data/b202_si.dta), clean == 1
>   Output sheet:
>     t05_synthesis   one sheet, intensity vs absolute emissions.
>                     Rows: all manufacturing over 2010-2022, 2010-2015,
>                     2017-2022, then each KBLI 2-digit sector over 2010-2022
>                     (sectors with firms in both years).
>                     Columns (100 x change in ln = log points):
>                       d_co2           total CO2 (absolute emissions)
>                       d_va            scale: total VA (nominal)
>                       d_gj_per_va     energy intensity  (line 3)
>                       d_co2_per_gj    carbon content    (line 4)
>                       d_co2_per_va    carbon intensity  (= d_gj_per_va + d_co
> 2_per_gj)
>                       d_gj_pw         energy per worker (physical check)
>                       check           d_co2 - d_va - d_gj_per_va - d_co2_per_
> gj (= 0)
>                       reading_energy  energy intensity down/up x emissions do
> wn/up
>                       reading_carbon  carbon intensity down/up x emissions do
> wn/up
> 
>   Total CO2 = VA x GJ/VA x CO2/GJ, so d_co2 = d_va + d_gj_per_va + d_co2_per_
> gj.
>   "Efficiency improvement without full decarbonisation" = intensity falls
>   while total emissions still rise.
> 
>   NOTE: VA is NOMINAL. Price inflation raises d_va and lowers d_gj_per_va
>   by the same amount, so "intensity down" on VA may be partly prices.
>   d_gj_pw has no price in it: if it rises, energy use per worker did not
>   fall. 2015-2017 crosses the questionnaire change.
> ==========================================================================*/
. if "$B202" == "" {
.     display as error "Run 00_run.do first (it sets the paths)."
.     exit 198
. }

. 
. * ---- A. all manufacturing, three windows ----
. use "$B202_DATA/b202_si.dta", clear
(G0 -> G0.25 OBSCURED -> G0.5 DUMMY PANEL -> G1 RE-ESTIMATED)

. keep if clean == 1
(30 observations deleted)

. collapse (sum) tot_co2 = co2_total tot_gj = gj_total tot_va = va tot_workers 
> = workers, by(year)

. tempfile yearly result

. save `yearly'
file /var/folders/7l/7f30l8dj7219j21dhg9glmwc0000gn/T//St65806.000001 saved
    as .dta format

. 
. local starts "2010 2010 2017"

. local ends   "2022 2015 2022"

. forvalues i = 1/3 {
  2.     local a : word `i' of `starts'
  3.     local b : word `i' of `ends'
  4.     use `yearly', clear
  5.     keep if year == `a' | year == `b'
  6.     sort year
  7.     generate d_co2        = 100 * (ln(tot_co2[2]) - ln(tot_co2[1]))
  8.     generate d_va         = 100 * (ln(tot_va[2]) - ln(tot_va[1]))
  9.     generate d_gj_per_va  = 100 * (ln(tot_gj[2] / tot_va[2]) - ln(tot_gj[1
> ] / tot_va[1]))
 10.     generate d_co2_per_gj = 100 * (ln(tot_co2[2] / tot_gj[2]) - ln(tot_co2
> [1] / tot_gj[1]))
 11.     generate d_gj_pw      = 100 * (ln(tot_gj[2] / tot_workers[2]) - ln(tot
> _gj[1] / tot_workers[1]))
 12.     keep in 1
 13.     generate unit = "All manufacturing"
 14.     generate window = "`a'-`b'"
 15.     generate row = `i'
 16.     if `i' > 1 append using `result'
 17.     save `result', replace
 18. }
