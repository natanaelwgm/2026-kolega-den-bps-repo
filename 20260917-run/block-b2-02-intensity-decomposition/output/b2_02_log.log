. * ---- B. each sector, 2010-2022 ----
. use "$B202_DATA/b202_si.dta", clear
(G0 -> G0.25 OBSCURED -> G0.5 DUMMY PANEL -> G1 RE-ESTIMATED)

. keep if clean == 1 & !missing(kbli2) & (year == 2010 | year == 2022)
(27,559 observations deleted)

. generate n_firms = 1

. collapse (sum) n_firms tot_co2 = co2_total tot_gj = gj_total tot_va = va tot_
> workers = workers, by(kbli2 year)

. reshape wide n_firms tot_co2 tot_gj tot_va tot_workers, i(kbli2) j(year)
(j = 2010 2022)

Data                               Long   ->   Wide
-----------------------------------------------------------------------------
Number of observations               48   ->   24          
Number of variables                   7   ->   11          
j variable (2 values)              year   ->   (dropped)
xij variables:
                                n_firms   ->   n_firms2010 n_firms2022
                                tot_co2   ->   tot_co22010 tot_co22022
                                 tot_gj   ->   tot_gj2010 tot_gj2022
                                 tot_va   ->   tot_va2010 tot_va2022
                            tot_workers   ->   tot_workers2010 tot_workers2022
-----------------------------------------------------------------------------

. keep if !missing(n_firms2010, n_firms2022)
(0 observations deleted)

. generate d_co2        = 100 * (ln(tot_co22022) - ln(tot_co22010))

. generate d_va         = 100 * (ln(tot_va2022) - ln(tot_va2010))

. generate d_gj_per_va  = 100 * (ln(tot_gj2022 / tot_va2022) - ln(tot_gj2010 / 
> tot_va2010))

. generate d_co2_per_gj = 100 * (ln(tot_co22022 / tot_gj2022) - ln(tot_co22010 
> / tot_gj2010))

. generate d_gj_pw      = 100 * (ln(tot_gj2022 / tot_workers2022) - ln(tot_gj20
> 10 / tot_workers2010))

. decode kbli2, generate(unit)

. generate window = "2010-2022"

. generate row = 3 + kbli2

. append using `result'

. 
