. * loop: workers (main), va, output as the size measure
. foreach m in workers va output {
  2.     generate traj_`m' = .
  3.     replace traj_`m' = 1 if in2020 == 0 & in2021 == 0 & in2022 == 0
  4.     replace traj_`m' = 2 if in2020 == 0 & (in2021 == 1 | in2022 == 1)
  5.     replace traj_`m' = 3 if in2020 == 1 & in2022 == 1 & `m'_2022 <  `m'_20
> 19 & !missing(`m'_2019, `m'_2022)
  6.     replace traj_`m' = 4 if in2020 == 1 & in2022 == 1 & `m'_2022 >= `m'_20
> 19 & !missing(`m'_2019, `m'_2022)
  7.     replace traj_`m' = 5 if in2020 == 1 & in2022 == 0
  8.     replace traj_`m' = 6 if in2020 == 1 & in2022 == 1 & missing(`m'_2019, 
> `m'_2022)
  9.     assert !missing(traj_`m')         // every cohort firm is in one group
 10. }
