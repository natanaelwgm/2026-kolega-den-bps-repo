. label variable imp_share_int "Imports / total intermediate inputs, importers 
> only"

. label variable clean "1 = not an energy outlier"

. compress
  variable kbli2 was float now byte
  variable prov was float now byte
  variable java was float now byte
  variable large was float now byte
  variable importer was float now byte
  variable exporter was float now byte
  variable fdi was float now byte
  variable clean was float now byte
  (793,176 bytes saved)

