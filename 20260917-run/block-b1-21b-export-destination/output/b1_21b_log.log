(547 missing values generated)
(547 missing values generated)

. 
. * ---- save -------------------------------------------------------------
. keep  firm_id year source_row kbli2 kbli5 prov java large importer imports ma
> terials inputs ///
>       imp_share_mat imp_share_int exporter export_share fdi va output capital
>  ///
>       workers va_pw out_pw cap_pw tfp_* co2_s1 co2_s2 co2_total gj_s1 gj_s2 /
> //
>       gj_total co2_per_va gj_per_va co2_per_out co2_pw gj_pw clean ln_*

. order firm_id year source_row kbli2 kbli5 prov java large importer exporter f
> di

. label variable imp_share_mat "Imports / raw materials (RTLVCU), importers onl
