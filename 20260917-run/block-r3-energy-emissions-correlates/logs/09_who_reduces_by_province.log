. quietly summarize lo

. local dlo = 50 - r(min)

. quietly summarize hi

. local dhi = r(max) - 50

. local half = max(10, 5 * ceil((max(`dlo', `dhi') + 3) / 5))

. local xlo = 50 - `half'

. local xhi = 50 + `half'

. local xs  = 10 * floor(`half' / 10)

. display "   x range `xlo'-`xhi'"
   x range 30-70

. sort panel refy y

. * layers: 1 interval, 2 province, 3 island group, [4 together], labels, dashed line
. local l3 ""

. local k3 ""

. local lref 5

. if `has3' {
.     * white-filled circle, thin black edge: stays hollow in the PDF and hides the interval line behind it
.     local l3 "(scatter y pct if rtype == 3, msymbol(O) mfcolor(white) mlcolor(black) mlwidth(thin) msize(small))"
.     local k3 `"4 "Smaller provinces together (each under `minchg' changes)""'
.     local lref 6
. }

. twoway (rspike lo hi y, horizontal lcolor(black) lwidth(thin)) ///
>     (scatter y pct if rtype == 2, msymbol(O) mcolor(black) msize(vsmall)) ///
>     (scatter y pct if rtype == 1, msymbol(D) mcolor(black) msize(vsmall)) ///
>     `l3' ///
>     (scatter y labx, msymbol(none) mlabel(plab) mlabvposition(labp) mlabgap(0.6) mlabsize(vsmall) mlabcolor(gs5)) ///
>     (line refy refx, lpattern(dash) lcolor(gs8) lwidth(thin)), ///
>     by(panel, rows(1) graphregion(color(white) lcolor(white) ilcolor(white)) legend(pos(6)) scale(0.8125) ///
>         title("Figure R3-09. Share of yearly changes in which energy and CO2 fell more (or rose less) than at the typi
> cal firm," ///
>               "by province (codes only: the file has no names), grouped by island and sorted by panel (a)", size(small
> ) pos(11) span) ///
>         note("Notes: Each dot = share of the province's one-year changes that fell more or rose less than the typical 
> (median) change of all firms that year." ///
>              "50% = same as the typical firm; where the 95% interval crosses the dashed line, the row is not clearly d
> ifferent. Shows where, not why." ///
>              "In (a), `nmiss' of `K' province rows are clearly different, against about `nexp' by chance. Island group
>  = first digit: Sumatra 1–2, Java 3, other islands 5–9." ///
>              "Firms that start high tend to fall back: in (c), `q5pct'% of changes from the top fifth of starting ener
> gy beat the typical change, `q1pct'% from the bottom fifth;" ///
>              "so provinces whose firms start high look better, partly automatically (the table holds sector or startin
> g level fixed). GJ = gigajoules." ///
>              "VA = value added = output minus materials, energy and services bought (current prices). Province = code 
> at the start of each change." ///
>              "`srcnote'" "`devnote'", size(vsmall) span linegap(0.6))) ///
>     subtitle(, pos(11) nobox fcolor(white) lcolor(white) size(small)) ///
>     yscale(reverse noline range(-0.3 `ymax')) ylabel(`ylab', angle(0) noticks tlength(0) nogrid labsize(vsmall)) ytitl
> e("") ///
>     xscale(range(`xlo' `xhi') lcolor(gs10)) ///
>     xlabel(`=50 - `xs''(10)`=50 + `xs'', noticks tlength(0) labsize(vsmall) grid glcolor(gs15) glwidth(vthin)) ///
>     xtitle("Changes that fell more or rose less than the typical firm's that year (% of the province's changes)", size
> (vsmall)) ///
