. display "Step 6/8: same shares holding sector fixed, and holding the starting level fixed (table only)"
Step 6/8: same shares holding sector fixed, and holding the starting level fixed (table only)

. *---------------------------------------------------------------------------
. * Sector fixed: share predicted from a linear model of 'beat' on the row and the
. * sector, averaged over all changes = the row's share if its changes had the
. * sector mix of all firms. Starting level fixed: the same with the fifth of the
. * starting level (within the start year) instead of the sector.
. foreach v in energy_va co2_va energy co2 {
  2.     foreach a in sec q5 {
  3.         local ctl = cond("`a'" == "sec", "i.g_sec", "i.q5_`v'")
  4.         quietly regress beat_`v' i.grp `ctl' if cmp, vce(cluster firm_id)
  5.         quietly testparm i.grp
  6.         display "   `v', `a' held fixed: do rows differ? F(" r(df) ", " r(df_r) ") = " %6.2f r(F) ", p = " %6.4f r(
> p)
  7.         quietly margins grp
  8.         matrix G_`v'_`a' = r(table)
  9.         quietly regress beat_`v' i.g_isl `ctl' if cmp, vce(cluster firm_id)
 10.         quietly margins g_isl
 11.         matrix I_`v'_`a' = r(table)
 12.     }
 13.     quietly regress beat_`v' i.grp if cmp, vce(cluster firm_id)
 14.     quietly testparm i.grp
 15.     display "   `v', as drawn: do rows differ? F(" r(df) ", " r(df_r) ") = " %6.2f r(F) ", p = " %6.4f r(p)
 16. }
