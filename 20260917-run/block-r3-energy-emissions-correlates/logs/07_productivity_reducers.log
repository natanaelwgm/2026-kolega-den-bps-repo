. display "Step 4/8: which start year drives the productivity gap? (leave one out)"
Step 4/8: which start year drives the productivity gap? (leave one out)

. *---------------------------------------------------------------------------
. * Gap = firm-average productivity, reducers minus non-reducers (main flag).
. * The start year whose removal moves the gap most is shown separately in A.
. egen byte tagf = tag(firm_id)

. quietly regress avg_tfp_lp i.reducer_adj_energy_va if tagf, vce(robust)

. local gap_all = _b[1.reducer_adj_energy_va]

. quietly levelsof start_year if cmp, local(sys)

. local best = -1

. local second = -1

. local yx = .

. foreach s of local sys {
  2.     capture drop lx_rel lx_n lx_avg lx_flag
  3.     gen double lx_rel = rel_chg_energy_va if start_year != `s'
  4.     bysort firm_id: egen int    lx_n   = count(lx_rel)
  5.     bysort firm_id: egen double lx_avg = mean(lx_rel)
  6.     gen byte lx_flag = (lx_avg < 0) if lx_n >= 2
  7.     quietly regress avg_tfp_lp i.lx_flag if tagf, vce(robust)
  8.     local d = abs(_b[1.lx_flag] - `gap_all')
  9.     display "   without changes starting in `s': gap moves by " %5.3f `d' " log points"
 10.     if `d' > `best' {
 11.         local second = `best'
 12.         local best = `d'
 13.         local yx = `s'
 14.     }
 15.     else if `d' > `second' local second = `d'
 16. }
