. display "Step 5/8: A - productivity gap, reducers vs non-reducers (one row per firm)"
Step 5/8: A - productivity gap, reducers vs non-reducers (one row per firm)

. *---------------------------------------------------------------------------
. * The gap is in log points; 100*(exp(gap)-1) turns it into a % difference.
. * One row per firm, so a plain robust interval is right.
. tempname P

. tempfile arows

. postfile `P' int row_order byte in_figure str24 measure str40 measure_label str16 productivity ///
>     str40 flag_version int left_out_start_year double(gap_move_left_out gap_move_next) ///
>     long(firms_classified firms_with_productivity reducers nonreducers) ///
>     double(gap_log gap_log_lo gap_log_hi gap_pct gap_pct_lo gap_pct_hi ///
>            mean_rel_reducers mean_rel_nonreducers median_rel_reducers median_rel_nonreducers) ///
>     int(sectors_with_productivity sectors_total) using `arows', replace
(file /var/folders/0k/wcj_06q55_gd0c7z2x717jsc0000gn/T//S_92371.000001 not found)

. local r 0

. foreach spec in "tfp_lp energy_va m" "tfp_lp energy_va x" "tfp_lp co2_va m" "tfp_lp co2_va x" ///
>                 "tfp_lp energy m" "tfp_lp energy x" "tfp_lp co2 m" "tfp_lp co2 x" ///
>                 "tfp_acf energy_va m" "tfp_wrdg energy_va m" "common_tfp_lp energy_va m" {
  2.     local m : word 1 of `spec'
  3.     local v : word 2 of `spec'
  4.     local f : word 3 of `spec'
  5.     local flag = cond("`f'" == "m", "reducer_adj_`v'", "reducer_x_`v'")
  6.     local ver  = cond("`f'" == "m", "all one-year changes", "without changes starting in `yx'")
  7.     if "`v'" == "energy_va" local vl "Energy per unit of VA"
  8.     if "`v'" == "co2_va"    local vl "CO2 per unit of VA"
  9.     if "`v'" == "energy"    local vl "Energy use, GJ"
 10.     if "`v'" == "co2"       local vl "CO2 emitted, tonnes"
 11.     local ++r
 12.     quietly count if tagf & !missing(`flag')
 13.     local ncl = r(N)
 14.     quietly count if tagf & !missing(`flag') & !missing(avg_`m')
 15.     local nwp = r(N)
 16.     quietly count if tagf & `flag' == 1 & !missing(avg_`m')
 17.     local n1 = r(N)
 18.     quietly count if tagf & `flag' == 0 & !missing(avg_`m')
 19.     local n0 = r(N)
 20.     local g = .
 21.     local glo = .
 22.     local ghi = .
 23.     if `n1' > 1 & `n0' > 1 {
 24.         quietly regress avg_`m' i.`flag' if tagf, vce(robust)
 25.         local g   = _b[1.`flag']
 26.         local glo = _b[1.`flag'] - invttail(e(df_r), 0.025) * _se[1.`flag']
 27.         local ghi = _b[1.`flag'] + invttail(e(df_r), 0.025) * _se[1.`flag']
 28.     }
 29.     quietly summarize avg_`m' if tagf & `flag' == 1, detail
 30.     local m1 = r(mean)
 31.     local p1 = r(p50)
 32.     quietly summarize avg_`m' if tagf & `flag' == 0, detail
 33.     local m0 = r(mean)
 34.     local p0 = r(p50)
 35.     local infig = ("`m'" == "tfp_lp")
 36.     local lo_out = cond("`f'" == "x", `yx', .)
 37.     post `P' (`r') (`infig') ("`v'") ("`vl'") ("`m'") ("`ver'") (`lo_out') (`best') (`second') ///
>         (`ncl') (`nwp') (`n1') (`n0') (`g') (`glo') (`ghi') ///
>         (100 * (exp(`g') - 1)) (100 * (exp(`glo') - 1)) (100 * (exp(`ghi') - 1)) ///
>         (`m1') (`m0') (`p1') (`p0') (`n_sec_prod') (`n_sec_all')
 38. }

. postclose `P'

