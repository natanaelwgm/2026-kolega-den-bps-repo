. * starting energy relative to the least productive quarter, same start year
. local er1 = 1                   // the least productive quarter is the reference

. forvalues k = 2/5 {
  2.     local er`k' = .
  3. }

. capture regress s_lnE ib1.g_q i.start_year if g_q < 5

. if _rc == 0 {
.     forvalues k = 2/4 {
  2.         local er`k' = exp(_b[`k'.g_q])
  3.     }
. }

. * energy-use gap vs the least productive quarter when starting energy is held
. * fixed (same fifth of starting energy, same start year) - CSV check only
. forvalues k = 1/5 {
  2.     local ss`k' = .
  3.     local ssl`k' = .
  4.     local ssh`k' = .
  5. }

. capture regress beat_energy ib1.g_q i.start_year#i.e5 if g_q < 5, vce(cluster firm_id)

. if _rc == 0 {
.     forvalues k = 2/4 {
  2.         quietly lincom 100 * `k'.g_q
  3.         local ss`k'  = r(estimate)
  4.         local ssl`k' = r(lb)
  5.         local ssh`k' = r(ub)
  6.     }
. }

. local gl `""Lowest 25%" "25–50%" "50–75%" "Highest 25%" "No productivity figure at start""'

. forvalues k = 1/5 {
  2.     quietly count if cmp & g_q == `k'
  3.     if r(N) == 0 continue
  4.     local gname : word `k' of `gl'
  5.     local vals ""
  6.     foreach v in energy_va co2_va energy co2 {
  7.         quietly mean beat_`v' if cmp & g_q == `k', vce(cluster firm_id)
  8.         matrix T = r(table)
  9.         local p  = 100 * T[1,1]
 10.         local lo = 100 * T[5,1]
 11.         local hi = 100 * T[6,1]
 12.         local nn = e(N)
 13.         local nf = e(N_clust)
 14.         local g = .
 15.         local glo = .
 16.         local ghi = .
 17.         if inrange(`k', 2, 4) {
 18.             quietly regress beat_`v' ib1.g_q if cmp & g_q < 5, vce(cluster firm_id)
 19.             quietly lincom 100 * `k'.g_q
 20.             local g   = r(estimate)
 21.             local glo = r(lb)
 22.             local ghi = r(ub)
 23.         }
 24.         local vals `vals' (`p') (`lo') (`hi') (`g') (`glo') (`ghi')
 25.     }
 26.     quietly summarize beat_va if cmp & g_q == `k'
 27.     local pva = 100 * r(mean)
 28.     local pmin = .
 29.     local pmed = .
 30.     local pmax = .
 31.     if `k' < 5 {
 32.         quietly summarize s_prod if cmp & g_q == `k', detail
 33.         local pmin = r(min)
 34.         local pmed = r(p50)
 35.         local pmax = r(max)
 36.     }
 37.     quietly summarize s_workers if cmp & g_q == `k', detail
 38.     local wmed = r(p50)
 39.     quietly summarize beat_energy_va if cmp & g_q == `k' & year < 2016
 40.     local pe = 100 * r(mean)
 41.     local ne = r(N)
 42.     quietly summarize beat_energy_va if cmp & g_q == `k' & year > 2016
 43.     local pl = 100 * r(mean)
 44.     local nl = r(N)
 45.     post `Q' (`k') ((`k' < 5)) ("`gname'") (`nn') (`nf') (`pmin') (`pmed') (`pmax') (`wmed') (`er`k'') ///
>         `vals' (`pva') (`ss`k'') (`ssl`k'') (`ssh`k'') (`pe') (`ne') (`pl') (`nl')
 46. }

. postclose `Q'

. quietly count if start_year == `yx' & g_q < 5

