 47.             }
 48.             local vals `vals' (`p') (`lo') (`hi') (`g') (`glo') (`ghi') (`px') (`lox') (`hix')
 49.         }
 50.         * main measure before and after the missing 2016 file
.         quietly summarize beat_energy_va if cmp & g_`d' == `k' & year < 2016
