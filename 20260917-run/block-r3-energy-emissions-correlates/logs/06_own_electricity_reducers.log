 59.         quietly summarize rel_chg_va if cmp & g_`d' == `k', detail
 60.         local mva = 100 * (exp(r(p50)) - 1)
 61.         post `P' (`r') ((`k' != `nrg')) ("`dn'") ("`gname'") ("`refname'") (`nn') (`nf') (`nx') (`yx') ///
>             `vals' (`pe') (`ne') (`pl') (`nl') (`pb') (`nb') (`mva')
 62.     }
 63. }

