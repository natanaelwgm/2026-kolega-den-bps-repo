. foreach v in energy co2 energy_va co2_va {
  2.     * Year-adjusted: this firm's change minus the typical (median) change of all
.     * compared firms in the same year, so the years a firm happens to be
.     * observed in do not decide whether it is a reducer.
.     bysort year: egen double med_chg_`v' = pctile(chg_`v'), p(50)   // median; egen median() would ignore "double"
  3.     gen double rel_chg_`v' = chg_`v' - med_chg_`v'
  4.     bysort firm_id: egen int    n_chg_`v'   = count(chg_`v')
  5.     bysort firm_id: egen double avg_chg_`v' = mean(chg_`v')
  6.     bysort firm_id: egen double avg_rel_`v' = mean(rel_chg_`v')
  7.     gen byte reducer_`v'     = (avg_chg_`v' < 0) if n_chg_`v' >= 2
  8.     gen byte reducer_adj_`v' = (avg_rel_`v' < 0) if n_chg_`v' >= 2
  9. }
