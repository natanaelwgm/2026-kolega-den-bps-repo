 38.                 local g   = r(estimate)
 39.                 local glo = r(lb)
 40.                 local ghi = r(ub)
 41.             }
 42.             local vals `vals' (`p') (`lo') (`hi') (`g') (`glo') (`ghi')
 43.         }
 44.         * worker counts behind the size groups
.         local wmin = .
 45.         local wmed = .
 46.         local wmax = .
 47.         if inlist("`d'", "size", "large") {
 48.             quietly summarize s_workers if cmp & g_`d' == `k', detail
 49.             local wmin = r(min)
