 12.     if "`d'" == "large"  local gl `""More than 100 workers" "100 or fewer""'
 13.     local ref = cond("`d'" == "size", 1, 2)
 14.     local refname : word `ref' of `gl'
 15.     local infig = inlist("`d'", "size", "exp", "imp", "fdi")
 16.     forvalues k = 1/3 {
 17.         quietly count if cmp & g_`d' == `k'
 18.         if r(N) == 0 continue
 19.         local ++r
 20.         local gname : word `k' of `gl'
 21.         local vals ""
 22.         foreach v in energy_va co2_va energy co2 {
 23.             quietly mean beat_`v' if cmp & g_`d' == `k', vce(cluster firm_id)
 24.             matrix T = r(table)
