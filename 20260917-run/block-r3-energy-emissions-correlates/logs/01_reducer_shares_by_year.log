. foreach v in energy co2 energy_va co2_va {
  2.     gen byte down_`v'  = (`v' < L.`v') if cmp                        // main rule: any fall
  3.     gen byte down5_`v' = (ln(`v') - ln(L.`v') < ln(0.95)) if cmp     // check: fell by more than 5%
  4.     quietly count if cmp & `v' == L.`v'
  5.     display "   exact ties (unchanged) for `v': " r(N)
  6. }
