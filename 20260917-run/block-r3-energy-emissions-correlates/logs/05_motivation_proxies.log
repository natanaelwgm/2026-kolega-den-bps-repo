. * small helper: turn a list of years into short text, e.g. "2011 2017 2018 2019" -> "2011, 2017–19"
. capture program drop yearspan

. program define yearspan, rclass
  1.     local out ""
  2.     local first = .
  3.     local prev  = .
  4.     foreach y of local 0 {
  5.         if `y' == `prev' + 1 {
  6.             local prev = `y'
  7.             continue
  8.         }
  9.         if `first' < . {
 10.             local seg = cond(`prev' > `first', "`first'–" + substr("`prev'", 3, 2), "`first'")
 11.             local out = cond(`"`out'"' == "", "`seg'", "`out', `seg'")
 12.         }
 13.         local first = `y'
 14.         local prev  = `y'
 15.     }
 16.     if `first' < . {
 17.         local seg = cond(`prev' > `first', "`first'–" + substr("`prev'", 3, 2), "`first'")
 18.         local out = cond(`"`out'"' == "", "`seg'", "`out', `seg'")
 19.     }
 20.     return local s "`out'"
 21. end

