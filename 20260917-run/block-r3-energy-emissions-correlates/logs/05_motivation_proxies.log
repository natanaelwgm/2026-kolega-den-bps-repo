. local r 0

. foreach f of local fams {
  2.     if "`f'" == "doc"   local qn "Environmental permit"
  3.     if "`f'" == "waste" local qn "Waste treatment"
  4.     if "`f'" == "rd"    local qn "R&D activity"
  5.     if "`f'" == "inn"   local qn "Any innovation"
  6.     if "`f'" == "proc"  local qn "Process innovation"
  7.     if "`f'" == "amdal" local qn "AMDAL held (any other too)"
  8.     if "`f'" == "ukl"   local qn "UKL-UPL held"
  9.     if "`f'" == "sppl"  local qn "SPPL held"
 10.     local gl `""Yes" "No" "Not recorded""'
 11.     if "`f'" == "doc" local gl `""AMDAL (strictest)" "UKL-UPL or SPPL only" "None of the three" "Not recorded""'
 12.     local K : word count `gl'
 13.     local ref = cond("`f'" == "doc", 3, 2)
 14.     local refname : word `ref' of `gl'
 15.     local infig = inlist("`f'", "doc", "waste", "rd", "inn", "proc")
 16.     forvalues k = 1/`K' {
 17.         quietly count if g_`f' == `k'
 18.         if r(N) == 0 continue
 19.         local ++r
 20.         local gname : word `k' of `gl'
 21.         local vals ""
 22.         foreach v in energy_va co2_va energy co2 {
 23.             quietly mean b_`f'_`v' if g_`f' == `k', vce(cluster firm_id)
 24.             matrix T = r(table)
 25.             local p  = 100 * T[1,1]
 26.             local lo = 100 * T[5,1]
 27.             local hi = 100 * T[6,1]
 28.             local nn = e(N)
 29.             local nf = e(N_clust)
 30.             local g = .
 31.             local glo = .
 32.             local ghi = .
 33.             if `k' != `ref' {
 34.                 quietly regress b_`f'_`v' ib`ref'.g_`f', vce(cluster firm_id)
 35.                 quietly lincom 100 * `k'.g_`f'
 36.                 local g   = r(estimate)
 37.                 local glo = r(lb)
 38.                 local ghi = r(ub)
 39.             }
 40.             local vals `vals' (`p') (`lo') (`hi') (`g') (`glo') (`ghi')
 41.         }
 42.         * leave out one start year at a time (main measure)
.         local lmin = .
 43.         local lmax = .
 44.         local nst : word count `st_`f''
 45.         if `nst' > 1 {
 46.             foreach sy of local st_`f' {
 47.                 quietly summarize b_`f'_energy_va if g_`f' == `k' & start_year != `sy'
 48.                 if r(N) > 0 {
 49.                     local lmin = min(`lmin', 100 * r(mean))
 50.                     local lmax = cond(`lmax' == ., 100 * r(mean), max(`lmax', 100 * r(mean)))
 51.                 }
 52.             }
 53.         }
 54.         * without the provisional R&D / innovation years
.         local pnp = .
 55.         if inlist("`f'", "rd", "inn", "proc") {
 56.             gen byte tmp_np = 1
 57.             foreach y of local prov_yrs {
 58.                 replace tmp_np = 0 if start_year == `y'
 59.             }
 60.             quietly summarize b_`f'_energy_va if g_`f' == `k' & tmp_np == 1
 61.             if r(N) > 0 local pnp = 100 * r(mean)
 62.             drop tmp_np
 63.         }
 64.         * the same change compared with ALL firms that year (the R3-02 benchmark)
.         quietly summarize b_all_energy_va if g_`f' == `k'
 65.         local pall = 100 * r(mean)
 66.         local isans = (`k' < `K')
 67.         post `P' (`r') (`infig') ("`f'") ("`qn'") ("`span_`f''") ("`gname'") (`isans') (`nn') (`nf') ("`refname'") 
> ///
>             `vals' (`lmin') (`lmax') (`pnp') (`pall')
 68.     }
 69. }
