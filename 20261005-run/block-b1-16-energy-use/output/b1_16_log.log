######## B1-16: 05_by_productivity_and_scale ########

. /*==========================================================================
>   Line 5: "Value added per worker, value added, output, output per worker, ca
> pital, capital per worker,"
>   Data  : SI 2010-2022 (data/b16_si.dta), clean == 1
>   Output sheets:
>     t05_by_{va_pw,va,output,out_pw,capital,cap_pw}_q  GJ scope 1 / 2 / total 
> (level & ln), GJ per VA and per worker, by quintile (within year)
> 
>   NOTE: Quintiles are among firms with a positive value; zero or negative
>   values are a separate group. Nominal, masked values.
> ==========================================================================*/
. if "$B16" == "" {
.     display as error "Run 00_run.do first (it sets the paths)."
.     exit 198
. }

. local ENERGY "gj_s1 gj_s2 gj_total ln_gj_s1 ln_gj_s2 ln_gj_total gj_per_va gj
> _pw"

. 
. foreach v in va_pw va output out_pw capital cap_pw {
  2.     use "$B16_DATA/b16_si.dta", clear
  3.     keep if clean == 1
  4.     * quintiles within each year, among positive values
.     generate q_`v' = 0 if `v' <= 0
  5.     levelsof year if `v' > 0 & !missing(`v'), local(years)
  6.     foreach y of local years {
  7.         xtile tmp = `v' if year == `y' & `v' > 0, nquantiles(5)
  8.         replace q_`v' = tmp if year == `y' & `v' > 0 & !missing(`v')
  9.         drop tmp
 10.     }
 11.     label define quint 0 "Zero or negative" 1 "Q1 (lowest)" 2 "Q2" 3 "Q3" 
> 4 "Q4" 5 "Q5 (highest)", replace
 12.     label values q_`v' quint
 13.     do "$B16/_sumstats.do" "`ENERGY'" "q_`v'" "t05_by_`v'_q"
 14. }
(G0 -> G0.25 OBSCURED -> G0.5 DUMMY PANEL -> G1 RE-ESTIMATED)
