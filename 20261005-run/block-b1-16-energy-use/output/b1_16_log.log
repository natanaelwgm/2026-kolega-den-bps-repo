.     label define all 1 "All firms", replace
.     label values all all
.     local grp all
. }

. local periods "pool year"

. if "`mode'" == "poolonly" local periods "pool"

. foreach v of local vars {
  2.     * a variable is not summarised by itself (e.g. exporter rate by export
> er)
.     if "`v'" == "`grp'" continue
  3.     foreach period of local periods {
  4.         preserve
  5.         keep `v' `grp' year
  6.         keep if !missing(`v') & !missing(`grp')
  7.         if _N > 0 {
  8.             if "`period'" == "pool" replace year = 0
  9.             collapse (count) n = `v' (mean) mean = `v' (sd) sd = `v' ///
>                      (p10) p10 = `v' (p25) p25 = `v' (p50) p50 = `v' ///
>                      (p75) p75 = `v' (p90) p90 = `v' (min) min = `v' (max) ma
> x = `v', ///
>                      by(`grp' year)
 10.             generate str32 variable = "`v'"
 11.             if `first' == 0 append using `result'
 12.             save `result', replace
 13.             local first 0
 14.         }
 15.         restore
 16.     }
 17. }
