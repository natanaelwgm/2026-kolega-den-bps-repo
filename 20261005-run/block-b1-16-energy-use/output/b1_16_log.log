######## B1-16: 01_energy_overview ########

. /*==========================================================================
>   Line 1: "Elaborate energy use scope 1, scope 2, dan total: dicek original v
> alue dan ln, dicek pool dan jg by year"
>   Data  : SI 2010-2022 (data/b16_si.dta), clean == 1
>   Output sheets:
>     t01_totals    sum over firms of GJ scope 1 / 2 / total (and CO2, kWh), % 
> of firms with energy use, pool + by year
>     t01_stats     per firm-year: GJ scope 1 / 2 / total (level & ln), GJ per 
> VA, GJ per worker, electricity, pool + by year
>     t01_fuel_qty  reported physical fuel quantities, pool + by year
> 
>   NOTE: Scope 1 = GJ of the 4 fuels asked in every year (diesel, petrol, coal
> ,
>   LPG); scope 2 = purchased electricity (PLN + non-PLN); own generation is
>   not scope 2. Energy reporting changes between 2015 and 2017.
> ==========================================================================*/
. if "$B16" == "" {
.     display as error "Run 00_run.do first (it sets the paths)."
.     exit 198
. }

. 
. * ---- 1. aggregate totals ----
. use "$B16_DATA/b16_si.dta", clear
(G0 -> G0.25 OBSCURED -> G0.5 DUMMY PANEL -> G1 RE-ESTIMATED)

. keep if clean == 1
(30 observations deleted)

. generate n_firms = 1

. generate any_gj = (gj_total > 0 & !missing(gj_total))

. expand 2, generate(copy)              // copy of every row with year = 0 for 
> "pool"
(33,019 observations created)

. replace year = 0 if copy == 1
(33,019 real changes made)

. collapse (sum) n_firms any_gj gj_s1 gj_s2 gj_total co2_s1 co2_s2 co2_total el
> ec_purch_kwh elec_owngen_kwh, by(year)

. generate pct_any_gj   = 100 * any_gj / n_firms

. generate s1_share_pct = 100 * gj_s1 / gj_total

. generate period = cond(year == 0, "pool", string(year))

. order period n_firms any_gj pct_any_gj gj_s1 gj_s2 gj_total s1_share_pct co2_
> s1 co2_s2 co2_total elec_purch_kwh elec_owngen_kwh

. drop year

. list period n_firms pct_any_gj gj_s1 gj_s2 gj_total s1_share_pct, clean noobs

