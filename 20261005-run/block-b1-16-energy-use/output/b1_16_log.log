. * ---- energy use by emissions quintile ----
. foreach v in co2_s1 co2_s2 co2_total {
  2.     use "$B16_DATA/b16_si.dta", clear
  3.     keep if clean == 1
  4.     generate q_`v' = 0 if `v' == 0
  5.     levelsof year if `v' > 0 & !missing(`v'), local(years)
  6.     foreach y of local years {
  7.         xtile tmp = `v' if year == `y' & `v' > 0, nquantiles(5)
  8.         replace q_`v' = tmp if year == `y' & `v' > 0 & !missing(`v')
  9.         drop tmp
 10.     }
 11.     label define quint 0 "Zero" 1 "Q1 (lowest)" 2 "Q2" 3 "Q3" 4 "Q4" 5 "Q5
>  (highest)", replace
 12.     label values q_`v' quint
 13.     local short = subinstr("`v'", "co2_", "", 1)
 14.     do "$B16/_sumstats.do" "`ENERGY'" "q_`v'" "t09_by_co2_`short'_q"
 15. }
