> x = `v', ///
>                      by(`grp' year)
 10.             generate str32 variable = "`v'"
 11.             if `first' == 0 append using `result'
 12.             save `result', replace
 13.             local first 0
 14.         }
 15.         restore
 16.     }
 17. }
