######## B1-14: 11_figures ########

. /*==========================================================================
>   Line 11: "Elaborate bs dengan output stats/stylish facts dalam bentuk
>            table atau dengan graph, atau table yg ready untuk dibuat graph"
>   Every other file writes its tables to output/b1_14_tables.xlsx. This
>   file draws the charts FROM those tables (helper _charts.do), so a chart
>   always matches its table. The exact points of every chart, and the label
>   printed next to each point, are written to a sheet figNN_data.
>   Runs LAST in 00_run.do.
> 
>   Charts (output/):
>     fig01_group_share.png  % of firm-years per KBLI 2-digit sector (pooled)
>     fig02_tfp.png          TFP (Levinsohn-Petrin) per KBLI 2-digit sector (po
> oled)
>     fig03_va_pw.png        Value added per worker per KBLI 2-digit sector (po
> oled)
>     fig07_energy.png       Energy use (median) per KBLI 2-digit sector (poole
> d)
>     fig08_emissions.png    CO2 emissions (median) per KBLI 2-digit sector (po
> oled)
> 
>   Chart rules (repo consensus): see _charts.do.
> ==========================================================================*/
. if "$B14" == "" {
.     display as error "Run 00_run.do first (it sets the paths)."
.     exit 198
. }

. 
. global FIG_XLSX "$B14_XLSX"

. global FIG_OUT  "$B14_OUT"

. do "$B14/_charts.do"

. /*==========================================================================
>   _charts.do -- helper: chart programs for the figures file
> 
>   Load once at the top of the figures file, after setting
>       global FIG_XLSX  the block's tables workbook (charts read only from it)
>       global FIG_OUT   the block's output folder
> 
>   Programs:
>     ch_wide    load one statistic from a table sheet, by year, one column
>                per group (s1 s2 ...); returns locals `wide' and `glabels'
>     ch_lines   by-year lines: 2016 band, first/last labels, legend
>     ch_qlines  lines over quintiles 1-5 (no year axis), first/last labels
>     ch_dots    pooled dot plot per group, sorted, value labels
>     ch_shares  pooled % of firm-years per category (horizontal bars)
>     ch_profile pooled % exporting / importing / FDI / ... per group
>     ch_counts  firm-years per year (bars with counts, 2016 band)
> 
>   Chart rules (repo consensus, WRITING-PREFERENCES-SEE-HERE.md):
>     - lines are labelled at their first and last point only; bars and dots
>       carry their value; labels are formatted from the table cells
>     - 2016 has no survey file: lines break there and a gray band marks it,
>       with a "No annual file" key in the legend
>     - every chart has a legend, a Notes line and a separate Source line
>     - fixed precision per unit (set by the caller with fmt())
>     - the points of every chart, and the printed labels, are written to a
>       sheet figNN_data in the same workbook
> ==========================================================================*/
. global FIG_SRC "Source: SI 2010-2022 analysis-ready data (block 0; obscured v
> alues, fictional firm links); authors' calculations."

. global C1 "42 120 214"      // blue

. global C2 "235 104 52"      // orange

. global C3 "27 175 122"      // green

. global C4 "150 90 190"      // purple

. global BAND "gs14"          // 2016 band

. global GOPT "scheme(s1color) graphregion(color(white)) plotregion(color(white
> )) xsize(7) ysize(4.5)"

. 
. * ---------------------------------------------------------------------------
. * ch_wide, sheet(t08_tfp) key(group) stat(mean) [var(tfp_lp) filter(...) scal
> e(100)]
. *   key   = column whose values become the series (group, category or variabl
> e)
. *   var   = keep only this variable (for _sumstats sheets)
. *   filter= any extra keep-if condition
. *   Series keep the order of the table (= the group codes).
. * ---------------------------------------------------------------------------
. capture program drop ch_wide

. program define ch_wide
  1.     syntax, SHEET(string) KEY(string) STAT(string) [VAR(string) FILTER(str
> ing asis) SCALE(real 1)]
  2.     import excel using "$FIG_XLSX", sheet("`sheet'") firstrow clear
  3.     foreach v in group category {
  4.         capture confirm variable `v'
  5.         if !_rc {
  6.             capture confirm string variable `v'
  7.             if _rc tostring `v', replace
  8.         }
  9.     }
 10.     if "`var'" != "" keep if variable == "`var'"
 11.     if `"`filter'"' != "" keep if `filter'
 12.     keep if period != "pool"
 13.     generate long order = _n
 14.     bysort `key' (order): generate long first = order[1]
 15.     egen gid = group(first)
 16.     local labs ""
 17.     local wide ""
 18.     quietly levelsof gid, local(ids)
 19.     foreach i of local ids {
 20.         quietly levelsof `key' if gid == `i', local(g) clean
 21.         local labs `"`labs' `"`g'"'"'
 22.         local wide "`wide' s`i'"
 23.     }
 24.     generate year = real(period)
 25.     generate double s = `stat' * `scale'
 26.     keep year gid s
 27.     reshape wide s, i(year) j(gid)
 28.     c_local glabels `"`labs'"'
 29.     c_local wide "`wide'"
 30. end

. 
. * ---------------------------------------------------------------------------
. * ch_endlabels s1 s2, x(year) fmt(%4.2f) gap(0.1)
. *   appends one row per printed label: _lk (series number), _lx, _ly (where
. *   the label is drawn), _lpos (9 = left of the first point, 3 = right of
. *   the last point) and _ltxt (the printed value). Labels at the same end
. *   that would overlap are moved apart vertically by at least gap; the
. *   printed value itself never changes.
. * ---------------------------------------------------------------------------
. capture program drop ch_endlabels

. program define ch_endlabels
  1.     syntax varlist, X(varname) FMT(string) GAP(real)
  2.     tempfile main labs
  3.     quietly save `main'
  4.     local k 0
  5.     foreach s of local varlist {
  6.         local ++k
  7.         use `main', clear
  8.         keep `x' `s'
  9.         drop if missing(`s') | missing(`x')
 10.         quietly summarize `x'
 11.         local xmin = r(min)
 12.         local xmax = r(max)
 13.         keep if inlist(`x', `xmin', `xmax')
 14.         generate byte _lk = `k'
 15.         generate byte _lpos = cond(`x' == `xmin' & `xmin' != `xmax', 9, 3)
 16.         rename `x' _lx
 17.         rename `s' _lv
 18.         generate str16 _ltxt = strtrim(string(_lv, "`fmt'"))
 19.         keep _lk _lx _lv _lpos _ltxt
 20.         if `k' > 1 append using `labs'
 21.         quietly save `labs', replace
 22.     }
 23.     generate double _ly = _lv
 24.     sort _lpos _lx _lv _lk
 25.     by _lpos _lx: replace _ly = max(_ly, _ly[_n-1] + `gap') if _n > 1
 26.     keep _lk _lx _ly _lpos _ltxt
 27.     quietly save `labs', replace
 28.     use `main', clear
 29.     append using `labs'
 30. end

. 
. * ---------------------------------------------------------------------------
. * ch_lines s1 s2, labels("A" "B") fmt(%4.2f) ytitle() title() note("Notes: ..
> ." "$FIG_SRC") sheet() file()
. *   data in memory: year s1 [s2 [s3 [s4]]], one row per survey year
. * ---------------------------------------------------------------------------
. capture program drop ch_lines

. program define ch_lines
  1.     syntax varlist(min=1 max=4), LABELS(string asis) FMT(string) YTITLE(st
> ring) ///
>         TITLE(string) NOTE(string asis) SHEET(string) FILE(string)
  2.     local colors `""$C1" "$C2" "$C3" "$C4""'
  3.     local symbols "O S T D"
  4.     * printed labels: first and last available year of each series
.     foreach s of local varlist {
  5.         quietly summarize year if !missing(`s')
  6.         generate str16 lab_`s' = strtrim(string(`s', "`fmt'")) if !missing
> (`s') & inlist(year, r(min), r(max))
  7.     }
  8.     * graph-ready data, with the printed labels
.     preserve
  9.     sort year
 10.     export excel using "$FIG_XLSX", sheet("`sheet'", replace) firstrow(var
> iables)
 11.     restore
 12.     * 2016 band spans the plotted range
.     local lo .
 13.     local hi .
 14.     foreach s of local varlist {
 15.         quietly summarize `s'
 16.         if r(min) < `lo' | `lo' == . local lo = r(min)
 17.         if r(max) > `hi' | `hi' == . local hi = r(max)
 18.     }
 19.     local pad = (`hi' - `lo') * 0.12
 20.     if `pad' == 0 local pad = abs(`hi') * 0.1 + 1
 21.     local lo = `lo' - `pad'
 22.     local hi = `hi' + `pad'
 23.     quietly count if year == 2016
 24.     if r(N) == 0 {
 25.         quietly set obs `=_N + 1'
 26.         quietly replace year = 2016 in `=_N'
 27.     }
 28.     generate band_lo = `lo' if year == 2016
 29.     generate band_hi = `hi' if year == 2016
 30.     sort year
 31.     * label anchors: first value left of the line, last value right of it
.     ch_endlabels `varlist', x(year) fmt(`fmt') gap(`=(`hi' - `lo') * 0.06')
 32.     quietly summarize _ly
 33.     if r(max) > `hi' local hi = r(max)
 34.     * plots: 1 = band, 2..k+1 = lines, then the label layers
.     local plots "(rbar band_lo band_hi year, barwidth(0.8) color($BAND) lwidt
> h(none))"
 35.     local k 0
 36.     foreach s of local varlist {
 37.         local ++k
 38.         local col : word `k' of `colors'
 39.         local sym : word `k' of `symbols'
 40.         local plots `"`plots' (connected `s' year, lcolor("`col'") mcolor(
> "`col'") msymbol(`sym') lwidth(medthick) cmissing(n))"'
 41.     }
 42.     local k 0
 43.     foreach s of local varlist {
 44.         local ++k
 45.         local col : word `k' of `colors'
 46.         local plots `"`plots' (scatter _ly _lx if _lk == `k', msymbol(none
> ) mlabel(_ltxt) mlabvposition(_lpos) mlabcolor("`col'") mlabsize(small))"'
 47.     }
 48.     local order ""
 49.     local k 1
 50.     foreach l of local labels {
 51.         local ++k
 52.         local order `"`order' `k' `"`l'"'"'
 53.     }
 54.     local rows = cond(`k' <= 4, 1, 2)
 55.     twoway `plots', ///
>         legend(order(`order' 1 "No annual file") rows(`rows') size(small) reg
> ion(lcolor(white))) ///
>         yscale(range(`lo' `hi')) ylabel(, angle(0) labsize(small) format(`fmt
> ')) ///
>         xscale(range(2008.4 2023.6)) xlabel(2010(2)2022, labsize(small)) xtit
> le("") ///
>         ytitle("`ytitle'", size(small) margin(0 3 0 0)) ///
>         title("`title'", size(medsmall)) note(`note', size(vsmall)) $GOPT
 56.     graph export "$FIG_OUT/`file'.png", replace width(2200)
 57. end

. 
. * ---------------------------------------------------------------------------
. * ch_qlines s1 s2, labels() fmt() ytitle() xtitle() title() note() sheet() fi
> le()
. *   data in memory: quintile (1-5) s1 [s2 [s3 [s4]]]
. * ---------------------------------------------------------------------------
. capture program drop ch_qlines

. program define ch_qlines
  1.     syntax varlist(min=1 max=4), LABELS(string asis) FMT(string) YTITLE(st
> ring) XTITLE(string) ///
>         TITLE(string) NOTE(string asis) SHEET(string) FILE(string)
  2.     local colors `""$C1" "$C2" "$C3" "$C4""'
  3.     local symbols "O S T D"
  4.     foreach s of local varlist {
  5.         quietly summarize quintile if !missing(`s')
  6.         generate str16 lab_`s' = strtrim(string(`s', "`fmt'")) if !missing
> (`s') & inlist(quintile, r(min), r(max))
  7.     }
  8.     sort quintile
  9.     export excel using "$FIG_XLSX", sheet("`sheet'", replace) firstrow(var
> iables)
 10.     local lo .
 11.     local hi .
 12.     foreach s of local varlist {
 13.         quietly summarize `s'
 14.         if r(min) < `lo' | `lo' == . local lo = r(min)
 15.         if r(max) > `hi' | `hi' == . local hi = r(max)
 16.     }
 17.     local gap = (`hi' - `lo') * 0.05
 18.     if `gap' == 0 local gap = abs(`hi') * 0.05 + 0.01
 19.     ch_endlabels `varlist', x(quintile) fmt(`fmt') gap(`gap')
 20.     local plots ""
 21.     local k 0
 22.     foreach s of local varlist {
 23.         local ++k
 24.         local col : word `k' of `colors'
 25.         local sym : word `k' of `symbols'
 26.         local plots `"`plots' (connected `s' quintile, lcolor("`col'") mco
> lor("`col'") msymbol(`sym') lwidth(medthick))"'
 27.     }
 28.     local k 0
 29.     foreach s of local varlist {
 30.         local ++k
 31.         local col : word `k' of `colors'
 32.         local plots `"`plots' (scatter _ly _lx if _lk == `k', msymbol(none
> ) mlabel(_ltxt) mlabvposition(_lpos) mlabcolor("`col'") mlabsize(small))"'
 33.     }
 34.     local order ""
 35.     local k 0
 36.     foreach l of local labels {
 37.         local ++k
 38.         local order `"`order' `k' `"`l'"'"'
 39.     }
 40.     twoway `plots', ///
>         legend(order(`order') rows(1) size(small) region(lcolor(white))) ///
>         xscale(range(0.3 5.7)) xlabel(1 "Q1 (lowest)" 2 "Q2" 3 "Q3" 4 "Q4" 5 
> "Q5 (highest)", labsize(small)) ///
>         ylabel(, angle(0) labsize(small) format(`fmt')) xtitle("`xtitle'", si
> ze(small)) ///
>         ytitle("`ytitle'", size(small) margin(0 3 0 0)) ///
>         title("`title'", size(medsmall)) note(`note', size(vsmall)) $GOPT
 41.     graph export "$FIG_OUT/`file'.png", replace width(2200)
 42. end

. 
. * ---------------------------------------------------------------------------
. * ch_dots, sheet() var() stat() fmt() xtitle() legend() title() note() outshe
> et() file() [minn(100) prefix("KBLI ")]
. *   pooled value per group, sorted from high to low; groups with fewer than
. *   minn firm-years are left out
. * ---------------------------------------------------------------------------
. capture program drop ch_dots

. program define ch_dots
  1.     syntax, SHEET(string) VAR(string) STAT(string) FMT(string) XTITLE(stri
> ng) LEGEND(string) ///
>         TITLE(string) NOTE(string asis) OUTSHEET(string) FILE(string) [MINN(i
> nteger 0) PREFIX(string)]
  2.     import excel using "$FIG_XLSX", sheet("`sheet'") firstrow clear
  3.     capture confirm string variable group
  4.     if _rc tostring group, replace
  5.     keep if variable == "`var'" & period == "pool" & n >= `minn'
  6.     gsort -`stat'
  7.     generate pos = _n
  8.     generate str16 lab = strtrim(string(`stat', "`fmt'"))
  9.     generate str48 name = "`prefix'" + group
 10.     keep pos name n `stat' lab
 11.     export excel using "$FIG_XLSX", sheet("`outsheet'", replace) firstrow(
> variables)
 12.     local ylab ""
 13.     forvalues i = 1/`=_N' {
 14.         local ylab `"`ylab' `i' "`=name[`i']'""'
 15.     }
 16.     summarize `stat', meanonly
 17.     local xlo = r(min) - 0.05 * (r(max) - r(min))
 18.     local xhi = r(max) + 0.25 * (r(max) - r(min))
 19.     local ys = min(9, max(4.5, 0.22 * _N + 2.5))
 20.     local ns = cond(`ys' > 6, "tiny", "vsmall")
 21.     twoway (scatter pos `stat', msymbol(O) mcolor("$C1") ///
>             mlabel(lab) mlabpos(3) mlabsize(vsmall) mlabcolor(black)), ///
>         legend(on order(1 "`legend'") size(small) region(lcolor(white))) ///
>         ylabel(`ylab', angle(0) labsize(vsmall) nogrid) yscale(reverse range(
> 0.5 `=_N + 0.5')) ///
>         xscale(range(`xlo' `xhi')) xlabel(, labsize(small) format(`fmt')) ///
>         ytitle("") xtitle("`xtitle'", size(small)) ///
>         title("`title'", size(medsmall)) note(`note', size(`ns')) ///
>         scheme(s1color) graphregion(color(white)) plotregion(color(white)) xs
> ize(7) ysize(`ys')
 22.     graph export "$FIG_OUT/`file'.png", replace width(2200)
 23. end

. 
. * ---------------------------------------------------------------------------
. * ch_shares, sheet() title() note() outsheet() file() [prefix() group()]
. *   pooled % of firm-years per category from a _shares.do sheet
. * ---------------------------------------------------------------------------
. capture program drop ch_shares

. program define ch_shares
  1.     syntax, SHEET(string) TITLE(string) NOTE(string asis) OUTSHEET(string)
>  FILE(string) ///
>         [PREFIX(string) GROUP(string)]
  2.     import excel using "$FIG_XLSX", sheet("`sheet'") firstrow clear
  3.     foreach v in group category {
  4.         capture confirm string variable `v'
  5.         if _rc tostring `v', replace
  6.     }
  7.     keep if period == "pool"
  8.     if "`group'" != "" keep if group == "`group'"
  9.     gsort -pct_firms
 10.     generate order = _n
 11.     generate str16 lab = strtrim(string(pct_firms, "%4.1f"))
 12.     generate str48 name = "`prefix'" + category
 13.     keep order name n_firms pct_firms lab
 14.     export excel using "$FIG_XLSX", sheet("`outsheet'", replace) firstrow(
> variables)
 15.     summarize pct_firms, meanonly
 16.     local hi = r(max) * 1.15
 17.     local ys = min(9, max(4.5, 0.22 * _N + 2.5))
 18.     local ns = cond(`ys' > 6, "tiny", "vsmall")
 19.     graph hbar (asis) pct_firms, over(name, sort(order) label(labsize(vsma
> ll))) ///
>         bar(1, color("$C1")) blabel(bar, format(%4.1f) size(vsmall)) ///
>         legend(on order(1 "% of firm-years (pooled)") size(small) region(lcol
> or(white))) ///
>         ytitle("% of firm-years", size(small)) yscale(range(0 `hi')) ylabel(,
>  labsize(small)) ///
>         title("`title'", size(medsmall)) note(`note', size(`ns')) ///
>         scheme(s1color) graphregion(color(white)) plotregion(color(white)) xs
> ize(7) ysize(`ys')
 20.     graph export "$FIG_OUT/`file'.png", replace width(2200)
 21. end

. 
. * ---------------------------------------------------------------------------
. * ch_profile, sheet() title() note() outsheet() file()
. *   pooled % of each group that exports / imports / is FDI / large / does
. *   R&D / is in Java (the means of the 0/1 variables of a _sumstats sheet)
. * ---------------------------------------------------------------------------
. capture program drop ch_profile

. program define ch_profile
  1.     syntax, SHEET(string) TITLE(string) NOTE(string asis) OUTSHEET(string)
>  FILE(string)
  2.     import excel using "$FIG_XLSX", sheet("`sheet'") firstrow clear
  3.     capture confirm string variable group
  4.     if _rc tostring group, replace
  5.     keep if period == "pool"
  6.     generate pct = 100 * mean
  7.     generate str32 rate = ""
  8.     replace rate = "Exporting"            if variable == "exporter"
  9.     replace rate = "Importing"            if variable == "importer"
 10.     replace rate = "FDI (>=10%)"          if variable == "fdi"
 11.     replace rate = "Large (>100)"         if variable == "large"
 12.     replace rate = "R&D (2017-22)"        if variable == "rnd"
 13.     replace rate = "Java"                 if variable == "java"
 14.     keep if rate != ""
 15.     generate long order = _n
 16.     bysort variable (order): generate long rate_order = order[1]
 17.     bysort group (order): generate long group_order = order[1]
 18.     generate str16 lab = strtrim(string(pct, "%4.1f"))
 19.     sort rate_order group_order
 20.     keep rate group n pct lab rate_order group_order
 21.     export excel using "$FIG_XLSX", sheet("`outsheet'", replace) firstrow(
> variables)
 22.     * groups in code order (same colours as the line charts), labelled by 
> name
.     egen gnum = group(group_order)
 23.     quietly levelsof gnum, local(gs)
 24.     local ng : word count `gs'
 25.     foreach i of local gs {
 26.         quietly levelsof group if gnum == `i', local(gname) clean
 27.         label define gnum `i' `"`gname'"', add
 28.     }
 29.     label values gnum gnum
 30.     local colors `""$C1" "$C2" "$C3" "$C4""'
 31.     local bars ""
 32.     forvalues k = 1/`=min(`ng', 4)' {
 33.         local c : word `k' of `colors'
 34.         local bars `"`bars' bar(`k', color("`c'"))"'
 35.     }
 36.     summarize pct, meanonly
 37.     local hi = r(max) * 1.15
 38.     graph hbar (asis) pct, over(gnum, label(labsize(vsmall))) ///
>         over(rate, sort(rate_order) label(labsize(vsmall))) asyvars `bars' //
> /
>         blabel(bar, format(%4.1f) size(vsmall)) ///
>         legend(rows(1) size(small) region(lcolor(white))) ///
>         ytitle("% of firm-years in the group (pooled)", size(small)) yscale(r
> ange(0 `hi')) ylabel(, labsize(small)) ///
>         title("`title'", size(medsmall)) note(`note', size(tiny)) ///
>         scheme(s1color) graphregion(color(white)) plotregion(color(white)) xs
> ize(7) ysize(6)
 39.     graph export "$FIG_OUT/`file'.png", replace width(2200)
 40. end

. 
. * ---------------------------------------------------------------------------
. * ch_counts, sheet() var() title() note() outsheet() file()
. *   firm-years per year = n of a variable observed for every record
. * ---------------------------------------------------------------------------
. capture program drop ch_counts

. program define ch_counts
  1.     syntax, SHEET(string) VAR(string) TITLE(string) NOTE(string asis) OUTS
> HEET(string) FILE(string)
  2.     import excel using "$FIG_XLSX", sheet("`sheet'") firstrow clear
  3.     keep if variable == "`var'" & period != "pool"
  4.     generate year = real(period)
  5.     keep year n
  6.     generate str16 lab_n = strtrim(string(n, "%9.0fc"))
  7.     sort year
  8.     export excel using "$FIG_XLSX", sheet("`outsheet'", replace) firstrow(
> variables)
  9.     summarize n, meanonly
 10.     local hi = r(max) * 1.15
 11.     set obs `=_N + 1'
 12.     replace year = 2016 in `=_N'
 13.     generate band_hi = `hi' if year == 2016
 14.     generate band_lo = 0 if year == 2016
 15.     sort year
 16.     twoway (rbar band_lo band_hi year, barwidth(0.8) color($BAND) lwidth(n
> one)) ///
>            (bar n year, barwidth(0.7) color("$C1")) ///
>            (scatter n year, msymbol(none) mlabel(lab_n) mlabpos(12) mlabsize(
> vsmall) mlabcolor(black)), ///
>         legend(order(2 "Firm-years in the file" 1 "No annual file") rows(1) s
> ize(small) region(lcolor(white))) ///
>         yscale(range(0 `hi')) ylabel(, angle(0) labsize(small) format(%9.0fc)
> ) ///
>         xlabel(2010(2)2022, labsize(small)) xtitle("") ytitle("Firm-years", s
> ize(small) margin(0 3 0 0)) ///
>         title("`title'", size(medsmall)) note(`note', size(vsmall)) $GOPT
 17.     graph export "$FIG_OUT/`file'.png", replace width(2200)
 18. end

. 
end of do-file

. 
